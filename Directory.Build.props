<Project>
  <!-- Common build settings for all Atalaya projects. -->
  <PropertyGroup>
    <!-- F8 — LA VERSIÓN, EN UN SOLO SITIO.
         De aquí salen AssemblyVersion, FileVersion e InformationalVersion de TODOS los
         ensamblados, y de InformationalVersion sale lo que enseña «Acerca de».

         El workflow de release la PISA con la del tag (`-p:Version=1.2.3`), así que el binario
         que se distribuye siempre dice la verdad sobre el tag que lo produjo: un desajuste
         tag↔binario es imposible por construcción. -->

    <!-- BUGFIX-VERSION — QUIÉN construyó esto, no solo qué número lleva.

         `Version` llega como propiedad GLOBAL únicamente desde el workflow (`-p:Version=`), y una
         propiedad global no se puede redefinir aquí. Así que estar vacía en este punto significa,
         sin ambigüedad, «esto NO es un build de release»: es un publish local o un F5 del IDE.
         Es la única señal fiable — la posición en git no vale, porque un publish local sobre el
         commit exacto del tag sigue sin ser el artefacto que se distribuye.

         Lo que se hace con esa señal está en Directory.Build.targets: un build local se estampa
         con `-dev` y su commit, para que jamás pueda leerse como «la release 1.0.0». -->
    <AtalayaReleaseBuild Condition="'$(Version)' != ''">true</AtalayaReleaseBuild>
    <AtalayaReleaseBuild Condition="'$(AtalayaReleaseBuild)' == ''">false</AtalayaReleaseBuild>

    <!-- El suelo: lo que se estampa cuando no hay git con el que preguntar (un zip del código
         sin `.git`, una imagen de CI recortada). Ya no hay que acordarse de subirlo en cada
         release —el tag es el único ritual—, pero sigue siendo el número del que se parte. -->
    <AtalayaFallbackVersion>1.0.0</AtalayaFallbackVersion>

    <!-- AssemblyVersion y FileVersion son NUMÉRICAS: no admiten sufijos. Se quedan en el número
         base, y toda la verdad sobre el origen del binario viaja en InformationalVersion, que es
         lo que «Acerca de» lee (y lo que SemVer permite adornar). -->
    <Version Condition="'$(Version)' == ''">$(AtalayaFallbackVersion)</Version>

    <!-- F38 — LA MARCA DEL BINARIO, EXPLÍCITA.

         Sin estas cuatro propiedades MSBuild las deriva del nombre del ensamblado y deja
         `Copyright` vacío: Windows enseñaba «Atalaya» en Producto por accidente y nada en
         Copyright. Un metadato que sale bien por defecto es uno que se rompe el día que cambia el
         `AssemblyName`. La marca de la APLICACIÓN es Atalaya y no la de ninguna organización: lo
         que sale de la organización configurada es la firma en pantalla y el pie del informe, que
         se leen del hub en tiempo de ejecución (F38 §1). -->
    <Company>Atalaya</Company>
    <Product>Atalaya</Product>
    <Authors>Álvaro López Ciller</Authors>
    <Copyright>© 2026 Álvaro López Ciller</Copyright>

    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Per §11: warnings-as-errors is enforced in Domain and Storage explicitly.
         We keep it off globally so WPF/XAML analyzer noise in App does not block builds. -->
  </PropertyGroup>
</Project>
