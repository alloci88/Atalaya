<Project Sdk="Microsoft.NET.Sdk">

  <!-- El banco de medida de F18. NO está en Atalaya.sln a propósito: no forma parte del producto
       ni de la suite, y meterlo en la solución haría que cada build de la aplicación arrastrara un
       ejecutable que solo se usa a mano. Se compila y se corre por su ruta, como IconGen. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- F24: el modo `barrido` corre el coordinador de verdad, y ése vive en Atalaya.App
         (WPF). El banco no abre ninguna ventana; solo necesita el mismo TFM. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PromptBench</AssemblyName>
    <RootNamespace>Atalaya.PromptBench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atalaya.Agents\Atalaya.Agents.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.App\Atalaya.App.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.ClaudeCode\Atalaya.ClaudeCode.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Copilot\Atalaya.Copilot.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Domain\Atalaya.Domain.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Mcp\Atalaya.Mcp.csproj" />
  </ItemGroup>

</Project>
