<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Atalaya.Copilot</RootNamespace>
    <!-- SDK version FIXED per §6.1. Verified real API surface against this build (H5). -->
    <CopilotSdkVersion>1.0.11</CopilotSdkVersion>
    <!-- GHCP001: the SDK marks some members [Experimental]; we opt in knowingly and isolate them. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.2.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atalaya.Domain\Atalaya.Domain.csproj" />
  </ItemGroup>

</Project>
