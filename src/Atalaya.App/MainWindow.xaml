<ui:FluentWindow
    x:Class="Atalaya.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Atalaya"
    Icon="pack://application:,,,/assets/atalaya.ico"
    Width="1340"
    Height="800"
    MinWidth="900"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- La barra de título va SIN icono al lado del texto. Se probó —el de la aplicación, en
             el hueco nativo de la barra— y no convenció: en esa esquina el icono no aporta nada
             que no diga ya la palabra, y la barra se lee mejor limpia. Windows sigue enseñando el
             icono donde hace falta: barra de tareas, Alt-Tab y Explorador, todos desde
             Window.Icon y ApplicationIcon (F6.4 §1). -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Atalaya"
            Grid.ColumnSpan="2" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="12,16">
                <!-- F5.3: sin cabecera de marca. «Atalaya» ya está en la barra de título; repetirla
                     aquí en grande era la MISMA marca dos veces en la misma ventana. El rail
                     empieza directamente por los items. -->
                <StackPanel>
                    <ui:Button
                        Command="{Binding ShowPortfolioCommand}"
                        Content="Portafolio"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <!-- Sesión: solo aparece cuando hay una (en curso o recién terminada). El punto
                         late mientras corre, que es la señal de que la auditoría sigue viva aunque
                         estés en otra página (F5.2, Hito 1). -->
                    <ui:Button
                        Command="{Binding ShowSessionCommand}"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2"
                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="#3FB950"
                                     Visibility="{Binding IsSessionRunning, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSessionRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="Pulse">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="1.0" To="0.15" Duration="0:0:0.9"
                                                                AutoReverse="True" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Pulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SessionNavLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <!-- Arreglo asistido (F6.9): mismo patrón que la sesión — solo aparece cuando
                         hay uno, y el punto late mientras el agente escribe en el clon. Se queda
                         mientras QUEDEN cambios sin cerrar: es el camino de vuelta al descarte. -->
                    <ui:Button
                        Command="{Binding ShowFixCommand}"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2"
                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="#E0A030"
                                     Visibility="{Binding IsFixRunning, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFixRunning}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="FixPulse">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="Opacity"
                                                                From="1.0" To="0.15" Duration="0:0:0.9"
                                                                AutoReverse="True" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="FixPulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding FixNavLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button
                        Command="{Binding ShowFindingsCommand}"
                        Content="Hallazgos"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowMetricsCommand}"
                        Content="Métricas"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowReportsCommand}"
                        Content="Informes"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding NewAppCommand}"
                        Content="Nueva aplicación"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowAccountCommand}"
                        Content="Cuenta"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowSettingsCommand}"
                        Content="Ajustes"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                </StackPanel>
            </Border>

            <!-- Page host. Las dos filas de arriba son los avisos que no pueden perderse: la
                 versión nueva (F8 §3) y el cierre de ciclo (F12 §G). Cada una ocupa alto solo
                 cuando hay algo que decir, así que el 99 % de los arranques la ventana se ve
                 exactamente igual que antes. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Discreto a propósito: ni modal ni toast. Un modal interrumpe por una noticia
                     que no es urgente; un toast caduca a los 8 s y se pierde si mirabas otra cosa.
                     Esto se queda hasta que el usuario decide, y ocupa una línea. -->
                <Border Grid.Row="0"
                        Margin="20,12,20,0" Padding="12,8"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="pack://application:,,,/assets/atalaya.ico"
                                                 DecodePixelWidth="16" DecodePixelHeight="16" />
                                </Image.Source>
                            </Image>
                            <TextBlock Text="{Binding UpdateLabel}" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />

                            <!-- F11 — Actualizar es una DECISIÓN, y por eso es un botón y no un
                                 automatismo. Mientras dura, el banner deja de ofrecer y pasa a
                                 contar: quien pulsó tiene derecho a ver qué está pasando. -->
                            <ui:Button Content="{Binding InstallUpdateLabel}"
                                       Command="{Binding InstallUpdateCommand}"
                                       Appearance="Primary"
                                       Margin="14,0,0,0" Padding="12,3"
                                       VerticalAlignment="Center"
                                       ToolTip="Descarga la versión nueva, comprueba su checksum, sustituye la carpeta y vuelve a abrir Atalaya. Tus ajustes, tu cuenta y tus clones no se tocan."
                                       Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />

                            <ui:HyperlinkButton Content="Ver novedades"
                                                Command="{Binding OpenUpdateCommand}"
                                                Margin="12,0,0,0" Padding="0"
                                                VerticalAlignment="Center"
                                                ToolTip="Abre la página de la versión en el navegador, con sus notas y su zip."
                                                Visibility="{Binding CanOpenUpdate, Converter={StaticResource BoolToVisibility}}" />
                            <ui:HyperlinkButton Content="Descartar"
                                                Command="{Binding DismissUpdateCommand}"
                                                Margin="14,0,0,0" Padding="0"
                                                VerticalAlignment="Center"
                                                ToolTip="No vuelve a avisar de esta versión. De la siguiente sí." />
                        </StackPanel>

                        <!-- Por qué NO se puede actualizar (una sesión en curso, un build local,
                             sin permisos), o qué tener en cuenta si sí (un arreglo abierto). Un
                             botón que falta sin explicación se lee como un fallo del programa. -->
                        <TextBlock Text="{Binding UpdateNotice}"
                                   Margin="26,6,0,0"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Margin="26,8,0,0"
                                    Visibility="{Binding UpdateInProgress, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding UpdateProgressText}" TextWrapping="Wrap" />
                            <ProgressBar Height="4" Margin="0,6,0,0"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding UpdateProgressPercent, Mode=OneWay, FallbackValue=0, TargetNullValue=0}"
                                         IsIndeterminate="{Binding UpdateProgressIndeterminate}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- F12 §G — CIERRE DE CICLO. F9.2 cerraba y sembraba bien, pero en silencio: el
                     Portafolio pasaba a «Ciclo 2» y ya. Mismo patrón que el aviso de versión —
                     discreto, no efímero y descartable— porque cerrar un ciclo es una buena
                     noticia que no puede perderse si mirabas otra pantalla, y no una
                     interrupción que merezca un modal. -->
                <Border Grid.Row="1"
                        Margin="20,12,20,0" Padding="12,8"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Visibility="{Binding CycleClosed, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel>
                        <TextBlock Text="✓" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" />
                        <TextBlock Text="{Binding CycleClosedLabel}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                        <ui:HyperlinkButton Content="Ver el informe del cierre"
                                            Command="{Binding OpenCycleReportCommand}"
                                            Margin="14,0,0,0" Padding="0"
                                            VerticalAlignment="Center"
                                            ToolTip="La foto de con qué cerró el ciclo y qué hereda el siguiente."
                                            Visibility="{Binding CanOpenCycleReport, Converter={StaticResource BoolToVisibility}}" />
                        <ui:HyperlinkButton Content="Descartar"
                                            Command="{Binding DismissCycleCloseCommand}"
                                            Margin="14,0,0,0" Padding="0"
                                            VerticalAlignment="Center"
                                            ToolTip="Quita el aviso. El informe del cierre sigue en Informes." />
                    </WrapPanel>
                </Border>

                <Border Grid.Row="2" Padding="20,12">
                    <ContentControl Content="{Binding Navigation.Current}" />
                </Border>
            </Grid>

            <!-- Avisos efímeros (F5.3 §3): flotan SOBRE la página, caducan a los 8 s y se
                 descartan con un clic. Ya no son elementos de la barra de estado, que es lo que
                 hacía que dos «Sesión completada» se quedaran ahí para siempre. -->
            <ItemsControl
                Grid.Column="0"
                Grid.ColumnSpan="2"
                ItemsSource="{Binding Toasts}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,12"
                IsHitTestVisible="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,4,0,0"
                            Cursor="Hand"
                            HorizontalAlignment="Right"
                            ToolTip="Descartar">
                            <Border Background="#EE2B2B2B" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="12,7" MaxWidth="420">
                                <StackPanel Orientation="Horizontal">
                                    <!-- F6.4: el aviso lo firma la aplicación. Los toasts son
                                         NUESTROS (no los del sistema), así que el icono es el
                                         mismo .ico compilado, a 16 px — el tamaño para el que
                                         existe la variante de silueta. -->
                                    <Image Width="16" Height="16" Margin="0,0,9,0"
                                           VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Source>
                                            <BitmapImage UriSource="pack://application:,,,/assets/atalaya.ico"
                                                         DecodePixelWidth="16" DecodePixelHeight="16" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#F0F0F0" MaxWidth="370" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding SyncHealth, Converter={StaticResource SyncHealthToBrush}}" />
                    <TextBlock Text="{Binding SyncHealth}" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.85" />
                    <ui:ProgressRing
                        IsIndeterminate="True"
                        Width="16"
                        Height="16"
                        Margin="12,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Progreso de la sesión: clic → V5. Que se vea desde cualquier página es
                         justo lo que faltaba (F5.2, Hito 1). -->
                    <Button
                        Command="{Binding ShowSessionCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,0"
                        Margin="14,0,0,0"
                        Cursor="Hand"
                        ToolTip="Ir a la sesión en vivo"
                        Visibility="{Binding SessionProgress, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SessionProgress}" VerticalAlignment="Center" Opacity="0.9" />
                        </StackPanel>
                    </Button>

                    <!-- Arreglo asistido en curso (F6.9): mismo sitio y mismo gesto que el de
                         la auditoría, para que se vea desde cualquier página. -->
                    <Button
                        Command="{Binding ShowFixCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,0"
                        Margin="14,0,0,0"
                        Cursor="Hand"
                        ToolTip="Ir al arreglo asistido"
                        Visibility="{Binding FixProgress, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FixProgress}" VerticalAlignment="Center" Opacity="0.9" />
                        </StackPanel>
                    </Button>

                    <!-- Connected account (D4): click goes to Cuenta. -->
                    <Button
                        Command="{Binding ShowAccountCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,0"
                        Margin="14,0,0,0"
                        Cursor="Hand"
                        ToolTip="Cuenta de GitHub">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AccountAvatarUrl}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding AccountLabel}" Margin="7,0,0,0" VerticalAlignment="Center" Opacity="0.85" />
                            <TextBlock
                                Text="⚠"
                                Foreground="#E0A030"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Reconecta tu cuenta de GitHub"
                                Visibility="{Binding AccountNeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
