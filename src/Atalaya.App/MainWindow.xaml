<ui:FluentWindow
    x:Class="Atalaya.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Atalaya"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="560"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="Atalaya"
            Grid.ColumnSpan="2" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="12,16">
                <StackPanel>
                    <TextBlock Text="ATALAYA" FontWeight="Bold" FontSize="16" Margin="6,0,0,18" Opacity="0.9" />
                    <ui:Button
                        Command="{Binding ShowPortfolioCommand}"
                        Content="Portafolio"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowFindingsCommand}"
                        Content="Hallazgos"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowMetricsCommand}"
                        Content="Métricas"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding NewAppCommand}"
                        Content="Nueva aplicación"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowImportCommand}"
                        Content="Importar v4"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                    <ui:Button
                        Command="{Binding ShowSettingsCommand}"
                        Content="Ajustes"
                        Appearance="Secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="0,2" />
                </StackPanel>
            </Border>

            <!-- Page host -->
            <Border Grid.Column="1" Padding="20,12">
                <ContentControl Content="{Binding Navigation.Current}" />
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}" Padding="14,6">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="{Binding SyncHealth, Converter={StaticResource SyncHealthToBrush}}" />
                    <TextBlock Text="{Binding SyncHealth}" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.85" />
                    <ui:ProgressRing
                        IsIndeterminate="True"
                        Width="16"
                        Height="16"
                        Margin="12,0,0,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#22808080" CornerRadius="10" Padding="10,3" Margin="4,0">
                                <TextBlock Text="{Binding}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
