<ui:FluentWindow
    x:Class="Atalaya.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    Title="Atalaya"
    Icon="pack://application:,,,/assets/atalaya.ico"
    Width="1100"
    Height="700"
    MinWidth="1100"
    MinHeight="700"
    Background="{DynamicResource Brush.Bg}"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <!-- EL SUELO SE PINTA AQUÍ, no en `Window.Background` (F26 §A). `FluentWindow` aplica su
         propio telón —el «backdrop» de Windows 11— por debajo de lo que declare la ventana, y con
         él salían el #202020 y el #FAFAFA de fábrica de la librería en vez de nuestro #171B22 y
         nuestro crema: el tema cambiaba TODO menos el fondo, que es lo primero que se ve. La
         rejilla raíz está por encima del telón y no admite discusión. -->
    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- La barra de título va SIN icono al lado del texto. Se probó —el de la aplicación, en
             el hueco nativo de la barra— y no convenció: en esa esquina el icono no aporta nada
             que no diga ya la palabra, y la barra se lee mejor limpia. Windows sigue enseñando el
             icono donde hace falta: barra de tareas, Alt-Tab y Explorador, todos desde
             Window.Icon y ApplicationIcon (F6.4 §1). -->
        <ui:TitleBar
            Grid.Row="0"
            Title="Atalaya" />

        <Grid Grid.Row="1" x:Name="Shell" SizeChanged="OnShellSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== EL RAÍL (F26 §A, D-954)

                 Lo que había: ocho botones con borde, todos iguales, sin icono y sin ninguna señal
                 de dónde estabas. Un menú así no es un mapa, es una lista. Ahora: icono y texto,
                 agrupados por sentido (trabajo · aplicación activa · sistema), la entrada activa
                 con fondo y barra de color primario, y plegable a solo iconos cuando la ventana se
                 estrecha. «Nueva aplicación» ya no está: es una ACCIÓN del portafolio —donde ya era
                 el botón primario—, no un sitio al que ir.
            -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="{StaticResource Border.Right}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="{StaticResource Rail.Width}" />
                        <!-- El relleno es EL MISMO plegado y desplegado, y horizontalmente cero:
                             quien reparte el ancho son los carriles de cada fila (D-966). Cuando
                             el relleno cambiaba con el estado, el icono cambiaba de sitio con él. -->
                        <Setter Property="Padding" Value="{StaticResource Pad.Rail}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
                                <Setter Property="Width" Value="{StaticResource Rail.CollapsedWidth}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <DockPanel>
                    <!-- El plegado, arriba del todo. Va en los MISMOS carriles que las entradas
                         (D-966): sus tres rayas caen exactamente en la x de los iconos de abajo,
                         plegado o no. Antes iba alineado a la izquierda con su propio margen, y por
                         eso no cuadraba con nada. -->
                    <Button DockPanel.Dock="Top"
                            Style="{StaticResource RailRow}"
                            Command="{Binding ToggleRailCommand}"
                            AutomationProperties.Name="Plegar o desplegar el menú">
                        <Button.ToolTip>
                            <Binding Path="RailCollapsed" Converter="{StaticResource RailToggleTip}" />
                        </Button.ToolTip>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Source={StaticResource Rail.MarkerLane}}" />
                                <ColumnDefinition Width="{Binding Source={StaticResource Rail.IconChannel}}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="1"
                                  Style="{StaticResource Icon}"
                                  HorizontalAlignment="Center"
                                  Data="{x:Static c:Icons.RailToggle}" />
                        </Grid>
                    </Button>

                    <!-- El pie del raíl: la cuenta. Es «quién eres», que es información de sistema
                         y no de trabajo; abajo, fuera del camino, y siempre a un clic. -->
                    <!-- LA FILA DE USUARIO (D-966/D-967). Misma altura, mismo relleno y mismos
                         carriles que una entrada del menú —usa el mismo estilo `RailRow`, así que
                         no es «parecida»: es la misma fila—. La línea fina de encima la separa del
                         menú sin meter un hueco, que es lo que la haría bailar al plegar. -->
                    <Border DockPanel.Dock="Bottom"
                            BorderBrush="{DynamicResource Brush.Line}"
                            BorderThickness="{StaticResource Border.Top}">
                        <Button Style="{StaticResource RailRow}"
                                Command="{Binding ShowAccountCommand}"
                                ToolTip="{Binding AccountTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={StaticResource Rail.MarkerLane}}" />
                                    <ColumnDefinition Width="{Binding Source={StaticResource Rail.IconChannel}}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- El avatar ocupa el canal de iconos, centrado como ellos: es el
                                     icono de esta fila. Y EL PILOTO ES SU INSIGNIA, no un elemento
                                     aparte (D-967) — 8 px de color en la esquina, con un anillo del
                                     color del raíl que lo despega del avatar sin pintarle un borde.
                                     Suelto al final de la fila era una cuarta cosa que alinear; en
                                     la esquina del avatar es lo que ya se mira para saber quién
                                     eres, diciendo además si puedes trabajar. -->
                                <Grid Grid.Column="1" HorizontalAlignment="Center"
                                      ToolTip="{Binding SyncTooltip}">
                                    <Border Width="{StaticResource Rail.AvatarSize}"
                                            Height="{StaticResource Rail.AvatarSize}"
                                            CornerRadius="{StaticResource Radius.Pill}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding AccountAvatarUrl}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Ellipse Width="{StaticResource Rail.BadgeSize}"
                                             Height="{StaticResource Rail.BadgeSize}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{Binding SyncHealth, Converter={StaticResource SyncHealthToBrush}}"
                                             Stroke="{DynamicResource Brush.Surface}"
                                             StrokeThickness="{StaticResource Rail.BadgeRing}" />
                                </Grid>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Margin="{StaticResource Pad.RailLabel}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding RailCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                                    <!-- Del mismo tamaño que una entrada del menú: es una fila
                                         más del raíl, y una letra distinta la delataría como
                                         añadida aparte. El color sí es el apagado, porque no es
                                         un sitio al que ir sino quién eres. -->
                                    <TextBlock Text="{Binding AccountLabel}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="⚠"
                                               Foreground="{DynamicResource Brush.Warning.Ink}"
                                               Margin="{StaticResource Pad.RailLabel}"
                                               VerticalAlignment="Center"
                                               ToolTip="Reconecta tu cuenta de GitHub"
                                               Visibility="{Binding AccountNeedsAttention, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>

                    <ItemsControl ItemsSource="{Binding NavGroups}" DockPanel.Dock="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- El rótulo del grupo desaparece al plegar: a 60 px no cabe,
                                         y una etiqueta recortada a dos letras no es un rótulo. -->
                                    <!-- Sangrada a la x del texto de las entradas (D-966): un
                                         rótulo de grupo que no cae en la misma columna que lo que
                                         rotula se lee como si fuera de otra cosa. -->
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource Text.Meta}"
                                               Margin="{StaticResource Pad.RailGroup}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding DataContext.RailCollapsed,
                                                   RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                   Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding Command}"
                                                        Style="{StaticResource RailItem}"
                                                        AutomationProperties.Name="{Binding Label}"
                                                        ToolTip="{Binding Label}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ==================================================== EL ÁREA PRINCIPAL -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- LA MIGA DE PAN Y LA VUELTA (F26 §A, D-955). Portafolio › XBLAST › Inventario.
                     Antes no había ninguna referencia de dónde estabas fuera del título de la
                     página, y el único camino de vuelta era volver a empezar por el portafolio. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="{StaticResource Border.Bottom}"
                        Padding="{StaticResource Pad.TopBar}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource Button.Ghost}"
                                Command="{Binding GoBackCommand}"
                                Margin="{StaticResource Pad.Zero}"
                                ToolTip="Volver">
                            <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Back}" />
                        </Button>

                        <!-- Aquí NO va el piloto del hub (D-964). Estuvo, con la palabra «Green»
                             al lado, y sobraban las dos cosas: la palabra era el nombre interno
                             del estado —en inglés, y sin decir de qué—, y el punto estaba lejos de
                             la otra mitad de la misma pregunta. Los dos se han mudado al pie del
                             raíl, junto a la cuenta. Esta barra dice solo dónde estás. -->

                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center"
                                      Margin="{StaticResource Pad.XS}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- El separador va DETRÁS del enlace, no delante: delante
                                         del primero saldría un «›» suelto abriendo la miga, que
                                         apunta a un eslabón que no existe. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Label}"
                                                Command="{Binding Command}"
                                                Style="{StaticResource Button.Link}"
                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                                        <Path Style="{StaticResource Icon}"
                                              Data="{x:Static c:Icons.Chevron}"
                                              Width="12" Height="12"
                                              Stroke="{DynamicResource Brush.TextFaint}"
                                              Margin="{StaticResource Pad.XS}"
                                              Visibility="{Binding IsLink, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- LA VERSIÓN NUEVA, EN UNA TIRA FINA (F26 §A, D-957). Era una banda de dos
                     líneas en la cabecera de TODAS las vistas: la primera cosa que se veía al
                     abrir cualquier página era una noticia que no es urgente. Ahora es una línea,
                     con el color de aviso para que se vea sin ocupar, y al descartar desaparece.
                     Lo que decía la segunda línea —por qué no se puede actualizar todavía— se
                     enseña solo cuando hay algo que decir. -->
                <Border Grid.Row="1"
                        Background="{DynamicResource Brush.Warning.Soft}"
                        Padding="{StaticResource Pad.Strip}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                        <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Warning}"
                              Width="14" Height="14"
                              Stroke="{DynamicResource Brush.Warning.Ink}" />
                        <TextBlock Text="{Binding UpdateLabel}"
                                   Style="{StaticResource Text.Small}"
                                   Foreground="{DynamicResource Brush.Warning.Ink}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateNotice}"
                                   Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding UpdateNotice}"
                                   Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding UpdateProgressText}"
                                   Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding UpdateInProgress, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{Binding InstallUpdateLabel}"
                                Command="{Binding InstallUpdateCommand}"
                                Style="{StaticResource Button.Secondary}"
                                Padding="{StaticResource Pad.ButtonSmall}"
                                MinHeight="0"
                                ToolTip="Descarga la versión nueva, comprueba su checksum, sustituye la carpeta y vuelve a abrir Atalaya. Tus ajustes, tu cuenta y tus clones no se tocan."
                                Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Ver novedades"
                                Command="{Binding OpenUpdateCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.Warning.Ink}"
                                ToolTip="Abre la página de la versión en el navegador, con sus notas y su zip."
                                Visibility="{Binding CanOpenUpdate, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Descartar"
                                Command="{Binding DismissUpdateCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.Warning.Ink}"
                                ToolTip="No vuelve a avisar de esta versión. De la siguiente sí." />
                    </StackPanel>
                </Border>

                <!-- F12 §G — CIERRE DE CICLO. Mismo tratamiento que el aviso de versión y por la
                     misma razón: es una buena noticia que no puede perderse si mirabas otra
                     pantalla, y no una interrupción que merezca un modal. Va en verde porque es
                     precisamente eso, una buena noticia. -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Brush.Success.Soft}"
                        Padding="{StaticResource Pad.Strip}"
                        Visibility="{Binding CycleClosed, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                        <TextBlock Text="✓" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Success.Ink}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CycleClosedLabel}"
                                   Style="{StaticResource Text.Small}"
                                   Foreground="{DynamicResource Brush.Success.Ink}"
                                   VerticalAlignment="Center" />
                        <Button Content="Ver el informe del cierre"
                                Command="{Binding OpenCycleReportCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.Success.Ink}"
                                ToolTip="La foto de con qué cerró el ciclo y qué hereda el siguiente."
                                Visibility="{Binding CanOpenCycleReport, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Descartar"
                                Command="{Binding DismissCycleCloseCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.Success.Ink}"
                                ToolTip="Quita el aviso. El informe del cierre sigue en Informes." />
                    </StackPanel>
                </Border>

                <!-- LA PÁGINA. El relleno lo pone la carcasa —una vez— y no cada vista. -->
                <Border Grid.Row="3" Padding="{StaticResource Pad.Page}">
                    <ContentControl Content="{Binding Navigation.Current}" />
                </Border>

                <!-- EL PIE: lo que está corriendo. La cuenta se ha mudado al raíl y el estado del
                     hub a la miga, así que aquí queda solo el trabajo en marcha, que es lo único
                     que de verdad hay que poder ver desde cualquier página. -->
                <Border Grid.Row="4"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="{StaticResource Border.Top}"
                        Padding="{StaticResource Pad.Footer}"
                        Visibility="{Binding HasFooter, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.L}">
                        <Button Command="{Binding ShowSessionCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                ToolTip="Ir a la sesión en vivo"
                                Visibility="{Binding SessionProgress, Converter={StaticResource NotEmptyToVisibility}}">
                            <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" />
                                <TextBlock Text="{Binding SessionProgress}"
                                           Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowFixCommand}"
                                Style="{StaticResource Button.Link}"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                ToolTip="Ir al arreglo asistido"
                                Visibility="{Binding FixProgress, Converter={StaticResource NotEmptyToVisibility}}">
                            <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" />
                                <TextBlock Text="{Binding FixProgress}"
                                           Style="{StaticResource Text.Small}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Avisos efímeros (F5.3 §3): flotan SOBRE la página, caducan a los 8 s y se
                 descartan con un clic. -->
            <ItemsControl
                Grid.Column="0"
                Grid.ColumnSpan="2"
                ItemsSource="{Binding Toasts}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="{StaticResource Pad.L}"
                IsHitTestVisible="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource Button.Ghost}"
                            Padding="{StaticResource Pad.Zero}"
                            Margin="{StaticResource Pad.XXS}"
                            HorizontalAlignment="Right"
                            ToolTip="Descartar">
                            <Border Background="{DynamicResource Brush.Surface2}"
                                    BorderBrush="{DynamicResource Brush.LineStrong}"
                                    BorderThickness="{StaticResource Border.Hairline}"
                                    CornerRadius="{StaticResource Radius.L}"
                                    Padding="{StaticResource Pad.Notice}"
                                    MaxWidth="440">
                                <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                                    <!-- F6.4: el aviso lo firma la aplicación. Los toasts son
                                         NUESTROS (no los del sistema), así que el icono es el
                                         mismo .ico compilado, a 16 px — el tamaño para el que
                                         existe la variante de silueta. -->
                                    <Image Width="16" Height="16"
                                           VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Source>
                                            <BitmapImage UriSource="pack://application:,,,/assets/atalaya.ico"
                                                         DecodePixelWidth="16" DecodePixelHeight="16" />
                                        </Image.Source>
                                    </Image>
                                    <TextBlock Text="{Binding Text}"
                                               Style="{StaticResource Text.Small}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               MaxWidth="380" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</ui:FluentWindow>
