<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atalaya.App</RootNamespace>
    <AssemblyName>Atalaya</AssemblyName>
    <!-- F6.4: el icono del EJECUTABLE (Explorador, accesos directos, Alt-Tab del proceso).
         El de la ventana y la barra de tareas se pone aparte, como Resource, más abajo. -->
    <ApplicationIcon>..\..\assets\atalaya.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The connection services expose a few internal seams (config parsing, URL comparison,
         failure diagnosis) that the tests drive directly. -->
    <InternalsVisibleTo Include="Atalaya.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deployment configuration (D1): embedded as the built-in default AND copied next to the
         executable so a corporate deployment can override it without rebuilding. -->
    <EmbeddedResource Include="appsettings.deploy.json" />
    <Content Include="appsettings.deploy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- F6.4 · Identidad. El icono va COMPILADO como recurso: la ventana y la barra de tareas lo
         necesitan siempre y no puede depender de que un fichero siga en su sitio. -->
    <Resource Include="..\..\assets\atalaya.ico" Link="assets\atalaya.ico" />

    <!-- F38 · Aquí se desplegaba además un logotipo corporativo (dos variantes, según el tema).
         Se ha ido con la organización donde nació la aplicación: la marca en pantalla es ahora el
         NOMBRE de la organización configurada, que es un dato del hub y no un asset. `assets/` se
         queda con el icono de casa, que sí es nuestro. -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atalaya.Domain\Atalaya.Domain.csproj" />
    <ProjectReference Include="..\Atalaya.Storage\Atalaya.Storage.csproj" />
    <ProjectReference Include="..\Atalaya.Inventory\Atalaya.Inventory.csproj" />
    <ProjectReference Include="..\Atalaya.Agents\Atalaya.Agents.csproj" />

    <!-- PROV-2 §1 — AQUÍ YA NO SE NOMBRA A NINGUNA CASA.
         Estaban Atalaya.Copilot y Atalaya.ClaudeCode, y por la primera la aplicación entera
         arrastraba el SDK de GitHub Copilot en tiempo de compilación (PROV-1). Lo que se
         referencia ahora es la COMPOSICIÓN: quien sabe montar los proveedores de esta versión y
         devolverlos en su orden. Un tercer proveedor entra ahí y esta línea no cambia. -->
    <ProjectReference Include="..\Atalaya.Providers\Atalaya.Providers.csproj" />
    <ProjectReference Include="..\Atalaya.ImportV4\Atalaya.ImportV4.csproj" />

    <!-- F14 — el puente MCP viaja JUNTO a la aplicación, no como assembly referenciado.
         `claude` lo lanza como PROCESO (es su servidor MCP por stdio), así que lo que hace falta
         es su .exe en la carpeta de salida; enlazarlo como biblioteca no tendría ningún sentido y
         metería un ensamblado más en el grafo. ReferenceOutputAssembly=false dice exactamente eso:
         constrúyelo y cópialo, pero no lo referencies. -->
    <ProjectReference Include="..\Atalaya.Mcp\Atalaya.Mcp.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest"
                      Targets="Build" />
  </ItemGroup>

</Project>
