<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atalaya.App</RootNamespace>
    <AssemblyName>Atalaya</AssemblyName>
    <!-- F6.4: el icono del EJECUTABLE (Explorador, accesos directos, Alt-Tab del proceso).
         El de la ventana y la barra de tareas se pone aparte, como Resource, más abajo. -->
    <ApplicationIcon>..\..\assets\atalaya.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The connection services expose a few internal seams (config parsing, URL comparison,
         failure diagnosis) that the tests drive directly. -->
    <InternalsVisibleTo Include="Atalaya.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deployment configuration (D1): embedded as the built-in default AND copied next to the
         executable so a corporate deployment can override it without rebuilding. -->
    <EmbeddedResource Include="appsettings.deploy.json" />
    <Content Include="appsettings.deploy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- F6.4 · Identidad. El icono va COMPILADO como recurso: la ventana y la barra de tareas lo
         necesitan siempre y no puede depender de que un fichero siga en su sitio. -->
    <Resource Include="..\..\assets\atalaya.ico" Link="assets\atalaya.ico" />

    <!-- El logotipo corporativo, en cambio, se DESPLIEGA como fichero suelto. La versión en
         negativo (maxam-logo-dark.png) todavía no existe: compilarla obligaría a tenerla para
         poder construir, y buscándola en disco basta con dejarla caer el día que llegue. El
         comodín acepta que no haya ninguna — un despliegue sin marca es legítimo. La fuente
         (-source) se queda fuera: no se despliega lo que no se pinta. -->
    <Content Include="..\..\assets\maxam-logo*.png"
             Exclude="..\..\assets\maxam-logo-source.png"
             Link="assets\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atalaya.Domain\Atalaya.Domain.csproj" />
    <ProjectReference Include="..\Atalaya.Storage\Atalaya.Storage.csproj" />
    <ProjectReference Include="..\Atalaya.Inventory\Atalaya.Inventory.csproj" />
    <ProjectReference Include="..\Atalaya.Copilot\Atalaya.Copilot.csproj" />
    <ProjectReference Include="..\Atalaya.ImportV4\Atalaya.ImportV4.csproj" />
  </ItemGroup>

</Project>
