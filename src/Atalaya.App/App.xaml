<Application
    x:Class="Atalaya.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Atalaya.App"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    xmlns:views="clr-namespace:Atalaya.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <!-- EL ORDEN NO ES DECORATIVO (F26 Parte A, D-945):
                   1. WPF-UI pone sus colores y sus plantillas de fábrica.
                   2. `Tokens` añade la escala de tamaños y espacios, que no depende del tema.
                   3. La PALETA va después de WPF-UI a propósito: parte de su trabajo es reescribir
                      las claves de la librería para que sus controles se tiñan con los nuestros.
                      `ThemeService` sustituye ESTE puesto al cambiar de tema, sin moverlo de sitio.
                   4. `Styles` va el último porque construye sobre las tres anteriores.
                 Aquí se monta la oscura porque es el tema de fábrica; el arranque aplica la que
                 diga el ajuste antes de enseñar ninguna ventana. -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/Themes/Converters.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Palette.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Styles.xaml" />
                <!-- F30 §3 — la conversación: va DESPUÉS de Styles porque se apoya en sus piezas. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/Conversation.xaml" />
                <!-- F30 §4 — los pasos de una operación. Mismo puesto y mismo motivo. -->
                <ResourceDictionary Source="pack://application:,,,/Themes/StepList.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Themes/Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Application.Resources>
</Application>
