<!--
    ESTILOS BASE (F26 Parte A, D-949).

    Las piezas del sistema, construidas SOBRE los tokens y la paleta. Ninguna escribe un número ni
    un color: todo sale de `Tokens.xaml` y de la paleta que esté puesta, que es lo que hace que
    cambiar de tema cambie la aplicación entera y no solo el fondo.

    POR QUÉ PLANTILLAS PROPIAS Y NO LAS DE WPF-UI. Los botones de la librería traen su relleno, su
    radio y sus colores de acento; con ellos, «el botón primario» de Atalaya sería el que WPF-UI
    considere primario y no el que dice la paleta. Se escriben aquí las cuatro variantes que el
    sistema reconoce —primario, secundario, peligro y enlace— y ninguna más: la regla de un solo
    primario por vista (principio 4) no se puede sostener si hay siete formas de parecer el botón
    importante.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:c="clr-namespace:Atalaya.App.Controls">

    <!-- ================================================================ Tipografía por defecto

         La base de 14 se pone AQUÍ, en el estilo implícito, y no vista por vista. Es la mitad del
         arreglo de «los elementos y las fuentes son demasiado pequeños»: sin esto, cada TextBlock
         que no diga nada hereda el 12-13 del tema de la librería.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <!-- OJO: el estilo implícito NO toca `Foreground`. Un estilo implícito de TextBlock alcanza
         también a los TextBlock que viven DENTRO de las plantillas de los controles —incluido el
         del contenido de un botón—, así que fijar ahí el color del texto pintaría de gris la
         etiqueta blanca de un botón primario. El color se hereda del control, que es de donde
         tiene que venir; los estilos con nombre de abajo sí lo declaran, porque ésos se piden a
         mano y saben sobre qué van. -->

    <Style x:Key="Text.Default" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.H1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.H3" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.H3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Lead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Lead}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Lead}" />
    </Style>

    <!-- El texto de trabajo largo: el interlineado 1.4 se pone donde hay párrafos, no en todo
         TextBlock, porque una etiqueta de una línea con LineHeight forzado desalinea su fila. -->
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Secundario: la ayuda de un ajuste, el subtítulo de una tarjeta. 13, NUNCA 11. -->
    <Style x:Key="Text.Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Metadatos, y solo metadatos: rutas, sellos de tiempo, contadores. 12 es el suelo. -->
    <Style x:Key="Text.Meta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Meta}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- ================================================================ Cómo se recorta un texto

         TRES PRIMITIVAS Y NADA MÁS (P-01). Hasta aquí cada vista recortaba a su manera —o no
         recortaba— y el resultado era que lo mismo mentía en un sitio y no en otro: rutas cortadas
         por el final sin puntos suspensivos (UI-0009), una pastilla reducida a «Age» (UI-0011), una
         etiqueta cortada a mitad de la «o» de «Descubrimiento» (UI-0033). D-983 §5 arregló uno de
         los tres, con un presupuesto de caracteres fijo, y el arreglo no se generalizó: volvió a
         aparecer en cuanto la ventana bajó a 1280.

         Las tres, y qué dice cada una:

           · `Text.Name` — un NOMBRE se recorta por el final, con elipsis. Lo que identifica está
             al principio, y lo que se pierde se anuncia.
           · `Text.Path` — una RUTA se acorta por el MEDIO y conserva los dos extremos, porque lo
             que identifica un fichero es su nombre y va al final. Va sobre `c:PathText`, que mide
             contra el ancho que hay en vez de contar caracteres.
           · `Text.Chip` — una PASTILLA no se recorta: si no cabe entera, no se pinta
             (`c:ChipHost`). Una etiqueta a medias no es una versión corta de la etiqueta; es otra
             palabra.

         `DesignTokenTests` comprueba que ningún texto de una vista recorte por su cuenta.
    -->
    <Style x:Key="Text.Name" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- `PathText` deriva de `TextBlock`, y un estilo implícito solo alcanza a su tipo EXACTO: la
         tipografía por defecto hay que dársela aquí. -->
    <Style x:Key="Text.Path" TargetType="c:PathText">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="Text.Chip" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- UN CONTENEDOR CON DESPLAZAMIENTO LLEVA SU AIRE (UI-0002, UI-0028, UI-0037). El porqué de
         los tres números está en `Pad.Scroll`; aquí solo se consume, para que los veinte
         `ScrollViewer` de las vistas no lo escriban veinte veces. -->
    <Style x:Key="Scroll" TargetType="ScrollViewer">
        <Setter Property="Padding" Value="{StaticResource Pad.Scroll}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Y CUANDO EL CORTE CAE EN MEDIO, un degradado dice que el contenido sigue (UI-0028,
         UI-0037). Se pinta ENCIMA del desplazamiento, en la misma celda; no toca el foco ni el
         ratón. El porqué del color y por qué no es una máscara de opacidad está en la paleta. -->
    <Style x:Key="Scroll.Fade.Top" TargetType="Rectangle">
        <!-- El MISMO relleno que el desplazamiento: el degradado tiene que empezar donde empieza
             la ventana de contenido —no donde empieza el control— y no puede taparle el carril a
             la barra. -->
        <Setter Property="Margin" Value="{StaticResource Pad.Scroll}" />
        <Setter Property="Height" Value="{StaticResource Space.M}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Fill" Value="{DynamicResource Brush.ScrollFade.Top}" />
    </Style>

    <Style x:Key="Scroll.Fade.Bottom" TargetType="Rectangle" BasedOn="{StaticResource Scroll.Fade.Top}">
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Fill" Value="{DynamicResource Brush.ScrollFade.Bottom}" />
    </Style>

    <!-- Los mismos dos, para un desplazamiento que va dentro de una TARJETA. -->
    <Style x:Key="Scroll.Fade.Top.Surface" TargetType="Rectangle" BasedOn="{StaticResource Scroll.Fade.Top}">
        <Setter Property="Fill" Value="{DynamicResource Brush.ScrollFade.Top.Surface}" />
    </Style>

    <Style x:Key="Scroll.Fade.Bottom.Surface" TargetType="Rectangle" BasedOn="{StaticResource Scroll.Fade.Bottom}">
        <Setter Property="Fill" Value="{DynamicResource Brush.ScrollFade.Bottom.Surface}" />
    </Style>

    <!-- ================================================================ El anillo de foco (P-04)

         LO ÚLTIMO QUE PINTABA WINDOWS Y NO ATALAYA (UI-0015). Ningún control declaraba su anillo,
         así que WPF dibujaba el suyo: un rectángulo de puntos negros de 1 px. Medido sobre el «···»
         del Portafolio en oscuro daba **1,21:1** —era el único elemento visual de la aplicación
         que no cambiaba con el tema, porque no salía de la paleta— y su forma a hueso no se parecía
         a la pastilla redondeada del raíl, así que el foco y el «estás aquí» hablaban dos idiomas.

         Se dibuja FUERA del control (margen negativo) para no taparle nada, y en DOS capas: el
         anillo y, por dentro, un pelo del color del fondo. Esa segunda capa es lo que hace que el
         foco se vea también sobre un botón macizo — un anillo azul pegado al azul del primario no
         se distingue; separado por el hueco, sí.

         El radio es el de un control (`Radius.M`) más lo que el anillo se separa, que es lo que
         hace que la curva del anillo acompañe a la del botón en vez de cortarla.
    -->
    <Style x:Key="Focus.Visual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="{StaticResource Pad.FocusRing}" SnapsToDevicePixels="True">
                        <Border CornerRadius="{StaticResource Radius.L}"
                                BorderThickness="{StaticResource Focus.Ring}"
                                BorderBrush="{DynamicResource Brush.Focus.Ring}" />
                        <Border Margin="{StaticResource Pad.FocusRingInset}"
                                CornerRadius="{StaticResource Radius.M}"
                                BorderThickness="{StaticResource Focus.RingOffset}"
                                BorderBrush="{DynamicResource Brush.Focus.RingOffset}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Y SE PONE EN LOS CONTROLES DE LA LIBRERÍA, que no pasan por nuestras plantillas. Sin
         `BasedOn` un estilo implícito SUSTITUIRÍA al de WPF-UI y el control se quedaría sin
         plantilla (la lección del `ui:Card` de Métricas): estos cinco extienden el suyo y solo le
         añaden el anillo. Los NUESTROS lo reciben por `Button.Secondary`, de quien derivan todos. -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    </Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
    </Style>

    <!-- ================================================================ Botones

         Cuatro variantes con significado y nada más. `Button.Secondary` es el estilo implícito:
         un botón que no declara nada es secundario, que es lo que debe ser por defecto.
    -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.M}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Label"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <!-- Deshabilitado se ve deshabilitado, pero SE SIGUE LEYENDO.
                             El 0.4 de fábrica dejaba la etiqueta por debajo de cualquier contraste
                             útil, y un botón cuya razón hay que adivinar es peor que uno que no
                             está. La razón se escribe AL LADO (`Reason.Chip`), no en un tooltip.

                             Y NO basta con bajar la opacidad (F26-B revisión, D-983): un verde o un
                             azul macizo al 65 % sobre una tarjeta sigue siendo verde o azul macizo,
                             así que «Arreglar con agente» bloqueado se veía igual que disponible.
                             El color con significado se APAGA — el relleno pasa a superficie neutra
                             y la tinta a texto secundario—, que es lo que dice el principio 4: si
                             el color significa algo, no puede pintarse cuando no significa nada.
                             6,4:1 en los dos temas: apagado no es ilegible. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}" />

    <!-- UNO por vista. Es la acción que la vista existe para ofrecer. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.OnFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Fill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Verde: la acción que ADELANTA trabajo (auditar, arreglar). Se separa del primario azul
         porque en Atalaya conviven las dos: «Auditar selección» es la principal de Inventario y
         «Arreglo asistido» es la que hace avanzar un hallazgo. -->
    <Style x:Key="Button.Success" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success.OnFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Fill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Peligro: perfilado, no relleno. Un rojo macizo en una barra de acciones atrae el ojo antes
         que el primario, y lo que hay que pulsar no es «Cerrar como falso positivo». Relleno solo
         cuando destruir ES la acción de la vista (el «Detener» de la sesión). -->
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Ink}" />
    </Style>

    <!-- Aviso: la accion que INTERRUMPE. No destruye nada —lo hecho se queda— pero corta lo que
         esta pasando, y eso no es una accion neutra. El ambar es el color de «cuidado con esto»
         que ya usan los avisos (D-949), y aqui macizo porque es un boton, no un rotulo.
         Tinta oscura sobre el ambar: es el par que la paleta tiene medido (D-947). -->
    <!-- AVISO, y la misma pareja que peligro (D-949): perfilado por defecto, macizo cuando la
         acción de aviso ES la acción de la vista. Un ámbar relleno atrae el ojo antes que el
         primario, así que un «Silenciar» dentro de un bloque de gobernanza va perfilado; el
         «Pausar» de una sesión que está corriendo, macizo. -->
    <Style x:Key="Button.Warning" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Ink}" />
    </Style>

    <Style x:Key="Button.WarningSolid" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.OnFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Fill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.DangerSolid" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Fill}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.OnFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Fill}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- UN ENLACE ES TEXTO, así que tiene su propia plantilla y no la del botón.

         Dos motivos, los dos vistos en el dist (D-983). El relleno era uniforme —4 px por los
         cuatro lados— y eso mete el texto del enlace 4 px a la derecha de la línea que tiene
         encima y de la que tiene debajo: dentro de un bloque, un único margen izquierdo, y un
         enlace no es una excepción. Ahora el relleno es solo vertical: el blanco de pulsado sigue
         siendo cómodo y el texto arranca donde arranca el párrafo.

         Y el deshabilitado. Los botones apagan color pintando superficie neutra, que es lo correcto
         para una chapa; sobre un enlace eso es una chapa gris donde no había ninguna —el «Nada ha
         cambiado desde su auditoría» del Portafolio salía con recuadro—. Un enlace que no se puede
         pulsar simplemente deja de parecer pulsable: se apaga la tinta y ya. -->
    <Style x:Key="Button.Link" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
        <Setter Property="Padding" Value="{StaticResource Pad.XXS.V}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Label"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground"
                                    Value="{DynamicResource Brush.Primary.Fill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Label" Property="TextElement.Foreground"
                                    Value="{DynamicResource Brush.TextMuted}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sin fondo ni borde: el «…» de una tarjeta, la flecha de volver, un icono en una fila.
         Hereda la plantilla del enlace por lo mismo: apagarlo no puede pintarle una chapa. -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Link}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Padding" Value="{StaticResource Pad.XS}" />
        <Style.Triggers>
            <!-- APAGADO SE LEE COMO APAGADO (UI-0048). La flecha de volver se pintaba del MISMO
                 color deshabilitada que habilitada —#A4ABB8 en los dos casos, medido píxel a
                 píxel— porque su contenido es un `Path` y no texto: el disparador de la plantilla
                 del enlace apaga la tinta del rótulo, y aquí no hay rótulo. Se apaga el
                 `Foreground` del BOTÓN, del que el icono cuelga. D-983 §4 resolvió esto para los
                 botones y esta flecha se quedó fuera; es la primera cosa arriba a la izquierda de
                 la primera pantalla, con forma de control y sin hacer nada. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Line}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- El «…» de una tarjeta: lo que existe pero no compite por la mirada. Es un ToggleButton
         porque abre un menú y hay que poder ver si está abierto. -->
    <Style x:Key="Button.More" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Content" Value="···" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="{StaticResource Pad.XS}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.M}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Superficies -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.L}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Igual que la tarjeta pero SIN relleno: para lo que trae su propio contenido a sangre —una
         lista de filas, una tabla— y no puede llevar aire por dentro del borde. -->
    <Style x:Key="Panel" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Pad.Zero}" />
    </Style>

    <!-- ================================================================ Pastillas

         La gravedad se ve DESDE LEJOS (principio 4): fondo teñido, tinta del color, 12 px en
         seminegrita y un ancho mínimo para que las cuatro se alineen en columna.
    -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.S}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Pill.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>

    <!-- ================================================================ Avisos en línea

         Un aviso es un fondo teñido, un icono y una frase — nunca un párrafo gris a 11 px, que es
         lo que había y lo que nadie leía. Tres niveles, y el color dice cuál es.
    -->
    <Style x:Key="Notice" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Notice}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Notice.Warning" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Fill}" />
    </Style>

    <Style x:Key="Notice.Danger" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Fill}" />
    </Style>

    <Style x:Key="Notice.Success" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Fill}" />
    </Style>

    <!-- LA RAZÓN DE UN DESHABILITADO (principio 4). Va PEGADA al botón que no se puede pulsar y
         dice por qué en tres palabras, con el color de aviso. Un tooltip no vale: hay que saber
         que existe para verlo, y quien mira un botón apagado no sabe que hay nada que ver. -->
    <Style x:Key="Reason.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Reason.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================================================================ Campos

         Ancho digno: la caja de «Pasadas del barrido» medía seis caracteres y parecía rota. El
         mínimo de un campo numérico es que quepa su etiqueta de unidades al lado sin apretarse.
    -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHeight}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
    </Style>

    <!-- ================================================================ Tablas

         Filas de 40 px y cabecera con etiqueta a 13. La tabla de Informes tenía las columnas sin
         nombre legible y las filas tan bajas que una sola fila parecía un error de carga.
    -->
    <Style x:Key="Table.Header" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Table.Row" TargetType="Border">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Bottom}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================================================================ Iconos de línea

         Trazo, no relleno, y del color del texto que acompañan: un icono que no cambia con el tema
         es el que delata que el tema no cambia todo.
    -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="{StaticResource Icon.Size}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="StrokeThickness" Value="{StaticResource Icon.Stroke}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Icon.Small" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Small}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Small}" />
    </Style>


    <!-- ================================================================ El raíl

         UNA fila del raíl, y de ella salen las tres que hay: el botón de plegar, cada entrada del
         menú y la fila de usuario. Comparten estilo —altura, relleno y alineación— y comparten
         carriles, que es lo que hace que el icono de las tres caiga en la MISMA x, plegado o
         desplegado (D-966). Si cada una se maquetara por su cuenta, «igual» duraría hasta el
         siguiente retoque.

         Los carriles están dibujados en `Tokens.xaml`, con la cuenta. Aquí solo se consumen.
    -->
    <Style x:Key="RailRow" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Padding" Value="{StaticResource Pad.RailItem}" />
        <Setter Property="Margin" Value="{StaticResource Pad.RailItemGap}" />
        <!-- ALTO FIJO, no mínimo: la fila de usuario va anclada al pie del raíl y con un mínimo
             crecía con lo que le sobrara, despegando el avatar de su insignia. -->
        <Setter Property="Height" Value="{StaticResource Rail.RowHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Los carriles, para que las tres filas los declaren igual sin copiarlos. -->
    <ItemsPanelTemplate x:Key="RailStack">
        <StackPanel />
    </ItemsPanelTemplate>

    <Style x:Key="RailItem" TargetType="Button" BasedOn="{StaticResource RailRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- El carril del marcador. Existe SIEMPRE, con barra o sin ella: si
                                 apareciera solo al activarse, la entrada activa se desplazaría
                                 respecto a las demás y el menú bailaría al cambiar de página. -->
                            <ColumnDefinition Width="{Binding Source={StaticResource Rail.MarkerLane}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- EL MARCADOR CABE EN SU CARRIL (UI-0046). Con `Pad.XXS` uniforme el
                             `Border` pedía 3 de barra + 4 a cada lado = 11 dentro de un carril de
                             8, así que WPF lo recortaba EN SILENCIO: no aparecía un solo píxel del
                             primario en el raíl de ninguna de las cuatro combinaciones, ni
                             desplegado ni plegado, y toda la señal de «estás aquí» recaía en el
                             relleno de la pastilla —1,27:1 en oscuro, y plegado no hay texto que
                             lo salve—. Era la aritmética de carriles de D-966 fallando por tercera
                             vez (D-963 y D-999 §3 fueron las dos primeras), así que esta vez la
                             cuenta la vigila un test: marcador + relleno ≤ carril.

                             El relleno pasa a ser SOLO VERTICAL, que es lo que el carril dice
                             desde el principio: «0…8 · 3 px de barra + 5 de aire». La barra va
                             pegada al borde y los 5 que sobran son el aire hasta el icono. -->
                        <Border x:Name="Marker" Grid.Column="0"
                                Width="{StaticResource Rail.MarkerWidth}"
                                HorizontalAlignment="Left"
                                Margin="{StaticResource Pad.RailMarker}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="Transparent" />

                        <Border x:Name="Chrome" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                Margin="{StaticResource Pad.RailChip}"
                                CornerRadius="{StaticResource Radius.M}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Source={StaticResource Rail.IconChannel}}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- El icono, centrado en su canal. Ni ancho fijo que se recorte ni
                                     alineación a la izquierda: centrado en un canal de ancho fijo
                                     es lo único que da la misma x en las tres filas. -->
                                <!-- El `Stroke` NO se asigna aquí: un valor local en la plantilla
                                     gana a los disparadores de la propia plantilla, y el latido de
                                     abajo no podría teñirlo. Lo pone el disparador de `IsActive` o
                                     el del latido; sin ninguno de los dos, el estilo `Icon`. -->
                                <Path x:Name="Glyph" Grid.Column="0"
                                      Style="{StaticResource Icon}"
                                      Data="{Binding Icon}"
                                      HorizontalAlignment="Center" />


                                <TextBlock x:Name="Label" Grid.Column="1"
                                           Text="{Binding Label}"
                                           Margin="{StaticResource Pad.RailLabel}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock x:Name="Badge" Grid.Column="2"
                                           Text="{Binding Badge}"
                                           Style="{StaticResource Text.Meta}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Nav.Active}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <!-- LO QUE ESTÁ CORRIENDO SE DICE CON EL ICONO, no sustituyéndolo
                             (UI-0047). La plantilla cambiaba el icono por un punto verde de 9 px,
                             con su comentario: «lo que late sustituye al icono en vez de sumarse».
                             El precio se veía al plegar el raíl: la entrada de lo que está
                             corriendo quedaba como un punto suelto en una columna de iconos,
                             indistinguible del piloto del avatar dos filas más abajo. Ahora el
                             icono se queda —es lo que dice QUÉ está corriendo— y lo que late es
                             él: el mismo verde y el mismo pulso, sobre la forma que identifica. -->
                        <DataTrigger Binding="{Binding Pulsing}" Value="True">
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Success.Ink}" />
                            <Setter TargetName="Glyph" Property="StrokeThickness" Value="2" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="PulseOn">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Glyph"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0" To="0.35" Duration="0:0:0.9"
                                            AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseOn" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                        <!-- Plegado: se va el TEXTO y nada más. Los carriles no se tocan, que es
                             justamente el arreglo: el icono no se entera de que el raíl ha
                             cambiado de ancho. -->
                        <DataTrigger Binding="{Binding DataContext.RailCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Brush.Text}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LA FILA DE IDENTIDAD DEL PIE DEL RAÍL (UI-0061). Mide, se rellena y se alinea como una
         entrada del menú —los mismos carriles, la misma altura— pero NO es un botón: dejó de
         navegar. Había dos controles del raíl llevando a «Cuenta» —la entrada del bloque de
         sistema y esta fila—, y la de abajo no marcaba «estás aquí» cuando estabas en Cuenta, no
         tenía nombre de accesibilidad y era la SEGUNDA parada de tabulación de toda la ventana,
         antes que las entradas del menú que tiene encima. La entrada de «Cuenta» se queda: tiene
         su icono, marca dónde estás y está en el bloque que le toca. Esto es quién eres y si el
         hub responde, que es lo que un pie de menú dice. -->
    <Style x:Key="RailIdentity" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Rail.RowHeight}" />
        <Setter Property="Padding" Value="{StaticResource Pad.RailItem}" />
        <Setter Property="Margin" Value="{StaticResource Pad.RailItemGap}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ================================================================ Gravedad

         La gravedad se ve DESDE LEJOS (principio 4), y se ve con los colores del tema: pastilla de
         fondo teñido con su tinta, y una banda al borde de la fila para poder recorrer una lista
         sin leer una palabra.

         POR QUÉ CON `DataTrigger` Y NO CON UN CONVERTER (D-971). Un converter devuelve una brocha
         YA RESUELTA: al cambiar de tema no se vuelve a preguntar y la lista se queda con los
         colores del tema anterior. Los `DataTrigger` ponen `DynamicResource`, que sí se reevalúa.
         Es la diferencia entre «el tema cambia todos los recursos» (principio 5) y «el tema cambia
         los recursos que no pasaron por un converter».

         El converter `SeverityToBrush` se queda para las GRÁFICAS, que es otra cosa: allí el color
         identifica una serie y tiene que ser el mismo en los dos temas para poder comparar dos
         capturas.
    -->
    <!-- CUATRO RELLENOS PARA CUATRO NIVELES (P-05, UI-0034). Estos cuatro `Background` eran
         `Danger.Soft` DOS VECES —no existía un relleno de crítica, así que reutilizaba el de
         alta—, `Warning.Soft` y `Primary.Soft`: la escala de cuatro se leía como tres, y la baja
         se pintaba del mismo azul que la entrada activa del raíl. La gravedad tiene ahora su
         propia escala completa, tintas y rellenos, y `PaletteContrastTests` comprueba que los
         ocho son distintos entre sí en los dos temas. -->
    <Style x:Key="Pill.Sev" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Setter Property="MinWidth" Value="64" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Critica">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Crit.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.High.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Media">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Med.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Baja">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Low.Soft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- LA PASTILLA DE UN RECUENTO A CERO NO SE TIÑE (UI-0051). El color de gravedad dice «hay
         algo de esta gravedad»; con cero, dice lo contrario de lo que dice el número que lleva
         dentro, y es lo primero que se ve al abrir la aplicación —«Críticas 0» con su borde rojo—.
         Un recuento a cero se pinta en neutro y el color aparece cuando hay algo que contar.

         Se enlaza a `Count` y no a `Severity`: el nivel sigue siendo el que es, lo que cambia es
         que no hay ninguno. El orden importa —este disparador va DESPUÉS de los de `Pill.Sev`, y
         por eso gana—. -->
    <Style x:Key="Pill.Sev.Count" TargetType="Border" BasedOn="{StaticResource Pill.Sev}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pill.Sev.Text" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Critica">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.Crit}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Media">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.Med}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Baja">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.Low}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- La tinta del recuento a cero, a juego con su relleno (UI-0051). -->
    <Style x:Key="Pill.Sev.Count.Text" TargetType="TextBlock" BasedOn="{StaticResource Pill.Sev.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- LA CIFRA DE UN RECUENTO POR GRAVEDAD, y el cero en neutro (UI-0051). El disparador mira su
         PROPIO texto y no un enlace: quien la pinta —Portafolio en dos sitios— la enlaza a cuatro
         propiedades con nombres distintos, y un estilo que dependiera del nombre de la propiedad
         no valdría para los dos. El color se pone en el uso, que es quien sabe de qué nivel es la
         cifra; lo que el sistema fija es que a cero se apaga. -->
    <Style x:Key="Stat.Number.Sev" TargetType="TextBlock" BasedOn="{StaticResource Stat.Number}">
        <Style.Triggers>
            <Trigger Property="Text" Value="0">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ El estado de un hallazgo

         Activo, resuelto y todo lo demás (silenciado, caducado, falso positivo). Lo pintaban dos
         converters con sus hexadecimales dentro —`#4A9EE0` para «Activo», el mismo en los dos
         temas— y por eso `PaletteContrastTests` no los miraba nunca: sobre el crema del tema claro
         daban 2,38:1, y el dato que dice si un hallazgo sigue vivo se leía peor que las dos
         pastillas de al lado (UI-0006).

         `DataTrigger` y no converter, por lo de siempre (D-971): un pincel ya resuelto no se
         entera de que el tema ha cambiado. -->
    <Style x:Key="Pill.Status" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Activo">
                <Setter Property="Background" Value="{DynamicResource Brush.Primary.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Resuelto">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pill.Status.Text" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Activo">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Resuelto">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El punto de gravedad de una línea de actividad: 6 px, solo color, y por eso lleva la tinta
         VIVA de la escala y no el relleno teñido. Se pintaba con `SeverityToBrush` —el juego de las
         gráficas— dentro de la misma columna en la que las pastillas usaban el de la paleta
         (UI-0010). -->
    <Style x:Key="Dot.Sev" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Sev.Low}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Critica">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Crit}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Media">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Med}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- La banda del borde izquierdo de una fila. Es lo que permite recorrer una lista de cien
         hallazgos y ver dónde están las críticas sin leer ni una palabra. -->
    <Style x:Key="Band.Sev" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource Band.Width}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Critica">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Crit}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Alta">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Media">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Med}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Baja">
                <Setter Property="Background" Value="{DynamicResource Brush.Sev.Low}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Cifras grandes

         El número primero y grande, la etiqueta debajo y pequeña. Es lo contrario de lo que hacía
         el portafolio —«Crít 0» todo del mismo tamaño, cuatro veces— donde el dato y su nombre
         pesaban igual y no se leía ninguno de los dos de un vistazo.
    -->
    <Style x:Key="Stat.Number" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.H2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style x:Key="Stat.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- La tarjeta de cifra, con su banda de color a la izquierda. -->
    <Style x:Key="Stat.Card" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="{StaticResource Pad.M}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.M}" />
    </Style>

    <!-- El enlace de texto de siempre (pre-F26). Vive aquí desde F26 §B: estaba suelto en
         `App.xaml`, así que solo existía con la aplicación arrancada y la sesión en vivo no se
         podía montar fuera de ella. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                               Margin="{TemplateBinding Padding}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="Label" Property="Foreground"
                                    Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Estado de una unidad

         Auditada en verde, pendiente en neutro, «Grande» —la que no se audita de una vez— en
         ámbar (D-975). Antes las tres eran la
         misma pastilla gris: había que leer fila por fila para saber por dónde iba un módulo, que
         es justo lo que una lista de novecientas unidades no permite.

         Se enlaza a `StateLabel` —el texto que ya se enseña— y no al enum: es lo que la fila tiene
         a mano, y así la pastilla no obliga a exponer el modelo en la vista.
    -->
    <Style x:Key="Pill.UnitState" TargetType="Border" BasedOn="{StaticResource Pill}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateLabel}" Value="Auditada">
                <Setter Property="Background" Value="{DynamicResource Brush.Success.Soft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateLabel}" Value="Grande">
                <Setter Property="Background" Value="{DynamicResource Brush.Warning.Soft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Pill.UnitState.Text" TargetType="TextBlock" BasedOn="{StaticResource Pill.Text}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateLabel}" Value="Auditada">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StateLabel}" Value="Grande">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ El diff

         D-971 otra vez: el color lo pone un DataTrigger con DynamicResource, no un converter. Un
         converter devuelve un pincel YA RESUELTO y se queda con el color del tema que hubiera al
         convertir, asi que al cambiar de tema el diff seguia pintado con los tonos del anterior.
         Y hasta D-980 daba igual, porque el panel era oscuro en los dos temas; ahora no.

         El fondo de la fila SI sigue siendo un converter, y es correcto: son tintes con alfa, que
         se componen sobre la superficie que haya y por eso no dependen del tema. Lo que dependia
         era la TINTA, que es solida. -->
    <Style x:Key="Diff.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Ink}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Anadida">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Added}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Quitada">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Removed}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="Salto">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Faint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El marcador (+ - ...) va delante SIEMPRE: el color solo refuerza lo que ya se lee. -->
    <Style x:Key="Diff.Marker" TargetType="TextBlock" BasedOn="{StaticResource Diff.Text}">
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Los numeros de linea: son referencia, no contenido, y se apagan sin bajar de la tinta
         minima legible. Opacity sobre la tinta del panel, no un gris propio. -->
    <Style x:Key="Diff.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Code.Faint}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Margin" Value="{StaticResource Pad.XS.Right}" />
    </Style>

    <!-- ================================================================ Estado vacío (Parte C)

         Icono, UNA frase y —si la hay— la acción que lo llena. La plantilla del control
         `EmptyState`, que existe para que los siete vacíos de Métricas e Informes sean el mismo
         y no siete párrafos grises escritos a ojo.

         Va CENTRADO en su panel y no pegado a la izquierda: un vacío alineado con el contenido se
         lee como una fila más de ese contenido.
    -->
    <Style TargetType="{x:Type c:EmptyState}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource Pad.Empty}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:EmptyState}">
                    <StackPanel HorizontalAlignment="Center" Margin="{TemplateBinding Padding}">
                        <Path Style="{StaticResource Icon}"
                              Width="{StaticResource Icon.Size.Empty}"
                              Height="{StaticResource Icon.Size.Empty}"
                              Data="{TemplateBinding Glyph}"
                              Stroke="{DynamicResource Brush.TextFaint}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding Message}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   TextAlignment="Center"
                                   MaxWidth="{StaticResource Read.MaxWidth}"
                                   Margin="{StaticResource Pad.S.Top}"
                                   HorizontalAlignment="Center" />
                        <Button x:Name="Action"
                                Content="{TemplateBinding ActionLabel}"
                                Command="{TemplateBinding Command}"
                                Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Center"
                                Margin="{StaticResource Pad.M.Top}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <!-- Sin rótulo no hay acción, y sin acción no hay botón: uno que no lleva
                             a ningún sitio es peor que ninguno. -->
                        <Trigger Property="ActionLabel" Value="">
                            <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ La fila de un ajuste

         UN ritmo para las cinco secciones de Ajustes: a la izquierda la etiqueta con UNA línea de
         ayuda, a la derecha el control. Es un `DockPanel` y no un `Grid` con dos columnas escritas
         quince veces — dos números que hay que mantener iguales a mano acaban siendo distintos
         (D-966), y aquí serían treinta.
    -->
    <Style x:Key="Setting.Row" TargetType="DockPanel">
        <Setter Property="LastChildFill" Value="True" />
        <Setter Property="Margin" Value="{StaticResource Pad.L.Bottom}" />
    </Style>

    <Style x:Key="Setting.Label" TargetType="StackPanel">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="Width" Value="{StaticResource Setting.LabelWidth}" />
        <Setter Property="Margin" Value="{StaticResource Pad.L.Right}" />
    </Style>

    <!-- El nombre del ajuste: cuerpo, no título. Un ajuste no es una sección. -->
    <Style x:Key="Setting.Name" TargetType="TextBlock" BasedOn="{StaticResource Text.Default}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- La ayuda: 14 px, NUNCA 11. Es la mitad literal de la queja original. -->
    <Style x:Key="Setting.Help" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Margin" Value="{StaticResource Pad.XXS.Top}" />
    </Style>

    <!-- El título de una sección de la vista. -->
    <Style x:Key="Setting.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.H3}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Margin" Value="{StaticResource Pad.M.Bottom}" />
    </Style>

    <!-- El «más» de una descripción larga. Es un enlace que abre lo que no cabe en una línea, y no
         un párrafo de cuatro líneas a 11 px puesto siempre a la vista (principio 8). Sin relleno
         horizontal, como todo enlace: dentro de un bloque hay UN margen izquierdo (D-983 §10). -->
    <Style x:Key="Toggle.More" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Visual}" />
        <Setter Property="Content" Value="Más" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="{StaticResource Pad.XXS.V}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                               Margin="{TemplateBinding Padding}"
                               FontSize="{TemplateBinding FontSize}"
                               Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Text" Value="Menos" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lo que el «más» despliega. Mismo tamaño que la ayuda: no es letra pequeña, es texto que
         estaba plegado. -->
    <Style x:Key="Setting.More" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Margin" Value="{StaticResource Pad.XXS.Top}" />
    </Style>

    <!-- Los campos con ancho digno. El numérico cabe cuatro cifras cómodas; el desplegable, el
         nombre de un modelo con su multiplicador. -->
    <Style x:Key="Field.Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinWidth" Value="{StaticResource Field.NumberWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- El desplegable NO lleva estilo propio, y es a propósito: un `Style TargetType="ComboBox"`
         sin `BasedOn` SUSTITUYE al implícito de WPF-UI en vez de extenderlo, y el control se queda
         sin su plantilla (es la lección del `ui:Card` de Métricas). Su ancho mínimo sale del token
         `Field.SelectWidth`, escrito en el control. -->

    <!-- ================================================================ La lista de secciones

         El raíl de segundo nivel de Ajustes. Comparte la gramática del de primero —barra de «estás
         aquí», fondo teñido y peso en la entrada activa— porque es el mismo gesto una capa más
         abajo: si se pareciera a otra cosa, habría que aprenderlo dos veces.
    -->
    <Style x:Key="Setting.Section" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
        <Setter Property="Margin" Value="{StaticResource Pad.RailItemGap}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Source={StaticResource Rail.MarkerLane}}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- El mismo carril y la misma cuenta que el raíl de primer nivel
                             (UI-0046): comparten gramática, así que compartían el defecto. -->
                        <Border x:Name="Marker" Grid.Column="0"
                                Width="{StaticResource Rail.MarkerWidth}"
                                HorizontalAlignment="Left"
                                Margin="{StaticResource Pad.RailMarker}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Background="Transparent" />
                        <Border x:Name="Chrome" Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.M}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Label" Text="{Binding Label}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Brush.Primary.Fill}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Section.Active}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Avisos, completos

         `Notice` ya existía con sus tres niveles. Faltaba el INFORMATIVO —el que dice dónde está
         algo que aquí no se edita— y faltaban el icono y la frase, que se escribían a mano en cada
         sitio y por eso salían de tamaños distintos.
    -->
    <Style x:Key="Notice.Info" TargetType="Border" BasedOn="{StaticResource Notice}">
        <Setter Property="Background" Value="{DynamicResource Brush.Info.Soft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Fill}" />
    </Style>

    <Style x:Key="Notice.Icon" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{StaticResource Pad.S.Right}" />
    </Style>

    <!-- La frase de un aviso NO se estira hasta el borde del monitor: un aviso es texto, y a 1.400
         px una línea deja de poder seguirse. Se para en la medida de lectura y arranca a la
         izquierda, pegada a su icono. -->
    <Style x:Key="Notice.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxWidth" Value="{StaticResource Read.MaxWidth}" />
    </Style>

    <!-- ================================================================ Estados de conexión

         Icono + COLOR + PALABRA (F26 Parte C). Los tres, siempre: el color solo no se lee sin
         distinguirlo, y el glifo solo —«…», «•»— no significa nada. Antes lo pintaban dos
         converters con sus hexadecimales dentro, que es el defecto de D-971 en su forma pura: un
         pincel ya resuelto no se entera de que el tema ha cambiado.

         El estado «comprobando» no lleva glifo sino anillo: lo que está pasando se mueve.
    -->
    <Style x:Key="Check.Glyph" TargetType="Path" BasedOn="{StaticResource Icon}">
        <Setter Property="Data" Value="{x:Static c:Icons.Pending}" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextFaint}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ok">
                <Setter Property="Data" Value="{x:Static c:Icons.Check}" />
                <Setter Property="Stroke" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Data" Value="{x:Static c:Icons.Cross}" />
                <Setter Property="Stroke" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Optional">
                <Setter Property="Data" Value="{x:Static c:Icons.Plus}" />
                <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El anillo va DENTRO de este hueco y no lleva estilo propio, por la misma razón que el
         desplegable: estilar un control de WPF-UI sin `BasedOn` le quita su plantilla. Lo que se
         estila es el hueco —un `Grid`, que no tiene implícito de nadie— y con él su visibilidad. -->
    <Style x:Key="Check.Spinner" TargetType="Grid">
        <Setter Property="Width" Value="{StaticResource Icon.Size}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- LA PALABRA. Es un `Setter` por estado y no un converter porque un texto no es un pincel:
         se puede fijar aquí, al lado del color al que acompaña, y así no hay dos sitios donde
         mirar para saber qué dice una fila verde. -->
    <!-- La palabra va al TAMAÑO DEL TÍTULO al que acompaña, no un punto por debajo: las dos
         ocupan los dos extremos de la misma fila y no pueden compartir línea base con `Run`
         (D-983 §9), así que lo que las alinea es medir igual. -->
    <Style x:Key="Check.Word" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="No comprobado" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Ok">
                <Setter Property="Text" Value="Disponible" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter Property="Text" Value="No disponible" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Running">
                <Setter Property="Text" Value="Comprobando" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Optional">
                <Setter Property="Text" Value="Disponible si lo activas" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Pilotos y estados de la casa

         LOS COLORES DE ESTADO SALEN DE LA PALETA (UI-0008). Los pintaban seis converters con sus
         hexadecimales dentro —el verde `#3FB950`, el ámbar `#E0A030`, el rojo `#D13A3A`—, los
         mismos en los dos temas porque «el estado es semántico y significa lo mismo en claro que
         en oscuro». El argumento no se sostiene en el píxel: ese verde es el del tema OSCURO, y
         sobre el crema del claro da 2,34:1. El dato que dice si una unidad está hecha era lo menos
         legible de su columna.

         Y lo apagado se apaga CAMBIANDO DE COLOR, no bajando la opacidad (D-983 §4): «completa»
         llevaba `Opacity="0.65"` encima del verde, así que en claro salía `#7DCA81` — 1,66:1.

         `DataTrigger` con `DynamicResource` y no converter, por lo de siempre (D-971): un pincel
         ya resuelto se queda con el color del tema que hubiera al convertir.
    -->
    <Style x:Key="Dot.Sync" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Brush.Danger.Ink}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SyncHealth}" Value="Green">
                <Setter Property="Fill" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SyncHealth}" Value="Amber">
                <Setter Property="Fill" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Dot.Link" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Brush.Danger.Ink}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Link.State}" Value="Vinculada">
                <Setter Property="Fill" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Link.State}" Value="Problema">
                <Setter Property="Fill" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El estado de una unidad de la sesión: el glifo y la palabra, del mismo color. -->
    <Style x:Key="Unit.State" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Auditando">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Completa">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Incompleta">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="CoberturaIncompleta">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="CortadaPorPresupuesto">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="NoLocalizada">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Unit.State.Glyph" TargetType="TextBlock" BasedOn="{StaticResource Unit.State}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Quien habla en la conversación del arreglo. -->
    <Style x:Key="Voice.Name" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Voice}" Value="Agente">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Voice}" Value="Usuario">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Un evento del historial del hallazgo: la línea de tiempo se recorre con la vista, y el
         color hace que «Resuelto» y «Reabierto» se distingan sin leerlos. -->
    <Style x:Key="Event.Glyph" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Event}" Value="Resolved">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="Reopened">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="Recurrence">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.High}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="Disputed">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="DisputeCleared">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="Detected">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Event}" Value="SeverityChanged">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Sev.Med}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Celda de tabla

         `Table.Header` y `Table.Row` ya estaban; faltaba la celda, que en Informes se escribía a
         12 px con recorte. Un texto recortado no falla, MIENTE (D-975): la columna «Usuario»
         enseñaba «Daniel Rodríguez d…» y no había forma de saber de quién era el informe.
    -->
    <Style x:Key="Table.Cell" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- La celda que identifica la fila: la que se lee primero al recorrer la tabla. -->
    <Style x:Key="Table.Cell.Strong" TargetType="TextBlock" BasedOn="{StaticResource Table.Cell}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <!-- La UNIDAD de una columna, bajo su nombre. Una cabecera de dos líneas es lo que permite
         que «Entrada» no se lea como un número y que «$ por millón» no haya que adivinarlo — y,
         sobre todo, que la cabecera no tenga que caber en el ancho de la cifra. -->
    <Style x:Key="Table.HeaderUnit" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ================================================================ Celda EDITABLE

         Una tabla que se edita no puede ser cien cajas con borde: se lee como un formulario y no
         como una tabla. La celda es texto hasta que se toca — el marco aparece al pasar por
         encima y al entrar en ella—, que es como se comporta cualquier hoja de cálculo.
    -->
    <Style x:Key="Field.Cell" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
        <Setter Property="MinHeight" Value="{StaticResource Control.MinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Las cifras, a la derecha y con DÍGITOS TABULARES. Sin ellos, «1,00» y «12,50» no alinean
         sus comas y una columna de precios deja de poder recorrerse de un vistazo: es la
         diferencia entre una tabla y una lista de números. -->
    <Style x:Key="Field.Cell.Number" TargetType="TextBox" BasedOn="{StaticResource Field.Cell}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- La nota: texto largo, envuelve, y no se recorta. -->
    <Style x:Key="Field.Cell.Note" TargetType="TextBox" BasedOn="{StaticResource Field.Cell}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- ================================================================ Error de validación

         La razón por la que un campo no vale, DEBAJO del campo y en peligro. Es la misma regla que
         `Reason.Chip` aplica a un botón bloqueado (D-949): la razón va pegada a lo que la produce,
         no en un tooltip ni en un toast que caduca a los ocho segundos.
    -->
    <Style x:Key="Text.Error" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
        <Setter Property="Margin" Value="{StaticResource Pad.XXS.Top}" />
    </Style>

</ResourceDictionary>
