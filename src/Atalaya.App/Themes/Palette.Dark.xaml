<!--
    PALETA OSCURA (F26 Parte A, D-945/D-947).

    Las MISMAS CLAVES que `Palette.Light.xaml`, con otros valores. Ésa es toda la regla del tema:
    quien pinta pide `Brush.Danger.Ink` y no se entera de en qué tema está. Antes el cambio de tema
    era una llamada a `ApplicationThemeManager.Apply` y poco más —el fondo cambiaba y el resto de
    los colores eran los de fábrica de WPF-UI—, y por eso el modo claro salía blanco nuclear.

    LOS COLORES SALEN DE LA MAQUETA APROBADA, con los retoques mínimos de contraste que se
    explican en D-947: la maqueta se dibujó a ojo y siete pares no llegaban a AA. Aquí se han
    subido o bajado en luminosidad lo justo para pasar 4.5:1 conservando el tono; los valores
    cambiados llevan su original al lado. `PaletteContrastTests` los recorre todos y falla si
    alguien vuelve a bajar de AA.

    LA FAMILIA DE CADA COLOR SEMÁNTICO tiene cuatro papeles, y no son intercambiables:
      · `.Fill`   — el relleno sólido (fondo de botón, punto de estado, borde de aviso).
      · `.OnFill` — la tinta que se escribe ENCIMA de ese relleno.
      · `.Ink`    — el color como TEXTO o icono sobre una superficie normal.
      · `.Soft`   — el fondo teñido (pastilla, tira de aviso), que lleva `.Ink` encima.
    Confundirlos es exactamente lo que rompe el contraste: el verde vivo que se lee estupendamente
    sobre el gris de fondo no aguanta texto blanco encima.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- La marca que lee `ThemeService` para saber qué paleta hay puesta y poder sustituirla. -->
    <sys:String x:Key="Palette.Name">dark</sys:String>

    <!-- ============================================================ Superficies y líneas -->
    <Color x:Key="Color.Bg">#171B22</Color>
    <Color x:Key="Color.Surface">#1F242D</Color>
    <Color x:Key="Color.Surface2">#262C37</Color>
    <Color x:Key="Color.Line">#313847</Color>
    <Color x:Key="Color.LineStrong">#3E4757</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />

    <!-- ============================================================ Texto

         `TextFaint` sube de #7C8494 a #8C93A1: el original se quedaba en 3.73:1 sobre `Surface2`,
         y es justo el color con el que están escritas las rutas y los sellos de tiempo a 12 px.
    -->
    <Color x:Key="Color.Text">#E6E9EF</Color>
    <Color x:Key="Color.TextMuted">#A8B0BD</Color>
    <Color x:Key="Color.TextFaint">#8C93A1</Color>

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />

    <!-- ============================================================ Primario

         Dos azules y no uno, porque hacen dos trabajos incompatibles sobre fondo oscuro: el
         RELLENO tiene que aguantar tinta blanca (el #4C7FE0 de la maqueta se quedaba en 3.87:1, así
         que baja a #3A72DD) y la TINTA tiene que leerse sobre el gris (el mismo #4C7FE0 daba 4.02:1,
         así que sube a #759DE8). Un solo azul no puede hacer las dos cosas y pasar AA.
    -->
    <Color x:Key="Color.Primary.Fill">#3A72DD</Color>
    <Color x:Key="Color.Primary.OnFill">#FFFFFF</Color>
    <Color x:Key="Color.Primary.Ink">#759DE8</Color>
    <Color x:Key="Color.Primary.Soft">#243554</Color>

    <SolidColorBrush x:Key="Brush.Primary.Fill" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="Brush.Primary.OnFill" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="Brush.Primary.Ink" Color="{StaticResource Color.Primary.Ink}" />
    <SolidColorBrush x:Key="Brush.Primary.Soft" Color="{StaticResource Color.Primary.Soft}" />

    <!-- ============================================================ Éxito, aviso, peligro

         Sobre fondo oscuro estos tres son colores VIVOS, y un color vivo lleva tinta OSCURA
         encima, no blanca: blanco sobre el verde #3FB950 da 2.54:1 —ilegible— y el casi negro da
         6.8:1. Es la misma razón por la que un botón amarillo de aviso nunca lleva letra blanca.
    -->
    <Color x:Key="Color.Ink.OnVivid">#10151B</Color>
    <Color x:Key="Color.Success.OnFill">#10151B</Color>
    <Color x:Key="Color.Warning.OnFill">#10151B</Color>
    <Color x:Key="Color.Danger.OnFill">#10151B</Color>

    <Color x:Key="Color.Success.Fill">#3FB950</Color>
    <Color x:Key="Color.Success.Ink">#3FB950</Color>
    <Color x:Key="Color.Success.Soft">#1C3324</Color>
    <SolidColorBrush x:Key="Brush.Success.Fill" Color="{StaticResource Color.Success.Fill}" />
    <SolidColorBrush x:Key="Brush.Success.OnFill" Color="{StaticResource Color.Success.OnFill}" />
    <SolidColorBrush x:Key="Brush.Success.Ink" Color="{StaticResource Color.Success.Ink}" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{StaticResource Color.Success.Soft}" />

    <Color x:Key="Color.Warning.Fill">#E3B341</Color>
    <Color x:Key="Color.Warning.Ink">#E3B341</Color>
    <Color x:Key="Color.Warning.Soft">#3A3014</Color>
    <SolidColorBrush x:Key="Brush.Warning.Fill" Color="{StaticResource Color.Warning.Fill}" />
    <SolidColorBrush x:Key="Brush.Warning.OnFill" Color="{StaticResource Color.Warning.OnFill}" />
    <SolidColorBrush x:Key="Brush.Warning.Ink" Color="{StaticResource Color.Warning.Ink}" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{StaticResource Color.Warning.Soft}" />

    <!-- Peligro sube de #F2615B a #F2645E: el original daba 4.43:1 sobre `Surface2`, que es el
         fondo de una fila resaltada — donde más veces se escribe «Crítica». -->
    <Color x:Key="Color.Danger.Fill">#F2645E</Color>
    <Color x:Key="Color.Danger.Ink">#F2645E</Color>
    <Color x:Key="Color.Danger.Soft">#42211F</Color>
    <SolidColorBrush x:Key="Brush.Danger.Fill" Color="{StaticResource Color.Danger.Fill}" />
    <SolidColorBrush x:Key="Brush.Danger.OnFill" Color="{StaticResource Color.Danger.OnFill}" />
    <SolidColorBrush x:Key="Brush.Danger.Ink" Color="{StaticResource Color.Danger.Ink}" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{StaticResource Color.Danger.Soft}" />

    <!-- ============================================================ Gravedad

         Cuatro colores propios y no «peligro, peligro, aviso, primario»: la gravedad es una escala
         y tiene que leerse COMO escala de un vistazo, de rojo a azul pasando por naranja y ámbar.
         `SevLow` sube de #6E93E8 a #799CEA para aguantar sobre la pastilla azul.
    -->
    <Color x:Key="Color.Sev.Crit">#F2645E</Color>
    <Color x:Key="Color.Sev.High">#F0883E</Color>
    <Color x:Key="Color.Sev.Med">#E3B341</Color>
    <Color x:Key="Color.Sev.Low">#799CEA</Color>

    <SolidColorBrush x:Key="Brush.Sev.Crit" Color="{StaticResource Color.Sev.Crit}" />
    <SolidColorBrush x:Key="Brush.Sev.High" Color="{StaticResource Color.Sev.High}" />
    <SolidColorBrush x:Key="Brush.Sev.Med" Color="{StaticResource Color.Sev.Med}" />
    <SolidColorBrush x:Key="Brush.Sev.Low" Color="{StaticResource Color.Sev.Low}" />

    <!-- ============================================================ El tema de WPF-UI, redirigido

         Los controles de la librería (botones, cajas, tarjetas, desplegables) leen SUS claves, no
         las nuestras. Si no se reescriben aquí, el sistema visual se acaba en el borde de cada
         control de WPF-UI y la pantalla vuelve a ser dos diseños pegados. Se reescriben las que
         se ven; las que no se usan se quedan como estén.
    -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Primary.Ink}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Color.Surface}" />

</ResourceDictionary>
