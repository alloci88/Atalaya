<!--
    PALETA CLARA (F26 Parte A, D-945/D-947/D-948).

    Las MISMAS CLAVES que `Palette.Dark.xaml`. Ver la cabecera de aquel fichero para qué significa
    cada papel (`.Fill`, `.OnFill`, `.Ink`, `.Soft`) y por qué son cuatro y no uno.

    POR QUÉ CREMA Y NO BLANCO (D-948, calentado en D-961). El modo claro de antes era el de fábrica
    de WPF-UI: blanco puro, #FFFFFF. Sobre un monitor a brillo de oficina, una pantalla llena de
    blanco puro con texto negro es la combinación que más cansa la vista de todas las posibles —es
    la queja literal del usuario, «el fondo es blanco nuclear y quema»—.

    El fondo es #F2EBDD y las superficies #FAF5EC: se conserva la jerarquía (fondo < superficie)
    sin llegar a ninguno de los dos extremos. El texto es un casi negro CÁLIDO (#1E2229) y no un
    negro puro, por la misma razón por el otro lado.

    TODA la rampa neutra comparte el tono 40°, que es el de esas dos referencias. Es lo que hace
    que el crema se lea como una decisión y no como un blanco sucio: si las líneas y la superficie
    intermedia se quedaran en un gris neutro, cada borde de tarjeta metería un tono frío en una
    pantalla cálida, y eso se ve aunque no se sepa nombrar.

    LOS SEMÁNTICOS SON MÁS OSCUROS QUE EN LA MAQUETA, lo justo para AA sobre crema (D-947): en modo
    claro el problema es el contrario que en oscuro —aquí el color vivo es el que no se lee—, así
    que verde, ámbar y rojo bajan de luminosidad y la tinta que llevan encima es blanca.

    Y LOS FONDOS TEÑIDOS SE CALENTARON CON EL RESTO (D-961). Un menta #DFF2E3 sobre un crema de 45
    de saturación se ve azulado por contraste simultáneo: el ojo lee cada color contra su vecino,
    no contra el blanco. Las cuatro pastillas están ahora en la misma familia cálida, y sus tintas
    se han vuelto a resolver contra ellas — bajar el fondo sin bajar la tinta habría comprado
    calidez con contraste.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:String x:Key="Palette.Name">light</sys:String>

    <!-- ============================================================ Superficies y líneas -->
    <Color x:Key="Color.Bg">#F2EBDD</Color>
    <Color x:Key="Color.Surface">#FAF5EC</Color>
    <Color x:Key="Color.Surface2">#F6F0E4</Color>
    <Color x:Key="Color.Line">#E6DDCC</Color>
    <Color x:Key="Color.LineStrong">#CFC1AB</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />

    <!-- `TextFaint` baja de #7B838E a #666E78: el original daba 3.34:1 sobre el crema del fondo,
         que es menos contraste del que tenía en oscuro. Un gris que se ve bien sobre negro no se
         ve bien sobre crema; hay que elegirlo dos veces. -->
    <Color x:Key="Color.Text">#1E2229</Color>
    <Color x:Key="Color.TextMuted">#4F5761</Color>
    <Color x:Key="Color.TextFaint">#646B75</Color>

    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}" />

    <!-- ============================================================ Primario

         Aquí el mismo azul SÍ puede hacer los dos trabajos: #2F62C9 aguanta blanco encima (5.66:1)
         y se lee sobre el crema (5.34:1). Se mantienen las dos claves de todos modos, porque quien
         pinta no debe tener que saber en qué tema está. -->
    <Color x:Key="Color.Primary.Fill">#2F62C9</Color>
    <Color x:Key="Color.Primary.OnFill">#FFFFFF</Color>
    <Color x:Key="Color.Primary.Ink">#2E5FC3</Color>
    <Color x:Key="Color.Primary.Soft">#D6E1F5</Color>

    <SolidColorBrush x:Key="Brush.Primary.Fill" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="Brush.Primary.OnFill" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="Brush.Primary.Ink" Color="{StaticResource Color.Primary.Ink}" />
    <SolidColorBrush x:Key="Brush.Primary.Soft" Color="{StaticResource Color.Primary.Soft}" />

    <!-- ============================================================ Éxito, aviso, peligro -->
    <Color x:Key="Color.Ink.OnVivid">#FFFFFF</Color>
    <Color x:Key="Color.Success.OnFill">#FFFFFF</Color>
    <Color x:Key="Color.Warning.OnFill">#FFFFFF</Color>
    <Color x:Key="Color.Danger.OnFill">#FFFFFF</Color>

    <Color x:Key="Color.Success.Fill">#1C7C35</Color>
    <Color x:Key="Color.Success.Ink">#1B7934</Color>
    <Color x:Key="Color.Success.Soft">#D7EFDF</Color>
    <SolidColorBrush x:Key="Brush.Success.Fill" Color="{StaticResource Color.Success.Fill}" />
    <SolidColorBrush x:Key="Brush.Success.OnFill" Color="{StaticResource Color.Success.OnFill}" />
    <SolidColorBrush x:Key="Brush.Success.Ink" Color="{StaticResource Color.Success.Ink}" />
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{StaticResource Color.Success.Soft}" />

    <Color x:Key="Color.Warning.Fill">#906400</Color>
    <Color x:Key="Color.Warning.Ink">#8D6200</Color>
    <Color x:Key="Color.Warning.Soft">#F7ECC9</Color>
    <SolidColorBrush x:Key="Brush.Warning.Fill" Color="{StaticResource Color.Warning.Fill}" />
    <SolidColorBrush x:Key="Brush.Warning.OnFill" Color="{StaticResource Color.Warning.OnFill}" />
    <SolidColorBrush x:Key="Brush.Warning.Ink" Color="{StaticResource Color.Warning.Ink}" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{StaticResource Color.Warning.Soft}" />

    <Color x:Key="Color.Danger.Fill">#BA3630</Color>
    <Color x:Key="Color.Danger.Ink">#B8352F</Color>
    <Color x:Key="Color.Danger.Soft">#F7DCD9</Color>
    <SolidColorBrush x:Key="Brush.Danger.Fill" Color="{StaticResource Color.Danger.Fill}" />
    <SolidColorBrush x:Key="Brush.Danger.OnFill" Color="{StaticResource Color.Danger.OnFill}" />
    <SolidColorBrush x:Key="Brush.Danger.Ink" Color="{StaticResource Color.Danger.Ink}" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{StaticResource Color.Danger.Soft}" />

    <!-- ============================================================ El panel de código

         Superficie propia, y ahora una POR TEMA (D-980). Tenía una sola, oscura en los dos, con el
         argumento de que un bloque de código con fondo propio es una convención que se lee igual
         de bien en claro. Sobre el crema no se lee igual: es un ladrillo negro en una pantalla
         cálida, y contradice el principio 5 —el tema cambia todos los recursos—.

         En claro es un gris CÁLIDO del mismo tono que el resto (#E9E0CE), un punto más oscuro que
         el fondo: lo justo para que el panel se distinga sin convertirse en una mancha. La
         sintaxis se ajusta a AA contra la superficie que toque, no a ojo.
    -->
    <Color x:Key="Color.Code.Surface">#E9E0CE</Color>
    <Color x:Key="Color.Code.Ink">#23262D</Color>

    <SolidColorBrush x:Key="Brush.Code.Surface" Color="{StaticResource Color.Code.Surface}" />
    <SolidColorBrush x:Key="Brush.Code.Ink" Color="{StaticResource Color.Code.Ink}" />

    <!-- El diff. Su tinta NO puede ser la de la interfaz: la fila lleva encima un tinte de
         color, asi que el fondo real contra el que se lee no es la superficie del panel sino la
         superficie MAS el tinte, un punto mas oscura. Estos tres tonos estan medidos contra ese
         fondo compuesto (D-980). -->
    <Color x:Key="Color.Code.Added">#16642B</Color>
    <Color x:Key="Color.Code.Removed">#962B26</Color>
    <Color x:Key="Color.Code.Faint">#545A62</Color>

    <SolidColorBrush x:Key="Brush.Code.Added" Color="{StaticResource Color.Code.Added}" />
    <SolidColorBrush x:Key="Brush.Code.Removed" Color="{StaticResource Color.Code.Removed}" />
    <SolidColorBrush x:Key="Brush.Code.Faint" Color="{StaticResource Color.Code.Faint}" />

    <!-- El velo de un cajon o un modal: apaga lo de debajo sin taparlo. Mas denso en oscuro,
         porque sobre un fondo ya oscuro un velo claro no separa nada. -->
    <Color x:Key="Color.Scrim">#66000000</Color>
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />

    <!-- ============================================================ Gravedad -->
    <Color x:Key="Color.Sev.Crit">#B8352F</Color>
    <Color x:Key="Color.Sev.High">#9E4E17</Color>
    <Color x:Key="Color.Sev.Med">#8D6200</Color>
    <Color x:Key="Color.Sev.Low">#2E5FC3</Color>

    <SolidColorBrush x:Key="Brush.Sev.Crit" Color="{StaticResource Color.Sev.Crit}" />
    <SolidColorBrush x:Key="Brush.Sev.High" Color="{StaticResource Color.Sev.High}" />
    <SolidColorBrush x:Key="Brush.Sev.Med" Color="{StaticResource Color.Sev.Med}" />
    <SolidColorBrush x:Key="Brush.Sev.Low" Color="{StaticResource Color.Sev.Low}" />

    <!-- ============================================================ El tema de WPF-UI, redirigido -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Color.TextFaint}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.Primary.Fill}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Color.Primary.Ink}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Color.Primary.OnFill}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Color.Bg}" />

</ResourceDictionary>
