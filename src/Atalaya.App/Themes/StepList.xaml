<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:services="clr-namespace:Atalaya.App.Services">

    <!-- ================================================================================
         LOS PASOS DE UNA OPERACIÓN (F30 §4)

         UN componente, cuatro operaciones: el alta, el re-escaneo, la verificación y reconciliar
         costes. El §0 de F30 midió que escanear una aplicación son 175 ms y que lo que se lleva el
         tiempo es lo de después —escribir el inventario, reconciliar las unidades grandes, publicar
         en el hub—, sin una sola señal: el botón se apagaba y la pantalla se quedaba quieta.

         SON PASOS, NO CANTIDADES. Ni porcentaje ni barra: nadie sabe qué fracción de un alta es
         «escribir el inventario», y una barra que avanza a saltos inventados miente mejor que no
         tener ninguna. Lo que sí se puede decir con verdad es en qué paso va, cuánto lleva ése y
         cuánto tardaron los anteriores.

         UNA PLANTILLA PARA LOS DOS SENTIDOS. Lo único que cambia entre el vertical y el horizontal
         es el panel que los coloca; la FILA es la misma, con su icono, su rótulo, su tiempo y —si
         falló— su motivo en la línea. Dos plantillas para dos orientaciones serían dos copias de lo
         mismo, y dos copias divergen (F5.14, D-1020).
         ================================================================================ -->

    <!-- ================================================================ El icono del estado

         LA MISMA FAMILIA QUE EL CHEQUEO DE CUENTA (`Check.Glyph`), y por el mismo motivo: un paso
         hecho y un proveedor disponible son el mismo hecho dicho en dos pantallas, y no pueden
         llevar dos marcas distintas. Lo que cambia es de dónde sale el estado.

         Y EL COLOR SALE DE LA PALETA con `DataTrigger` + `DynamicResource`, no de un converter
         (D-971): un pincel ya resuelto se queda con el color del tema que hubiera al convertir.
    -->
    <Style x:Key="Step.Glyph" TargetType="Path" BasedOn="{StaticResource Icon.Small}">
        <Setter Property="Data" Value="{x:Static c:Icons.Pending}" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.TextFaint}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Hecho">
                <Setter Property="Data" Value="{x:Static c:Icons.Check}" />
                <Setter Property="Stroke" Value="{DynamicResource Brush.Success.Ink}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Fallido">
                <Setter Property="Data" Value="{x:Static c:Icons.Cross}" />
                <Setter Property="Stroke" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
            <!-- En curso no hay glifo: en su sitio va el giro, que es el que dice que sigue vivo. -->
            <DataTrigger Binding="{Binding State}" Value="EnCurso">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- El giro va DENTRO de un hueco del tamaño del icono y sin estilo propio, por lo mismo que en
         Cuenta: estilar un control de WPF-UI sin `BasedOn` le quita su plantilla. Lo que se estila
         es el hueco —un `Grid`, que no tiene implícito de nadie— y con él su visibilidad. -->
    <Style x:Key="Step.Spinner" TargetType="Grid">
        <Setter Property="Width" Value="{StaticResource Icon.Size.Small}" />
        <Setter Property="Height" Value="{StaticResource Icon.Size.Small}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="EnCurso">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ El rótulo

         PENDIENTE EN TERCIARIO, y lo demás en la tinta que le toca. Lo que está por venir se lee
         como lo que todavía no ha pasado; lo que falló, en peligro — y el motivo va detrás, en la
         misma línea, no en un tooltip que hay que saber que existe (D-944.4).
    -->
    <Style x:Key="Step.Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="EnCurso">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Hecho">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Fallido">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- EL MOTIVO, en la línea del paso que falló. Envuelve en vertical y se recorta en la tira:
         la tira mide una línea y no puede crecer, así que ahí el motivo entero va al tooltip
         además de a la línea — la línea es la que avisa, el tooltip la que completa. -->
    <Style x:Key="Step.Reason" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Meta}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="{StaticResource Pad.XS.Left}" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReason}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- EL TIEMPO, monoespaciado y en su columna: se compara antes de leerse. Es el mismo criterio
         que la hora de la conversación (`Conversation.Time`). -->
    <Style x:Key="Step.Time" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Width" Value="{StaticResource Step.TimeWidth}" />
        <Setter Property="Margin" Value="{StaticResource Pad.XS.Left}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Pendiente">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ La fila -->

    <DataTemplate x:Key="Step.Row" DataType="{x:Type services:Step}">
        <DockPanel Margin="{StaticResource Pad.StepRow}">
            <!-- El icono y el giro comparten hueco: así el rótulo arranca en la misma x tenga el
                 estado que tenga, que es lo que impide que la lista se mueva al avanzar. -->
            <Grid DockPanel.Dock="Left"
                  Width="{StaticResource Icon.Size.Small}"
                  Height="{StaticResource Icon.Size.Small}"
                  VerticalAlignment="Center"
                  Margin="{StaticResource Pad.XS.Right}">
                <Path Style="{StaticResource Step.Glyph}" />
                <Grid Style="{StaticResource Step.Spinner}">
                    <ui:ProgressRing IsIndeterminate="True"
                                     Width="{StaticResource Icon.Size.Small}"
                                     Height="{StaticResource Icon.Size.Small}" />
                </Grid>
            </Grid>

            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource Step.Time}"
                       Text="{Binding TimeText}" />

            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Step.Label}" Text="{Binding Label}" />

            <TextBlock Style="{StaticResource Step.Reason}"
                       Text="{Binding Reason}"
                       ToolTip="{Binding Reason}" />
        </DockPanel>
    </DataTemplate>

    <!-- ================================================================ La lista

         La plantilla IMPLÍCITA del tipo: una vista cuelga `<ContentControl Content="{Binding
         AltaSteps}" />` y ya está. Sin clave a mano en cada sitio — que es como se acaba teniendo
         cuatro listas de pasos ligeramente distintas.
    -->
    <ItemsPanelTemplate x:Key="Step.Panel.Vertical">
        <StackPanel Orientation="Vertical" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="Step.Panel.Horizontal">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
    </ItemsPanelTemplate>

    <DataTemplate DataType="{x:Type services:StepList}">
        <!-- La lista se enseña mientras dura y SE QUEDA si algo falló: lo que hay que leer después
             de un fallo es qué paso fue, y eso no puede irse con el último tic. -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <!-- La tira mide una línea, siempre la misma: el inventario que hay debajo
                             no puede saltar según el rótulo del paso en curso. -->
                        <DataTrigger Binding="{Binding Flow}" Value="Horizontal">
                            <Setter Property="Height" Value="{StaticResource Step.StripHeight}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <DockPanel>
                <!-- «CANCELAR» SOLO DONDE CANCELAR DEJA EL HUB COMO ESTABA. Lo decide el paso en
                     curso, no la operación: en cuanto se escribe algo, el botón desaparece en vez
                     de quedarse prometiendo lo que ya no puede cumplir. -->
                <Button DockPanel.Dock="Right"
                        Content="Cancelar"
                        VerticalAlignment="Center"
                        Margin="{StaticResource Pad.S.Left}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Todavía no se ha escrito nada: cancelar deja el hub como estaba.">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Link}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanCancel}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ItemsControl ItemsSource="{Binding Steps}"
                              ItemTemplate="{StaticResource Step.Row}"
                              VerticalAlignment="Center">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel" Value="{StaticResource Step.Panel.Vertical}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Flow}" Value="Horizontal">
                                    <Setter Property="ItemsPanel" Value="{StaticResource Step.Panel.Horizontal}" />
                                    <Setter Property="ItemContainerStyle">
                                        <Setter.Value>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Margin" Value="{StaticResource Pad.StepStrip}" />
                                            </Style>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
