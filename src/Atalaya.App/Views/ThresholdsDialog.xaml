<ui:FluentWindow
    x:Class="Atalaya.App.Views.ThresholdsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Umbrales de la aplicación"
    Width="620"
    Height="480"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Umbrales de la aplicación" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" Margin="22,10,14,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="{Binding AppName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Esto es política de la aplicación, no una preferencia tuya: vive en el hub, vale para todo el equipo y queda en el historial de git quién la cambió y cuándo. Clasifica el inventario que todos compartís, así que si cada máquina llevara el suyo, la clasificación cambiaría con quien re-escaneara el último." />

                <TextBlock Text="Unidad grande (LOC)" FontWeight="SemiBold" Margin="0,20,0,0" />
                <ui:TextBox Text="{Binding LargeUnitLoc, UpdateSourceTrigger=PropertyChanged}"
                            Width="140" HorizontalAlignment="Left" Margin="0,6,0,0" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Opacity="0.65"
                           Text="A partir de cuántas líneas una unidad es demasiado grande para auditarla de una vez. Sale marcada «Grande»: no cuenta como pendiente y no impide cerrar el ciclo. Mínimo 1." />

                <TextBlock Text="Unidad grande (caracteres)" FontWeight="SemiBold" Margin="0,18,0,0" />
                <ui:TextBox Text="{Binding LargeUnitChars, UpdateSourceTrigger=PropertyChanged}"
                            Width="140" HorizontalAlignment="Left" Margin="0,6,0,0" />
                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Opacity="0.65"
                           Text="El mismo umbral por peso: una unidad de pocas líneas pero enorme tampoco cabe de una vez. Basta con superar UNO de los dos. Mínimo 1." />

                <Border CornerRadius="6" Padding="12,10" Margin="0,20,0,0"
                        Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" />
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Opacity="0.65"
                                   Text="La cuenta es por líneas, sobre el inventario que ya hay: el peso de cada unidad no se guarda, así que por caracteres no se puede contar sin volver a leer el clon." />
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"
                           Text="Aplica al RE-ESCANEAR. Guardar no reclasifica nada por sí solo: el inventario que ya está escrito se queda como está hasta que alguien re-escanee esta aplicación —desde cualquier máquina, en cuanto tenga el cambio— o cierre o reinicie el ciclo." />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,16,22,18">
            <ui:Button Content="Guardar umbrales" Appearance="Primary" Command="{Binding SaveCommand}" />
            <ui:Button Content="Cerrar" Appearance="Secondary" Margin="8,0,0,0" Click="OnClose" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
