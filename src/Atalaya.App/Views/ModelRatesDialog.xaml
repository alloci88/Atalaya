<ui:FluentWindow
    x:Class="Atalaya.App.Views.ModelRatesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Tarifas por modelo"
    Width="980"
    Height="620"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tarifas por modelo" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,0">
            <TextBlock TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Desde el 1 de junio de 2026 Copilot factura AI credits (1 credit = 0,01 $) consumidos por TOKENS, a las tarifas de API de cada modelo. Esta tabla es de la organización: vive en el hub, vale para todo el equipo y el historial de git dice quién cambió qué tarifa y cuándo. Se edita aquí porque las tarifas cambian y traen promocionales con caducidad: corregir un precio no puede exigir una versión nueva de Atalaya." />

            <Border CornerRadius="6" Padding="12,10" Margin="0,14,0,0"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Modelos usados SIN tarifa configurada" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" FontSize="11" Opacity="0.75"
                               Text="Sus sesiones no se pueden valorar, así que los agregados que las incluyan salen marcados como parciales. Añade su tarifa abajo y el coste aparece." />
                    <ItemsControl ItemsSource="{Binding MissingModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Margin="0,1,0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" Margin="22,14,22,0"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{DynamicResource SubtleFillColorTransparentBrush}"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="220" />
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Provider}" Width="110" />
                <DataGridTextColumn Header="Entrada $/M" Binding="{Binding Input}" Width="95" />
                <DataGridTextColumn Header="Salida $/M" Binding="{Binding Output}" Width="95" />
                <DataGridTextColumn Header="Caché leída $/M" Binding="{Binding CachedInput}" Width="110" />
                <DataGridTextColumn Header="Caché escrita $/M" Binding="{Binding CacheWrite}" Width="120" />
                <DataGridTextColumn Header="Nota" Binding="{Binding Note}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="22,10,22,18">
            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.65"
                       Text="Proveedor en blanco = vale para cualquiera. Ponlo solo cuando el mismo modelo cueste distinto según quién facture (Claude Code usa caché de una hora, que se cobra al doble de la entrada). Caché escrita en blanco = ese modelo no la cobra aparte, y esos tokens son entrada normal; no es lo mismo que escribir un 0." />

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12"
                       Foreground="#E0A030"
                       Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button Content="Añadir modelo" Appearance="Secondary" Command="{Binding AddRowCommand}" />
                <ui:Button Content="Guardar tarifas" Appearance="Primary" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
                <ui:Button Content="Cerrar" Appearance="Secondary" Margin="8,0,0,0" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
