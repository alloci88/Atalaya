<UserControl
    x:Class="Atalaya.App.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- La cabecera de módulo es un enlace de fila, como en V3: mismo gesto, mismo aspecto. -->
        <Style x:Key="ModuleHeaderLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- · Cabecera: título y plegado de todos los módulos (F5.6 §1, igual que V3) · -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <ui:Button Content="{Binding ToggleAllLabel}"
                       Command="{Binding ToggleAllGroupsCommand}"
                       Appearance="Secondary"
                       Padding="10,3" FontSize="11.5"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       ToolTip="Con todo plegado, las cabeceras son el resumen: módulo y cuántas de sus unidades están auditadas."
                       Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- · Barra de acciones · -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
            <ui:TextBox
                PlaceholderText="Buscar unidad…"
                ToolTip="Filtra por ruta. Filtrar NO deselecciona: lo que queda fuera de la vista sigue marcado."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                Width="220"
                Margin="0,0,8,8" />
            <ui:Button Content="Auditar selección" Command="{Binding AuditSelectionCommand}" Appearance="Primary" Margin="0,0,8,8" />
            <ui:Button Content="{Binding PendingToggleLabel}" Command="{Binding SelectPendingCommand}"
                       ToolTip="{Binding PendingToggleTooltip}" Margin="0,0,8,8" />
            <ui:Button Content="Re-escanear" Command="{Binding RescanCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Reset ciclo" Command="{Binding ResetCycleCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Ver hallazgos" Command="{Binding ShowFindingsCommand}" Margin="0,0,8,8" />
        </WrapPanel>

        <!-- · Barra de selección: solo cuando hay algo marcado. El contador es lo que se va a
             gastar, así que se lee antes de pulsar «Auditar selección» (F5.6 §3). · -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="·" Margin="10,0" Opacity="0.5" VerticalAlignment="Center" />
                <ui:Button Content="Deseleccionar todo"
                           Command="{Binding ClearSelectionCommand}"
                           Appearance="Secondary"
                           Padding="10,3" FontSize="11.5"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- · Árbol de módulos · -->
        <ScrollViewer Grid.Row="3" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">

                            <!-- Cabecera: la casilla tri-estado selecciona el módulo entero; el
                                 resto de la fila pliega y despliega. Dos gestos, dos zonas. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- IsThreeState="False" a propósito: el clic solo marca o desmarca,
                                     pero un valor nulo se sigue pintando como indeterminado. -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsThreeState="False"
                                          VerticalAlignment="Center"
                                          Margin="0,0,2,0"
                                          ToolTip="Selecciona o quita todas las unidades de este módulo." />

                                <Button Grid.Column="1"
                                        Style="{StaticResource ModuleHeaderLink}"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ExpandGlyph}"
                                                   Width="18" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- El margen derecho reserva el ancho de la barra de desplazamiento:
                                 sin él, «🔒 alguien» se corta contra ella en las filas reclamadas. -->
                            <ItemsControl ItemsSource="{Binding Units}" Margin="34,2,16,6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border Grid.Column="2" Background="#22808080" CornerRadius="8" Padding="8,2" Margin="6,0">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding ClaimedBy, StringFormat='🔒 {0}'}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Text="Sin inventario. Configura el clon local y pulsa «Re-escanear»."
            Opacity="0.6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <!-- Cycle summary -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="3" Margin="14,0,0,0" Padding="14"
                Background="#18808080" CornerRadius="8" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Resumen del ciclo" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock><Run Text="Ciclo " /><Run Text="{Binding CycleN}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="Unidades: " /><Run Text="{Binding TotalUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="Auditadas: " /><Run Text="{Binding AuditedUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="Pendientes: " /><Run Text="{Binding PendingUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="Grandes: " /><Run Text="{Binding LargeUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"><Run Text="Sesiones: " /><Run Text="{Binding SessionCount}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"><Run Text="Seleccionadas: " /><Run Text="{Binding SelectedCount}" FontWeight="Bold" /></TextBlock>
                <TextBlock
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap"
                    Opacity="0.85"
                    Margin="0,12,0,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
