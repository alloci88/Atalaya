<UserControl
    x:Class="Atalaya.App.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- La cabecera de módulo es un enlace de fila, como en V3: mismo gesto, mismo aspecto. -->
        <Style x:Key="ModuleHeaderLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- OBLIGATORIO en un Style de Button sin BasedOn: al no heredar del implícito de
                 WPF-UI, el Foreground cae al de serie de WPF, que es NEGRO. Sobre el fondo oscuro
                 del tema eso es texto invisible (0,0,0 sobre 32,32,32). -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El pelo que separa los tres bloques del panel del ciclo (F9.1 §2). Mismo recurso y
             mismo grosor que el divisor de la ficha de hallazgo: un pelo, no una raya. -->
        <Style x:Key="PanelDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,14,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- · Cabecera: título y plegado de todos los módulos (F5.6 §1, igual que V3) · -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
            <ui:Button Content="{Binding ToggleAllLabel}"
                       Command="{Binding ToggleAllGroupsCommand}"
                       Appearance="Secondary"
                       Padding="10,3" FontSize="11.5"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       ToolTip="Con todo plegado, las cabeceras son el resumen: módulo y cuántas de sus unidades están auditadas."
                       Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- · Barra de acciones · -->
        <WrapPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
            <ui:TextBox
                PlaceholderText="Buscar unidad…"
                ToolTip="Filtra por ruta. Filtrar NO deselecciona: lo que queda fuera de la vista sigue marcado."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                Width="220"
                Margin="0,0,8,8" />
            <!-- F5.8 §3: lo que LANZA una auditoría o lee el clon se deshabilita sin vínculo local,
                 y dice por qué. Lo demás —seleccionar, resetear el ciclo, ver hallazgos— sigue
                 entero: el inventario se abre siempre. -->
            <ui:Button Content="Auditar selección" Command="{Binding AuditSelectionCommand}" Appearance="Primary"
                       IsEnabled="{Binding CanAudit}" ToolTip="{Binding AuditDisabledTooltip}" Margin="0,0,8,8" />
            <ui:Button Content="{Binding PendingToggleLabel}" Command="{Binding SelectPendingCommand}"
                       ToolTip="{Binding PendingToggleTooltip}" Margin="0,0,8,8" />
            <!-- F9 §3: hace pareja con «Seleccionar pendientes» y desemboca en el MISMO flujo —
                 mismo diálogo, misma estimación de coste, mismo barrido, misma reconciliación. La
                 re-auditoría no estrena ningún camino nuevo de resolución. -->
            <ui:Button Content="{Binding ChangedToggleLabel}" Command="{Binding SelectChangedCommand}"
                       ToolTip="{Binding ChangedToggleTooltip}" Margin="0,0,8,8" />
            <!-- El filtro de deriva es PROPIO y aparte del estado de auditoría: son dos dimensiones
                 distintas, y una unidad puede estar «auditada» y «cambiada» a la vez. -->
            <ComboBox SelectedIndex="{Binding DriftFilter}" Width="210" Margin="0,0,8,8"
                      VerticalAlignment="Center"
                      ToolTip="Filtra por lo que le ha pasado al código desde que se auditó. Es una dimensión aparte del estado de auditoría.">
                <ComboBoxItem Content="Deriva: todas" />
                <ComboBoxItem Content="Solo cambiadas" />
                <ComboBoxItem Content="Solo arregladas sin verificar" />
                <ComboBoxItem Content="Solo sin historial" />
            </ComboBox>
            <ui:Button Content="Re-escanear" Command="{Binding RescanCommand}"
                       IsEnabled="{Binding CanAudit}" ToolTip="{Binding AuditDisabledTooltip}" Margin="0,0,8,8" />
            <ui:Button Content="Reset ciclo" Command="{Binding ResetCycleCommand}" Margin="0,0,8,8" />
            <ui:Button Content="Ver hallazgos" Command="{Binding ShowFindingsCommand}" Margin="0,0,8,8" />
        </WrapPanel>

        <!-- · Solo lectura (F5.8 §3): por qué no se puede auditar y el acceso directo a
             arreglarlo. Va arriba y no al pie: es la explicación de los botones grises que se
             tienen justo encima. · -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="#22D2B036" BorderBrush="#55D2B036"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                         Fill="{Binding Link.State, Converter={StaticResource CloneLinkStateToBrush}}" />
                <TextBlock Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap" Margin="8,0,0,0"
                           VerticalAlignment="Center" MaxWidth="620" />
                <ui:Button Content="{Binding LinkActionLabel}"
                           Command="{Binding LinkCloneCommand}"
                           Appearance="Primary"
                           Padding="10,3" FontSize="11.5"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- · Deriva: contra qué se ha medido y qué NO ve este análisis (F9 §1.1). Va arriba
             porque condiciona la lectura de todos los indicadores de abajo. · -->
        <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding DriftWarnings}"
                      Margin="0,0,0,10"
                      Visibility="{Binding HasDriftWarnings, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#18808080" CornerRadius="6" Padding="12,7" Margin="0,0,0,6">
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- · Barra de selección: solo cuando hay algo marcado. El contador es lo que se va a
             gastar, así que se lee antes de pulsar «Auditar selección» (F5.6 §3). · -->
        <Border Grid.Row="4" Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,10"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="·" Margin="10,0" Opacity="0.5" VerticalAlignment="Center" />
                <ui:Button Content="Deseleccionar todo"
                           Command="{Binding ClearSelectionCommand}"
                           Appearance="Secondary"
                           Padding="10,3" FontSize="11.5"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- · Árbol de módulos · -->
        <ScrollViewer Grid.Row="5" Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,4">

                            <!-- Cabecera: la casilla tri-estado selecciona el módulo entero; el
                                 resto de la fila pliega y despliega. Dos gestos, dos zonas. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- La casilla es de DOS estados a propósito (F5.13): marcada si y
                                     solo si TODAS las unidades del módulo lo están. La plantilla de
                                     WPF-UI pinta el indeterminado con el MISMO relleno de acento
                                     que el marcado —solo cambia el glifo, un guion en vez de la
                                     marca—, así que enviarle un nulo hacía que marcar UNA clase
                                     pareciera marcar el módulo entero. La selección parcial se dice
                                     con palabras, al lado del nombre. El clic llega por comando
                                     porque IsChecked ya solo entra, no sale. -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                          IsThreeState="False"
                                          Command="{Binding DataContext.ToggleModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          CommandParameter="{Binding}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,2,0"
                                          ToolTip="Marca o quita todas las unidades de este módulo." />

                                <Button Grid.Column="1"
                                        Style="{StaticResource ModuleHeaderLink}"
                                        Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ExpandGlyph}"
                                                   Width="18" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <!-- Lo que el guion del tri-estado nunca llegó a decir: cuántas. -->
                                        <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                Visibility="{Binding HasSelectionNote, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding SelectionNote}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- El margen derecho reserva el ancho de la barra de desplazamiento:
                                 sin él, «🔒 alguien» se corta contra ella en las filas reclamadas. -->
                            <ItemsControl ItemsSource="{Binding Units}" Margin="34,2,16,6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Border Grid.Column="2" Background="#22808080" CornerRadius="8" Padding="8,2" Margin="6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <!-- F9 §3: la deriva es una dimensión APARTE del estado
                                                 de auditoría, así que lleva su propio indicador al
                                                 lado del otro y no lo sustituye: una unidad puede
                                                 estar «Auditada» y «Cambiada» a la vez. El color
                                                 nunca es el único canal — el texto va siempre. -->
                                            <!-- F12 §H.3 — TODO va centrado en la fila: la píldora,
                                                 el punto de color y su texto. Sin el centrado, la
                                                 píldora se estiraba a lo alto de la fila y su texto
                                                 quedaba pegado arriba mientras el punto sí estaba
                                                 centrado: el indicador se leía descolgado del
                                                 nombre de la unidad y de la píldora de estado. Vale
                                                 para los DOS indicadores —«Cambiada desde su
                                                 auditoría» y «Arreglada — pendiente de verificar»—
                                                 porque los dos salen de esta misma plantilla. -->
                                            <Border Grid.Column="3" CornerRadius="8" Padding="8,2" Margin="0,0,6,0"
                                                    Background="#18808080"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{Binding DriftTooltip}"
                                                    Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                             Fill="{Binding DriftInk}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding DriftLabel}" FontSize="11"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Column="4" Text="{Binding ClaimedBy, StringFormat='🔒 {0}'}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Text="Sin inventario. Vincula tu clon local y pulsa «Re-escanear»."
            Opacity="0.6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <!-- · Resumen del ciclo · Cada dato lleva una frase que lo explica a quien abre la
             aplicación por primera vez: el usuario no distinguía ciclo de sesión (F5.6 §5).
             «Grandes» ya no sale aquí por decisión del usuario — no aporta a este nivel, y el
             estado sigue visible como badge en la fila de cada unidad, que es donde se actúa. -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="5" Margin="14,0,0,0" Padding="14"
                Background="#18808080" CornerRadius="8" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Resumen del ciclo" FontWeight="SemiBold" Margin="0,0,0,4"
                           ToolTip="Lo que hay en la vuelta actual del inventario de esta aplicación." />

                <!-- · Bloque 1 · CICLO — dónde va la vuelta actual del inventario.
                     Los tres bloques van separados por un pelo y un microtítulo (F9.1 §2): en la
                     lista corrida anterior, «deriva» quedaba como una línea perdida en el medio y
                     los patrones y las directivas parecían parte de ella, cuando no tienen nada
                     que ver. Lo que agrupa es el aire; el pelo solo lo confirma. · -->
                <TextBlock Text="{Binding CycleLabel}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           ToolTip="{Binding CycleTooltip}" />
                <TextBlock Margin="0,4,0,0" ToolTip="{Binding UnitsTooltip}"><Run Text="Unidades: " /><Run Text="{Binding TotalUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0" ToolTip="Ya revisadas en este ciclo. Puedes volver sobre ellas marcándolas a mano."><Run Text="Auditadas: " /><Run Text="{Binding AuditedUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0" ToolTip="Aún sin revisar en este ciclo. Es lo que queda para que se cierre."><Run Text="Pendientes: " /><Run Text="{Binding PendingUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0" ToolTip="Cada lanzamiento de auditoría es una sesión. Los cierres de ciclo y los resets no cuentan."><Run Text="Sesiones este ciclo: " /><Run Text="{Binding SessionCount}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"
                           ToolTip="Las unidades que se auditarán al pulsar «Auditar selección»."
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"><Run Text="Seleccionadas: " /><Run Text="{Binding SelectedCount}" FontWeight="Bold" /></TextBlock>

                <!-- · Bloque 2 · DERIVA — qué ha cambiado desde que se auditó (F9). · -->
                <Border Style="{StaticResource PanelDivider}" />
                <TextBlock Text="Deriva" FontWeight="SemiBold" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Lo que le ha pasado al código desde que se auditó. Se calcula del historial de tu clon y no se guarda en ninguna parte." />
                <!-- Contra qué se ha medido, como SUBTÍTULO del grupo y no como línea suelta: es
                     el alcance de los tres números de abajo, no un dato más. -->
                <TextBlock Text="{Binding DriftBranchLabel}" FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap" Margin="0,1,0,0"
                           ToolTip="La rama de tu clon y su HEAD. Medir contra otra rama es legítimo, pero lo que veas será la deriva de esa rama."
                           Visibility="{Binding DriftIsKnown, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,6,0,0" Text="Calculando…" FontSize="11.5" Opacity="0.6"
                           ToolTip="Se está comparando el commit de cada auditoría con HEAD de tu clon. Va fuera del hilo de la interfaz: puedes seguir usando la vista."
                           Visibility="{Binding IsDriftLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11.5" Opacity="0.75"
                           Text="{Binding DriftProblem}"
                           ToolTip="Por qué no hay deriva que enseñar. No saber no es lo mismo que saber que no ha cambiado nada, así que en vez de un cero se dice qué falta."
                           Visibility="{Binding HasDriftProblem, Converter={StaticResource BoolToVisibility}}" />
                <!-- Tres ceros seguidos ocupan lo mismo que un dato y no dicen más que una frase. -->
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding NoDriftLabel}"
                           ToolTip="Ninguna unidad auditada ha cambiado, ninguna está pendiente de verificar y de todas se ha podido leer el historial."
                           Visibility="{Binding HasNoDrift, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,6,0,0"
                           ToolTip="Auditadas cuyo código ha cambiado por mano ajena desde su auditoría. Son las candidatas de «Seleccionar cambiadas»."
                           Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Cambiadas: " /><Run Text="{Binding ChangedUnits}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"
                           ToolTip="Arregladas desde Atalaya y todavía sin comprobar. Se cierran verificando, que es el instrumento que detectó el hallazgo; al verificar en verde dejan de contar."
                           Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Arregladas sin verificar: " /><Run Text="{Binding FixedPendingVerify}" FontWeight="Bold" /></TextBlock>
                <TextBlock Margin="0,4,0,0"
                           ToolTip="Auditadas cuyo historial no se puede comparar: el commit de su auditoría no está en este clon, se reescribió la historia, o tu clon va por detrás. Ni «sin cambios» ni «cambiada» serían ciertas."
                           Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Sin historial: " /><Run Text="{Binding NoHistoryUnits}" FontWeight="Bold" /></TextBlock>
                <!-- F9 §4: los hallazgos que se quedaron sin código. Nada se resuelve solo. -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock VerticalAlignment="Center"
                               ToolTip="Hallazgos activos cuyo fichero ya no está en el repositorio. No se verifican ni se resuelven solos."><Run Text="Sin código: " /><Run Text="{Binding OrphanFindings}" FontWeight="Bold" /><Run Text=" · " /></TextBlock>
                    <ui:HyperlinkButton Content="Revisar" Padding="0" Margin="0" VerticalAlignment="Center"
                                        Command="{Binding ShowDeletedUnitsCommand}"
                                        ToolTip="Ver esos hallazgos, con el commit que borró cada fichero, y resolverlos por código eliminado si procede. La decisión es tuya." />
                </StackPanel>

                <!-- · Bloque 3 · GOBERNANZA — lo que condiciona QUÉ se reporta en esta aplicación.
                     No tiene nada que ver con la deriva, y pegado a ella lo parecía. · -->
                <Border Style="{StaticResource PanelDivider}" />
                <TextBlock Text="Gobernanza" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Lo que esta aplicación ha decidido callar y lo que ha decidido contarle al auditor. Condiciona la lectura de todo lo de arriba." />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock VerticalAlignment="Center" ToolTip="{Binding PatternsTooltip}"><Run Text="Patrones silenciados: " /><Run Text="{Binding SilencedPatterns}" FontWeight="Bold" /><Run Text=" · " /></TextBlock>
                    <ui:HyperlinkButton Content="Gestionar" Padding="0" Margin="0" VerticalAlignment="Center"
                                        Command="{Binding ManagePatternSilencesCommand}"
                                        ToolTip="Ver cuánto suprime cada patrón, afinar su ejemplar, des-silenciarlo o cambiar su caducidad." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock VerticalAlignment="Center" ToolTip="{Binding DirectivesTooltip}"><Run Text="Directivas: " /><Run Text="{Binding ActiveDirectives}" FontWeight="Bold" /><Run Text=" · " /></TextBlock>
                    <ui:HyperlinkButton Content="Gestionar" Padding="0" Margin="0" VerticalAlignment="Center"
                                        Command="{Binding ManageDirectivesCommand}"
                                        ToolTip="Activar los ficheros de convenciones del proyecto, decidir a qué flujo aplica cada uno, ordenarlos y ver cuánto presupuesto consumen." />
                </StackPanel>
                <!-- F5.7 §4: el resultado de la última acción va por el toast global, no
                     incrustado al fondo de este panel, donde se quedaba pegado. -->
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
