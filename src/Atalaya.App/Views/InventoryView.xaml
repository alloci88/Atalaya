<UserControl
    x:Class="Atalaya.App.Views.InventoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels">

    <!--
        INVENTARIO (F26 Parte B, D-975).

        Lo que había: los seis botones de acción metidos en la misma línea que la caja de búsqueda,
        todos del mismo peso; el árbol ocupando media pantalla y el resto vacío; y un panel del
        ciclo de 260 px donde el texto se cortaba a media palabra —«Gestiona», «Aquí r»— porque no
        cabía. Los estados de unidad eran pastillas grises: todas iguales, sin decir nada de un
        vistazo.

        Lo que hay: las acciones de la VISTA en su cabecera, y «Auditar selección» —el único
        primario; los gestos que tocan la LISTA (buscar, filtrar deriva, seleccionar pendientes o
        cambiadas) en la barra de la lista, que es donde actúan; el árbol al ancho; y el panel del
        ciclo a 320 px, que es lo que su contenido necesita, plegándose en cuanto no cabe.
    -->

    <UserControl.Resources>
        <!-- La cabecera de módulo es un enlace de fila, como en V3: mismo gesto, mismo aspecto. -->
        <Style x:Key="ModuleHeaderLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <!-- OBLIGATORIO en un Style de Button sin BasedOn: al no heredar del implícito, el
                 Foreground cae al de serie de WPF, que es NEGRO. Sobre el fondo oscuro del tema
                 eso es texto invisible. -->
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="{StaticResource Pad.XS}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.M}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- El pelo que separa los tres bloques del panel del ciclo (F9.1 §2): un pelo, no una raya. -->
        <Style x:Key="PanelDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Margin" Value="{StaticResource Pad.PanelDivider}" />
        </Style>

        <!-- El microtítulo de cada bloque del panel. -->
        <Style x:Key="PanelSection" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!-- Una línea «etiqueta: valor» del panel. -->
        <Style x:Key="PanelLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Margin" Value="{StaticResource Pad.XXS.Top}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- ============================================ LAS DOS FILAS DEL ÁRBOL (F37)

             Declaradas POR TIPO y no como `ItemTemplate` de una lista concreta: una carpeta puede
             contener otra carpeta, y con plantillas por tipo la recursión sale sola. Escrita como
             `ItemTemplate` habría que repetirla en cada nivel, y a partir del segundo nadie las
             mantiene iguales.
        -->
        <DataTemplate DataType="{x:Type vm:FolderNode}">
            <StackPanel Margin="{StaticResource Pad.XXS.Bottom}">

                <!-- La misma cabecera que el proyecto, y por la misma razón: la casilla marca lo
                     de dentro, el resto de la fila pliega. Lo que la carpeta NO tiene es acciones
                     propias — una carpeta no se audita; se audita lo que se marca a través de ella
                     con «Auditar selección», que no cambia. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- De dos estados en el dibujo y de tres en el modelo, igual que la del
                         proyecto (F5.13): la plantilla de WPF-UI pinta el indeterminado con el
                         mismo relleno de acento que el marcado, así que lo que está a medias se
                         dice con palabras, en la pastilla de al lado. -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                              IsThreeState="False"
                              AutomationProperties.Name="{Binding Name}"
                              Command="{Binding DataContext.ToggleFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"
                              VerticalAlignment="Center"
                              ToolTip="Marca o quita todas las unidades de esta carpeta, las de sus subcarpetas incluidas." />

                    <Button Grid.Column="1"
                            Style="{StaticResource ModuleHeaderLink}"
                            Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExpandGlyph}"
                                       Width="18"
                                       Style="{StaticResource Text.Meta}"
                                       VerticalAlignment="Center" />

                            <!-- EL GLIFO Y EL NOMBRE, DEL COLOR DE LA APLICACIÓN (D-314). Son la
                                 misma cosa a la vista, así que van del mismo color: un icono en
                                 tinta normal al lado de un nombre de color se lee como un
                                 descuido. El color viaja en el nodo porque el reparto de la
                                 paleta se hace sobre el portafolio completo y tiene un valor por
                                 tema (D-317) — nada de eso cabe en un recurso estático. -->
                            <Path Data="{x:Static c:Icons.Folder}"
                                  Style="{StaticResource Icon.Small}"
                                  Stroke="{Binding Ink}"
                                  Margin="{StaticResource Pad.XXS.Right}" />

                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Ink}"
                                       VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}"
                                    Margin="{StaticResource Pad.XS.Left}"
                                    Visibility="{Binding HasSelectionNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding SelectionNote}"
                                           Style="{StaticResource Pill.Text}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl ItemsSource="{Binding Children}"
                              Margin="{StaticResource Pad.FolderRow}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UnitNode}">
            <Grid Margin="{StaticResource Pad.XXS.Bottom}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- La casilla se llama como su unidad (UI-0016):
                     las 923 llegaban sin nombre y un lector de
                     pantalla anunciaba «casilla» 923 veces. -->
                <!-- APAGADA CUANDO OTRO LA ESTA AUDITANDO (F31 §4).
                     El motivo va al lado, en la pastilla de la
                     columna 4, y no en un tooltip: hay que saber
                     que existe para verlo (D-944.4). -->
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                          IsEnabled="{Binding IsSelectable}"
                          AutomationProperties.Name="{Binding FileName}"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                           Style="{StaticResource Text.Name}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Pad.XS.Left}" />

                <!-- El estado, con COLOR (D-975): auditada en
                     verde, pendiente en neutro, excluida apagada.
                     Antes las tres eran la misma pastilla gris, así
                     que había que leer cada fila para saber por
                     dónde iba el módulo. -->
                <Border Grid.Column="2" Style="{StaticResource Pill.UnitState}"
                        Margin="{StaticResource Pad.XS.Left}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateLabel}"
                               Style="{StaticResource Pill.UnitState.Text}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- F9 §3: la deriva es una dimensión APARTE del
                     estado, así que lleva su propio indicador al
                     lado y no lo sustituye: una unidad puede estar
                     «Auditada» y «Cambiada» a la vez. El color
                     nunca es el único canal — el texto va siempre.
                     F12 §H.3: TODO centrado en la fila. -->
                <Border Grid.Column="3" Style="{StaticResource Pill}"
                        Margin="{StaticResource Pad.XS.Left}"
                        VerticalAlignment="Center"
                        ToolTip="{Binding DriftTooltip}"
                        Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding DriftInk}"
                                 Margin="{StaticResource Pad.XXS.Right}" />
                        <TextBlock Text="{Binding DriftLabel}"
                                   Style="{StaticResource Pill.Text}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- QUIEN LA ESTA AUDITANDO Y DESDE CUANDO (F31 §4).
                     Pastilla de estado DEL SISTEMA, distinta de la
                     de la columna 2: aquella dice en que punto esta
                     la unidad, esta dice quien la tiene ahora. Con
                     el NOMBRE, no una X: sin servidor, la
                     reclamacion reciente es la unica senal que hay
                     de que alguien esta trabajando. -->
                <Border Grid.Column="4" Style="{StaticResource Pill}"
                        Margin="{StaticResource Pad.XS.Left}"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsClaimedByOther, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ClaimLabel}"
                               Style="{StaticResource Pill.Text}"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============================================ EL RESUMEN DEL CICLO, UNA VEZ

             Se pinta en dos sitios —acoplado a la derecha cuando cabe, y como cajón encima de
             la lista cuando no (D-982)— y por eso vive aquí, en una plantilla. Dos copias del
             mismo bloque divergen: la que se ve menos deja de mantenerse y un día le falta una
             fila que la otra sí tiene.
        -->
        <DataTemplate x:Key="CycleSummary">
            <ScrollViewer Style="{StaticResource Scroll}" VerticalScrollBarVisibility="Auto" MaxHeight="{StaticResource Cycle.PanelHeight}">
                <StackPanel>
                    <TextBlock Text="Resumen del ciclo" Style="{StaticResource Text.Lead}"
                               FontWeight="SemiBold"
                               ToolTip="Lo que hay en la vuelta actual del inventario de esta aplicación." />

                    <!-- · Bloque 1 · CICLO — dónde va la vuelta actual del inventario.
                         Los tres bloques van separados por un pelo y un microtítulo (F9.1 §2): en
                         la lista corrida anterior, «deriva» quedaba como una línea perdida en el
                         medio y los patrones parecían parte de ella. Lo que agrupa es el aire; el
                         pelo solo lo confirma. · -->
                    <TextBlock Text="{Binding CycleLabel}" Style="{StaticResource PanelLine}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"
                               ToolTip="{Binding CycleTooltip}" />

                    <!-- F17: la lupa del ciclo, con su color, y el acceso a cambiarla. Va pegado al
                         ciclo porque ES del ciclo: con otra lupa, «auditada» significa otra cosa. -->
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XS.Top}"
                                c:Stack.Gap="{StaticResource Space.XS}">
                        <!-- Texto y no pastilla, como en el Portafolio y por la misma razón
                             (UI-0019, UI-0050): ver la nota de `PortfolioView.xaml`. -->
                        <TextBlock Text="{Binding CycleThemeLabel}"
                                   Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding CycleThemeTooltip}" />
                        <Button Content="Configurar ciclo" Style="{StaticResource Button.Link}"
                                VerticalAlignment="Center"
                                Command="{Binding ConfigureCycleCommand}"
                                ToolTip="Elegir la temática del ciclo y el modelo preferido. Cambiar de temática con unidades auditadas las devuelve a pendientes; los hallazgos no se tocan." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource PanelLine}"
                               ToolTip="El modelo con el que el equipo prefiere auditar este ciclo. Es una preferencia: lanzar con otro avisa y deja continuar."><Run Text="Modelo preferido: " /><Run Text="{Binding PreferredModelLabel, Mode=OneWay}" /></TextBlock>

                    <!-- F17.1: el ciclo no olvida con qué lupa se trabajó antes del cambio. -->
                    <TextBlock Style="{StaticResource PanelLine}"
                               Text="{Binding CycleThemeHistory}"
                               ToolTip="Las temáticas por las que ha pasado este ciclo, con quién las cambió y cuándo. Los hallazgos de cada lupa siguen llevando la suya."
                               Visibility="{Binding HasCycleThemeHistory, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource PanelLine}" ToolTip="{Binding UnitsTooltip}"><Run Text="Unidades: " /><Run Text="{Binding TotalUnits, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}" ToolTip="Ya revisadas en este ciclo. Puedes volver sobre ellas marcándolas a mano."><Run Text="Auditadas: " /><Run Text="{Binding AuditedUnits, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}" ToolTip="Aún sin revisar en este ciclo. Es lo que queda para que se cierre."><Run Text="Pendientes: " /><Run Text="{Binding PendingUnits, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}" ToolTip="Cada lanzamiento de auditoría es una sesión. Los cierres de ciclo y los resets no cuentan."><Run Text="Sesiones este ciclo: " /><Run Text="{Binding SessionCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}"
                               ToolTip="Las unidades que se auditarán al pulsar «Auditar selección»."
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"><Run Text="Seleccionadas: " /><Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" /></TextBlock>

                    <!-- · Bloque 2 · DERIVA — qué ha cambiado desde que se auditó (F9). · -->
                    <Border Style="{StaticResource PanelDivider}" />
                    <TextBlock Text="Deriva" Style="{StaticResource PanelSection}"
                               ToolTip="Lo que le ha pasado al código desde que se auditó. Se calcula del historial de tu clon y no se guarda en ninguna parte." />
                    <!-- Contra qué se ha medido, como SUBTÍTULO del grupo y no como línea suelta:
                         es el alcance de los tres números de abajo, no un dato más. -->
                    <TextBlock Text="{Binding DriftBranchLabel}" Style="{StaticResource Text.Meta}"
                               TextWrapping="Wrap" Margin="{StaticResource Pad.XXS.Top}"
                               ToolTip="La rama de tu clon y su HEAD. Medir contra otra rama es legítimo, pero lo que veas será la deriva de esa rama."
                               Visibility="{Binding DriftIsKnown, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Calculando…" Style="{StaticResource PanelLine}"
                               ToolTip="Se está comparando el commit de cada auditoría con HEAD de tu clon. Va fuera del hilo de la interfaz: puedes seguir usando la vista."
                               Visibility="{Binding IsDriftLoading, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding DriftProblem}" Style="{StaticResource PanelLine}"
                               ToolTip="Por qué no hay deriva que enseñar. No saber no es lo mismo que saber que no ha cambiado nada, así que en vez de un cero se dice qué falta."
                               Visibility="{Binding HasDriftProblem, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Tres ceros seguidos ocupan lo mismo que un dato y no dicen más que una frase. -->
                    <TextBlock Text="{Binding NoDriftLabel}" Style="{StaticResource PanelLine}"
                               ToolTip="Ninguna unidad auditada ha cambiado, ninguna está pendiente de verificar y de todas se ha podido leer el historial."
                               Visibility="{Binding HasNoDrift, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource PanelLine}"
                               ToolTip="Auditadas cuyo código ha cambiado por mano ajena desde su auditoría. Son las candidatas de «Seleccionar cambiadas»."
                               Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Cambiadas: " /><Run Text="{Binding ChangedUnits, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}"
                               ToolTip="Arregladas desde Atalaya y todavía sin comprobar. Se cierran verificando, que es el instrumento que detectó el hallazgo; al verificar en verde dejan de contar."
                               Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Arregladas sin verificar: " /><Run Text="{Binding FixedPendingVerify, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    <TextBlock Style="{StaticResource PanelLine}"
                               ToolTip="Auditadas cuyo historial no se puede comparar: el commit de su auditoría no está en este clon, se reescribió la historia, o tu clon va por detrás. Ni «sin cambios» ni «cambiada» serían ciertas."
                               Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"><Run Text="Sin historial: " /><Run Text="{Binding NoHistoryUnits, Mode=OneWay}" FontWeight="Bold" /></TextBlock>

                    <!-- F9 §4: los hallazgos que se quedaron sin código. Nada se resuelve solo. -->
                    <StackPanel Margin="{StaticResource Pad.XXS.Top}"
                                Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource PanelLine}"
                                   ToolTip="Hallazgos activos cuyo fichero ya no está en el repositorio. No se verifican ni se resuelven solos."><Run Text="Sin código: " /><Run Text="{Binding OrphanFindings, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                        <Button Content="Revisar" Style="{StaticResource Button.Link}"
                                HorizontalAlignment="Left"
                                Command="{Binding ShowDeletedUnitsCommand}"
                                ToolTip="Ver esos hallazgos, con el commit que borró cada fichero, y resolverlos por código eliminado si procede. La decisión es tuya." />
                    </StackPanel>

                    <!-- · Bloque 3 · GOBERNANZA — lo que condiciona QUÉ se reporta en esta
                         aplicación. No tiene nada que ver con la deriva, y pegado a ella lo
                         parecía. · -->
                    <Border Style="{StaticResource PanelDivider}" />
                    <TextBlock Text="Gobernanza" Style="{StaticResource PanelSection}"
                               ToolTip="Lo que esta aplicación ha decidido callar y lo que ha decidido contarle al auditor. Condiciona la lectura de todo lo de arriba." />

                    <Grid Margin="{StaticResource Pad.XXS.Top}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource PanelLine}" VerticalAlignment="Center"
                                   ToolTip="{Binding PatternsTooltip}"><Run Text="Patrones silenciados: " /><Run Text="{Binding SilencedPatterns, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                        <Button Grid.Column="1" Content="Gestionar" Style="{StaticResource Button.Link}"
                                VerticalAlignment="Center"
                                Command="{Binding ManagePatternSilencesCommand}"
                                ToolTip="Ver cuánto suprime cada patrón, afinar su ejemplar, des-silenciarlo o cambiar su caducidad." />
                    </Grid>

                    <!-- DIRECTIVAS, OCULTO (R9). La línea «Directivas: 0 · Gestionar» sale del
                         resumen y el diálogo deja de ser alcanzable desde la interfaz: la capacidad
                         no se usa por ahora y una fila que siempre dice cero es una fila que enseña
                         a no mirar el panel. NO se borra nada — el servicio, el diálogo, su
                         view-model y sus tests siguen enteros, y las directivas que ya estén
                         registradas en el hub siguen viajando en los prompts—: lo único que cambia
                         es que no hay puerta. Volver a abrirla es devolver estas nueve líneas.
                         Ver D-1008. -->

                    <!-- F13: el umbral de tamaño es política de la aplicación y se edita aquí,
                         junto a lo demás que gobierna qué se reporta. En Ajustes no está: aquello
                         es de esta máquina, y esto clasifica el inventario que comparte el equipo. -->
                    <Grid Margin="{StaticResource Pad.XXS.Top}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource PanelLine}" VerticalAlignment="Center"
                                   ToolTip="{Binding ThresholdsTooltip}"><Run Text="Umbrales: " /><Run Text="{Binding LargeUnitLoc, Mode=OneWay}" FontWeight="Bold" /><Run Text=" LOC" /></TextBlock>
                        <Button Grid.Column="1" Content="Gestionar" Style="{StaticResource Button.Link}"
                                VerticalAlignment="Center"
                                Command="{Binding ManageThresholdsCommand}"
                                ToolTip="Fijar a partir de cuántas líneas —o de cuántos caracteres— una unidad es demasiado grande para auditarla de una vez. Es política de la aplicación: vale para todo el equipo y aplica en el próximo re-escaneo." />
                    </Grid>

                    <!-- · Bloque 4 · COSTE — lo que las sesiones de esta aplicación no han podido
                         valorar (F29 §1). Va con la aplicación y no en Ajustes → Tarifas: el coste
                         es de la sesión, la sesión es de esta aplicación, y quien mira el Portafolio
                         —que es quien decide— no pasa por Ajustes.

                         La misma frase que la insignia de la tarjeta, con la acción al lado y con
                         la forma de las tres de arriba: dato a la izquierda, enlace a la derecha,
                         como «Gestionar». Y solo cuando hay algo que reconciliar. · -->
                    <StackPanel Visibility="{Binding HasCostGap, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource PanelDivider}" />
                        <Grid Margin="{StaticResource Pad.XXS.Top}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        c:Stack.Gap="{StaticResource Space.XXS}"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding CostGapTooltip}">
                                <Path Style="{StaticResource Icon.Meta}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Text="{Binding CostGapLabel}"
                                           Style="{StaticResource PanelLine}"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding CostGapTooltip}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reconciliar costes" Style="{StaticResource Button.Link}"
                                    VerticalAlignment="Center"
                                    Command="{Binding ReconcileCostsCommand}"
                                    ToolTip="Ver qué sesiones se quedaron sin coste y por qué, y cerrar las que se puedan. Escribe en el hub lo que falta para calcularlo, con tu nombre en el commit; los informes ya escritos no se reescriben." />
                        </Grid>
                    </StackPanel>

                    <!-- F5.7 §4: el resultado de la última acción va por el toast global, no
                         incrustado al fondo de este panel, donde se quedaba pegado. -->
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

    </UserControl.Resources>

    <Grid x:Name="Split" SizeChanged="OnSplitSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- F30 §4 — la tira de los pasos del re-escaneo. `Auto` y no una altura fija: sin
                 re-escaneo la fila mide cero y la lista sube a donde estaba. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera de vista

             Las acciones de la VISTA van aquí. Lo que toca la LISTA —buscar, filtrar, seleccionar
             pendientes o cambiadas y AUDITAR LA SELECCIÓN— vive en la barra de la lista, que es
             donde actúa: un primario a media pantalla de las casillas que gobierna no se lee como
             el final de ese gesto (F26 §C, segunda revisión).
        -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource Pad.M.Bottom}">
            <StackPanel>
                <TextBlock Text="Inventario" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding CycleLabel}" Style="{StaticResource Text.Small}"
                           Margin="{StaticResource Pad.XXS.Top}"
                           ToolTip="{Binding CycleTooltip}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        c:Stack.Gap="{StaticResource Space.XS}">
                <ToggleButton x:Name="MoreActions" Style="{StaticResource Button.More}"
                              ToolTip="Más acciones" />
                <Popup IsOpen="{Binding IsChecked, ElementName=MoreActions}"
                       PlacementTarget="{Binding ElementName=MoreActions}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.XXS}"
                            Margin="{StaticResource Pad.XXS}">
                        <StackPanel c:Stack.Gap="{StaticResource Space.XXS}">
                            <Button Content="Re-escanear" Command="{Binding RescanCommand}"
                                    IsEnabled="{Binding CanAudit}" ToolTip="{Binding AuditDisabledTooltip}"
                                    BorderBrush="Transparent" Background="Transparent"
                                    HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" />
                            <Button Content="Reset ciclo" Command="{Binding ResetCycleCommand}"
                                    Style="{StaticResource Button.Danger}" BorderBrush="Transparent"
                                    HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Solo cuando el panel no cabe al lado: si cabe, este boton abriria encima
                     lo que ya se esta viendo (D-982). -->
                <Button Content="Resumen del ciclo"
                        Command="{Binding ToggleCycleDrawerCommand}"
                        ToolTip="Ciclo, modelo, unidades, deriva y gobernanza."
                        Visibility="{Binding Wide, Converter={StaticResource InverseBoolToVisibility}}" />

                <Button Content="Ver hallazgos" Command="{Binding ShowFindingsCommand}" />
            </StackPanel>
        </Grid>

        <!-- ==================================================== Avisos

             Solo lectura (F5.8 §3): por qué no se puede auditar y el acceso directo a arreglarlo.
             Va arriba porque explica los botones grises que tiene encima.
        -->
        <StackPanel Grid.Row="1" Grid.Column="0" c:Stack.Gap="{StaticResource Space.XS}"
                    Margin="{StaticResource Pad.S.Bottom}">
            <Border Style="{StaticResource Notice.Warning}"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{Binding LinkActionLabel}"
                            Command="{Binding LinkCloneCommand}"
                            Style="{StaticResource Button.Primary}"
                            Margin="{StaticResource Pad.S.Left}"
                            VerticalAlignment="Center" />
                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" VerticalAlignment="Center"
                             Margin="{StaticResource Pad.XS.Right}"
                             Style="{StaticResource Dot.Link}" />
                    <TextBlock Text="{Binding ReadOnlyNotice}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Deriva: contra qué se ha medido y qué NO ve este análisis (F9 §1.1). Va arriba
                 porque condiciona la lectura de todos los indicadores de abajo. -->
            <ItemsControl ItemsSource="{Binding DriftWarnings}"
                          Visibility="{Binding HasDriftWarnings, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Notice}" Margin="{StaticResource Pad.XXS.Bottom}">
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ==================================================== La barra de la lista

             Lo que TOCA la lista: buscar, filtrar por deriva, seleccionar por estado y plegar. No
             son acciones de la vista —no lanzan nada, no escriben— y por eso no están arriba.
        -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Panel}"
                Padding="{StaticResource Pad.S}" Margin="{StaticResource Pad.S.Bottom}">
            <DockPanel LastChildFill="True">
                <!-- La forma de plegar es la MISMA que en Hallazgos (UI-0023): un secundario,
                     no un enlace. El sitio ya era éste y sigue siéndolo — es Hallazgos el que baja
                     aquí su botón. El porqué del sitio está tres líneas más arriba. -->
                <Button DockPanel.Dock="Right"
                        Content="{Binding ToggleAllLabel}"
                        Command="{Binding ToggleAllGroupsCommand}"
                        Style="{StaticResource Button.Secondary}"
                        Margin="{StaticResource Pad.S.Left}"
                        VerticalAlignment="Center"
                        ToolTip="Con todo plegado, las cabeceras son el resumen: módulo y cuántas de sus unidades están auditadas."
                        Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}" />

                <WrapPanel Orientation="Horizontal">
                    <ui:TextBox PlaceholderText="Buscar unidad…"
                                ToolTip="Filtra por ruta. Filtrar NO deselecciona: lo que queda fuera de la vista sigue marcado."
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="{StaticResource FontSize.Body}"
                                Padding="{StaticResource Pad.Field}"
                                Width="240" Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Deriva:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}" />
                        <!-- El filtro de deriva es PROPIO y aparte del estado de auditoría: son dos
                             dimensiones distintas, y una unidad puede estar «auditada» y «cambiada»
                             a la vez. -->
                        <ComboBox SelectedIndex="{Binding DriftFilter}" MinWidth="190"
                                  AutomationProperties.Name="Filtrar por deriva"
                                  VerticalAlignment="Center"
                                  ToolTip="Filtra por lo que le ha pasado al código desde que se auditó. Es una dimensión aparte del estado de auditoría.">
                            <ComboBoxItem Content="Todas" />
                            <ComboBoxItem Content="Solo cambiadas" />
                            <ComboBoxItem Content="Solo arregladas sin verificar" />
                            <ComboBoxItem Content="Solo sin historial" />
                        </ComboBox>
                    </StackPanel>

                    <Button Content="{Binding PendingToggleLabel}" Command="{Binding SelectPendingCommand}"
                            ToolTip="{Binding PendingToggleTooltip}"
                            Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />
                    <!-- F9 §3: hace pareja con «Seleccionar pendientes» y desemboca en el MISMO
                         flujo — mismo diálogo, misma estimación de coste, mismo barrido, misma
                         reconciliación. La re-auditoría no estrena ningún camino de resolución. -->
                    <Button Content="{Binding ChangedToggleLabel}" Command="{Binding SelectChangedCommand}"
                            ToolTip="{Binding ChangedToggleTooltip}"
                            Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />

                    <!-- EL PRIMARIO, JUNTO A LO QUE ACTÚA (F26 §C, segunda revisión). Estaba en la
                         cabecera de la vista, arriba a la derecha, a media pantalla de las casillas
                         que selecciona; aquí está pegado a los dos botones que hacen la selección y
                         dice sobre cuántas unidades va a actuar. En la cabecera quedan solo las
                         acciones de VISTA, que es lo que aquella barra es. -->
                    <Button Content="{Binding AuditSelectionLabel}" Command="{Binding AuditSelectionCommand}"
                            Style="{StaticResource Button.Primary}"
                            IsEnabled="{Binding CanAuditSelection}" ToolTip="{Binding AuditDisabledTooltip}"
                            Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />

                    <!-- LA RAZÓN, PEGADA AL BOTÓN APAGADO (P-27, UI-0022). Un tooltip no vale: hay
                         que saber que existe para verlo, y quien mira un botón apagado no sabe que
                         hay nada que ver. -->
                    <Border Style="{StaticResource Reason.Chip}"
                            Margin="{StaticResource Pad.XXS}"
                            Visibility="{Binding HasAuditBlockedReason, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding AuditBlockedReason}" Style="{StaticResource Reason.Text}" />
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================== Los pasos del re-escaneo (F30 §4)

             UNA LÍNEA BAJO LA BARRA DE HERRAMIENTAS, y desaparece al terminar. Re-escanear se
             anunciaba con un toast —«Re-escaneando…»— que decía que había empezado y nada más:
             ni en qué paso iba, ni cuál falló. Aquí el mismo componente que el alta, en
             horizontal, porque en esta pantalla no hay altura que gastar y porque el árbol de
             módulos no puede saltar mientras se re-escanea.
        -->
        <!-- La visibilidad va AQUÍ además de dentro del componente: un contenedor con margen que
             envuelve algo colapsado deja su margen puesto, y la lista se quedaría 12 px más abajo
             para siempre sin que nada lo explicara. -->
        <ContentControl Grid.Row="3" Grid.Column="0" Content="{Binding RescanSteps}"
                        Margin="{StaticResource Pad.S.Bottom}" HorizontalAlignment="Left"
                        Visibility="{Binding RescanSteps.IsVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <!-- ==================================================== La selección

             Solo cuando hay algo marcado. El contador es lo que se va a gastar, así que se lee
             antes de pulsar «Auditar selección» (F5.6 §3).
        -->
        <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource Notice.Info}"
                Margin="{StaticResource Pad.S.Bottom}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                <TextBlock Text="{Binding SelectionLabel}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
                <Button Content="Deseleccionar todo"
                        Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource Button.Link}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ==================================================== El árbol de módulos -->
        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource Panel}"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource Pad.XS}">
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="{StaticResource Pad.XXS.Bottom}">

                                <!-- Cabecera: la casilla tri-estado selecciona el módulo entero; el
                                     resto de la fila pliega y despliega. Dos gestos, dos zonas. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- La casilla es de DOS estados a propósito (F5.13): marcada
                                         si y solo si TODAS las unidades del módulo lo están. La
                                         plantilla de WPF-UI pinta el indeterminado con el MISMO
                                         relleno de acento que el marcado, así que enviarle un nulo
                                         hacía que marcar UNA clase pareciera marcar el módulo
                                         entero. La selección parcial se dice con palabras. -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsAllSelected, Mode=OneWay}"
                                              IsThreeState="False"
                                              AutomationProperties.Name="{Binding Name}"
                                              Command="{Binding DataContext.ToggleModuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}"
                                              VerticalAlignment="Center"
                                              ToolTip="Marca o quita todas las unidades de este módulo." />

                                    <Button Grid.Column="1"
                                            Style="{StaticResource ModuleHeaderLink}"
                                            Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ExpandGlyph}"
                                                       Width="18"
                                                       Style="{StaticResource Text.Meta}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Header}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       VerticalAlignment="Center" />
                                            <!-- Lo que el guion del tri-estado nunca llegó a decir. -->
                                            <Border Style="{StaticResource Pill}"
                                                    Margin="{StaticResource Pad.XS.Left}"
                                                    Visibility="{Binding HasSelectionNote, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding SelectionNote}"
                                                           Style="{StaticResource Pill.Text}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- LO QUE CUELGA DEL PROYECTO (F37 §1.1): sus carpetas y, detrás, las
                                     unidades que no están en ninguna. Sin `ItemTemplate`: cada tipo
                                     de fila trae la suya, declarada por tipo arriba, que es lo único
                                     que permite que una carpeta contenga otra carpeta sin escribir
                                     la plantilla dos veces. -->
                                <ItemsControl ItemsSource="{Binding Children}"
                                              Margin="{StaticResource Pad.UnitRow}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ==================================================== Sin inventario -->
        <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" c:Stack.Gap="{StaticResource Space.S}"
                        Margin="{StaticResource Pad.XL}">
                <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Inventory}"
                      Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock Text="Sin inventario" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" />
                <TextBlock Text="Vincula tu clon local y vuelve a escanear."
                           Style="{StaticResource Text.Small}" HorizontalAlignment="Center" />
                <Button Content="Re-escanear" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding CanAudit}" ToolTip="{Binding AuditDisabledTooltip}"
                        Style="{StaticResource Button.Primary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ==================================================== El resumen del ciclo

             Panel fijo a la derecha, y se PLIEGA cuando no cabe (principio 1). A 260 px su texto
             se cortaba a media palabra —«Gestiona», «Aquí r»—: el ancho no daba y nadie lo dijo.
             320 es lo que necesita su línea más larga.

             Cada dato lleva una frase que lo explica: el usuario no distinguía ciclo de sesión
             (F5.6 §5). «Grandes» no sale aquí por decisión suya — no aporta a este nivel, y el
             estado sigue visible en la fila de cada unidad, que es donde se actúa.
        -->
        <!-- Acoplado a la derecha cuando hay sitio. Cuando no lo hay, este panel NO se limita a
             desaparecer: se abre como cajón desde la cabecera (D-982). -->
        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="5"
                Style="{StaticResource Card}"
                Width="{StaticResource Cycle.PanelWidth}"
                Margin="{StaticResource Pad.M.Left}"
                VerticalAlignment="Top"
                Visibility="{Binding Wide, Converter={StaticResource BoolToVisibility}}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CycleSummary}" />
        </Border>

        <!-- ==================================================== El cajón del ciclo (D-982)

             Encima de la lista, no al lado: cuando no cabe una columna de 320 px, lo que cabe es
             una capa. El velo apaga lo de debajo y cierra al pulsarlo, que es el gesto que todo
             el mundo prueba primero.
        -->
        <Grid Grid.Row="0" Grid.RowSpan="6" Grid.Column="0" Grid.ColumnSpan="2"
              Visibility="{Binding CycleDrawerOpen, Converter={StaticResource BoolToVisibility}}">
            <Button Command="{Binding ToggleCycleDrawerCommand}"
                    Background="{DynamicResource Brush.Scrim}" BorderThickness="{StaticResource Pad.Zero}"
                    Focusable="False" ToolTip="Cerrar el resumen">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- EL CAJÓN TOMA EL FOCO, LO RETIENE Y ESCAPE LO CIERRA (P-03, UI-0003). Al
                 abrirlo, el foco se quedaba en el botón que lo abrió, Tab NO entraba y seguía
                 recorriendo la página que el cajón tapa —buscador, filtro, «Auditar selección» y
                 las novecientas filas de módulo—, y Escape no lo cerraba: sus seis controles
                 estaban marcados como enfocables y no había ninguna secuencia de Tab que llegara a
                 ellos. Desde que D-997 §2 retiró de Ajustes el aviso del umbral, éste es el único
                 sitio desde el que se llega a la gobernanza del ciclo. -->
            <Border Style="{StaticResource Card}"
                    Width="{StaticResource Cycle.PanelWidth}"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    c:Overlay.IsOpen="{Binding CycleDrawerOpen}"
                    c:Overlay.CloseCommand="{Binding ToggleCycleDrawerCommand}"
                    AutomationProperties.Name="Resumen del ciclo">
                <DockPanel>
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right"
                            Content="Cerrar" Style="{StaticResource Button.Link}"
                            Margin="{StaticResource Pad.XS.Bottom}"
                            Command="{Binding ToggleCycleDrawerCommand}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CycleSummary}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
