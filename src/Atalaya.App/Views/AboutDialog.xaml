<ui:FluentWindow
    x:Class="Atalaya.App.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Atalaya.App.Controls"
    Title="Acerca de Atalaya"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Acerca de" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,10,28,24">

            <!-- Identidad de la aplicación: el icono grande y su nombre. -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Image Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center">
                    <Image.Source>
                        <BitmapImage UriSource="pack://application:,,,/assets/atalaya.ico"
                                     DecodePixelWidth="64" DecodePixelHeight="64" />
                    </Image.Source>
                </Image>
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="Atalaya" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding VersionLabel}" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                Text="Auditoría de código colaborativa con agentes de IA. El estado vive en un repositorio git compartido; no hay servidor propio."
                TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,18"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- La organización, con su firma. Es uno de los TRES sitios donde va la marca. -->
            <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,18"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Visibility="{Binding HasOrganization, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Organization}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <controls:BrandMark LogoHeight="30" />
                </StackPanel>
            </Border>

            <!-- BUGFIX-VERSION: los dos enlaces salen de «appRepoUrl» del despliegue, y si no
                 está configurado NO se enseñan. Un enlace que lleva a un 404 es peor que ningún
                 enlace: el hueco se explica debajo. -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibility}}">
                <ui:HyperlinkButton Content="Repositorio" NavigateUri="{Binding Repository}"
                                    Padding="0,4" Margin="0,0,18,0" />
                <ui:HyperlinkButton Content="Manual" NavigateUri="{Binding Manual}"
                                    Padding="0,4" />
            </StackPanel>

            <TextBlock Text="{Binding NoLinksNotice}" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasNoLinks, Converter={StaticResource BoolToVisibility}}" />

            <ui:Button Content="Cerrar" Click="OnClose" Appearance="Secondary"
                       HorizontalAlignment="Right" Padding="18,6" Margin="0,18,0,0" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
