<v:AtalayaDialog
    x:Class="Atalaya.App.Views.LinkCloneDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:v="clr-namespace:Atalaya.App.Views"
    Title="Vincular clon local"
    Width="600"
    SizeToContent="Height"
    ResizeMode="NoResize">
    <Grid Background="{DynamicResource Brush.Bg}">
        <!-- EL DIÁLOGO PINTA SU FONDO (UI-0013). `FluentWindow` aplica su propio telón por
             debajo —`#FAFAFA` en claro, `#202020` en oscuro, los colores de fábrica de
             WPF-UI— y `MainWindow` lo tapa desde F26 §A justamente por eso; ninguno de los
             nueve diálogos lo hacía, así que abrir uno enseñaba otro programa encima de una
             aplicación crema. Y `PaletteContrastTests` pasaba en verde midiendo contra una
             superficie que la aplicación nunca declara.

             Y sus botones son los cuatro del sistema (UI-0014): el primario era el acento de
             Windows —`#1E9BFA`/`#0071C7`— y no el azul de la casa, y el botón que confirma un
             borrado irreversible no puede ser de otro color que el de Atalaya. El macizo de
             peligro se queda AQUÍ y solo aquí (UI-0039): destruir es lo que se ha venido a
             hacer a un diálogo de confirmación. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:DialogHeader Grid.Row="0" Title="{Binding Title}" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Dialog}">
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="{StaticResource Pad.XS.Top}" />

            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}">
                <TextBlock Text="Repo de la aplicación: " Foreground="{DynamicResource Brush.TextMuted}" Style="{StaticResource Dialog.Help}" />
                <TextBlock Text="{Binding RepoUrl}" Style="{StaticResource Dialog.Help}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <!-- · Los dos caminos. Se eligen a la vista, no en un menú: quien no tiene el repo
                 clonado no debe tener que adivinar que existe la segunda opción. · -->
            <StackPanel Visibility="{Binding Linked, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.M.Top}">
                    <RadioButton Content="Ya tengo el repo clonado"
                                 GroupName="Camino"
                                 IsChecked="{Binding IsExistingMode, Mode=TwoWay}" />
                    <RadioButton Content="Clonarlo ahora"
                                 GroupName="Camino"
                                 Margin="{StaticResource Pad.L.Left}"
                                 IsEnabled="{Binding CanClone}"
                                 IsChecked="{Binding IsCloneMode, Mode=TwoWay}" />
                </StackPanel>

                <!-- Camino 1 -->
                <StackPanel Margin="{StaticResource Pad.M.Top}"
                            Visibility="{Binding IsExistingMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Carpeta del clon (la que contiene «.git»)" FontWeight="SemiBold" Margin="{StaticResource Pad.XXS.Bottom}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding ExistingPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Examinar…" Command="{Binding ChooseExistingCommand}" Margin="{StaticResource Pad.XS.Left}" />
                    </Grid>
                    <TextBlock
                        Text="Se comprueba que la carpeta sea un repo git y que su remoto «origin» sea el de esta aplicación."
                        Foreground="{DynamicResource Brush.TextMuted}" Style="{StaticResource Dialog.Help}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" />
                    <Button Content="Vincular"
                               Command="{Binding LinkExistingCommand}"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Pad.S.Top}" Style="{StaticResource Button.Primary}" />
                </StackPanel>

                <!-- Camino 2 -->
                <StackPanel Margin="{StaticResource Pad.M.Top}"
                            Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Carpeta destino (el clon se crea dentro)" FontWeight="SemiBold" Margin="{StaticResource Pad.XXS.Bottom}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding TargetParent, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Examinar…" Command="{Binding ChooseTargetCommand}" Margin="{StaticResource Pad.XS.Left}" />
                    </Grid>
                    <TextBlock Text="{Binding TargetPreview, StringFormat='Quedará en: {0}'}"
                               Foreground="{DynamicResource Brush.TextMuted}" Style="{StaticResource Dialog.Help}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" />
                    <Button Content="Clonar y vincular"
                               Command="{Binding CloneNowCommand}"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Pad.S.Top}" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </StackPanel>

            <!-- · Vinculada: el piloto en verde, dicho aquí mismo · -->
            <Border Style="{StaticResource Notice.Success}" Margin="{StaticResource Pad.M.Top}"
                    Visibility="{Binding Linked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LinkedPath}" Foreground="{DynamicResource Brush.TextMuted}" Style="{StaticResource Dialog.Help}" TextWrapping="Wrap" Margin="{StaticResource Pad.XXS.Top}" />
                </StackPanel>
            </Border>

            <!-- · El clon está en otro commit: se dice y se ofrece, no se hace solo · -->
            <Border Style="{StaticResource Notice.Warning}" Margin="{StaticResource Pad.S.Top}"
                    Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DriftWarning}" TextWrapping="Wrap" />
                    <Button Content="Re-escanear ahora"
                               Command="{Binding RescanNowCommand}"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="{StaticResource Pad.S.Top}" />
                </StackPanel>
            </Border>

            <!-- · El error, específico y con las dos URLs cuando el remoto no coincide · -->
            <Border Style="{StaticResource Notice.Danger}" Margin="{StaticResource Pad.S.Top}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}"
                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Progress}" Margin="{StaticResource Pad.XS.Left}" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pad.M.Top}">
                <Button Content="Cerrar" Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</v:AtalayaDialog>
