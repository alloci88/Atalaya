<ui:FluentWindow
    x:Class="Atalaya.App.Views.LinkCloneDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Vincular clon local"
    Width="600"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,20">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Repo de la aplicación: " Opacity="0.6" FontSize="12" />
                <TextBlock Text="{Binding RepoUrl}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>

            <!-- · Los dos caminos. Se eligen a la vista, no en un menú: quien no tiene el repo
                 clonado no debe tener que adivinar que existe la segunda opción. · -->
            <StackPanel Visibility="{Binding Linked, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <RadioButton Content="Ya tengo el repo clonado"
                                 GroupName="Camino"
                                 IsChecked="{Binding IsExistingMode, Mode=TwoWay}" />
                    <RadioButton Content="Clonarlo ahora"
                                 GroupName="Camino"
                                 Margin="18,0,0,0"
                                 IsEnabled="{Binding CanClone}"
                                 IsChecked="{Binding IsCloneMode, Mode=TwoWay}" />
                </StackPanel>

                <!-- Camino 1 -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsExistingMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Carpeta del clon (la que contiene «.git»)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding ExistingPath, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="Examinar…" Command="{Binding ChooseExistingCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock
                        Text="Se comprueba que la carpeta sea un repo git y que su remoto «origin» sea el de esta aplicación."
                        Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ui:Button Content="Vincular"
                               Command="{Binding LinkExistingCommand}"
                               Appearance="Primary"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- Camino 2 -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Carpeta destino (el clon se crea dentro)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding TargetParent, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="Examinar…" Command="{Binding ChooseTargetCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding TargetPreview, StringFormat='Quedará en: {0}'}"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <ui:Button Content="Clonar y vincular"
                               Command="{Binding CloneNowCommand}"
                               Appearance="Primary"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="0,12,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- · Vinculada: el piloto en verde, dicho aquí mismo · -->
            <Border Background="#2233C25B" BorderBrush="#5533C25B" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,16,0,0"
                    Visibility="{Binding Linked, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LinkedPath}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- · El clon está en otro commit: se dice y se ofrece, no se hace solo · -->
            <Border Background="#22D2B036" BorderBrush="#55D2B036" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                    Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DriftWarning}" TextWrapping="Wrap" />
                    <ui:Button Content="Re-escanear ahora"
                               Command="{Binding RescanNowCommand}"
                               IsEnabled="{Binding NotBusy}"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- · El error, específico y con las dos URLs cuando el remoto no coincide · -->
            <Border Background="#22D13A3A" BorderBrush="#55D13A3A" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Progress}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cerrar" Click="OnClose" Appearance="Secondary" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
