<ui:FluentWindow
    x:Class="Atalaya.App.Views.RuleExclusionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Reglas excluidas"
    Width="720"
    Height="540"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Reglas excluidas" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,0">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Reglas que no aplican a esta aplicación. Ninguna auditoría suya las reporta mientras la exclusión siga activa. Es por-aplicación: la misma regla puede ser vital en otra." />
            <TextBlock Text="No hay ninguna regla excluida en esta aplicación."
                       Margin="0,14,0,0" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="22,12,14,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding RuleId}" FontFamily="Consolas" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding Reason, Mode=OneWay}" />
                                    <Run Text=" · por " /><Run Text="{Binding By, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Expiry, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="{Binding Notes}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Effect}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Caducidad (días) — 0 = permanente" VerticalAlignment="Center"
                                               Margin="0,0,8,6" FontSize="12" />
                                    <ui:TextBox Width="90" Margin="0,0,8,6"
                                                Text="{Binding ExpiryDays, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="Días desde hoy. 0 deja la exclusión permanente." />
                                    <ui:Button Content="Aplicar caducidad" Margin="0,0,8,6"
                                               Command="{Binding DataContext.ApplyExpiryCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Des-excluir" Margin="0,0,0,6"
                                               Command="{Binding DataContext.UnexcludeCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="La regla vuelve al brief y sus hallazgos pueden volver a reportarse." />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,12,22,18">
            <ui:Button Content="Cerrar" Click="OnClose" Appearance="Secondary" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
