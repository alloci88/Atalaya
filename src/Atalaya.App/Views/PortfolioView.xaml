<UserControl
    x:Class="Atalaya.App.Views.PortfolioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls">

    <!--
        PORTAFOLIO (F26 Parte B, D-972).

        Lo que había: UNA tarjeta de 330 px fijos y el resto de una pantalla de 1920 en blanco. La
        tarjeta amontonaba nombre, piloto, ciclo, barra, cuatro pastillas del mismo tamaño, deriva,
        última sesión y DOS botones de ancho completo, uno debajo del otro, los dos gritando lo
        mismo. No había forma de saber de un vistazo qué aplicación está peor.

        Lo que hay: una rejilla que reparte el ancho (3-4 columnas a pantalla completa, 2 a 1280),
        el resumen del portafolio ocupando el sitio que sobraba, y UNA acción principal por tarjeta
        —la que toca según el estado del vínculo—. La papelera se va a un menú «…»: es una salida,
        no una acción del día.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera -->
        <Grid Grid.Row="0" Margin="{StaticResource Pad.L.Bottom}">
            <StackPanel>
                <TextBlock Text="Portafolio" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding Summary.Headline}"
                           Style="{StaticResource Text.Small}"
                           Margin="{StaticResource Pad.XXS.Top}" />
            </StackPanel>

            <!-- El único primario de la vista (principio 4). -->
            <Button Content="+ Nueva aplicación"
                    Command="{Binding NewAppCommand}"
                    Style="{StaticResource Button.Primary}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- ==================================================== El resumen del portafolio

             Ocupa el ancho que antes se quedaba vacío, y contesta la pregunta que se hace al abrir
             Atalaya por la mañana: ¿cuánto hay abierto y de qué gravedad? Las cifras grandes; las
             etiquetas, debajo y pequeñas.
        -->
        <!-- EL CERO NO SE PINTA DE PELIGRO (UI-0051). Con cero críticas el azulejo conservaba su
             borde rojo y la cifra iba en `Sev.Crit`: el color decía «hay una crítica» donde el
             número decía lo contrario, y es lo primero que se ve al abrir la aplicación. El color
             de gravedad aparece cuando hay algo de esa gravedad. -->
        <c:ColumnsPanel Grid.Row="1"
                        MinColumnWidth="200" MaxColumns="4"
                        Gap="{StaticResource Space.M}"
                        Margin="{StaticResource Pad.L.Bottom}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Stat.Card}">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Crit}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.Critica}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Summary.Critica}" Style="{StaticResource Stat.Number.Sev}"
                               Foreground="{DynamicResource Brush.Sev.Crit}" />
                    <TextBlock Text="Críticas" Style="{StaticResource Stat.Label}" />
                </StackPanel>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Stat.Card}">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.High}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.Alta}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Summary.Alta}" Style="{StaticResource Stat.Number.Sev}"
                               Foreground="{DynamicResource Brush.Sev.High}" />
                    <TextBlock Text="Altas" Style="{StaticResource Stat.Label}" />
                </StackPanel>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Stat.Card}">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Med}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.Media}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Summary.Media}" Style="{StaticResource Stat.Number.Sev}"
                               Foreground="{DynamicResource Brush.Sev.Med}" />
                    <TextBlock Text="Medias" Style="{StaticResource Stat.Label}" />
                </StackPanel>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Stat.Card}">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Low}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Summary.Baja}" Value="0">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Summary.Baja}" Style="{StaticResource Stat.Number.Sev}"
                               Foreground="{DynamicResource Brush.Sev.Low}" />
                    <TextBlock Text="Bajas" Style="{StaticResource Stat.Label}" />
                </StackPanel>
            </Border>
        </c:ColumnsPanel>

        <!-- ==================================================== Sin aplicaciones -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" c:Stack.Gap="{StaticResource Space.S}"
                        Margin="{StaticResource Pad.XL}">
                <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Portfolio}"
                      Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock Text="No hay aplicaciones todavía"
                           Style="{StaticResource Text.H3}" HorizontalAlignment="Center" />
                <TextBlock Text="Registra un repositorio de tu organización y lanza su primera auditoría."
                           Style="{StaticResource Text.Small}" HorizontalAlignment="Center" />
                <Button Content="+ Nueva aplicación"
                        Command="{Binding NewAppCommand}"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ==================================================== La rejilla de aplicaciones -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 420 de mínimo: por debajo, las cifras y la acción no caben en una fila
                             y la tarjeta empieza a apilarse sobre sí misma. -->
                        <c:ColumnsPanel MinColumnWidth="420" MaxColumns="4"
                                        Gap="{StaticResource Space.M}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel c:Stack.Gap="{StaticResource Space.M}">

                                <!-- Identidad y el «…» -->
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H3}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Stack}" Style="{StaticResource Text.Meta}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                c:Stack.Gap="{StaticResource Space.XS}">
                                        <Border Style="{StaticResource Pill}"
                                                Background="{DynamicResource Brush.Success.Soft}"
                                                Visibility="{Binding AuditingNow, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="auditando ahora"
                                                       Style="{StaticResource Pill.Text}"
                                                       Foreground="{DynamicResource Brush.Success.Ink}" />
                                        </Border>

                                        <!-- F5.3 §4: el hard-reset. Detrás de un «…» porque es una
                                             SALIDA, no una acción del día a día: en la cara de la
                                             tarjeta competía por la mirada con «Abrir inventario». -->
                                        <ToggleButton x:Name="More"
                                                      Style="{StaticResource Button.More}"
                                                      ToolTip="Más acciones" />
                                        <Popup IsOpen="{Binding IsChecked, ElementName=More}"
                                               PlacementTarget="{Binding ElementName=More}"
                                               Placement="Bottom" StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Style="{StaticResource Card}"
                                                    Padding="{StaticResource Pad.XXS}"
                                                    Margin="{StaticResource Pad.XXS}">
                                                <Button
                                                    Command="{Binding DataContext.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanDelete}"
                                                    ToolTip="{Binding DeleteTooltip}"
                                                    Style="{StaticResource Button.Danger}"
                                                    BorderBrush="Transparent"
                                                    HorizontalContentAlignment="Left"
                                                    Content="Eliminar la aplicación…" />
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Grid>

                                <!-- El vínculo, con su color (D-293). Si no se puede auditar, eso es
                                     lo primero que hay que saber de la tarjeta. -->
                                <StackPanel Orientation="Horizontal"
                                            c:Stack.Gap="{StaticResource Space.XS}"
                                            ToolTip="{Binding Link.Tooltip}">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Style="{StaticResource Dot.Link}" />
                                    <TextBlock Text="{Binding Link.Label}"
                                               Style="{StaticResource Text.Small}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Las cifras, GRANDES y por gravedad. Es lo que convierte la
                                     rejilla en un panel: se ve qué aplicación está peor sin leer. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Critica}" Style="{StaticResource Stat.Number.Sev}"
                                                   Foreground="{DynamicResource Brush.Sev.Crit}" />
                                        <TextBlock Text="Críticas" Style="{StaticResource Stat.Label}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Alta}" Style="{StaticResource Stat.Number.Sev}"
                                                   Foreground="{DynamicResource Brush.Sev.High}" />
                                        <TextBlock Text="Altas" Style="{StaticResource Stat.Label}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Media}" Style="{StaticResource Stat.Number.Sev}"
                                                   Foreground="{DynamicResource Brush.Sev.Med}" />
                                        <TextBlock Text="Medias" Style="{StaticResource Stat.Label}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding Baja}" Style="{StaticResource Stat.Number.Sev}"
                                                   Foreground="{DynamicResource Brush.Sev.Low}" />
                                        <TextBlock Text="Bajas" Style="{StaticResource Stat.Label}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Ciclo, cobertura y lupa -->
                                <StackPanel c:Stack.Gap="{StaticResource Space.XS}">
                                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                        <TextBlock Style="{StaticResource Text.Small}" VerticalAlignment="Center">
                                            <Run Text="Ciclo" /><Run Text=" " /><Run Text="{Binding CurrentCycle, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" · " /><Run Text="{Binding ProgressText, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" auditado" />
                                        </TextBlock>
                                        <!-- LA TEMÁTICA ES UN METADATO, no una etiqueta (UI-0050).
                                             Se pintaba como pastilla teñida aquí y en el resumen del
                                             ciclo, y como texto corrido en la ficha y en el informe:
                                             el mismo dato, dos formas según por dónde entres. Se
                                             elige TEXTO en los cuatro sitios, y no pastilla, por el
                                             sitio donde no cabe la otra opción — dentro de la frase
                                             «Ciclo: 1 · Temática: General · Modo: Lotes» del informe
                                             una pastilla no se puede pintar—. Un dato que en uno de
                                             sus cuatro sitios tiene que ser texto es texto.

                                             Y de paso se va el color que no salía de ninguna paleta
                                             (UI-0019): la pastilla usaba `#DDDBD7` sobre `#6B7280`
                                             en claro (3,50:1) y `#383E47` sobre `#9CA3AF` en oscuro
                                             (4,25:1) — el único par que fallaba en los DOS temas,
                                             porque nunca entró en la comprobación. -->
                                        <TextBlock Text="{Binding ThemeLabel}"
                                                   Style="{StaticResource Text.Small}"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding ThemeTooltip}" />
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6" />
                                </StackPanel>

                                <!-- Deriva y última sesión: metadatos, después de lo accionable
                                     (principio 8). -->
                                <StackPanel c:Stack.Gap="{StaticResource Space.XXS}">
                                    <Button Content="{Binding DriftLabel}"
                                            Command="{Binding DataContext.ShowDriftCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DriftIsActionable}"
                                            ToolTip="{Binding DriftTooltip}"
                                            Style="{StaticResource Button.Link}"
                                            HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Meta}">
                                        <Run Text="Última sesión:" /><Run Text=" " /><Run Text="{Binding LastSessionBy, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- LA ACCIÓN. Una, y la que toca: sin clon no hay nada que auditar,
                                     así que vincular es lo primario; con clon, entrar. Antes eran
                                     dos botones de ancho completo, uno encima del otro, y el
                                     primario era el de abajo. -->
                                <Button Content="{Binding Link.ActionLabel}"
                                        Command="{Binding DataContext.LinkCloneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Link.Tooltip}"
                                        Style="{StaticResource Button.Primary}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding Link.NeedsAction, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="Abrir inventario"
                                        Command="{Binding DataContext.OpenAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                            <Style.Triggers>
                                                <!-- Con el clon sin vincular, entrar al inventario
                                                     deja de ser lo principal —se puede mirar, pero
                                                     no auditar— y el primario pasa a ser vincular.
                                                     UN primario por tarjeta, siempre (principio 4). -->
                                                <DataTrigger Binding="{Binding Link.NeedsAction}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
