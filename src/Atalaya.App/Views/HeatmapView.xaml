<UserControl
    x:Class="Atalaya.App.Views.HeatmapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <UserControl.Resources>

        <Style x:Key="Block" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="BlockHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- El aviso de cobertura NO es decoración: es la frase que impide leer el gris como
             «limpio». Va en su propio recuadro para que no se confunda con la leyenda. -->
        <Style x:Key="Warning" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- El ancho de la franja de densidad, en la cabecera y en la fila: un solo valor, para
             que las dos rejillas no puedan descuadrarse por un píxel. -->
        <GridLength x:Key="StripeWidth">11</GridLength>

        <!-- La cabecera ordenable de la tabla. Con BasedOn: quien redefine un estilo hereda la
             responsabilidad de todo lo que ese estilo traía (ImplicitStyleTests). -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- La cabecera de una columna NUMÉRICA se alinea como sus números: a la derecha. Ese
             desajuste —cabecera a la izquierda, cifra a la derecha— es lo que hacía que la tabla
             pareciera descuadrada aunque las columnas estuvieran perfectamente puestas. -->
        <Style x:Key="SortHeaderRight" TargetType="Button" BasedOn="{StaticResource SortHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="2,2,6,2" />
        </Style>

        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
        </Style>

        <!-- Números: a la derecha y con cifras de ancho FIJO (tabular). Con las cifras
             proporcionales de serie, «1.234» y «9.999» ocupan distinto y la columna baila fila a
             fila aunque esté alineada. -->
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>

        <!-- El nombre de la unidad es un enlace, pero tiene que ocupar su columna entera para que
             el recorte por el medio sepa cuánto sitio hay. -->
        <Style x:Key="RowLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- La tarjeta de un módulo: un botón, porque el gesto es entrar en él. Con BasedOn no,
             porque redefine la plantilla entera; por eso fija su Foreground a mano, que es la
             trampa que ButtonForegroundTests vigila. -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="248" />
            <!-- Alto uniforme: sin él, las tarjetas sin hallazgos son más bajas y las filas del
                 WrapPanel salen dentadas. -->
            <Setter Property="MinHeight" Value="152" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LegendEntry">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,6" ToolTip="{Binding Tooltip}">
                <Rectangle Width="22" Height="13" RadiusX="2" RadiusY="2"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibility}}"
                           Fill="{Binding Fill}"
                           Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="{Binding Dotted, Converter={StaticResource DashedToArray}}" />
                <TextBlock Text="{Binding Label}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- La fila ESTRELLA: el contenido ocupa lo que queda a cualquier tamaño de ventana.
                 El hueco que aparecía al maximizar salía de un treemap de alto fijo dentro de una
                 tarjeta que no crecía con la fila (F10.2 §5). -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,18,12">
            <TextBlock Text="Mapa de calor" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BlockHint}"
                       Text="La estructura de la aplicación: el área de cada celda es su tamaño en líneas y el color, la densidad de deuda. El gris es lo que nadie ha auditado." />
        </StackPanel>

        <!-- Barra de mandos: cambian el significado de todo lo de abajo, así que van arriba. -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Aplicación" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7" Margin="0,0,8,0" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding AppOptions}"
                              SelectedItem="{Binding SelectedApp}"
                              DisplayMemberPath="Name"
                              ToolTip="El mapa es de UNA aplicación: mezclar dos repartiría el área entre códigos que no se comparan" />

                    <TextBlock Text="Color por" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7" Margin="20,0,8,0" />
                    <ComboBox MinWidth="150"
                              ItemsSource="{Binding MetricOptions}"
                              SelectedItem="{Binding SelectedMetric}"
                              DisplayMemberPath="Label"
                              ToolTip="{Binding SelectedMetric.Hint}" />

                    <TextBlock Text="Orden" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7" Margin="20,0,8,0"
                               Visibility="{Binding IsZoomed, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ComboBox MinWidth="130"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              DisplayMemberPath="Label"
                              ToolTip="{Binding SelectedSort.Hint}"
                              Visibility="{Binding IsZoomed, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="18,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ToggleSwitch Content="Solo auditadas"
                                     IsChecked="{Binding OnlyAudited}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,0"
                                     ToolTip="Esconde lo que nadie ha mirado y deja ver el mapa de lo que sí se sabe. El termómetro de arriba sigue contando la aplicación entera." />
                    <ui:ToggleSwitch Content="Ver como tabla"
                                     IsChecked="{Binding TableMode}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,0"
                                     ToolTip="Los mismos datos en columnas ordenables. El color nunca es el único canal." />
                    <ui:Button Content="Exportar imagen"
                               Appearance="Secondary"
                               Command="{Binding ExportImageCommand}"
                               ToolTip="Guarda un PNG del mapa con su título, su leyenda y su pie: la diapositiva" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Termómetro: la aplicación entera en una barra. Cuenta SIEMPRE el total, con «solo
             auditadas» puesto o no — un ancla que se mueve con el filtro no ancla nada. -->
        <StackPanel Grid.Row="2" Margin="0,0,18,14"
                    Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="5" Height="24" ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding Thermometer}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:ShareBar />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Brush}" ToolTip="{Binding Tooltip}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding ThermometerCaption}" Style="{StaticResource BlockHint}" />
        </StackPanel>

        <!-- Sin inventario no se dibuja un lienzo vacío: se dice qué falta. -->
        <ui:Card Grid.Row="3" Style="{StaticResource Block}" VerticalAlignment="Top" Margin="0,0,18,14"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Todavía no hay mapa" Style="{StaticResource BlockTitle}" />
                <TextBlock Text="{Binding EmptyReason}" Style="{StaticResource BlockHint}" />
            </StackPanel>
        </ui:Card>

        <!-- ============ NIVEL 1: las tarjetas de módulo ============
             Veintidós tarjetas en vez de 925 celdas. Ocupa la fila estrella y desplaza ella sola:
             el hueco entre los filtros y el mapa al maximizar salía de un treemap de alto fijo
             dentro de una tarjeta que no crecía. -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,18,0">
            <ScrollViewer.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                    <Binding Path="IsEmpty" Converter="{StaticResource InverseBool}" />
                    <Binding Path="TableMode" Converter="{StaticResource InverseBool}" />
                    <Binding Path="IsZoomed" Converter="{StaticResource InverseBool}" />
                </MultiBinding>
            </ScrollViewer.Visibility>
            <StackPanel>
                <TextBlock Text="{Binding PrefixNotice}" Style="{StaticResource BlockHint}"
                           Margin="0,0,0,8"
                           Visibility="{Binding PrefixNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource CardButton}"
                                    ToolTip="{Binding Tooltip}"
                                    Command="{Binding DataContext.OpenModuleCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- La densidad va al BORDE, no de fondo: teñir la tarjeta
                                         entera haría competir el color con todo lo que dice. -->
                                    <Border Grid.Column="0" Width="5" CornerRadius="3,0,0,3"
                                            Background="{Binding Stripe}" />

                                    <StackPanel Grid.Column="1" Margin="11,9,11,10">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Size}" FontSize="11.5" Opacity="0.7"
                                                   Margin="0,3,0,0" />

                                        <!-- Cobertura: aquí vive la honestidad del «no auditado»,
                                             como DATO medido y no como textura que invade el mapa. -->
                                        <Border Margin="0,9,0,0" Height="8" CornerRadius="4" ClipToBounds="True"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <ItemsControl ItemsSource="{Binding CoverageBar}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ShareBar />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Brush}" ToolTip="{Binding Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Text="{Binding CoverageText}" FontSize="11" Opacity="0.7"
                                                   Margin="0,5,0,0" />

                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding DensityText}" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DensityCaption}" FontSize="11" Opacity="0.7"
                                                       VerticalAlignment="Bottom" Margin="6,0,0,2" />
                                        </StackPanel>

                                        <!-- Tira de severidades: los colores de estado de siempre,
                                             que aquí no compiten con la rampa porque están en otra
                                             forma y en otro sitio. -->
                                        <Border Margin="0,8,0,0" Height="6" CornerRadius="3" ClipToBounds="True"
                                                Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Severities}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <controls:ShareBar />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Brush}" ToolTip="{Binding Tooltip}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                        <TextBlock Text="{Binding SeverityText}" FontSize="11" Opacity="0.7"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Legend}" Margin="0,14,0,0"
                              ItemTemplate="{StaticResource LegendEntry}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ NIVEL 2: el treemap del módulo ============
             Fila estrella: el treemap ocupa el alto que queda, a cualquier tamaño de ventana. -->
        <Grid Grid.Row="3" Margin="0,0,18,0">
            <Grid.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                    <Binding Path="IsEmpty" Converter="{StaticResource InverseBool}" />
                    <Binding Path="TableMode" Converter="{StaticResource InverseBool}" />
                    <Binding Path="IsZoomed" />
                </MultiBinding>
            </Grid.Visibility>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <!-- La única animación de la vista: 220 ms de entrada al ampliar, para no
                             perder el contexto espacial. Se apaga con las animaciones del sistema
                             (SystemParameters.ClientAreaAnimation), que es donde el usuario dice
                             que no quiere movimiento. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsZoomed}" Value="True" />
                                <Condition Binding="{Binding AnimationsEnabled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                            From="0.97" To="1" Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                            From="0.97" To="1" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="0.5" CenterY="0.5" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}"
                                Command="{Binding ZoomOutCommand}"
                                Content="{Binding SelectedApp.Name}"
                                ToolTip="Volver a los módulos" />
                        <TextBlock Text=" › " FontSize="15" VerticalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="{Binding ZoomedModule}" Style="{StaticResource BlockTitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ScaleCaption}" Style="{StaticResource BlockHint}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BlockHint}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource BlockHint}" MaxWidth="230"
                           Text="Un clic en una unidad abre sus hallazgos; un doble clic la lleva a auditar." />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Warning}"
                    Visibility="{Binding CoverageWarning, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding CoverageWarning}" FontSize="12" TextWrapping="Wrap" />
            </Border>

            <controls:Treemap Grid.Row="2" Margin="0,12,0,0" MinHeight="220"
                              Groups="{Binding MapGroups}"
                              ClusterFactory="{Binding ClusterFactory}"
                              UnknownFill="{Binding UnknownFill}"
                              SurfaceBrush="{Binding SurfaceBrush}"
                              StrokeBrush="{Binding StrokeBrush}"
                              LabelBrush="{Binding LabelBrush}"
                              MutedBrush="{Binding MutedBrush}"
                              TileCommand="{Binding TileCommand}"
                              ActivateCommand="{Binding ActivateCommand}" />

            <ItemsControl Grid.Row="3" ItemsSource="{Binding Legend}" Margin="0,12,0,10"
                          ItemTemplate="{StaticResource LegendEntry}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>


        <!-- ==================== La tabla equivalente ====================
             UN SOLO SCROLL. La tabla NO vive dentro del ScrollViewer de la página: ocupa el alto
             que queda, y desplaza ella sola. Anidada, salían dos barras solapadas y la rueda no
             sabía a quién obedecer — el patrón de «el hijo cede al padre al llegar al tope» doma
             el síntoma pero no lo quita, así que aquí se quita el anidamiento. -->
        <ui:Card Grid.Row="3" Margin="0,0,18,14" Padding="14,12">
            <ui:Card.Visibility>
                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                    <Binding Path="IsEmpty" Converter="{StaticResource InverseBool}" />
                    <Binding Path="TableMode" />
                </MultiBinding>
            </ui:Card.Visibility>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Las mismas unidades, en columnas" Style="{StaticResource BlockTitle}" />
                    <TextBlock Style="{StaticResource BlockHint}"
                               Text="Pulsa una cabecera para ordenar; púlsala otra vez para invertir. Un clic en el nombre abre sus hallazgos." />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BlockHint}" />
                </StackPanel>

                <!-- Cabecera fija: está FUERA del scroll, así que no hace falta domarla con un
                     sticky. Cada columna se alinea como sus celdas — el desajuste entre una
                     cabecera a la izquierda y un número a la derecha es lo que hacía que la tabla
                     no pareciera una tabla. -->
                <Grid Grid.Row="1" Margin="0,12,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource StripeWidth}" />
                        <ColumnDefinition Width="1.3*" MinWidth="90" />
                        <ColumnDefinition Width="2*" MinWidth="120" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="1.7*" MinWidth="130" />
                        <ColumnDefinition Width="78" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="{Binding HeaderModule}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Module}" />
                    <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="{Binding HeaderUnit}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Unit}" />
                    <Button Grid.Column="3" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderLoc}"
                            ToolTip="Líneas de código de la unidad"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Loc}" />
                    <Button Grid.Column="4" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderCritica}"
                            ToolTip="Críticas activas"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Critica}" />
                    <Button Grid.Column="5" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderAlta}"
                            ToolTip="Altas activas"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Alta}" />
                    <Button Grid.Column="6" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderMedia}"
                            ToolTip="Medias activas"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Media}" />
                    <Button Grid.Column="7" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderBaja}"
                            ToolTip="Bajas activas"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Baja}" />
                    <Button Grid.Column="8" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderDebt}"
                            ToolTip="Suma de pesos de los hallazgos activos: Crítica 10 · Alta 5 · Media 2 · Baja 1"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Debt}" />
                    <Button Grid.Column="9" Style="{StaticResource SortHeaderRight}" Content="{Binding HeaderDensity}"
                            ToolTip="Deuda por cada mil líneas. «—» es desconocida, no cero."
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Density}" />
                    <TextBlock Grid.Column="10" Text="Estado" Style="{StaticResource ColumnHead}" />
                    <TextBlock Grid.Column="11" Text="Acción" Style="{StaticResource ColumnHead}" />
                </Grid>

                <Border Grid.Row="2" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <!-- El ÚNICO scroll de la vista en este modo. Virtualizado: 925 filas. -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource StripeWidth}" />
                                        <ColumnDefinition Width="1.3*" MinWidth="90" />
                                        <ColumnDefinition Width="2*" MinWidth="120" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="1.7*" MinWidth="130" />
                                        <ColumnDefinition Width="78" />
                                    </Grid.ColumnDefinitions>

                                    <!-- La franja de densidad: el mismo color que su celda en el
                                         mapa, o el gris tramado si nadie la ha auditado. -->
                                    <Rectangle Grid.Column="0" Width="5" RadiusX="2.5" RadiusY="2.5"
                                               HorizontalAlignment="Left" Margin="0,3"
                                               Fill="{Binding Stripe}"
                                               ToolTip="{Binding State}" />

                                    <controls:MiddleEllipsisText Grid.Column="1" Text="{Binding Module}"
                                                                 Margin="6,0,8,0" FontSize="12"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="2" Style="{StaticResource RowLink}"
                                            Command="{Binding DataContext.ShowFindingsForCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Source}">
                                        <controls:MiddleEllipsisText Text="{Binding Unit}"
                                                                     FullText="{Binding Path}"
                                                                     FontSize="12"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Button>

                                    <TextBlock Grid.Column="3" Text="{Binding LocText}" Style="{StaticResource Number}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Critica}" Style="{StaticResource Number}" />
                                    <TextBlock Grid.Column="5" Text="{Binding Alta}" Style="{StaticResource Number}" />
                                    <TextBlock Grid.Column="6" Text="{Binding Media}" Style="{StaticResource Number}" />
                                    <TextBlock Grid.Column="7" Text="{Binding Baja}" Style="{StaticResource Number}" />
                                    <TextBlock Grid.Column="8" Text="{Binding Debt}" Style="{StaticResource Number}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="9" Text="{Binding DensityText}" Style="{StaticResource Number}" />

                                    <controls:MiddleEllipsisText Grid.Column="10" Text="{Binding State}"
                                                                 Margin="10,0,8,0" FontSize="12"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                    <Button Grid.Column="11" Style="{StaticResource LinkButton}"
                                            HorizontalContentAlignment="Left"
                                            Content="Auditar"
                                            ToolTip="Abre el inventario con esta unidad marcada"
                                            Command="{Binding DataContext.AuditCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Source}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ItemsControl Grid.Row="4" ItemsSource="{Binding Legend}" Margin="0,12,0,0"
                              ItemTemplate="{StaticResource LegendEntry}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
