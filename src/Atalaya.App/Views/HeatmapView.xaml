<UserControl
    x:Class="Atalaya.App.Views.HeatmapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <UserControl.Resources>

        <Style x:Key="Block" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="BlockHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- El aviso de cobertura NO es decoración: es la frase que impide leer el gris como
             «limpio». Va en su propio recuadro para que no se confunda con la leyenda. -->
        <Style x:Key="Warning" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- La cabecera ordenable de la tabla. Con BasedOn: quien redefine un estilo hereda la
             responsabilidad de todo lo que ese estilo traía (ImplicitStyleTests). -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="LegendEntry">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,6" ToolTip="{Binding Tooltip}">
                <Rectangle Width="22" Height="13" RadiusX="2" RadiusY="2"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasSwatch, Converter={StaticResource BoolToVisibility}}"
                           Fill="{Binding Fill}"
                           Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="{Binding Dotted, Converter={StaticResource DashedToArray}}" />
                <TextBlock Text="{Binding Label}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,18,12">
            <TextBlock Text="Mapa de calor" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource BlockHint}"
                       Text="La estructura de la aplicación: el área de cada celda es su tamaño en líneas y el color, la densidad de deuda. El gris es lo que nadie ha auditado." />
        </StackPanel>

        <!-- Barra de mandos: cambian el significado de todo lo de abajo, así que van arriba. -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Aplicación" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7" Margin="0,0,8,0" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding AppOptions}"
                              SelectedItem="{Binding SelectedApp}"
                              DisplayMemberPath="Name"
                              ToolTip="El mapa es de UNA aplicación: mezclar dos repartiría el área entre códigos que no se comparan" />

                    <TextBlock Text="Color por" VerticalAlignment="Center"
                               FontSize="12" Opacity="0.7" Margin="20,0,8,0" />
                    <ComboBox MinWidth="150"
                              ItemsSource="{Binding MetricOptions}"
                              SelectedItem="{Binding SelectedMetric}"
                              DisplayMemberPath="Label"
                              ToolTip="{Binding SelectedMetric.Hint}" />

                    <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="18,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:ToggleSwitch Content="Ver como tabla"
                                     IsChecked="{Binding TableMode}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,14,0"
                                     ToolTip="Los mismos datos en columnas ordenables. El color nunca es el único canal." />
                    <ui:Button Content="Exportar imagen"
                               Appearance="Secondary"
                               Command="{Binding ExportImageCommand}"
                               ToolTip="Guarda un PNG del mapa con su título, su leyenda y su pie: la diapositiva" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <StackPanel>

                <!-- Sin inventario no se dibuja un lienzo vacío: se dice qué falta. -->
                <ui:Card Style="{StaticResource Block}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Todavía no hay mapa" Style="{StaticResource BlockTitle}" />
                        <TextBlock Text="{Binding EmptyReason}" Style="{StaticResource BlockHint}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                    <!-- ==================== El mapa ==================== -->
                    <ui:Card Style="{StaticResource Block}"
                             Visibility="{Binding TableMode, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <!-- Migas: dónde se está y cómo se vuelve. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource LinkButton}"
                                                Command="{Binding ZoomOutCommand}"
                                                Content="{Binding SelectedApp.Name}"
                                                Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="Volver a la aplicación entera" />
                                        <TextBlock Text=" › " FontSize="15" VerticalAlignment="Center" Opacity="0.6"
                                                   Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding ZoomedModule}" Style="{StaticResource BlockTitle}"
                                                   Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="Módulos y unidades" Style="{StaticResource BlockTitle}"
                                                   Visibility="{Binding IsZoomed, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ScaleCaption}" Style="{StaticResource BlockHint}" />
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BlockHint}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Style="{StaticResource BlockHint}" MaxWidth="230"
                                           Text="Un clic amplía el módulo; ampliado, un clic abre los hallazgos de la unidad y un doble clic la lleva a auditar." />
                            </Grid>

                            <Border Style="{StaticResource Warning}"
                                    Visibility="{Binding CoverageWarning, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding CoverageWarning}" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <!-- Alto fijo: el treemap reparte el área que se le da, y dentro de un
                                 StackPanel sin alto pedido se quedaría en cero. -->
                            <controls:Treemap Height="520" Margin="0,12,0,0"
                                              Groups="{Binding Groups}"
                                              UnknownFill="{Binding UnknownFill}"
                                              SurfaceBrush="{Binding SurfaceBrush}"
                                              StrokeBrush="{Binding StrokeBrush}"
                                              LabelBrush="{Binding LabelBrush}"
                                              MutedBrush="{Binding MutedBrush}"
                                              TileCommand="{Binding TileCommand}"
                                              ActivateCommand="{Binding ActivateCommand}" />

                            <ItemsControl ItemsSource="{Binding Legend}" Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource LegendEntry}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>

                    <!-- ==================== La tabla equivalente ==================== -->
                    <ui:Card Style="{StaticResource Block}"
                             Visibility="{Binding TableMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Las mismas unidades, en columnas" Style="{StaticResource BlockTitle}" />
                            <TextBlock Style="{StaticResource BlockHint}"
                                       Text="Pulsa una cabecera para ordenar; púlsala otra vez para invertir. Un clic en una fila abre sus hallazgos." />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource BlockHint}" />

                            <Grid Margin="0,12,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="2.2*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource SortHeader}" Content="{Binding HeaderModule}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Module}" />
                                <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="{Binding HeaderUnit}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Unit}" />
                                <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="{Binding HeaderLoc}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Loc}" />
                                <Button Grid.Column="3" Style="{StaticResource SortHeader}" Content="{Binding HeaderCritica}"
                                        ToolTip="Críticas activas"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Critica}" />
                                <Button Grid.Column="4" Style="{StaticResource SortHeader}" Content="{Binding HeaderAlta}"
                                        ToolTip="Altas activas"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Alta}" />
                                <Button Grid.Column="5" Style="{StaticResource SortHeader}" Content="{Binding HeaderMedia}"
                                        ToolTip="Medias activas"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Media}" />
                                <Button Grid.Column="6" Style="{StaticResource SortHeader}" Content="{Binding HeaderBaja}"
                                        ToolTip="Bajas activas"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Baja}" />
                                <Button Grid.Column="7" Style="{StaticResource SortHeader}" Content="{Binding HeaderDebt}"
                                        ToolTip="Suma de pesos de los hallazgos activos"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Debt}" />
                                <Button Grid.Column="8" Style="{StaticResource SortHeader}" Content="{Binding HeaderDensity}"
                                        ToolTip="Deuda por cada mil líneas. «—» es desconocida, no cero."
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:HeatSort.Density}" />
                                <TextBlock Grid.Column="9" Text="Estado" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock Grid.Column="10" Text="Acción" FontSize="11" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                            <ItemsControl ItemsSource="{Binding Rows}" MaxHeight="560">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="86" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Module}" Style="{StaticResource Cell}"
                                                       Margin="4,0,6,0" />
                                            <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="{Binding Unit}"
                                                    ToolTip="{Binding Path}"
                                                    Command="{Binding DataContext.ShowFindingsForCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Source}" />
                                            <TextBlock Grid.Column="2" Text="{Binding LocText}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Critica}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Alta}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="5" Text="{Binding Media}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="6" Text="{Binding Baja}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="7" Text="{Binding Debt}" Style="{StaticResource Cell}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="8" Text="{Binding DensityText}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="9" Text="{Binding State}" Style="{StaticResource Cell}"
                                                       Margin="4,0,0,0" Opacity="0.8" />
                                            <Button Grid.Column="10" Style="{StaticResource LinkButton}"
                                                    HorizontalContentAlignment="Left"
                                                    Content="Auditar"
                                                    ToolTip="Abre el inventario con esta unidad marcada"
                                                    Command="{Binding DataContext.AuditCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Source}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Legend}" Margin="0,12,0,0"
                                          ItemTemplate="{StaticResource LegendEntry}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
