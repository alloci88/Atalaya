<UserControl
    x:Class="Atalaya.App.Views.FindingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels">

    <!--
        HALLAZGOS (F26 Parte B, D-973).

        Lo que había: cuatro desplegables seguidos que ponían «Todas · Todas · Activos · Todas» sin
        decir qué filtraban, dos checkboxes sueltos detrás, y una lista donde la gravedad era una
        pastilla de color plano con letra blanca —el mismo peso visual para una crítica que para una
        baja— y el título a 13,5 px.

        Lo que hay: cada filtro con su nombre delante, banda de gravedad al borde de la fila para
        poder recorrer la lista sin leer, pastilla con el color de la paleta y densidad a la escala
        del sistema.
    -->

    <UserControl.Resources>

        <!-- La fila entera es el enlace al detalle (F5.4): sin botón «Ver», hover sutil. -->
        <Style x:Key="RowLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="{StaticResource Border.Bottom}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera -->
        <Grid Grid.Row="0" Margin="{StaticResource Pad.M.Bottom}">
            <StackPanel>
                <TextBlock Text="Hallazgos" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding ResultsSummary}"
                           Style="{StaticResource Text.Small}"
                           Margin="{StaticResource Pad.XXS.Top}" />
            </StackPanel>

            <Button Content="{Binding ToggleAllLabel}"
                    Command="{Binding ToggleAllGroupsCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Con todo plegado, las cabeceras son el resumen: clase y conteo por gravedad."
                    Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ==================================================== La barra de filtros

             Cada filtro DICE QUÉ FILTRA. Antes eran cuatro desplegables seguidos que ponían
             «Todas · Todas · Activos · Todas», y había que abrirlos para saber cuál era cuál.
        -->
        <Border Grid.Row="1" Style="{StaticResource Panel}"
                Padding="{StaticResource Pad.S}"
                Margin="{StaticResource Pad.M.Bottom}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Limpiar filtros"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource Button.Link}"
                        Margin="{StaticResource Pad.S.Left}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />

                <WrapPanel Orientation="Horizontal">
                    <!-- `ui:TextBox` y no el de WPF: es el que trae texto de sugerencia, y una caja
                         de búsqueda vacía sin una palabra dentro no dice qué se busca en ella. Los
                         tamaños siguen saliendo de la escala. -->
                    <ui:TextBox PlaceholderText="Buscar…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Busca en el título del hallazgo, en la regla que lo detectó y en la ruta del fichero."
                                FontSize="{StaticResource FontSize.Body}"
                                Padding="{StaticResource Pad.Field}"
                                Width="240" Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Aplicación:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}" />
                        <ComboBox ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedApp}"
                                  DisplayMemberPath="Label" MinWidth="150" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Gravedad:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}" />
                        <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}"
                                  DisplayMemberPath="Label" MinWidth="110" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Estado:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}" />
                        <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}"
                                  DisplayMemberPath="Label" MinWidth="120" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Temática:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="Label" MinWidth="140" VerticalAlignment="Center"
                                  ToolTip="Temática del ciclo en que se detectó" />
                    </StackPanel>

                    <CheckBox Content="Por revisar"
                              IsChecked="{Binding OnlyNeedsReview}"
                              VerticalAlignment="Center" Margin="{StaticResource Pad.S}"
                              ToolTip="Hallazgos que la última comprobación no pudo confirmar, o cuya ubicación en el código se perdió." />

                    <CheckBox IsChecked="{Binding OnlyDisputed}"
                              VerticalAlignment="Center" Margin="{StaticResource Pad.XXS}"
                              ToolTip="Hallazgos que un auditor sostiene que nunca fueron un defecto. Los decide una persona.">
                        <StackPanel Orientation="Horizontal">
                            <!-- U+FE0E: presentación de TEXTO. Sin él la balanza sale como emoji a color. -->
                            <TextBlock Text="⚖︎" Margin="{StaticResource Pad.XXS}" />
                            <TextBlock Text="Disputados" />
                        </StackPanel>
                    </CheckBox>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================== La lista y la vista rápida -->
        <Grid Grid.Row="2" x:Name="Split" SizeChanged="OnSplitSizeChanged"
              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Panel}">
            <ListBox ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="{StaticResource Pad.Zero}"
                     Padding="{StaticResource Pad.Zero}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Margin" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.Resources>

                    <!-- · Cabecera de grupo: el fichero, su ruta, y los recuentos a la DERECHA · -->
                    <DataTemplate DataType="{x:Type vm:FindingGroupHeader}">
                        <Button Style="{StaticResource RowLink}"
                                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding CountLabel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding ExpandGlyph}"
                                           Width="18"
                                           Style="{StaticResource Text.Meta}"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}"
                                               Style="{StaticResource Text.Lead}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- La ruta en monoespaciado: es una ruta, y se lee como tal. -->
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource Text.Mono}"
                                               Margin="{StaticResource Pad.S.Left}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding Chips}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill.Sev}"
                                                    Margin="{StaticResource Pad.XXS}">
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource Pill.Sev.Text}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Button>
                    </DataTemplate>

                    <!-- · Fila de hallazgo: banda de gravedad, pastilla, título y metadatos · -->
                    <DataTemplate DataType="{x:Type vm:FindingRow}">
                        <Button Style="{StaticResource RowLink}"
                                Command="{Binding DataContext.ActivateRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding UnitPath}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- La banda: recorrer cien hallazgos y ver dónde están las
                                     críticas sin leer una palabra. -->
                                <Border Grid.Column="0" Style="{StaticResource Band.Sev}"
                                        Margin="{StaticResource Pad.XXS}" />

                                <Border Grid.Column="1" Style="{StaticResource Pill.Sev}"
                                        Margin="{StaticResource Pad.XS}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                               Style="{StaticResource Pill.Sev.Text}" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text}" />
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS.Top}">
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Meta}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAssignee, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="·" Style="{StaticResource Text.Meta}"
                                                       Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Assignee}" Style="{StaticResource Text.Meta}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="·" Style="{StaticResource Text.Meta}"
                                                   Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />
                                        <Ellipse Width="6" Height="6" Margin="{StaticResource Pad.XXS}"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Warning.Fill}"
                                                 ToolTip="Sin confirmar por encima del umbral de frescura."
                                                 Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding FreshnessLabel}" Style="{StaticResource Text.Meta}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource Pad.S.Left}">
                                    <Border Style="{StaticResource Pill}"
                                            Background="{DynamicResource Brush.Warning.Soft}"
                                            Margin="{StaticResource Pad.XXS}"
                                            ToolTip="{Binding DisputeLabel}"
                                            Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding DisputeBadge}" Style="{StaticResource Pill.Text}"
                                                   Foreground="{DynamicResource Brush.Warning.Ink}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}"
                                            Margin="{StaticResource Pad.XXS}"
                                            ToolTip="La última comprobación no pudo confirmarlo, o su ubicación en el código se perdió."
                                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Por revisar" Style="{StaticResource Pill.Text}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>

                </ListBox.Resources>
            </ListBox>
        </Border>

            <!-- ============================================== LA VISTA RÁPIDA (D-974)

                 Gravedad, título, regla, ubicación con su código, descripción, recomendación y las
                 acciones frecuentes con su razón al lado. El historial y la gobernanza NO están
                 aquí: son formularios, y un formulario en una columna de 460 px se rellena peor
                 que en su página. Para eso está «Abrir ficha».

                 En estrecho el panel desaparece y la fila vuelve a abrir la ficha entera, que es lo
                 que hacía siempre: reorganizar, no encoger (principio 1).
            -->
            <Border Grid.Column="1"
                    Style="{StaticResource Card}"
                    Width="{StaticResource Preview.Width}"
                    Margin="{StaticResource Pad.M.Left}"
                    Visibility="{Binding Wide, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <!-- Sin nada señalado: se dice qué hacer, no se deja un hueco gris. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                c:Stack.Gap="{StaticResource Space.S}"
                                Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                        <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Findings}"
                              Width="28" Height="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Elige un hallazgo para verlo aquí"
                                   Style="{StaticResource Text.Small}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding Preview}"
                                  Visibility="{Binding DataContext.HasPreview,
                                      RelativeSource={RelativeSource AncestorType=UserControl},
                                      Converter={StaticResource BoolToVisibility}}">
                        <StackPanel c:Stack.Gap="{StaticResource Space.M}">

                            <!-- Gravedad, identificador y regla -->
                            <StackPanel c:Stack.Gap="{StaticResource Space.XS}">
                                <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                    <Border Style="{StaticResource Pill.Sev}"
                                            DataContext="{Binding Finding}">
                                        <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                                   Style="{StaticResource Pill.Sev.Text}" />
                                    </Border>
                                    <TextBlock Text="{Binding Finding.DisplayId}" Style="{StaticResource Text.Mono}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RuleId}" Style="{StaticResource Text.Meta}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding Finding.Title}" Style="{StaticResource Text.H3}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SnippetPath}" Style="{StaticResource Text.Mono}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- LAS ACCIONES FRECUENTES, con la razón al lado del que no se puede
                                 pulsar (principio 4). El verde es la que adelanta trabajo. -->
                            <StackPanel c:Stack.Gap="{StaticResource Space.XS}">
                                <Button Content="Arreglar con agente"
                                        Command="{Binding StartAssistedFixCommand}"
                                        IsEnabled="{Binding CanStartFix}"
                                        ToolTip="{Binding AssistedFixTooltip}"
                                        Style="{StaticResource Button.Success}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding ShowAssistedFix, Converter={StaticResource BoolToVisibility}}" />

                                <Border Style="{StaticResource Reason.Chip}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding AssistedFixBlock, Converter={StaticResource NotEmptyToVisibility}}">
                                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                        <Path Style="{StaticResource Icon.Small}" Data="{x:Static c:Icons.Warning}"
                                              
                                              Stroke="{DynamicResource Brush.Warning.Ink}" />
                                        <TextBlock Text="{Binding AssistedFixBlock}"
                                                   Style="{StaticResource Reason.Text}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Content="Abrir en el editor"
                                        Command="{Binding OpenInEditorCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Content="Verificar ahora"
                                        Command="{Binding VerifyNowCommand}"
                                        HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Lo que NO cabe aquí, y adónde ir a buscarlo. -->
                            <Button Content="Abrir ficha  ·  historial y gobernanza"
                                    Command="{Binding DataContext.OpenSelectedCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource Button.Primary}"
                                    HorizontalAlignment="Stretch" />

                            <!-- El código donde está. Con su PROPIO desplazamiento, y con tope de
                                 alto: el código no se parte —una línea partida deja de ser código—
                                 así que se desplaza dentro de su caja, y no empuja fuera de la
                                 pantalla lo que hay debajo, que son las acciones (principio 8). -->
                            <Border Style="{StaticResource Panel}"
                                    Background="{DynamicResource Brush.Code.Surface}"
                                    Padding="{StaticResource Pad.S}">
                                <StackPanel c:Stack.Gap="{StaticResource Space.XS}">
                                    <TextBlock Text="{Binding SnippetCaption}" Style="{StaticResource Text.Meta}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ScrollViewer MaxHeight="{StaticResource Preview.CodeHeight}"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Snippet}" Style="{StaticResource Text.Mono}"
                                                   Foreground="{DynamicResource Brush.Code.Ink}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <StackPanel c:Stack.Gap="{StaticResource Space.XXS}">
                                <TextBlock Text="Descripción" Style="{StaticResource Text.Small}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding Finding.Description}" Style="{StaticResource Text.Body}" />
                            </StackPanel>

                            <StackPanel c:Stack.Gap="{StaticResource Space.XXS}">
                                <TextBlock Text="Recomendación" Style="{StaticResource Text.Small}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text}" />
                                <TextBlock Text="{Binding Finding.Recommendation}" Style="{StaticResource Text.Body}" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================================================== Sin resultados -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" c:Stack.Gap="{StaticResource Space.S}"
                        Margin="{StaticResource Pad.XL}">
                <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Findings}"
                      Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock Text="Sin hallazgos con estos filtros"
                           Style="{StaticResource Text.H3}" HorizontalAlignment="Center" />
                <Button Content="Limpiar filtros"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
