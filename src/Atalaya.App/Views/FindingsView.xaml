<UserControl
    x:Class="Atalaya.App.Views.FindingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels">

    <!--
        HALLAZGOS (F26 Parte B, D-973).

        Lo que había: cuatro desplegables seguidos que ponían «Todas · Todas · Activos · Todas» sin
        decir qué filtraban, dos checkboxes sueltos detrás, y una lista donde la gravedad era una
        pastilla de color plano con letra blanca —el mismo peso visual para una crítica que para una
        baja— y el título a 13,5 px.

        Lo que hay: cada filtro con su nombre delante, banda de gravedad al borde de la fila para
        poder recorrer la lista sin leer, pastilla con el color de la paleta y densidad a la escala
        del sistema.
    -->

    <UserControl.Resources>

        <!-- La fila entera es el enlace al detalle (F5.4): sin botón «Ver», hover sutil. -->
        <Style x:Key="RowLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="{StaticResource Border.Bottom}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera -->
        <Grid Grid.Row="0" Margin="{StaticResource Pad.M.Bottom}">
            <StackPanel>
                <TextBlock Text="Hallazgos" Style="{StaticResource Text.H1}" />
                <TextBlock Text="{Binding ResultsSummary}"
                           Style="{StaticResource Text.Small}"
                           Margin="{StaticResource Pad.XXS.Top}" />
            </StackPanel>

            <Button Content="{Binding ToggleAllLabel}"
                    Command="{Binding ToggleAllGroupsCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Con todo plegado, las cabeceras son el resumen: clase y conteo por gravedad."
                    Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ==================================================== La barra de filtros

             Cada filtro DICE QUÉ FILTRA. Antes eran cuatro desplegables seguidos que ponían
             «Todas · Todas · Activos · Todas», y había que abrirlos para saber cuál era cuál.
        -->
        <Border Grid.Row="1" Style="{StaticResource Panel}"
                Padding="{StaticResource Pad.S}"
                Margin="{StaticResource Pad.M.Bottom}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Limpiar filtros"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource Button.Link}"
                        Margin="{StaticResource Pad.S.Left}"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />

                <WrapPanel Orientation="Horizontal">
                    <!-- `ui:TextBox` y no el de WPF: es el que trae texto de sugerencia, y una caja
                         de búsqueda vacía sin una palabra dentro no dice qué se busca en ella. Los
                         tamaños siguen saliendo de la escala. -->
                    <!-- CADA CONTROL QUE SE ENFOCA DICE SU NOMBRE (UI-0016). El buscador y los
                         cuatro combos llegaban SIN NOMBRE al árbol de accesibilidad: un lector de
                         pantalla anunciaba «edición» y «cuadro combinado» cinco veces seguidas. El
                         rótulo está pintado al lado, pero un rótulo suelto no es el nombre de nada;
                         un texto de sugerencia tampoco. -->
                    <ui:TextBox PlaceholderText="Buscar…"
                                AutomationProperties.Name="Buscar en los hallazgos"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Busca en el título del hallazgo, en la regla que lo detectó y en la ruta del fichero."
                                FontSize="{StaticResource FontSize.Body}"
                                Padding="{StaticResource Pad.Field}"
                                Width="240" Margin="{StaticResource Pad.BarItem}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Aplicación:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                        <ComboBox ItemsSource="{Binding AppOptions}" SelectedItem="{Binding SelectedApp}"
                                  AutomationProperties.Name="Filtrar por aplicación"
                                  DisplayMemberPath="Label" MinWidth="150" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Gravedad:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                        <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}"
                                  AutomationProperties.Name="Filtrar por gravedad"
                                  DisplayMemberPath="Label" MinWidth="110" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Estado:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                        <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}"
                                  AutomationProperties.Name="Filtrar por estado"
                                  DisplayMemberPath="Label" MinWidth="120" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                VerticalAlignment="Center">
                        <TextBlock Text="Temática:" Style="{StaticResource Text.Small}"
                                   VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                  AutomationProperties.Name="Filtrar por temática"
                                  DisplayMemberPath="Label" MinWidth="140" VerticalAlignment="Center"
                                  ToolTip="Temática del ciclo en que se detectó" />
                    </StackPanel>

                    <!-- `Padding` a cero y `MinWidth` a cero en las DOS casillas (D-984). El
                         CheckBox de la librería trae relleno propio a la derecha del rótulo, así
                         que su caja acaba bastante después de su última letra: con el mismo margen
                         que el resto de la barra, el hueco medido entre las dos casillas era de 37
                         px y el de los demás de 16. El margen ya lo pone la barra; lo que sobra es
                         el relleno de un control que no sabe dónde está. -->
                    <CheckBox Content="Por revisar"
                              IsChecked="{Binding OnlyNeedsReview}"
                              VerticalAlignment="Center" Margin="{StaticResource Pad.BarItem}"
                              Padding="{StaticResource Pad.Zero}" MinWidth="0"
                              ToolTip="Hallazgos que la última comprobación no pudo confirmar, o cuya ubicación en el código se perdió." />

                    <!-- UNA SOLA LÍNEA DE TEXTO, como «Por revisar».

                         Era un StackPanel con la balanza y la palabra en dos TextBlock, cada uno
                         con su alineación y su margen. Eso son tres piezas donde «Por revisar»
                         tiene una, y se veía: la casilla quedaba despegada de su contenido y la
                         balanza flotaba entre las dos. Con un solo TextBlock la casilla tiene
                         enfrente lo mismo que en la otra —texto— así que la plantilla del
                         CheckBox los separa igual, y el espacio entre la balanza y la palabra lo
                         pone la tipografía, que es quien sabe.

                         U+FE0E: presentación de TEXTO. Sin él la balanza sale como emoji a color. -->
                    <CheckBox Content="⚖︎ Disputados"
                              IsChecked="{Binding OnlyDisputed}"
                              VerticalAlignment="Center" Margin="{StaticResource Pad.BarItem}"
                              Padding="{StaticResource Pad.Zero}" MinWidth="0"
                              ToolTip="Hallazgos que un auditor sostiene que nunca fueron un defecto. Los decide una persona." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================== La lista

             Ocupa el ancho ENTERO y pulsar una fila abre la ficha completa. Hubo una vista
             rápida a la derecha (D-974); se probó en el dist y se retiró (D-981): el detalle
             se lee mejor en su página que en una columna de 460 px.
        -->
        <Border Grid.Row="2" Style="{StaticResource Panel}"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <ListBox ItemsSource="{Binding Items}"
                     Background="Transparent"
                     BorderThickness="{StaticResource Pad.Zero}"
                     Padding="{StaticResource Pad.Zero}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Margin" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.Resources>

                    <!-- · Cabecera de grupo: el fichero, su ruta, y los recuentos a la DERECHA · -->
                    <DataTemplate DataType="{x:Type vm:FindingGroupHeader}">
                        <Button Style="{StaticResource RowLink}"
                                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Subtitle}"
                                ToolTip="{Binding CountLabel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding ExpandGlyph}"
                                           Width="18"
                                           Style="{StaticResource Text.Meta}"
                                           VerticalAlignment="Center" />

                                <!-- REJILLA Y NO `StackPanel` HORIZONTAL (P-01): un StackPanel
                                     horizontal mide a sus hijos con ancho infinito, así que el
                                     recorte no llegaba a activarse nunca y la ruta se salía por el
                                     borde. Con una columna estrella, `PathText` acorta por el MEDIO
                                     y conserva el nombre del fichero, que es lo que identifica. -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                               Style="{StaticResource Text.Lead}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- La ruta en monoespaciado: es una ruta, y se lee como tal. -->
                                    <c:PathText Grid.Column="1" Full="{Binding Subtitle}"
                                                Style="{StaticResource Text.Path}"
                                                FontFamily="{StaticResource Font.Mono}"
                                                FontSize="{StaticResource FontSize.Small}"
                                                Foreground="{DynamicResource Brush.TextMuted}"
                                                Margin="{StaticResource Pad.S.Left}"
                                                VerticalAlignment="Center"
                                                ToolTip="{Binding Subtitle}" />
                                </Grid>

                                <ItemsControl Grid.Column="2"
                                              ItemsSource="{Binding Chips}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Pill.Sev}"
                                                    Margin="{StaticResource Pad.XXS}">
                                                <TextBlock Text="{Binding Label}"
                                                           Style="{StaticResource Pill.Sev.Text}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Button>
                    </DataTemplate>

                    <!-- · Fila de hallazgo: banda de gravedad, pastilla, título y metadatos · -->
                    <DataTemplate DataType="{x:Type vm:FindingRow}">
                        <!-- La fila SE LLAMA como el hallazgo que abre (UI-0016): las 111 llegaban
                             sin nombre y se anunciaban todas igual. -->
                        <Button Style="{StaticResource RowLink}"
                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}"
                                ToolTip="{Binding UnitPath}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- La banda: recorrer cien hallazgos y ver dónde están las
                                     críticas sin leer una palabra. -->
                                <Border Grid.Column="0" Style="{StaticResource Band.Sev}"
                                        Margin="{StaticResource Pad.XXS}" />

                                <Border Grid.Column="1" Style="{StaticResource Pill.Sev}"
                                        Margin="{StaticResource Pad.XS}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                               Style="{StaticResource Pill.Sev.Text}" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text}" />
                                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS.Top}">
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Meta}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding HasAssignee, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="·" Style="{StaticResource Text.Meta}"
                                                       Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Assignee}" Style="{StaticResource Text.Meta}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="·" Style="{StaticResource Text.Meta}"
                                                   Margin="{StaticResource Pad.XXS}" VerticalAlignment="Center" />
                                        <Ellipse Width="6" Height="6" Margin="{StaticResource Pad.XXS}"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource Brush.Warning.Fill}"
                                                 ToolTip="Sin confirmar por encima del umbral de frescura."
                                                 Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding FreshnessLabel}" Style="{StaticResource Text.Meta}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="{StaticResource Pad.S.Left}">
                                    <Border Style="{StaticResource Pill}"
                                            Background="{DynamicResource Brush.Warning.Soft}"
                                            Margin="{StaticResource Pad.XXS}"
                                            ToolTip="{Binding DisputeLabel}"
                                            Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding DisputeBadge}" Style="{StaticResource Pill.Text}"
                                                   Foreground="{DynamicResource Brush.Warning.Ink}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}"
                                            Margin="{StaticResource Pad.XXS}"
                                            ToolTip="La última comprobación no pudo confirmarlo, o su ubicación en el código se perdió."
                                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Por revisar" Style="{StaticResource Pill.Text}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>

                </ListBox.Resources>
            </ListBox>
        </Border>

        <!-- ==================================================== Sin resultados -->
        <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" c:Stack.Gap="{StaticResource Space.S}"
                        Margin="{StaticResource Pad.XL}">
                <Path Style="{StaticResource Icon}" Data="{x:Static c:Icons.Findings}"
                      Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock Text="Sin hallazgos con estos filtros"
                           Style="{StaticResource Text.H3}" HorizontalAlignment="Center" />
                <Button Content="Limpiar filtros"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
