<ui:FluentWindow
    x:Class="Atalaya.App.Views.FactoryResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Restablecimiento de fábrica"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource Dialog}"
    ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource Brush.Bg}">
        <!-- EL DIÁLOGO PINTA SU FONDO (UI-0013). `FluentWindow` aplica su propio telón por
             debajo —`#FAFAFA` en claro, `#202020` en oscuro, los colores de fábrica de
             WPF-UI— y `MainWindow` lo tapa desde F26 §A justamente por eso; ninguno de los
             nueve diálogos lo hacía, así que abrir uno enseñaba otro programa encima de una
             aplicación crema. Y `PaletteContrastTests` pasaba en verde midiendo contra una
             superficie que la aplicación nunca declara.

             Y sus botones son los cuatro del sistema (UI-0014): el primario era el acento de
             Windows —`#1E9BFA`/`#0071C7`— y no el azul de la casa, y el botón que confirma un
             borrado irreversible no puede ser de otro color que el de Atalaya. El macizo de
             peligro se queda AQUÍ y solo aquí (UI-0039): destruir es lo que se ha venido a
             hacer a un diálogo de confirmación. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Style="{StaticResource Dialog.TitleBar}" Grid.Row="0" Title="Restablecimiento de fábrica" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Dialog}">
            <TextBlock
                Text="Esto borra el trabajo de TODO el equipo"
                FontSize="{StaticResource FontSize.Lead}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.Danger.Ink}"
                TextWrapping="Wrap" />

            <Border Style="{StaticResource Notice.Danger}" Margin="{StaticResource Pad.S.Top}">
                <StackPanel>
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TeamWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="{StaticResource Pad.XS.Top}" />
                    <TextBlock Text="{Binding LocalWarning}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" />
                    <TextBlock Text="{Binding Reassurance}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextMuted}" FontSize="{StaticResource FontSize.Small}" Margin="{StaticResource Pad.XS.Top}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Prompt}" Margin="{StaticResource Pad.M.Top}" TextWrapping="Wrap" />
            <ui:TextBox
                x:Name="WordBox"
                Text="{Binding TypedWord, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="RESET" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pad.M.Top}">
                <Button Content="Cancelar" Click="OnCancel" Margin="{StaticResource Pad.XS.Right}" />
                <Button
                    Content="Restablecer de fábrica"
                    Click="OnConfirm"
                    IsEnabled="{Binding CanReset}" Style="{StaticResource Button.DangerSolid}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
