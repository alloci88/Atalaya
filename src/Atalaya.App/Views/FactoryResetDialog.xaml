<ui:FluentWindow
    x:Class="Atalaya.App.Views.FactoryResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Restablecimiento de fábrica"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Restablecimiento de fábrica" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,20">
            <TextBlock
                Text="Esto borra el trabajo de TODO el equipo"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="#E05050"
                TextWrapping="Wrap" />

            <Border Background="#22D13A3A" BorderBrush="#55D13A3A" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TeamWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LocalWarning}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Reassurance}" TextWrapping="Wrap"
                               Opacity="0.75" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Prompt}" Margin="0,16,0,6" TextWrapping="Wrap" />
            <ui:TextBox
                x:Name="WordBox"
                Text="{Binding TypedWord, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="RESET" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cancelar" Click="OnCancel" Appearance="Secondary" Margin="0,0,8,0" />
                <ui:Button
                    Content="Restablecer de fábrica"
                    Click="OnConfirm"
                    Appearance="Danger"
                    IsEnabled="{Binding CanReset}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
