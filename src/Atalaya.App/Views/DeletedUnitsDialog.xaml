<ui:FluentWindow
    x:Class="Atalaya.App.Views.DeletedUnitsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Unidades que ya no existen"
    Width="760"
    Height="560"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource Dialog}"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource Brush.Bg}">
        <!-- EL DIÁLOGO PINTA SU FONDO (UI-0013). `FluentWindow` aplica su propio telón por
             debajo —`#FAFAFA` en claro, `#202020` en oscuro, los colores de fábrica de
             WPF-UI— y `MainWindow` lo tapa desde F26 §A justamente por eso; ninguno de los
             nueve diálogos lo hacía, así que abrir uno enseñaba otro programa encima de una
             aplicación crema. Y `PaletteContrastTests` pasaba en verde midiendo contra una
             superficie que la aplicación nunca declara.

             Y sus botones son los cuatro del sistema (UI-0014): el primario era el acento de
             Windows —`#1E9BFA`/`#0071C7`— y no el azul de la casa, y el botón que confirma un
             borrado irreversible no puede ser de otro color que el de Atalaya. El macizo de
             peligro se queda AQUÍ y solo aquí (UI-0039): destruir es lo que se ha venido a
             hacer a un diálogo de confirmación. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}" ShowMaximize="False" ShowMinimize="False" Grid.Row="0" Title="Unidades que ya no existen" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.DialogHead}">
            <TextBlock Text="{Binding Title}" FontSize="{StaticResource FontSize.Lead}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Margin="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Small}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Hallazgos activos cuyo fichero ya no está en el repositorio. No se pueden verificar —no queda nada que mirar— y no se resuelven solos: sin una decisión tuya se quedan activos para siempre. Ojo con el fichero troceado: sale como borrado más unidades nuevas, y coserlo a ojo sería inventar." />
            <TextBlock Text="Ningún hallazgo activo se ha quedado sin código."
                       Margin="{StaticResource Pad.M.Top}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="{StaticResource Pad.DialogList}" VerticalScrollBarVisibility="Auto" Padding="{StaticResource Pad.XS.Right}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.XS.Bottom}"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Top" Margin="{StaticResource Pad.XS.Right}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Alias, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding UnitPath}" Margin="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Small}"
                                               TextWrapping="Wrap" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <!-- La evidencia, escrita. Cuando no se localiza el commit, lo
                                         dice: una evidencia ausente no se sustituye por una frase
                                         que suene a que la hay. -->
                                    <TextBlock Text="{Binding Evidence}" Margin="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Small}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pad.DialogActions}">
            <Button Content="Marcar todo" Command="{Binding SelectAllCommand}" Margin="{StaticResource Pad.XS.Right}" />
            <Button Content="Resolver por código eliminado"
                       Command="{Binding ResolveSelectedCommand}" Margin="{StaticResource Pad.XS.Right}"
                       ToolTip="Resuelve los marcados con tu nombre y, como evidencia, el commit que borró el fichero. Es una decisión tuya: la aplicación nunca la toma sola." Style="{StaticResource Button.Primary}" />
            <Button Content="Cerrar" Click="OnClose" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
