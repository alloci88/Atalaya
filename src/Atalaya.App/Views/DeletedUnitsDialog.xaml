<ui:FluentWindow
    x:Class="Atalaya.App.Views.DeletedUnitsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Unidades que ya no existen"
    Width="760"
    Height="560"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Unidades que ya no existen" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,0">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Hallazgos activos cuyo fichero ya no está en el repositorio. No se pueden verificar —no queda nada que mirar— y no se resuelven solos: sin una decisión tuya se quedan activos para siempre. Ojo con el fichero troceado: sale como borrado más unidades nuevas, y coserlo a ojo sería inventar." />
            <TextBlock Text="Ningún hallazgo activo se ha quedado sin código."
                       Margin="0,14,0,0" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="22,12,14,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Top" Margin="0,1,8,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"><Run Text="{Binding Alias, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding UnitPath}" Margin="0,4,0,0" FontSize="12"
                                               TextWrapping="Wrap" FontFamily="Consolas"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <!-- La evidencia, escrita. Cuando no se localiza el commit, lo
                                         dice: una evidencia ausente no se sustituye por una frase
                                         que suene a que la hay. -->
                                    <TextBlock Text="{Binding Evidence}" Margin="0,4,0,0" FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,12,22,18">
            <ui:Button Content="Marcar todo" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
            <ui:Button Content="Resolver por código eliminado"
                       Command="{Binding ResolveSelectedCommand}"
                       Appearance="Primary" Margin="0,0,8,0"
                       ToolTip="Resuelve los marcados con tu nombre y, como evidencia, el commit que borró el fichero. Es una decisión tuya: la aplicación nunca la toma sola." />
            <ui:Button Content="Cerrar" Click="OnClose" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
