<ui:FluentWindow
    x:Class="Atalaya.App.Views.ExcludeRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Excluir regla"
    Width="540"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Excluir regla" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,20">
            <TextBlock Text="{Binding Question}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

            <Border CornerRadius="6" Padding="12,10" Margin="0,12,0,0"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RuleId}" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding YesExplanation}" TextWrapping="Wrap" Margin="0,14,0,0"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{Binding NoExplanation}" TextWrapping="Wrap" Margin="0,4,0,0"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cancelar" Click="OnCancel" Appearance="Secondary" Margin="0,0,8,8" />
                <ui:Button Content="No, solo prevenir futuros" Click="OnExcludeOnly" Margin="0,0,8,8" />
                <ui:Button Content="Sí, silenciarlos también" Click="OnExcludeAndSilence"
                           Appearance="Primary" Margin="0,0,0,8" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
