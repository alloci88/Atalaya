<UserControl
    x:Class="Atalaya.App.Views.SessionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls">
    <Grid>
        <!-- BUGFIX-CUOTA: el aviso de error tiene FILA PROPIA. Vivia en la fila 1, la misma que el
             cuerpo de tres columnas, asi que los dos se pintaban uno encima del otro: el cuerpo se
             declara despues y ganaba el Z-order, dejando el mensaje de error medio tapado y casi
             ilegible. Un aviso que hay que leer no puede depender del orden de declaracion. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera. Mismo reparto que el arreglo asistido, y por el mismo motivo: dos
             StackPanel en un Grid sin columnas no reparten espacio, se superponen. Aquí la
             izquierda es corta y no se había notado todavía. -->
        <c:PageHeader Grid.Row="0" Margin="{StaticResource Pad.S.Bottom}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <!-- La que encoge, acotada por los dos lados. Ver AssistedFixView: mismo
                         reparto, y el mismo suelo por el mismo motivo. -->
                    <ColumnDefinition Width="*" MinWidth="60" MaxWidth="420" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{StaticResource FontSize.H2}" FontWeight="SemiBold" />
                <!-- SIN HorizontalAlignment="Left", por lo mismo que en AssistedFixView: alineado
                     a la izquierda, WPF lo arregla a su tamaño deseado y se sale de su columna. -->
                <TextBlock Grid.Column="1" Text="{Binding Live.HeaderText}" Opacity="0.6"
                           VerticalAlignment="Bottom" Margin="{StaticResource Pad.S.Left}"
                           MaxWidth="420" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Live.HeaderText}" />
            </Grid>
            <!-- F16-RETOQUE §2·1: el aire entre piezas lo pone cada barra; el que separa esta zona
                 de la identidad lo pone c:PageHeader, que es quien reparte. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Detener" Command="{Binding StopCommand}" Appearance="Danger"
                           Margin="{StaticResource Pad.S.Right}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <!-- BUGFIX-CIERRE: una sesion terminada se puede ARCHIVAR. Antes se quedaba fija en
                     el rail, sin salida, ocupando una entrada para siempre. Y solo en lo terminal:
                     mientras corre, el boton de al lado es «Detener», que es otra cosa. -->
                <ui:Button Content="Cerrar" Command="{Binding CloseCommand}" Appearance="Secondary"
                           ToolTip="Archiva esta pantalla: desaparece del menu lateral y vuelves al Portafolio. No borra nada — la sesion, sus hallazgos y su informe siguen en el hub."
                           Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </c:PageHeader>

        <!-- F5.15 · EL FALLO SE VE. Un arranque fallido dejaba IsRunning y HasFinished en false, y
             con ellos desaparecía la única superficie que enseñaba el estado (la pantalla de cierre,
             condicionada a HasFinished): sesión zombi, reloj parado y ni una palabra. Este panel
             cuelga de HasFailed, que es un estado terminal propio, y lleva el remedio al lado del
             problema.

             BUGFIX-CUOTA · y ahora el texto se puede LEER y COPIAR: el mensaje va en un cuadro de
             solo lectura (seleccionable con el ratón, que es como se pega en un correo a IT), el
             error crudo del proveedor vive plegado tras «Ver detalle» para que su longitud no
             empuje nada, y hay botón de copiar porque seleccionar a mano varias líneas dentro de un
             banner es el gesto que nadie hace. -->
        <Border Grid.Row="1" CornerRadius="8" Padding="{StaticResource Pad.M}" Margin="{StaticResource Pad.S.Bottom}"
                Background="#22C04040" BorderBrush="#66C04040" BorderThickness="1"
                Visibility="{Binding ShowFailure, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSize.Lead}"
                               Foreground="#E06C6C" VerticalAlignment="Center" Margin="{StaticResource Pad.XS.Right}" />
                    <TextBlock Text="No se pudo completar la sesión" FontSize="{StaticResource FontSize.Lead}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Seleccionable: es un TextBox de solo lectura sin chrome, no un TextBlock. -->
                <TextBox Text="{Binding FailureMessage, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                         TextWrapping="Wrap" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" Padding="{StaticResource Pad.Zero}"
                         Margin="{StaticResource Pad.XS.Top}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}">
                    <ui:Button Content="{Binding DetailToggleLabel}" Appearance="Secondary" FontSize="{StaticResource FontSize.Meta}"
                               Command="{Binding ToggleFailureDetailCommand}"
                               Visibility="{Binding HasFailureDetail, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Copiar error" Appearance="Secondary" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Left}"
                               Command="{Binding CopyFailureCommand}" />
                    <ui:Button Content="Elegir modelo en Ajustes" Appearance="Primary" Margin="{StaticResource Pad.XS.Left}"
                               Command="{Binding FixModelCommand}"
                               Visibility="{Binding FailureOffersModelChange, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- El crudo: acotado en alto y con su propio scroll, para que un error largo del
                     proveedor no pueda comerse el cuerpo de la vista. -->
                <Border Margin="{StaticResource Pad.S.Top}" CornerRadius="6" Padding="{StaticResource Pad.S}" Background="#18000000"
                        Visibility="{Binding IsFailureDetailExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding FailureDetail, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                 TextWrapping="Wrap" BorderThickness="0" BorderBrush="Transparent" Background="Transparent" Padding="{StaticResource Pad.Zero}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSize.Meta}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- Cuerpo: tres columnas -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- · Col. 1 · Cola · -->
            <Border Grid.Column="0" Background="#14808080" CornerRadius="8" Padding="{StaticResource Pad.S}" Margin="{StaticResource Pad.S.Right}"
                    Visibility="{Binding ShowSummary, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Pad.S.Bottom}">
                        <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" />
                        <ProgressBar Value="{Binding Live.Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="{StaticResource Pad.XS.Top}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Units}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS.V}" CornerRadius="5" Background="#0C000000">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="{Binding StateGlyph}"
                                                    Foreground="{Binding State, Converter={StaticResource UnitRunStateToBrush}}"
                                                    FontWeight="Bold"
                                                    Width="18"
                                                    VerticalAlignment="Center" />
                                                <!-- F5.3: SOLO el nombre del fichero. La ruta completa está en el
                                                     tooltip y en la cabecera de actividad; recortada aquí no
                                                     identificaba nada y se comía la columna. -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ShortName}"
                                                    ToolTip="{Binding Path}"
                                                    FontSize="{StaticResource FontSize.Meta}"
                                                    TextTrimming="CharacterEllipsis"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock
                                                Text="{Binding StateLabel}"
                                                FontSize="{StaticResource FontSize.Meta}"
                                                Opacity="0.65"
                                                Margin="{StaticResource Pad.M.Left}"
                                                Foreground="{Binding State, Converter={StaticResource UnitRunStateToBrush}}" />
                                            <TextBlock
                                                Text="{Binding ResultLine}"
                                                FontSize="{StaticResource FontSize.Meta}"
                                                Opacity="0.75"
                                                Margin="{StaticResource Pad.M.Left}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding ResultLine, Converter={StaticResource NotEmptyToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- · Col. 2 · Actividad (la protagonista) · -->
            <Border Grid.Column="1" Background="#0C000000" CornerRadius="8" Padding="{StaticResource Pad.XXS}" Margin="{StaticResource Pad.S.Right}"
                    Visibility="{Binding ShowSummary, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="{StaticResource Pad.RowTight}">
                        <ui:Button
                            Content="↓ Volver al final"
                            Command="{Binding BackToBottomCommand}"
                            Padding="{StaticResource Pad.Pill}"
                            FontSize="{StaticResource FontSize.Meta}"
                            HorizontalAlignment="Right"
                            Visibility="{Binding AutoScroll, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <ScrollViewer x:Name="ActivityScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnActivityScrollChanged">
                        <ItemsControl ItemsSource="{Binding Units}" Margin="{StaticResource Pad.XS}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="{StaticResource Pad.XXS.Bottom}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StateGlyph}"
                                                           Foreground="{Binding State, Converter={StaticResource UnitRunStateToBrush}}"
                                                           FontWeight="Bold" Margin="{StaticResource Pad.XS.Right}" />
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding Passes}" Margin="{StaticResource Pad.M.Left}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="{StaticResource Pad.XXS.Bottom}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Headline}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.85" />
                                                        </Expander.Header>
                                                        <ItemsControl ItemsSource="{Binding Entries}" Margin="{StaticResource Pad.S.Left}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="{StaticResource Pad.XXS.V}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock
                                                                            Grid.Column="0"
                                                                            Text="{Binding Glyph}"
                                                                            Width="18"
                                                                            FontWeight="Bold"
                                                                            Opacity="0.9"
                                                                            VerticalAlignment="Top" />
                                                                        <Border
                                                                            Grid.Column="1"
                                                                            CornerRadius="3"
                                                                            Width="6" Height="6"
                                                                            Margin="{StaticResource Pad.XS}"
                                                                            VerticalAlignment="Top"
                                                                            Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                                            Visibility="{Binding Severity, Converter={StaticResource SeverityToVisibility}}" />
                                                                        <TextBlock
                                                                            Grid.Column="2"
                                                                            Text="{Binding Text}"
                                                                            TextWrapping="Wrap"
                                                                            FontFamily="Consolas"
                                                                            FontSize="{StaticResource FontSize.Meta}"
                                                                            FontWeight="{Binding Kind, Converter={StaticResource ActivityKindToWeight}}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- · Col. 3 · Hallazgos · -->
            <Border Grid.Column="2" Background="#14808080" CornerRadius="8" Padding="{StaticResource Pad.S}"
                    Visibility="{Binding ShowSummary, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Pad.XS.Bottom}">
                        <TextBlock Text="Hallazgos" FontWeight="SemiBold" />
                        <WrapPanel Margin="{StaticResource Pad.XS.Top}">
                            <Border Background="#D13A3A" CornerRadius="8" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS}">
                                <TextBlock FontSize="{StaticResource FontSize.Meta}" Foreground="White">
                                    <Run Text="Crítica " /><Run Text="{Binding CriticalCount, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                            <Border Background="#E07A2B" CornerRadius="8" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS}">
                                <TextBlock FontSize="{StaticResource FontSize.Meta}" Foreground="White">
                                    <Run Text="Alta " /><Run Text="{Binding HighCount, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                            <Border Background="#D2B036" CornerRadius="8" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS}">
                                <TextBlock FontSize="{StaticResource FontSize.Meta}" Foreground="#202020">
                                    <Run Text="Media " /><Run Text="{Binding MediumCount, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                            <Border Background="#6C93C0" CornerRadius="8" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS}">
                                <TextBlock FontSize="{StaticResource FontSize.Meta}" Foreground="White">
                                    <Run Text="Baja " /><Run Text="{Binding LowCount, Mode=OneWay}" FontWeight="Bold" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0C000000" CornerRadius="5" Padding="{StaticResource Pad.ButtonSmall}" Margin="{StaticResource Pad.XXS.V}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border CornerRadius="7" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XS.Right}"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding Severity}" FontSize="{StaticResource FontSize.Meta}" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="⚖" FontSize="{StaticResource FontSize.Meta}" Foreground="#E0A030" VerticalAlignment="Center"
                                                           ToolTip="Disputado: un auditor sostiene que nunca fue un defecto"
                                                           Visibility="{Binding Disputes.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XXS.Top}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- · Pantalla de cierre · SUSTITUYE a las tres columnas, no las tapa ·

                 Era un panel casi negro, opaco al 95 %, puesto ENCIMA de las tres columnas.
                 Dos problemas a la vez: el 95 % de opacidad dejaba traslucir la cola de unidades,
                 la actividad y los hallazgos —el texto del resumen chocaba con rutas y chips
                 fantasma—, y el negro fijo era un agujero oscuro en el tema claro. Ahora las
                 columnas se RETIRAN (arriba, `InverseBoolToVisibility`) y esto ocupa el hueco con
                 el fondo del tema: nada que traslucir, y correcto en los dos temas. -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{StaticResource Pad.L}"
                    Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Pad.M.Bottom}">
                        <TextBlock Text="Sesión terminada" FontSize="{StaticResource FontSize.H3}" FontWeight="SemiBold" />
                        <!--
                            EXCEPCIÓN deliberada a la regla de F5.7 §4: no es feedback de una
                            acción del usuario, es el ESTADO VIVO de la sesión que está corriendo
                            («Auditando…», «Deteniendo tras la unidad actual…»). Tiene que
                            permanecer mientras dure, y su sitio es el panel de la sesión.
                        -->
                        <TextBlock Text="{Binding Live.StatusMessage}" TextWrapping="Wrap" Opacity="0.8" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Top}" />
                        <TextBlock Text="Pulsa cualquier línea para ver qué hallazgos la componen y por qué."
                                   Opacity="0.55" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Top}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="{StaticResource Pad.M.Top}">
                        <ui:Button Content="Ver informe de sesión" Command="{Binding OpenReportCommand}" Appearance="Primary" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{StaticResource Pad.XXS.Bottom}">
                                        <Button
                                            Command="{Binding DataContext.ToggleLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#16808080"
                                            BorderThickness="0"
                                            Padding="{StaticResource Pad.Field}"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Count}" FontSize="{StaticResource FontSize.H3}" FontWeight="Bold"
                                                           Foreground="{Binding IsWarning, Converter={StaticResource WarningToBrush}}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="{StaticResource Pad.S.Right}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Explanation}" Opacity="0.7" FontSize="{StaticResource FontSize.Meta}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <!-- F12 §H.1 — el desglose de HALLAZGOS va agrupado por
                                             clase, con el recuento por severidad al lado, que es
                                             el mismo patrón de la vista de Hallazgos. Salía como
                                             una lista corrida: con veinte hallazgos de seis
                                             ficheros no había forma de ver de dónde venían. Las
                                             líneas que no hablan de hallazgos (unidades,
                                             incidencias) siguen siendo una lista: ahí la unidad
                                             ya ES la línea. -->
                                        <ItemsControl ItemsSource="{Binding Groups}" Margin="{StaticResource Pad.Indent.L}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="{StaticResource Pad.XS.Bottom}">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                                       FontSize="{StaticResource FontSize.Meta}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding CountLabel}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.6"
                                                                       Margin="{StaticResource Pad.XS.Left}" VerticalAlignment="Center" />
                                                            <ItemsControl ItemsSource="{Binding Chips}" Margin="{StaticResource Pad.XS.Left}"
                                                                          VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border CornerRadius="8" Padding="{StaticResource Pad.Pill}" Margin="{StaticResource Pad.XXS.Right}"
                                                                                Background="#16808080">
                                                                            <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Meta}"
                                                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.5"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Subtitle}" />
                                                        <ItemsControl ItemsSource="{Binding Items}" Margin="{StaticResource Pad.S.Left}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                               FontSize="{StaticResource FontSize.Meta}" Opacity="0.85" Margin="{StaticResource Pad.XXS.V}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Details}" Margin="{StaticResource Pad.Indent.L}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}" Opacity="0.85" Margin="{StaticResource Pad.XXS.V}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================ PIE ================================
             F17-RETOQUE: una sola línea que nunca trunca. Era un StackPanel horizontal, y con el
             segmento de Claude Code —tokens con la caché desglosada— el bloque antiguo de tokens
             que venía detrás se salía por el borde cortado a media palabra; además repetía lo que
             el segmento nuevo ya decía. Ahora el pie es una FooterLine: cada trozo trae sus formas
             y su prioridad (llamadas → coste → tokens), y el detalle entero está en el tooltip. -->
        <Border Grid.Row="3" Background="#14808080" CornerRadius="8" Padding="{StaticResource Pad.Field}" Margin="{StaticResource Pad.S.Top}">
            <c:FooterLine x:Name="Footer" Segments="{Binding Footer}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>
    </Grid>
</UserControl>
