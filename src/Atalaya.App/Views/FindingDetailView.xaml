<UserControl
    x:Class="Atalaya.App.Views.FindingDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Atalaya.App.Controls"
    SizeChanged="OnViewSizeChanged">

    <UserControl.Resources>

        <!-- Cada bloque en su tarjeta (F5.5 §1): el mismo envoltorio que la barra de filtros de
             V3, para que las dos vistas se lean como la misma aplicación. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- La línea de ayuda de cada sub-sección: qué hace este control, en una frase. -->
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- La etiqueta de un campo. El numérico de caducidad era huérfano y ya no lo es. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,6,0,3" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,14,0,12" />
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>

        <!-- «ver más» no es un botón: es una palabra en la que se hace clic. Con la plantilla de
             botón de serie, un control con chrome propio partía el párrafo en dos. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                                   Margin="{TemplateBinding Padding}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="Label" Property="Foreground"
                                        Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideAction" TargetType="ui:Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Un campo de metadatos: etiqueta a la izquierda, valor a la derecha con wrap. -->
        <DataTemplate x:Key="MetaRowTemplate">
            <Grid Margin="0,0,0,7" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mono}" Value="True">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- · Dos columnas mientras la ventana da de sí; una sola, en el mismo orden, cuando no ·
         El reparto es 60/40 y la lateral tiene su propio scroll, así que gobernanza y acciones
         siguen en pantalla por muy largo que sea el hallazgo: esa es toda la «adherencia» que
         hace falta y no requiere ningún truco de scroll. -->
    <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="3*" />
            <ColumnDefinition x:Name="GutterColumn" Width="18" />
            <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ================================ COLUMNA PRINCIPAL ================================ -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <StackPanel x:Name="MainStack">

                <!-- · Cabecera: título y una sola fila de chips · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Finding.Title}" FontSize="21" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <WrapPanel Margin="0,10,0,-4">
                            <Border Style="{StaticResource Chip}"
                                    Background="{Binding Finding.Severity, Converter={StaticResource SeverityToBrush}}"
                                    ToolTip="Severidad según la rúbrica del sistema.">
                                <TextBlock Text="{Binding Finding.Severity, Converter={StaticResource SeverityToLabel}}"
                                           Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                    ToolTip="{Binding ConfidenceHelp}">
                                <TextBlock Text="{Binding ConfidenceLabel}" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{Binding Status, Converter={StaticResource FindingStatusToFill}}"
                                    ToolTip="{Binding StatusHelp}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource FindingStatusToBrush}}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    ToolTip="{Binding DisputeSummary}"
                                    Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DisputeBadge}" FontSize="11"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                    ToolTip="La última comprobación no pudo confirmarlo, o su ubicación en el código se perdió."
                                    Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Por revisar" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- · Qué pasa, qué implica y qué hacer · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="El hallazgo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Descripción" Style="{StaticResource SubTitle}" />
                        <TextBlock Text="{Binding Finding.Description}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Impacto" Style="{StaticResource SubTitle}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Finding.Impact}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Recomendación" Style="{StaticResource SubTitle}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding Finding.Recommendation}" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <!-- · Código: el miembro completo, con las líneas del fichero · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Código" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding SnippetCaption}" HorizontalAlignment="Right"
                                       FontSize="11" FontFamily="Cascadia Mono, Consolas"
                                       TextTrimming="CharacterEllipsis" MaxWidth="380"
                                       ToolTip="{Binding SnippetCaption}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <!-- Nunca enseñar código viejo como si fuera actual: cuando el ancla no
                             casa, el aviso va ENCIMA y trae la acción que lo arregla. -->
                        <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,8"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                Visibility="{Binding HasSnippetNotice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SnippetNotice}" TextWrapping="Wrap" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <ui:Button Content="Verificar ahora" Command="{Binding VerifyCommand}"
                                           Appearance="Secondary" Padding="10,3" FontSize="11"
                                           Margin="10,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding SnippetNoticeOffersVerify, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="6" ClipToBounds="True"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisibility}}">
                            <controls:SnippetView
                                Height="320"
                                Padding="6,6,0,6"
                                Code="{Binding Snippet}"
                                FirstLine="{Binding SnippetFirstLine}"
                                HighlightLine="{Binding SnippetHighlightLine}"
                                SourcePath="{Binding SnippetPath}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- · Historial: línea de tiempo, completa y en castellano · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Historial" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12.5"
                                                       VerticalAlignment="Top" Margin="0,1,0,0"
                                                       Foreground="{Binding Event, Converter={StaticResource FindingEventToBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Header}" FontSize="11" Margin="8,1,0,0"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <!-- Texto COMPLETO con wrap. Plegado a dos líneas si es
                                                     largo, nunca cortado con puntos suspensivos. -->
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11.5"
                                                           Margin="0,2,0,0"
                                                           MaxHeight="{Binding DetailMaxHeight}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                                                <Button Content="{Binding ToggleLabel}" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Padding="0,2,0,0" FontSize="11"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsLong, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- · Comentarios · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Comentarios" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12"
                                                           Margin="0,3,0,0"
                                                           MaxHeight="{Binding DetailMaxHeight}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button Content="{Binding ToggleLabel}" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Padding="0,2,0,0" FontSize="11"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsLong, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ui:TextBox PlaceholderText="Nuevo comentario…" Text="{Binding NewComment}"
                                        Width="360" Margin="0,0,8,0" />
                            <ui:Button Content="Comentar" Command="{Binding AddCommentCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================================= COLUMNA LATERAL ================================= -->
        <ScrollViewer x:Name="SideScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <StackPanel x:Name="SideStack">

                <!-- · Metadatos: aquí aterriza el ruleId, con nombre · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Metadatos" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Meta}"
                                      ItemTemplate="{StaticResource MetaRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- · Acciones rápidas · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Acciones" Style="{StaticResource SectionTitle}" />
                        <ui:Button Content="Generar prompt de arreglo" Style="{StaticResource SideAction}"
                                   Command="{Binding GenerateFixPromptCommand}" Appearance="Primary"
                                   ToolTip="Compone el encargo para un agente y lo copia al portapapeles." />
                        <!-- F5.4: bajó de V3. Verificar de uno en uno deja ver QUÉ se le pregunta al agente. -->
                        <ui:Button Content="Verificar ahora" Style="{StaticResource SideAction}"
                                   Command="{Binding VerifyCommand}"
                                   ToolTip="Re-ancla la ubicación y pide veredicto al agente (§5.4)." />
                        <ui:Button Content="Abrir en el editor" Style="{StaticResource SideAction}"
                                   Command="{Binding OpenInEditorCommand}"
                                   ToolTip="Abre el fichero en la línea del hallazgo con el editor de Ajustes." />
                    </StackPanel>
                </Border>

                <!-- · Gobernanza: cada acción con su título y su línea de ayuda · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gobernanza" Style="{StaticResource SectionTitle}" />

                        <!-- Silenciar -->
                        <TextBlock Text="Silenciar" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Ocultar este hallazgo de informes y auditorías. Queda registrado con tu nombre y su motivo." />

                        <Border CornerRadius="6" Padding="9,6" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Visibility="{Binding HasSilence, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SilenceSummary}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding ReasonOptions}"
                                  SelectedValue="{Binding SilenceReason}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Notas" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SilenceNotes}" HorizontalAlignment="Stretch"
                                    PlaceholderText="Por qué se silencia" />

                        <!-- El numérico huérfano de F5.4, ahora con nombre y con la unidad dentro. -->
                        <TextBlock Text="Caducidad (días) — 0 = permanente" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SilenceExpiryDays}" Width="110" HorizontalAlignment="Left"
                                    ToolTip="Días que dura el silencio. Pasados, el hallazgo vuelve a aparecer solo. 0 lo deja permanente." />

                        <WrapPanel Margin="0,10,0,0">
                            <ui:Button Content="Silenciar" Command="{Binding SilenceCommand}" Margin="0,0,6,0"
                                       Visibility="{Binding CanSilence, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Des-silenciar" Command="{Binding UnsilenceCommand}"
                                       Visibility="{Binding CanUnsilence, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- Severidad -->
                        <TextBlock Text="Severidad" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Reclasificar este hallazgo. El cambio queda en el historial con tu nombre." />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
                                      Width="130" Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SeverityToLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button Content="Aplicar" Command="{Binding ApplySeverityCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- Resolución manual: plegada, que es una acción excepcional -->
                        <TextBlock Text="Resolución manual" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Cierra este hallazgo por decisión humana, sin auditoría — para código ya corregido o eliminado. Requiere justificación y queda registrado con tu nombre." />

                        <!-- Plegada, la cabecera tiene que verse ENTERA y leerse como expandible
                             (F5.6 §5). Sin `Padding`: la plantilla de WPF-UI se lo aplica a la
                             CABECERA, no al contenido, y por eso el título salía descolgado contra
                             el borde (D-231). El aire del contenido se lo pone el StackPanel de
                             dentro. Y la advertencia va en la propia cabecera, que es lo que la
                             distingue del combo de severidad de arriba (D-232). -->
                        <Expander IsExpanded="{Binding ManualResolutionExpanded}"
                                  HorizontalContentAlignment="Stretch"
                                  Margin="0,2,0,0"
                                  Visibility="{Binding CanResolveManually, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,7,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="Resolver a mano" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="— cierra el hallazgo sin auditar" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,1,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Justificación (obligatoria)" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Justification}" HorizontalAlignment="Stretch"
                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                            PlaceholderText="Qué se corrigió y dónde consta" />
                                <ui:Button Content="Resolver manualmente" Appearance="Danger" Margin="0,8,0,0"
                                           Command="{Binding ResolveManuallyCommand}" />
                            </StackPanel>
                        </Expander>

                        <ui:Button Content="Reabrir" Command="{Binding ReopenCommand}" Margin="0,4,0,0"
                                   ToolTip="Devuelve el hallazgo a activo, con traza en el historial."
                                   Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Disputa: existe SOLO si hay disputa (F5.1b, F5.5 §4) -->
                        <StackPanel Visibility="{Binding ShowDispute, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="Disputa abierta" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Help}"
                                       Text="Un auditor sostiene que esto nunca fue un defecto. Lo decide una persona; las notas de arriba quedan escritas en la decisión." />
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{Binding DisputeSummary}" TextWrapping="Wrap" FontSize="11.5"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </Border>
                            <ui:Button Content="Es falso positivo" Style="{StaticResource SideAction}"
                                       Command="{Binding AcceptDisputeCommand}"
                                       ToolTip="Da la razón al auditor que discrepó: se silencia como falso positivo, con tu nombre. No es una resolución." />
                            <ui:Button Content="Sigue siendo defecto" Style="{StaticResource SideAction}"
                                       Command="{Binding DismissDisputeCommand}"
                                       ToolTip="Da la razón a quien lo reportó: se retira la marca y el hallazgo sigue igual." />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
