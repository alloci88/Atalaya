<UserControl
    x:Class="Atalaya.App.Views.FindingDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Finding.Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Border Background="{Binding Finding.Severity, Converter={StaticResource SeverityToBrush}}" CornerRadius="8" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="{Binding Finding.Severity}" Foreground="White" FontSize="12" />
                </Border>
                <TextBlock Text="{Binding Finding.DisplayId}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="El alias es de presentación; la identidad es el ULID." />
                <TextBlock Text="{Binding Finding.Confidence, StringFormat='confianza {0}'}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Finding.Status}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Finding.RuleId}" FontFamily="Consolas" Opacity="0.7" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Descripción" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock Text="{Binding Finding.Description}" TextWrapping="Wrap" />
            <TextBlock Text="Impacto" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding Finding.Impact}" TextWrapping="Wrap" />
            <TextBlock Text="Recomendación" FontWeight="SemiBold" Margin="0,10,0,4" />
            <TextBlock Text="{Binding Finding.Recommendation}" TextWrapping="Wrap" />

            <TextBlock Text="Snippet anclado" FontWeight="SemiBold" Margin="0,16,0,4" />
            <Border BorderBrush="#33808080" BorderThickness="1" CornerRadius="6">
                <avalonedit:TextEditor x:Name="SnippetEditor" IsReadOnly="True" FontFamily="Consolas"
                                       FontSize="12" Height="150" SyntaxHighlighting="C#" ShowLineNumbers="True" />
            </Border>

            <WrapPanel Margin="0,14,0,0">
                <ui:Button Content="Generar prompt de arreglo" Command="{Binding GenerateFixPromptCommand}" Appearance="Primary" Margin="0,0,8,6" />
                <!-- F5.4: bajaron de V3. Verificar de uno en uno deja ver QUE se le pregunta al agente. -->
                <ui:Button Content="Verificar ahora" Command="{Binding VerifyCommand}" Margin="0,0,8,6"
                           ToolTip="Re-ancla la ubicacion y pide veredicto al agente (§5.4)." />
                <ui:Button Content="Abrir en el editor" Command="{Binding OpenInEditorCommand}" Margin="0,0,8,6" />
            </WrapPanel>

            <!-- Disputa abierta (F5.1b): las DOS salidas, aqui y solo aqui desde F5.4. -->
            <Border BorderBrush="#55E0A030" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0"
                    Background="#14E0A030"
                    Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Disputa abierta" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DisputeSummary}" TextWrapping="Wrap" FontSize="12" Opacity="0.85" Margin="0,4,0,0" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,6,0,0"
                               Text="Un auditor sostiene que esto nunca fue un defecto. Lo decide una persona; las notas de abajo quedan escritas en la decision." />
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="Es falso positivo" Command="{Binding AcceptDisputeCommand}" Margin="0,0,8,0"
                                   ToolTip="Da la razon al auditor que discrepo: se silencia como falso positivo, con tu nombre. No es una resolucion." />
                        <ui:Button Content="Sigue siendo defecto" Command="{Binding DismissDisputeCommand}"
                                   ToolTip="Da la razon a quien lo reporto: se retira la marca y el hallazgo sigue igual." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Gobernanza -->
            <TextBlock Text="Gobernanza" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8" />
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Reasons}" SelectedItem="{Binding SilenceReason}" Width="170" Margin="0,0,6,6" />
                <ui:TextBox PlaceholderText="Caduca (días)" Text="{Binding SilenceExpiryDays}" Width="120" Margin="0,0,6,6" />
                <ui:TextBox PlaceholderText="Motivo/notas" Text="{Binding SilenceNotes}" Width="200" Margin="0,0,6,6" />
                <ui:Button Content="Silenciar" Command="{Binding SilenceCommand}" Margin="0,0,6,6" />
                <ui:Button Content="Des-silenciar" Command="{Binding UnsilenceCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <ui:TextBox PlaceholderText="Asignar a…" Text="{Binding Assignee}" Width="180" Margin="0,0,6,6" />
                <ui:Button Content="Asignar" Command="{Binding ApplyAssignCommand}" Margin="0,0,12,6" />
                <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}" Width="120" Margin="0,0,6,6" />
                <ui:Button Content="Cambiar severidad" Command="{Binding ApplySeverityCommand}" Margin="0,0,12,6" />
                <ui:Button Content="Reabrir" Command="{Binding ReopenCommand}" Margin="0,0,6,6" />
            </WrapPanel>
            <WrapPanel Margin="0,4,0,0">
                <ui:TextBox PlaceholderText="Justificación de resolución manual" Text="{Binding Justification}" Width="360" Margin="0,0,6,6" />
                <ui:Button Content="Resolver manualmente" Command="{Binding ResolveManuallyCommand}" Appearance="Danger" Margin="0,0,6,6" />
            </WrapPanel>

            <!-- Comentarios -->
            <TextBlock Text="Comentarios" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14808080" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock FontSize="11" Opacity="0.6">
                                    <Run Text="{Binding By}" /><Run Text=" · " /><Run Text="{Binding Kind}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ui:TextBox PlaceholderText="Nuevo comentario…" Text="{Binding NewComment}" Width="500" Margin="0,0,6,0" />
                <ui:Button Content="Comentar" Command="{Binding AddCommentCommand}" />
            </StackPanel>

            <!-- Historial -->
            <TextBlock Text="Historial" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2" FontSize="12">
                            <Run Text="{Binding Utc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#888" />
                            <Run Text=" " /><Run Text="{Binding Event}" FontWeight="SemiBold" />
                            <Run Text=" — " /><Run Text="{Binding Detail}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Opacity="0.85" Margin="0,16,0,0"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
