<UserControl
    x:Class="Atalaya.App.Views.FindingDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:controls="clr-namespace:Atalaya.App.Controls"
    SizeChanged="OnViewSizeChanged">

    <UserControl.Resources>

        <!-- Cada bloque en su tarjeta (F5.5 §1): el mismo envoltorio que la barra de filtros de
             V3, para que las dos vistas se lean como la misma aplicación.

             F26 §B (D-976): los seis estilos de esta vista eran su tipografía COMPLETA —13,5 para
             los títulos, 12,5 para los sub, 11 para la ayuda, 13 para el cuerpo— y eran de aquí,
             de nadie más. Pasarlos por la escala convierte el fichero entero sin tocar sus 600
             líneas, y de paso desaparece la ayuda a 11 px que es de donde venía «no se lee». -->
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{StaticResource Pad.S.Bottom}" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Lead}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Margin" Value="{StaticResource Pad.XS.Bottom}" />
        </Style>

        <Style x:Key="SubTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Margin" Value="{StaticResource Pad.XXS.Bottom}" />
        </Style>

        <!-- La línea de ayuda de cada sub-sección: qué hace este control, en una frase. A 11 px no
             la leía nadie; el suelo del sistema es 13 y esto es texto secundario, así que 14. -->
        <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Margin" Value="{StaticResource Pad.XS.Bottom}" />
        </Style>

        <!-- La etiqueta de un campo. El numérico de caducidad era huérfano y ya no lo es. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Small}">
            <Setter Property="Margin" Value="{StaticResource Pad.FieldLabel}" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
            <Setter Property="Margin" Value="{StaticResource Pad.PanelDivider}" />
        </Style>

        <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="{StaticResource Pad.Chip}" />
        </Style>

        <!-- «ver más» no es un botón: es una palabra en la que se hace clic. Con la plantilla de
             botón de serie, un control con chrome propio partía el párrafo en dos. -->
        <!-- El estilo de enlace vive en el sistema desde H9.1: lo usan esta vista y la de arreglo
             asistido, y una copia por vista es una copia que se desincroniza. -->

        <Style x:Key="SideAction" TargetType="ui:Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="{StaticResource Pad.XXS.Bottom}" />
        </Style>

        <!-- Las acciones de la columna, con nuestras plantillas: la jerarquía de la botonera la
             marca el COLOR, y para eso hacen falta los estilos del sistema (D-949). -->
        <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{StaticResource Pad.XXS.Bottom}" />
        </Style>

        <Style x:Key="Action.Primary" TargetType="Button" BasedOn="{StaticResource Button.Success}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="{StaticResource Pad.XXS.Bottom}" />
        </Style>

        <!-- Un campo de metadatos: etiqueta a la izquierda, valor a la derecha con wrap. -->
        <DataTemplate x:Key="MetaRowTemplate">
            <Grid Margin="{StaticResource Pad.XS.Bottom}" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="{StaticResource FontSize.Meta}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{StaticResource FontSize.Meta}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mono}" Value="True">
                                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <!-- · Dos columnas mientras la ventana da de sí; una sola, en el mismo orden, cuando no ·
         El reparto es 60/40 y la lateral tiene su propio scroll, así que gobernanza y acciones
         siguen en pantalla por muy largo que sea el hallazgo: esa es toda la «adherencia» que
         hace falta y no requiere ningún truco de scroll. -->
    <Grid x:Name="Columns">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainColumn" Width="3*" />
            <ColumnDefinition x:Name="GutterColumn" Width="18" />
            <ColumnDefinition x:Name="SideColumn" Width="2*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- ================================ COLUMNA PRINCIPAL ================================ -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Pad.XXS.Right}">
            <StackPanel x:Name="MainStack">

                <!-- · Cabecera: título y una sola fila de chips · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Finding.Title}" FontSize="{StaticResource FontSize.H3}" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <WrapPanel Margin="{StaticResource Pad.S.Top}">
                            <Border Style="{StaticResource Chip}"
                                    Background="{Binding Finding.Severity, Converter={StaticResource SeverityToBrush}}"
                                    ToolTip="Severidad según la rúbrica del sistema.">
                                <TextBlock Text="{Binding Finding.Severity, Converter={StaticResource SeverityToLabel}}"
                                           Foreground="{DynamicResource Brush.Ink.OnVivid}" FontSize="{StaticResource FontSize.Meta}" FontWeight="SemiBold" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                    ToolTip="{Binding ConfidenceHelp}">
                                <TextBlock Text="{Binding ConfidenceLabel}" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{Binding Status, Converter={StaticResource FindingStatusToFill}}"
                                    ToolTip="{Binding StatusHelp}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="{StaticResource FontSize.Meta}" FontWeight="SemiBold"
                                           Foreground="{Binding Status, Converter={StaticResource FindingStatusToBrush}}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    ToolTip="{Binding DisputeSummary}"
                                    Visibility="{Binding IsDisputed, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DisputeBadge}" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </Border>

                            <Border Style="{StaticResource Chip}"
                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                    ToolTip="La última comprobación no pudo confirmarlo, o su ubicación en el código se perdió."
                                    Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Por revisar" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- · Qué pasa, qué implica y qué hacer · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="El hallazgo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Descripción" Style="{StaticResource SubTitle}" />
                        <TextBlock Text="{Binding Finding.Description}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Impacto" Style="{StaticResource SubTitle}" Margin="{StaticResource Pad.SectionGap}" />
                        <TextBlock Text="{Binding Finding.Impact}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Recomendación" Style="{StaticResource SubTitle}" Margin="{StaticResource Pad.SectionGap}" />
                        <TextBlock Text="{Binding Finding.Recommendation}" Style="{StaticResource BodyText}" />
                    </StackPanel>
                </Border>

                <!-- · Código: el miembro completo, con las líneas del fichero · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- La cabecera, en dos piezas y con columnas de verdad (D-983). Antes era
                             una sola linea con `MaxWidth=380` y recorte por el final, asi que lo
                             que se perdia era siempre la ruta y a veces ya el miembro: en el dist
                             se leia «HttpService.LoginExternalUser · XBLASTRecovery/C…».

                             Ahora el NOMBRE va entero y sin recorte —es lo que dice que se esta
                             mirando, y es corto— y la ruta va debajo, acortada por el MEDIO, que
                             conserva sus extremos: los que la identifican. Nada de MaxWidth: la
                             columna estrella reparte lo que haya. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Código" Style="{StaticResource SectionTitle}" />
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right"
                                        Margin="{StaticResource Pad.S.Left}"
                                        ToolTip="{Binding SnippetCaption}">
                                <TextBlock Text="{Binding SnippetMember}" HorizontalAlignment="Right"
                                           FontSize="{StaticResource FontSize.Meta}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="{Binding SnippetWhere, Converter={StaticResource MiddleEllipsis}, ConverterParameter=46}"
                                           HorizontalAlignment="Right"
                                           FontSize="{StaticResource FontSize.Meta}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           Foreground="{DynamicResource Brush.TextFaint}" />
                            </StackPanel>
                        </Grid>

                        <!-- Nunca enseñar código viejo como si fuera actual: cuando el ancla no
                             casa, el aviso va ENCIMA y trae la acción que lo arregla.

                             Y el TONO lo decide el estado del hallazgo (F6.7): ámbar mientras haya
                             algo que atender, neutro cuando la franja solo informa. Un resuelto
                             pintado de ámbar decía «cuidado» de un cambio que era el arreglo. -->
                        <Border CornerRadius="6" Padding="{StaticResource Pad.Field}" Margin="{StaticResource Pad.XS.Bottom}"
                                Visibility="{Binding HasSnippetNotice, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background"
                                            Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SnippetTone}" Value="Nota">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- F12 §H.4 — EL AVISO CABE. Era un StackPanel horizontal, y un
                                 StackPanel horizontal da a sus hijos ancho infinito: con eso
                                 `TextWrapping="Wrap"` no envuelve NUNCA y el texto se salía por la
                                 derecha, cortado contra el borde y sin tooltip que lo rescatara —
                                 justo el aviso de re-anclaje, que es de los largos. Una rejilla de
                                 dos columnas (texto elástico, botón a su medida) le da un ancho
                                 real, así que envuelve; y el tooltip lleva el texto entero por si
                                 aun así no cupiera. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding SnippetNotice}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                           ToolTip="{Binding SnippetNotice}"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SnippetTone}" Value="Nota">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ui:Button Grid.Column="1"
                                           Content="Verificar ahora" Command="{Binding VerifyCommand}"
                                           Appearance="Secondary" Padding="{StaticResource Pad.ButtonSmall}" FontSize="{StaticResource FontSize.Meta}"
                                           IsEnabled="{Binding CanAudit}"
                                           ToolTip="{Binding AuditDisabledTooltip}"
                                           Margin="{StaticResource Pad.S.Left}" VerticalAlignment="Center"
                                           Visibility="{Binding SnippetNoticeOffersVerify, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>

                        <Border CornerRadius="6" ClipToBounds="True"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisibility}}">
                            <!-- Alto ADAPTATIVO, no fijo (F5.6b): el panel mide lo que mide el
                                 miembro y solo se planta al llegar al tope, que es donde aparece
                                 el scroll interno. Con `Height` un método de cinco líneas dejaba
                                 250 px de vacío debajo y separaba la tarjeta de la siguiente; el
                                 comportamiento de un método largo no cambia. Mismo patrón que el
                                 historial y los comentarios, que ya usaban `MaxHeight`. -->
                            <controls:SnippetView
                                MaxHeight="320"
                                Padding="{StaticResource Pad.XS}"
                                Code="{Binding Snippet}"
                                FirstLine="{Binding SnippetFirstLine}"
                                HighlightLine="{Binding SnippetHighlightLine}"
                                SourcePath="{Binding SnippetPath}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- · Historial: línea de tiempo, completa y en castellano · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Historial" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{StaticResource Pad.S.Bottom}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="{StaticResource FontSize.Small}"
                                                       VerticalAlignment="Top" Margin="{StaticResource Pad.XXS.Top}"
                                                       Foreground="{Binding Event, Converter={StaticResource FindingEventToBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Label}" FontSize="{StaticResource FontSize.Meta}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Header}" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Left}"
                                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                                <!-- Texto COMPLETO con wrap. Plegado a dos líneas si es
                                                     largo, nunca cortado con puntos suspensivos. -->
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                                           Margin="{StaticResource Pad.XXS.Top}"
                                                           MaxHeight="{Binding DetailMaxHeight}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                                                <Button Content="{Binding ToggleLabel}" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Padding="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Meta}"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsLong, Converter={StaticResource BoolToVisibility}}" />
                                                <!-- H9.1 §1: del evento a la sesión que lo provocó.
                                                     Hoy solo lo trae el arreglo asistido, que es el
                                                     único evento con informe propio. -->
                                                <Button Content="Ver el informe de este arreglo"
                                                        Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.OpenSessionReportCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Meta}"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- · Comentarios · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Comentarios" Style="{StaticResource SectionTitle}" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Comments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                CornerRadius="6" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.XS.Bottom}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" FontSize="{StaticResource FontSize.Meta}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                                           Margin="{StaticResource Pad.XXS.Top}"
                                                           MaxHeight="{Binding DetailMaxHeight}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Button Content="{Binding ToggleLabel}" Style="{StaticResource LinkButton}"
                                                                    Command="{Binding ToggleCommand}"
                                                                    Padding="{StaticResource Pad.XXS.Top}" FontSize="{StaticResource FontSize.Meta}"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsLong, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XS.Top}">
                            <ui:TextBox PlaceholderText="Nuevo comentario…" Text="{Binding NewComment}"
                                        Width="360" Margin="{StaticResource Pad.XS.Right}" />
                            <ui:Button Content="Comentar" Command="{Binding AddCommentCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ================================= COLUMNA LATERAL ================================= -->
        <ScrollViewer x:Name="SideScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Pad.XXS.Right}">
            <StackPanel x:Name="SideStack">

                <!-- · Metadatos: aquí aterriza el ruleId, con nombre · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Metadatos" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Meta}"
                                      ItemTemplate="{StaticResource MetaRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- · Acciones rápidas · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Acciones" Style="{StaticResource SectionTitle}" />
                        <!-- F6.8: el rótulo sale del view-model porque la recolección de
                             referencias recorre el clon y en una solución grande se nota. El botón
                             se deshabilita solo mientras corre (AsyncRelayCommand), pero un botón
                             gris que no dice nada se pulsa otra vez: mientras busca, lo dice. -->
                        <!-- F6.9 · El camino nuevo va PRIMERO, y el de siempre se queda justo
                             debajo: son dos formas de arreglar lo mismo, no una que sustituye a
                             la otra. Cuando no se puede lanzar, el botón queda gris con el motivo
                             concreto en el tooltip. -->
                        <!-- F26 §B (D-976): el primario de la botonera es VERDE, que es el color
                             de lo que adelanta trabajo (D-949). Antes los cuatro botones eran
                             iguales y grises: no había forma de saber cuál era el que hace avanzar
                             el hallazgo. -->
                        <Button Content="Arreglar con agente" Style="{StaticResource Action.Primary}"
                                Command="{Binding StartAssistedFixCommand}"
                                IsEnabled="{Binding CanStartFix}"
                                ToolTip="{Binding AssistedFixTooltip}"
                                Visibility="{Binding ShowAssistedFix, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Y la razón por la que NO se puede, al lado y con el color de aviso, no
                             en un gris de 11 px que se lee como decoración (principio 4). -->
                        <Border Style="{StaticResource Reason.Chip}" HorizontalAlignment="Stretch"
                                Margin="{StaticResource Pad.XS.Bottom}">
                            <Border.Visibility>
                                <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                    <Binding Path="ShowAssistedFix" />
                                    <Binding Path="CanStartFix" Converter="{StaticResource InverseBool}" />
                                </MultiBinding>
                            </Border.Visibility>
                            <!-- DockPanel y no StackPanel horizontal: un StackPanel da a sus hijos
                                 ancho INFINITO, asi que el `TextWrapping` de dentro no llega a
                                 dispararse nunca y la razon se cortaba por la derecha justo antes
                                 de decir que hay que commitear. Aqui el icono ocupa lo suyo y el
                                 texto recibe lo que queda, que es lo unico que hace que envuelva.
                                 El icono va arriba: con la razon en dos lineas, centrarlo lo dejaba
                                 flotando entre ambas. -->
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Icon.Small}"
                                      Data="{x:Static c:Icons.Warning}"
                                      VerticalAlignment="Top"
                                      Margin="{StaticResource Pad.XS.Right}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Text="{Binding AssistedFixBlock}"
                                           Style="{StaticResource Reason.Text}"
                                           VerticalAlignment="Top"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <ui:Button Content="{Binding FixPromptActionLabel}" Style="{StaticResource SideAction}"
                                   Command="{Binding GenerateFixPromptCommand}"
                                   ToolTip="Compone el encargo para un agente —con la lista de quién usa este código— y lo copia al portapapeles." />
                        <!-- F5.4: bajó de V3. Verificar de uno en uno deja ver QUÉ se le pregunta al agente.
                             F5.8 §3: es una acción de AUDITAR —lee el clon—, así que sin vínculo
                             local queda gris con su motivo y el atajo para arreglarlo al lado. La
                             gobernanza de más abajo NO se toca: no necesita el código. -->
                        <!-- F5.16: el nombre y la ayuda salen del view-model porque cambian con la
                             CLASE de hallazgo. Uno medido no se pregunta, se mide: llamarlo igual
                             que a una verificación por LLM haría esperar tokens y una espera larga
                             donde solo hay una lectura de fichero. -->
                        <ui:Button Content="{Binding VerifyActionLabel}" Style="{StaticResource SideAction}"
                                   Command="{Binding VerifyCommand}"
                                   IsEnabled="{Binding CanAudit}"
                                   ToolTip="{Binding VerifyHelp}" />
                        <ui:Button Content="{Binding Link.ActionLabel}" Style="{StaticResource SideAction}"
                                   Command="{Binding LinkCloneCommand}"
                                   ToolTip="{Binding Link.Tooltip}"
                                   Visibility="{Binding Link.NeedsAction, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Abrir en el editor" Style="{StaticResource SideAction}"
                                   Command="{Binding OpenInEditorCommand}"
                                   ToolTip="Abre el fichero en la línea del hallazgo con el editor de Ajustes." />
                    </StackPanel>
                </Border>

                <!-- · Gobernanza: cada acción con su título y su línea de ayuda · -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gobernanza" Style="{StaticResource SectionTitle}" />

                        <!-- Silenciar -->
                        <TextBlock Text="Silenciar" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Ocultar este hallazgo de informes y auditorías. Queda registrado con tu nombre y su motivo." />

                        <!-- F12 §F — un hallazgo silenciado DICE por qué lo está: quién, cuándo,
                             con qué motivo, o qué patrón lo tapa. Y dice cómo deshacerlo, en la
                             misma tarjeta: la palanca que sirve para un silencio por patrón no es
                             «Des-silenciar» —el patrón seguiría puesto y la auditoría siguiente
                             volvería a callarlo— sino retirar el patrón. -->
                        <Border CornerRadius="6" Padding="{StaticResource Pad.Field}" Margin="{StaticResource Pad.XS.Bottom}"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Visibility="{Binding HasSilence, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SilenceSummary}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding SilenceUndoHint}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                           Margin="{StaticResource Pad.XXS.Top}" Opacity="0.85"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ui:HyperlinkButton Content="Gestionar el patrón que lo silencia"
                                                    Command="{Binding ManageSilencingPatternCommand}"
                                                    Margin="{StaticResource Pad.XXS.Top}" Padding="{StaticResource Pad.Zero}"
                                                    HorizontalAlignment="Left"
                                                    ToolTip="Abre los patrones silenciados de esta aplicación. Al retirarlo, este hallazgo vuelve a activo al instante."
                                                    Visibility="{Binding CanManageSilencingPattern, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- F5.12: si este hallazgo fue el origen de un patrón, lo dice. Sin esto,
                             un hallazgo silenciado por su propio patrón parece silenciado porque sí. -->
                        <Border CornerRadius="6" Padding="{StaticResource Pad.Field}" Margin="{StaticResource Pad.XS.Bottom}"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                Visibility="{Binding HasPatternOrigin, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PatternOriginSummary}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <!-- F5.12 · SELECTOR DE ALCANCE. La consecuencia de cada opción va DEBAJO
                             de ella, no en un tooltip: la diferencia entre las dos no es un matiz
                             —una oculta un caso, la otra calla un tipo entero de problema en toda
                             la aplicación— y quien las confunde no se entera hasta la auditoría
                             siguiente. Bajo la segunda va el EJEMPLAR, editable: es literalmente
                             la frase que el auditor va a leer, así que hay que verla antes de
                             confirmar y poder pulirla. -->
                        <TextBlock Text="Alcance" Style="{StaticResource FieldLabel}" Margin="{StaticResource Pad.XXS.Bottom}" />
                        <ItemsControl ItemsSource="{Binding ScopeOptions}" Margin="{StaticResource Pad.XXS.Bottom}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{StaticResource Pad.XS.Bottom}">
                                        <RadioButton GroupName="SilenceScope"
                                                     Content="{Binding Label}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.Indent}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Margin="{StaticResource Pad.Indent}"
                                                    Visibility="{Binding HasExemplar, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Tipo de problema que se silencia (edítalo si no lo describe bien)"
                                                       FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XXS.Bottom}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <ui:TextBox HorizontalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="False"
                                                        PlaceholderText="p. ej. bloques catch vacíos que ocultan excepciones"
                                                        ToolTip="Esta frase es lo único que el auditor lee para decidir qué callar."
                                                        Text="{Binding DataContext.PatternExemplar,
                                                               RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                               UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Motivo" Style="{StaticResource FieldLabel}" Margin="{StaticResource Pad.XXS.Bottom}" />
                        <ComboBox ItemsSource="{Binding ReasonOptions}"
                                  SelectedValue="{Binding SilenceReason}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  HorizontalAlignment="Stretch" />

                        <TextBlock Text="Notas" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SilenceNotes}" HorizontalAlignment="Stretch"
                                    PlaceholderText="Por qué se silencia" />

                        <!-- El numérico huérfano de F5.4, ahora con nombre y con la unidad dentro. -->
                        <TextBlock Text="Caducidad (días) — 0 = permanente" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding SilenceExpiryDays}" Width="110" HorizontalAlignment="Left"
                                    ToolTip="Días que dura el silencio. Pasados, el hallazgo vuelve a aparecer solo. 0 lo deja permanente." />

                        <WrapPanel Margin="{StaticResource Pad.S.Top}">
                            <!-- SILENCIAR SE VE (F26 §C, segunda revisión): borde y tinta de aviso,
                                 sin relleno. Es la acción con consecuencia de este bloque —oculta un
                                 hallazgo de informes y auditorías— y era un botón gris más entre
                                 seis. Perfilado y no macizo por la regla de D-949: un ámbar relleno
                                 atrae el ojo antes que el primario de la ficha. -->
                            <Button Content="{Binding SilenceActionLabel}" Command="{Binding SilenceCommand}"
                                    Style="{StaticResource Button.Warning}"
                                    Margin="{StaticResource Pad.XS.Right}"
                                    Visibility="{Binding CanApplySilence, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Des-silenciar" Command="{Binding UnsilenceCommand}"
                                       Visibility="{Binding CanUnsilence, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- Severidad -->
                        <TextBlock Text="Severidad" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Reclasificar este hallazgo. El cambio queda en el historial con tu nombre." />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
                                      Width="130" Margin="{StaticResource Pad.XS.Right}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SeverityToLabel}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ui:Button Content="Aplicar" Command="{Binding ApplySeverityCommand}" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- Resolución manual: plegada, que es una acción excepcional -->
                        <TextBlock Text="Resolución manual" Style="{StaticResource SubTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Cierra este hallazgo por decisión humana, sin auditoría — para código ya corregido o eliminado. Requiere justificación y queda registrado con tu nombre." />

                        <!-- Plegada, la cabecera tiene que verse ENTERA y leerse como expandible
                             (F5.6 §5). Sin `Padding`: la plantilla de WPF-UI se lo aplica a la
                             CABECERA, no al contenido, y por eso el título salía descolgado contra
                             el borde (D-231). El aire del contenido se lo pone el StackPanel de
                             dentro. Y la advertencia va en la propia cabecera, que es lo que la
                             distingue del combo de severidad de arriba (D-232). -->
                        <Expander IsExpanded="{Binding ManualResolutionExpanded}"
                                  HorizontalContentAlignment="Stretch"
                                  Margin="{StaticResource Pad.XXS.Top}"
                                  Visibility="{Binding CanResolveManually, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSize.Meta}"
                                               VerticalAlignment="Center" Margin="{StaticResource Pad.XS.Right}"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="Resolver a mano" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="— cierra el hallazgo sin auditar" FontSize="{StaticResource FontSize.Meta}"
                                               VerticalAlignment="Center" Margin="{StaticResource Pad.XS.Left}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="{StaticResource Pad.XS.Top}">
                                <TextBlock Text="Justificación (obligatoria)" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Justification}" HorizontalAlignment="Stretch"
                                            AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                            PlaceholderText="Qué se corrigió y dónde consta" />
                                <ui:Button Content="Resolver manualmente" Appearance="Danger" Margin="{StaticResource Pad.XS.Top}"
                                           Command="{Binding ResolveManuallyCommand}" />
                            </StackPanel>
                        </Expander>

                        <ui:Button Content="Reabrir" Command="{Binding ReopenCommand}" Margin="{StaticResource Pad.XXS.Top}"
                                   ToolTip="Devuelve el hallazgo a activo, con traza en el historial."
                                   Visibility="{Binding CanReopen, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Disputa: existe SOLO si hay disputa (F5.1b, F5.5 §4) -->
                        <StackPanel Visibility="{Binding ShowDispute, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Text="Disputa abierta" Style="{StaticResource SubTitle}" />
                            <TextBlock Style="{StaticResource Help}"
                                       Text="Un auditor sostiene que esto nunca fue un defecto. Lo decide una persona; las notas de arriba quedan escritas en la decisión." />
                            <Border CornerRadius="6" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.S.Bottom}"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                <TextBlock Text="{Binding DisputeSummary}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            </Border>
                            <!-- Cerrar un hallazgo como falso positivo lo saca de la lista para
                                 siempre con tu nombre encima: peligro, perfilado (D-949). -->
                            <Button Content="Es falso positivo" Style="{StaticResource Button.Danger}"
                                    HorizontalAlignment="Stretch" Margin="{StaticResource Pad.XXS.Bottom}"
                                    Command="{Binding AcceptDisputeCommand}"
                                       ToolTip="Da la razón al auditor que discrepó: se silencia como falso positivo, con tu nombre. No es una resolución." />
                            <ui:Button Content="Sigue siendo defecto" Style="{StaticResource SideAction}"
                                       Command="{Binding DismissDisputeCommand}"
                                       ToolTip="Da la razón a quien lo reportó: se retira la marca y el hallazgo sigue igual." />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
