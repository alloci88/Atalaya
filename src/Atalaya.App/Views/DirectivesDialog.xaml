<ui:FluentWindow
    x:Class="Atalaya.App.Views.DirectivesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    Title="Directivas del proyecto"
    Width="860"
    Height="640"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Directivas del proyecto" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,0">
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Los ficheros de convenciones que el equipo mantiene en el repositorio de esta aplicación: instrucciones de agentes, ADRs, specs, skills. Atalaya solo registra CUÁLES son; su contenido se lee del clon cada vez que se usa, así que siempre viaja la versión vigente. Informan el criterio del auditor y el estilo del arreglo — nunca cambian las reglas de la herramienta." />

            <!-- El presupuesto va arriba y siempre visible: es la decisión que condiciona todas las
                 demás de esta ventana. -->
            <Border CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding BudgetLabel}" TextWrapping="Wrap" FontSize="12" />
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Presupuesto (tokens) — 0 lo apaga" VerticalAlignment="Center"
                                   Margin="0,0,8,0" FontSize="12" />
                        <ui:TextBox Width="100" Margin="0,0,8,0"
                                    Text="{Binding Budget, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Es de ESTA aplicación y vive en su app.json: un monorepo lleno de ADRs no necesita lo mismo que un proyecto con un CLAUDE.md." />
                        <ui:Button Content="Aplicar presupuesto" Command="{Binding ApplyBudgetCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                    Background="#22D2B036" BorderBrush="#55D2B036" BorderThickness="1"
                    Visibility="{Binding IsOverBudget, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding OverBudgetNotice}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <Border CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                    Visibility="{Binding HasScanNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ScanNotice}" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <TextBlock Text="No se ha detectado ningún fichero de directivas y no hay ninguno registrado. Si este proyecto tiene convenciones escritas en otro sitio, añádelas a mano abajo."
                       Margin="0,14,0,0" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="22,12,14,0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DirectiveRow}">
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <StackPanel>
                                <!-- La casilla ACTIVA la directiva. Un candidato nace siempre sin
                                     marcar: la curación es humana (F7 §1). -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              ToolTip="Marcada, su contenido viaja en los prompts del ámbito elegido." />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="{Binding Path, Mode=OneWay}" FontFamily="Consolas" FontWeight="SemiBold" /></TextBlock>
                                </Grid>

                                <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding Kind, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Size, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Cost, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="{Binding Why}" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ámbito" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12" />
                                    <ComboBox Width="130" Margin="0,0,8,6"
                                              ItemsSource="{Binding Source={x:Static vm:DirectiveRow.ScopeOptions}}"
                                              SelectedItem="{Binding SelectedScope}"
                                              ToolTip="Auditoría informa el criterio del auditor y del verificador; Arreglo, el estilo del arreglo; Ambos, los dos." />
                                    <ui:Button Content="Guardar" Margin="0,0,8,6"
                                               Command="{Binding DataContext.ApplyScopeCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <TextBlock Text="Prioridad" VerticalAlignment="Center" Margin="0,0,8,6" FontSize="12" />
                                    <ui:TextBox Width="70" Margin="0,0,8,6"
                                                Text="{Binding Order, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="Menor entra antes cuando el presupuesto no da para todo." />
                                    <ui:Button Content="Aplicar prioridad" Margin="0,0,8,6"
                                               Command="{Binding DataContext.ApplyOrderCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Vista previa" Margin="0,0,8,6" Appearance="Secondary"
                                               Command="{Binding DataContext.TogglePreviewCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}" />
                                    <ui:Button Content="Retirar" Margin="0,0,0,6" Appearance="Secondary"
                                               Command="{Binding DataContext.ForgetCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"
                                               ToolTip="Quita la entrada del registro. Si el fichero sigue en el repositorio, volverá a proponerse como candidato." />
                                </WrapPanel>

                                <Border CornerRadius="4" Padding="10,8" Margin="0,8,0,0"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Preview}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap" MaxHeight="240" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- La válvula de F7 §1: lo que el catálogo no conoce se añade por su ruta. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="22,12,22,0">
            <TextBlock Text="Añadir a mano" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
            <ui:TextBox Width="420" Margin="0,0,8,0"
                        PlaceholderText="ruta/relativa/al/repo/CONVENCIONES.md"
                        Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Cualquier fichero del repositorio, aunque el catálogo no lo conozca." />
            <ui:Button Content="Añadir" Command="{Binding AddManualCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,12,22,18">
            <ui:Button Content="Cerrar" Click="OnClose" Appearance="Secondary" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
