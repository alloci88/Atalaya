<v:AtalayaDialog
    x:Class="Atalaya.App.Views.CycleConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:v="clr-namespace:Atalaya.App.Views"
    Title="{Binding Title}"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize">
    <Grid Background="{DynamicResource Brush.Bg}">
        <!-- EL DIÁLOGO PINTA SU FONDO (UI-0013). `FluentWindow` aplica su propio telón por
             debajo —`#FAFAFA` en claro, `#202020` en oscuro, los colores de fábrica de
             WPF-UI— y `MainWindow` lo tapa desde F26 §A justamente por eso; ninguno de los
             nueve diálogos lo hacía, así que abrir uno enseñaba otro programa encima de una
             aplicación crema. Y `PaletteContrastTests` pasaba en verde midiendo contra una
             superficie que la aplicación nunca declara.

             Y sus botones son los cuatro del sistema (UI-0014): el primario era el acento de
             Windows —`#1E9BFA`/`#0071C7`— y no el azul de la casa, y el botón que confirma un
             borrado irreversible no puede ser de otro color que el de Atalaya. El macizo de
             peligro se queda AQUÍ y solo aquí (UI-0039): destruir es lo que se ha venido a
             hacer a un diálogo de confirmación. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <c:DialogHeader Grid.Row="0" Title="{Binding Title}" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Dialog}">
            <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" Style="{StaticResource Dialog.Help}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- La temática: el catálogo cerrado de la casa, General primero y marcada como
                 recomendada. La frase de debajo dice qué significa la elegida, para que nadie
                 elija «Rendimiento» pensando que también mira lo demás. -->
            <TextBlock Text="Temática del ciclo" FontWeight="SemiBold" Margin="{StaticResource Pad.M.Top}" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme}"
                      DisplayMemberPath="Label"
                      Width="300" HorizontalAlignment="Left" Margin="{StaticResource Pad.XS.Top}"
                      ToolTip="Qué busca el auditor en este ciclo. Fuera de la temática no se reporta nada." />
            <TextBlock Text="{Binding ThemeDescription}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" Style="{StaticResource Dialog.Help}" />

            <!-- El aviso de cambiar con trabajo hecho. Solo aparece cuando cuesta algo. -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="{StaticResource Pad.XS.Right}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Style="{StaticResource Dialog.Help}" MaxWidth="470"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- El modelo preferido: la lista del proveedor de quien configura. Es preferencia,
                 no imposición, y la frase lo dice. -->
            <TextBlock FontWeight="SemiBold" Margin="{StaticResource Pad.M.Top}">
                <Run Text="Modelo preferido" /><Run Text=" · " /><Run Text="{Binding ProviderName}" FontWeight="Normal" />
            </TextBlock>
            <ComboBox ItemsSource="{Binding Models}"
                      SelectedValue="{Binding SelectedModelId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Label"
                      Width="300" HorizontalAlignment="Left" Margin="{StaticResource Pad.XS.Top}"
                      ToolTip="Con qué modelo prefiere el equipo auditar este ciclo. Quien lance con otro verá un aviso, y podrá seguir." />
            <TextBlock Text="{Binding ModelsNotice}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" Style="{StaticResource Dialog.Help}"
                       Foreground="{DynamicResource Brush.Warning.Ink}"
                       Visibility="{Binding HasModelsNotice, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" Style="{StaticResource Dialog.Help}" Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Es una preferencia compartida, no una imposición: no todo el mundo tiene las dos casas. Al lanzar con otro proveedor o modelo, el diálogo de lanzar lo avisa y deja continuar." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pad.M.Top}">
                <Button Content="Cancelar" Click="OnCancel" Margin="{StaticResource Pad.XS.Right}" />
                <Button x:Name="ApplyButton" Content="Aplicar" Click="OnApply" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</v:AtalayaDialog>
