<ui:FluentWindow
    x:Class="Atalaya.App.Views.CycleConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding Title}"
    Width="560"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title}" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,20">
            <TextBlock Text="{Binding AppName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- La temática: el catálogo cerrado de la casa, General primero y marcada como
                 recomendada. La frase de debajo dice qué significa la elegida, para que nadie
                 elija «Rendimiento» pensando que también mira lo demás. -->
            <TextBlock Text="Temática del ciclo" FontWeight="SemiBold" Margin="0,18,0,0" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedTheme}"
                      DisplayMemberPath="Label"
                      Width="300" HorizontalAlignment="Left" Margin="0,6,0,0"
                      ToolTip="Qué busca el auditor en este ciclo. Fuera de la temática no se reporta nada." />
            <TextBlock Text="{Binding ThemeDescription}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                       Opacity="0.75" />

            <!-- El aviso de cambiar con trabajo hecho. Solo aparece cuando cuesta algo. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="0,0,7,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" MaxWidth="470"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- El modelo preferido: la lista del proveedor de quien configura. Es preferencia,
                 no imposición, y la frase lo dice. -->
            <TextBlock FontWeight="SemiBold" Margin="0,18,0,0">
                <Run Text="Modelo preferido" /><Run Text=" · " /><Run Text="{Binding ProviderName}" FontWeight="Normal" />
            </TextBlock>
            <ComboBox ItemsSource="{Binding Models}"
                      SelectedValue="{Binding SelectedModelId}"
                      SelectedValuePath="Id"
                      DisplayMemberPath="Label"
                      Width="300" HorizontalAlignment="Left" Margin="0,6,0,0"
                      ToolTip="Con qué modelo prefiere el equipo auditar este ciclo. Quien lance con otro verá un aviso, y podrá seguir." />
            <TextBlock Text="{Binding ModelsNotice}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5"
                       Foreground="#E0A030"
                       Visibility="{Binding HasModelsNotice, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5" Opacity="0.65"
                       Text="Es una preferencia compartida, no una imposición: no todo el mundo tiene las dos casas. Al lanzar con otro proveedor o modelo, el diálogo de lanzar lo avisa y deja continuar." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cancelar" Click="OnCancel" Appearance="Secondary" Margin="0,0,8,0" />
                <ui:Button x:Name="ApplyButton" Content="Aplicar" Click="OnApply" Appearance="Primary" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
