<UserControl
    x:Class="Atalaya.App.Views.AssistedFixView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:services="clr-namespace:Atalaya.App.Services">

    <UserControl.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- · Una intervención de la conversación · -->
        <DataTemplate DataType="{x:Type services:FixMessage}">
            <Grid Margin="{StaticResource Pad.XXS.V}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Speaker}" FontSize="{StaticResource FontSize.Meta}" FontWeight="SemiBold"
                           VerticalAlignment="Top" Margin="{StaticResource Pad.XS}" TextAlignment="Right"
                           Style="{StaticResource Voice.Name}" />
                <Border Grid.Column="1" CornerRadius="6" Padding="{StaticResource Pad.Field}"
                        Background="{Binding Voice, Converter={StaticResource FixVoiceToFill}}">
                    <!-- Rejilla, NO StackPanel horizontal: un StackPanel horizontal mide a sus
                         hijos con ancho INFINITO, así que TextWrapping no envuelve nada y el
                         mensaje largo se sale del globo y se ve cortado. Con Auto+* el texto
                         recibe el ancho que queda y crece hacia abajo. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontWeight="Bold" Margin="{StaticResource Pad.XS.Right}"
                                   VerticalAlignment="Top" Opacity="0.9"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding Glyph, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- · Una pregunta esperando respuesta · -->
        <DataTemplate DataType="{x:Type services:FixQuestion}">
            <Border CornerRadius="8" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.Indent.XL}"
                    Style="{StaticResource Notice.Ask}">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Notice.Ask.Header}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Top}" FontSize="{StaticResource FontSize.Small}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- Opciones cerradas -->
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="{StaticResource Pad.S.Top}"
                                  Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <!-- Una opción por línea y a todo el ancho. Estas etiquetas no son «Sí/No»:
                             son consecuencias —«(A) lanzar excepción y adaptar los 7 llamadores»— y
                             se estarían eligiendo a ciegas si el botón las recortara. Nunca elipsis
                             aquí: el botón crece con su texto. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="{StaticResource Pad.XS.Bottom}" HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Command="{Binding DataContext.ChooseCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Content>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </Button.Content>
                                    <Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource QuestionChoicePair}">
                                            <Binding Path="DataContext"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            <Binding />
                                        </MultiBinding>
                                    </Button.CommandParameter>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Texto libre -->
                    <Grid Margin="{StaticResource Pad.XXS.Top}">
                        <Grid.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                <Binding Path="IsPending" />
                                <Binding Path="AllowFreeform" />
                            </MultiBinding>
                        </Grid.Visibility>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Se estira: un ancho fijo de 420 no cabe en la columna izquierda de una
                             pantalla de 1366 y empujaba el botón fuera de la tarjeta. -->
                        <ui:TextBox Grid.Column="0" PlaceholderText="…o contesta con tus palabras"
                                    Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
                        <!-- SECUNDARIO (UI-0021). Había DOS primarios a la vez en esta vista
                             —éste y «Enviar» del compositor— además de un aviso macizo y un
                             peligro macizo. De los dos campos de respuesta solo uno lleva el
                             primario, y es el compositor: es el canal que siempre está ahí. -->
                        <Button Grid.Column="1" Content="Responder" Margin="{StaticResource Pad.XS.Left}"
                                   Command="{Binding DataContext.AnswerFreeformCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </Grid>

                    <!-- Ya contestada -->
                    <TextBlock Margin="{StaticResource Pad.XS.Top}" FontSize="{StaticResource FontSize.Meta}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="Tu respuesta:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Answer, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <!-- BUGFIX-CUOTA: el aviso de error tiene FILA PROPIA. Compartia la fila 1 con el cuerpo
             de la sesion Y con el estado vacio: tres elementos en la misma celda, que en un Grid
             no reparten espacio sino que se superponen. El resultado, con el clon de XBLAST
             delante: «No se pudo arreglar» pintado encima de la conversacion del agente y de
             «Cambios en tu clon», texto sobre texto. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- El pie de sesión ya no tiene fila propia aquí: se ha mudado dentro del cuerpo,
                 que es lo que le da exactamente el ancho de los dos paneles (R4 §5). -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================================ CABECERA ================================ -->
        <!-- El reparto lo pone c:PageHeader: identidad a la izquierda (columna que encoge) y
             acciones a la derecha (columna que no cede). Antes eran dos StackPanel sueltos en un
             Grid sin columnas, que no reparte: superpone. Con el distintivo de proveedor de F16,
             «Pausar» acabó pintado encima de «Volver al hallazgo». -->
        <c:PageHeader Grid.Row="0" Margin="{StaticResource Pad.S.Bottom}">
            <!-- F16-RETOQUE §2·2 — el identificador aparece UNA vez. Salía truncado junto al
                 título («BUG-0012…») y otra vez entero dentro del rótulo del enlace, que es
                 leerlo dos veces y ninguna bien. Ahora vive en la fila de identidad, corto y
                 entero, y el enlace dice solo a dónde lleva. Lo que cede cuando falta sitio es el
                 nombre de la aplicación, que es lo único de esta zona que puede ser largo. -->
            <!-- LA FILA ENTERA SOBRE UNA SOLA LÍNEA BASE (R10 §6, ampliado en R11 §2). Eran tres
                 columnas de un `Grid`, y por eso «MEJ-0058» y «XBLAST» no compartían base con
                 «Arreglo asistido»: WPF no alinea líneas base entre celdas, y lo único que había
                 —`VerticalAlignment="Center"`— iguala el centro de las CAJAS. R10 metió los tres
                 textos en un `c:BaselineRow` y dejó fuera el enlace y el distintivo, que siguieron
                 quedando altos por lo mismo. Ahora entran los cinco: identificador, aplicación,
                 enlace y pastilla apoyan en la base del título.

                 Ya no hace falta rejilla ni tope: la fila empaqueta a la izquierda, así que el
                 enlace y el distintivo quedan pegados a la identidad sin que nadie tenga que
                 reservarles una columna. Y sigue midiendo de izquierda a derecha con lo que queda,
                 que es lo que hace que ceda lo último —el distintivo, que `c:ChipHost` retira
                 entero si no cabe (UI-0011)— y no el título. -->
            <c:BaselineRow Gap="{StaticResource Space.S}" VerticalAlignment="Center"
                           HorizontalAlignment="Left">
                    <!-- EL TÍTULO LO DICE EL VIEW-MODEL, no el XAML (UI-0029). Estaba escrito aquí
                         a mano, así que al terminar el arreglo la entrada del raíl pasaba a
                         «Último arreglo» y la página seguía diciendo «Arreglo asistido»: en la
                         misma pantalla, los tres sitios que dicen dónde estás decían dos cosas.
                         Ahora el rótulo del raíl, el título y el último eslabón de la miga salen
                         de la misma propiedad. -->
                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                               Style="{StaticResource Text.Name}"
                               FontSize="{StaticResource FontSize.H2}" FontWeight="SemiBold" />
                    <!-- El identificador, sin recorte: un alias a medias no identifica. -->
                    <TextBlock Text="{Binding FindingAliasText, Mode=OneWay}"
                               Style="{StaticResource Text.Name}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               ToolTip="El hallazgo que se está arreglando" />
                    <!-- El nombre de la aplicación: lo único de la zona que puede ser largo, así
                         que es lo que cede. Con el MISMO tamaño y la MISMA tinta secundaria que el
                         identificador (R10 §6): iba en `Brush.TextFaint`, un tercer nivel de gris
                         para una pieza que es hermana de la de al lado. -->
                    <TextBlock Text="{Binding AppNameText}"
                               Style="{StaticResource Text.Name}"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               MaxWidth="{StaticResource Header.AppNameMaxWidth}"
                               ToolTip="{Binding AppNameText}" />
                <!-- H9.1 §1: el camino de vuelta al hallazgo, disponible mientras haya sesión que
                     mirar —corriendo, terminada o fallida—, no solo en la pantalla de cierre.

                     Va ANTES del distintivo (F16-RETOQUE §2). Cuando no hay ancho, la cabecera
                     recorta la identidad por la derecha, así que el orden decide qué se pierde
                     primero: entre un camino que se pulsa y un dato que se lee, se pierde el
                     dato — y el dato, además, está entero en el informe. -->
                <!-- R6 §7: el enlace del SISTEMA, no el `LinkButton` de antes de F26 —que pinta con
                     las brochas de la librería y no con la paleta de la casa—. Es uno de los seis
                     controles que no daban ninguna señal al pasar el ratón.

                     SIN margen propio (R11 §2): el hueco lo pone el `Gap` de la fila, una vez y
                     para todos. -->
                <Button Content="{Binding BackToFindingLabel}" Command="{Binding BackToFindingCommand}"
                        Style="{StaticResource Button.Link}"
                        FontSize="{StaticResource FontSize.Small}"
                        ToolTip="Abre la ficha del hallazgo que originó este arreglo">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                            <Binding Path="HasSession" />
                            <Binding Path="CanGoBackToFinding" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <!-- F16: la pantalla es la misma con los dos motores, así que dice cuál trabaja. -->
                <!-- SIN recorte y sin ancho maximo (D-983). Un dato de 30 caracteres con
                     `MaxWidth=220` se corta siempre, y lo que se cortaba era el modelo. Y la
                     pastilla usa el estilo del sistema en vez de un `#18808080` escrito a mano,
                     que era el mismo gris en los dos temas.

                     Y SI NO CABE ENTERA, NO SE PINTA (P-01, UI-0011). Quitarle el ancho máximo no
                     bastó: a 1280 la columna se apretaba igual y la pastilla se cortaba a mitad de
                     palabra hasta dejar «Age» —y en el cierre, «Agente falso · clau»—, así que el
                     modelo con el que se está tocando el código dejaba de estar escrito y lo que
                     quedaba no se podía interpretar. «Age» no es una versión corta de «Agente
                     falso · claude-opus-4.7»: es otra palabra. `c:ChipHost` la retira entera
                     cuando no cabe; el dato sigue en el tooltip. -->
                <c:ChipHost Visibility="{Binding HasEngine, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Pill}"
                            ToolTip="El proveedor y el modelo que están haciendo este arreglo. Quedan escritos en el informe.">
                        <TextBlock Text="{Binding EngineText}" Style="{StaticResource Pill.Text}" />
                    </Border>
                </c:ChipHost>
            </c:BaselineRow>
            <!-- Barra de acciones. F16-RETOQUE §2·3 y §2·4, dos reglas:

                 · Aquí solo va lo que SE PULSA. «Compilar solución completa» no es una acción sino
                   un ajuste de la sesión, y se ha ido al pie, junto al resultado del build — que
                   es el sitio donde se ve su consecuencia.

                 · Y la destructiva no viaja entre las de control. Pausar, Detener y Cerrar
                   gobiernan la sesión; «Descartar todo» deshace el trabajo, y va la última, con
                   más aire del que separa a las demás. Estaba en medio, entre Pausar y Cerrar. -->
            <!-- SON UN GRUPO, y hasta D-983 no lo parecian: tres `ui:Button` de la libreria con
                 tres `Appearance` distintas traen tres rellenos y tres alturas, y encima las
                 separaciones se escribian control a control —12 a la derecha de unos, 12 a la
                 izquierda del ultimo, o sea 24 entre los dos de en medio—. Se veian como tres
                 botones sueltos que coinciden en una esquina.

                 Ahora son los botones del sistema: misma altura minima, mismo relleno horizontal
                 y una sola separacion, puesta por `Stack.Gap` en el contenedor, que es lo unico
                 que garantiza que sea la misma para todos. El significado lo sigue diciendo el
                 color, que es lo que se queria: Pausar secundario, Detener aviso, Descartar todo
                 peligro. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        c:Stack.Gap="{StaticResource Space.S}">
                <Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                        ToolTip="Mientras esté en pausa no se aplicará ningún cambio ni se compilará nada. El agente puede seguir razonando."
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Detener" Command="{Binding StopCommand}"
                        Style="{StaticResource Button.WarningSolid}"
                        ToolTip="Para al agente. Lo que ya haya aplicado se queda."
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <!-- BUGFIX-CIERRE: archivar la pantalla del arreglo. Apariencia neutra a
                     proposito: no revierte nada, y el gesto destructivo es el de al lado. -->
                <Button Content="Cerrar" Command="{Binding CloseCommand}"
                        ToolTip="Archiva esta pantalla y vuelve al hallazgo. No revierte nada: si el agente dejo ficheros tocados, te pregunta que hacer con ellos."
                        Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
                <!-- PERFILADA, NO MACIZA (UI-0039). D-999 §4 dejó la regla escrita —perfilado
                     por defecto, macizo solo cuando la acción de ese color ES la acción de la
                     vista— y aquí no se cumplía: en el cierre del arreglo «Descartar todo» seguía
                     macizo arriba a la derecha mientras el paso siguiente real, «Verificar
                     ahora», estaba abajo. El macizo se reserva para el diálogo de confirmación,
                     que es donde destruir es lo que se ha venido a hacer. -->
                <!-- EL BOTÓN Y SU RAZÓN SON UNA PIEZA (P-27, R10 §7, colocada en R11 §4). Iban
                     sueltos en la barra, y ahí la razón no tenía ni hueco propio ni tope: un
                     `StackPanel` horizontal mide a sus hijos con ancho INFINITO, así que el `Wrap`
                     de `Reason.Text` no envuelve nunca y la pastilla crece cuanto haga falta hasta
                     que la cabecera la recorta contra el botón que explica. Dentro de su propio
                     panel, la razón va a 8 px del botón —el mismo hueco que en Inventario, con la
                     misma pastilla ámbar del sistema— y con un tope que la hace envolver en vez de
                     empujar. -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Descartar todo" Command="{Binding DiscardAllCommand}"
                            Style="{StaticResource Button.Danger}"
                            IsEnabled="{Binding CanDiscardAll}"
                            ToolTip="Devuelve cada fichero tocado a como estaba antes de esta sesión." />
                    <Border Style="{StaticResource Reason.Chip}"
                            Margin="{StaticResource Pad.XS.Left}"
                            MaxWidth="{StaticResource Reason.MaxWidth}"
                            Visibility="{Binding HasDiscardBlockedReason, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding DiscardBlockedReason}" Style="{StaticResource Reason.Text}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </c:PageHeader>

        <!-- ================================ SIN SESIÓN ================================ -->
        <ScrollViewer Style="{StaticResource Scroll}" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aquí no hay ninguna sesión de arreglo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="El arreglo asistido se lanza desde la ficha de un hallazgo, con «Arreglar con agente». El agente edita tu clon local mientras te explica lo que hace y te pregunta en los momentos de decisión; commitear sigue siendo cosa tuya." />
                    </StackPanel>
                </Border>

                <!-- Cambios de sesiones anteriores que siguen sin cerrar. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Arreglos anteriores sin cerrar" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="{StaticResource Pad.XS.Bottom}"
                                   Text="Estos cambios los aplicó un arreglo asistido y siguen en tu clon. Puedes descartarlos —vuelven byte a byte a como estaban— o darlos por buenos para dejar de verlos aquí." />
                        <ItemsControl ItemsSource="{Binding Pending}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.XXS.V}"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="{StaticResource FontSize.Meta}" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}"
                                                           Margin="{StaticResource Pad.XXS.Top}" Opacity="0.8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource Button.Danger}" Content="Descartar" Margin="{StaticResource Pad.XS.Left}"
                                                           Command="{Binding DataContext.DiscardPendingCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <Button Content="Los mantengo" Margin="{StaticResource Pad.XS.Left}"
                                                           Command="{Binding DataContext.KeepPendingCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================ EL FALLO ================================ -->
        <!-- Mismo aviso que en la sesion de auditoria, y por las mismas razones: en su fila, con
             el texto seleccionable (TextBox de solo lectura, no TextBlock), con boton de copiar y
             con el error crudo del proveedor plegado tras «Ver detalle» dentro de un ScrollViewer
             acotado, para que su longitud no decida el layout. -->
        <Border Grid.Row="1" CornerRadius="8" Padding="{StaticResource Pad.M}" Margin="{StaticResource Pad.S.Bottom}"
                Style="{StaticResource Notice.Danger}"
                Visibility="{Binding ShowFailure, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="{StaticResource FontSize.Lead}"
                               Foreground="{DynamicResource Brush.Danger.Ink}" VerticalAlignment="Center" Margin="{StaticResource Pad.XS.Right}" />
                    <TextBlock Text="No se pudo arreglar" FontSize="{StaticResource FontSize.Lead}" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Text="{Binding FailureMessage, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                         TextWrapping="Wrap" BorderThickness="0" BorderBrush="Transparent"
                         Background="Transparent" Padding="{StaticResource Pad.Zero}" Margin="{StaticResource Pad.XS.Top}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <!-- Lo que le ha pasado a SU clon, que no es una frase fija: si el agente ya habia
                     escrito antes del corte, decir «no se ha tocado» seria mentir justo cuando
                     importa saberlo. -->
                <TextBlock Margin="{StaticResource Pad.XS.Top}" FontSize="{StaticResource FontSize.Meta}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding FailureCloneNote}" />

                <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}">
                    <Button Content="{Binding DetailToggleLabel}" FontSize="{StaticResource FontSize.Meta}"
                               Command="{Binding ToggleFailureDetailCommand}"
                               Visibility="{Binding HasFailureDetail, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Copiar error" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Left}"
                               Command="{Binding CopyFailureCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Content="Elegir modelo en Ajustes" Margin="{StaticResource Pad.XS.Left}"
                               Command="{Binding FixModelCommand}"
                               Visibility="{Binding FailureOffersModelChange, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <Border Margin="{StaticResource Pad.S.Top}" CornerRadius="6" Padding="{StaticResource Pad.S}" Background="{DynamicResource Brush.Bg}"
                        Visibility="{Binding IsFailureDetailExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer Style="{StaticResource Scroll}" MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding FailureDetail, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                 TextWrapping="Wrap" BorderThickness="0" BorderBrush="Transparent"
                                 Background="Transparent" Padding="{StaticResource Pad.Zero}"
                                 FontFamily="Consolas" FontSize="{StaticResource FontSize.Meta}"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================================ CUERPO ================================ -->
        <Grid Grid.Row="2" Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.15*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <!-- EL PIE VIVE EN ESTA MISMA REJILLA (R4 §5). Estaba en una fila de la rejilla raíz,
                 así que su ancho y el de los dos paneles eran dos medidas independientes que había
                 que mantener iguales a mano —y dos números así acaban siendo distintos (D-966)—.
                 Ahora es la fila de abajo de la rejilla de los paneles, cruzando sus tres columnas:
                 empieza donde empieza la conversación y acaba donde acaba «Cambios en tu clon»
                 porque son literalmente los mismos carriles, y lo seguirá haciendo cuando el
                 separador se arrastre o cambie el reparto. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- · Conversación (la protagonista) · -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Bg}" CornerRadius="8" Padding="{StaticResource Pad.XXS}"
                    Visibility="{Binding ShowClosing, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <!-- Campo de entrada SIEMPRE disponible: interrumpir y dirigir es la mitad
                         del producto (F6.9 §4). -->
                    <Grid DockPanel.Dock="Bottom" Margin="{StaticResource Pad.RowTight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    PlaceholderText="Dile algo al agente: «no toques ese fichero», «prefiero TryParse»…"
                                    Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="OnDraftKeyDown"
                                    IsEnabled="{Binding IsRunning}" />
                        <Button Style="{StaticResource Button.Primary}" Grid.Column="1" Content="Enviar" Margin="{StaticResource Pad.XS.Left}"
                                   Command="{Binding SendCommand}" IsEnabled="{Binding IsRunning}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="{StaticResource Pad.RowTight}">
                        <Button Content="↓ Volver al final" Command="{Binding BackToBottomCommand}"
                                   Padding="{StaticResource Pad.Pill}" FontSize="{StaticResource FontSize.Meta}" HorizontalAlignment="Right"
                                   Visibility="{Binding AutoScroll, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <!-- EL BORDE DE LA CONVERSACIÓN DICE QUE HAY MÁS (UI-0028). El panel empezaba
                         pegado a la cabecera, sin relleno y sin nada que marcara su borde, y como
                         el hilo se auto-desplaza al final, lo que quedaba arriba era un mensaje
                         seccionado a media altura de glifo: no parecía un texto que continuara
                         hacia arriba, parecía un texto roto. `Scroll` le da su media línea de aire
                         y el degradado dice lo que el aire no puede decir — que sigue. -->
                    <Grid>
                        <ScrollViewer Style="{StaticResource Scroll}" x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto"
                                      ScrollChanged="OnConversationScrollChanged">
                            <ItemsControl ItemsSource="{Binding Conversation}" Margin="{StaticResource Pad.XS}" />
                        </ScrollViewer>
                        <Rectangle Style="{StaticResource Scroll.Fade.Top}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding ShowClosing, Converter={StaticResource InverseBoolToVisibility}}" />

            <!-- · Diff · -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface2}" CornerRadius="8" Padding="{StaticResource Pad.S}"
                    Visibility="{Binding ShowClosing, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Pad.XS.Bottom}">
                        <TextBlock Text="Cambios en tu clon" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Cada pestaña es un fichero tocado. El diff compara con lo que había ANTES de esta sesión, que es lo que tendrás que revisar antes de commitear."
                                   Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Todavía no se ha modificado ningún fichero."
                                   Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Files}" Margin="{StaticResource Pad.XS.Top}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="{StaticResource Pad.XS}" Padding="{StaticResource Pad.Pill}" Cursor="Hand" BorderThickness="1"
                                            Command="{Binding DataContext.SelectFileCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RelativePath}"
                                            Background="{Binding IsSelected, Converter={StaticResource SelectedTabToFill}}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠" Margin="{StaticResource Pad.XXS.Right}" Foreground="{DynamicResource Brush.Warning.Ink}" FontSize="{StaticResource FontSize.Meta}"
                                                       ToolTip="Fichero fuera del hallazgo: lo autorizaste durante la sesión"
                                                       Visibility="{Binding InScope, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!-- Nombre largo: elipsis EN MEDIO, nunca al final —lo que
                                                 identifica un fichero es su nombre, y la extensión dice
                                                 de qué se trata—. La ruta entera va en el ToolTip. -->
                                            <TextBlock FontSize="{StaticResource FontSize.Meta}"
                                                       Text="{Binding FileName, Converter={StaticResource MiddleEllipsis}, ConverterParameter=28}" />
                                            <TextBlock Text="{Binding Tally}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.7" Margin="{StaticResource Pad.XS.Left}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer Style="{StaticResource Scroll}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedFile}">
                        <StackPanel>
                            <TextBlock FontSize="{StaticResource FontSize.Meta}" Opacity="0.75" Margin="{StaticResource Pad.XXS}"
                                       ToolTip="{Binding RelativePath}"
                                       Text="{Binding RelativePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=52}" />
                            <TextBlock Text="{Binding ScopeNote}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.6" Margin="{StaticResource Pad.XXS}"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding Kind, Converter={StaticResource DiffKindToFill}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" Style="{StaticResource Diff.Number}" />
                                            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" Style="{StaticResource Diff.Number}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Marker}" Style="{StaticResource Diff.Marker}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Text}" Style="{StaticResource Diff.Text}"
                                                       TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============================ PANTALLA DE CIERRE ============================ -->
            <!-- H9.1 §4: al llegar fix_done esta pantalla aparece y hay que ATERRIZAR en ella —
                 arriba del todo, con la rueda funcionando—. El aviso de visibilidad es lo que lo
                 dispara: se levanta una sola vez, cuando de verdad cambia. -->
            <!-- La tarjeta del SISTEMA, no la de la libreria (D-983): `Card` sale de nuestra
                 paleta y cambia con el tema como todo lo demas; los pinceles de WPF-UI son los
                 suyos, y por eso el suelo de la ventana se quedaba con el gris de fabrica hasta
                 que se pinto a mano (D-957). Misma razon, un nivel mas abajo. -->
            <Border x:Name="ClosingPanel" Grid.Column="0" Grid.ColumnSpan="3"
                    Style="{StaticResource Card}"
                    Padding="{StaticResource Pad.L}"
                    IsVisibleChanged="OnClosingShown"
                    Visibility="{Binding ShowClosing, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="{StaticResource Pad.M.Bottom}">
                        <!-- EL TITULAR LO DICE EL VIEW-MODEL (R10 §7): sin ficheros tocados no hay
                             nada que dar por terminado, y «Arreglo terminado» sobre un clon intacto
                             es la primera de las cuatro cosas que esta pantalla afirmaba de más. -->
                        <TextBlock Text="{Binding ClosingHeadline}" FontSize="{StaticResource FontSize.H3}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Fix.StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                                   FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Top}" />
                        <!-- UN AVISO ES ICONO, TEXTO Y —SI LA HAY— LA ACCIÓN (UI-0052). Aquí
                             «esto es un aviso» viajaba solo en el color: relleno ámbar y una frase,
                             sin el icono que llevan los de Métricas y Ajustes. El mismo control
                             salía en tres formas distintas según la vista.

                             Y SOLO SI HAY CAMBIOS (R10 §7): decir «los cambios están en tu clon sin
                             commitear» cuando no hay ninguno no es un matiz, es una advertencia
                             falsa que manda a mirar un `git status` limpio. -->
                        <Border Style="{StaticResource Notice.Warning}" Margin="{StaticResource Pad.S.Top}"
                                Visibility="{Binding ClosedWithChanges, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Style="{StaticResource Notice.Text}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}"
                                           Text="Los cambios están en tu clon sin commitear — revisa y commitea cuando estés conforme. Arreglar no resuelve el hallazgo: sigue activo hasta que lo verifiques." />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- LAS ACCIONES QUE APLICAN, Y NINGUNA MÁS (R10 §7). Sin ficheros tocados
                         quedan dos: leer lo que pasó y abrir el clon. «Verificar ahora» mediría un
                         cambio que no existe y «Me quedo los cambios» cerraría un conjunto vacío;
                         las dos preguntan por algo que nadie escribió. -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="{StaticResource Pad.M.Top}">
                        <Button Style="{StaticResource Button.Primary}" Content="Verificar ahora" Command="{Binding VerifyNowCommand}"
                                Visibility="{Binding ClosedWithChanges, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Abrir en el editor" Command="{Binding OpenInEditorCommand}" Margin="{StaticResource Pad.XS.Left}" />
                        <Button Content="Ver informe" Command="{Binding OpenReportCommand}" Margin="{StaticResource Pad.XS.Left}" />
                        <Button Content="Me quedo los cambios" Command="{Binding FinishCommand}" Margin="{StaticResource Pad.XS.Left}"
                                Visibility="{Binding ClosedWithChanges, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- LA BARRA FIJA NO SIEGA UNA LÍNEA (UI-0037). Recortaba el contenido en
                         seco: la de debajo se veía a media altura de glifo, sin elipsis y sin nada
                         que dijera que había más. Aquí era peor que en ningún sitio — el titular
                         «Resultado del último build/tests» quedaba a la vista y su única línea de
                         contenido, tapada: un epígrafe sin cuerpo. -->
                    <Grid>
                    <ScrollViewer Style="{StaticResource Scroll}" x:Name="ClosingScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Qué cambió y por qué" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Fix.Summary}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="Riesgos declarados" Style="{StaticResource SectionTitle}" Margin="{StaticResource Pad.SectionGapWide}"
                                       Visibility="{Binding Fix.Risks, Converter={StaticResource NotEmptyToVisibility}}" />
                            <TextBlock Text="{Binding Fix.Risks}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}" Foreground="{DynamicResource Brush.Warning.Ink}"
                                       Visibility="{Binding Fix.Risks, Converter={StaticResource NotEmptyToVisibility}}" />

                            <!-- EL BLOQUE NO SE PINTA SI NO HAY FICHEROS (R11 §3). Con «Arreglo
                                 detenido · no hay cambios en tu clon» arriba, «Ficheros tocados»
                                 salía igual: un titular con nada debajo, que se lee como una lista
                                 que no ha cargado y no como una lista vacía. -->
                            <TextBlock Text="Ficheros tocados" Style="{StaticResource SectionTitle}" Margin="{StaticResource Pad.SectionGapWide}"
                                       Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="{StaticResource Pad.XXS.V}" Cursor="Hand"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Command="{Binding DataContext.SelectFileCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <WrapPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="{StaticResource FontSize.Meta}"
                                                           ToolTip="{Binding RelativePath}"
                                                           Text="{Binding RelativePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=60}" />
                                                <TextBlock Text="{Binding Tally}" FontSize="{StaticResource FontSize.Meta}" Opacity="0.7" Margin="{StaticResource Pad.XS.Left}" />
                                                <TextBlock Text="fuera del hallazgo, autorizado por ti" FontSize="{StaticResource FontSize.Meta}"
                                                           Foreground="{DynamicResource Brush.Warning.Ink}" Margin="{StaticResource Pad.XS.Left}"
                                                           Visibility="{Binding InScope, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </WrapPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Y EL BUILD, IGUAL (R11 §3). Sin compilación pedida, esto era un
                                 titular de sección con «build/tests: no se ha pedido» debajo:
                                 dos líneas para decir que no hay nada. Cuando no se pidió, una
                                 línea y ninguna sección. -->
                            <TextBlock Text="No se pidió compilar" Style="{StaticResource Help}"
                                       Margin="{StaticResource Pad.SectionGapWide}"
                                       Visibility="{Binding HasBuildResult, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="Resultado del último build/tests" Style="{StaticResource SectionTitle}"
                                       Margin="{StaticResource Pad.SectionGapWide}"
                                       Visibility="{Binding HasBuildResult, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding BuildText}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XXS.Bottom}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding HasBuildResult, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Qué se compiló, dicho aparte: un veredicto sin ámbito no se puede
                                 interpretar (H9.1 §2). -->
                            <TextBlock Text="{Binding BuildScopeText}" TextWrapping="Wrap" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Bottom}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding BuildScopeText, Converter={StaticResource NotEmptyToVisibility}}" />
                            <Border CornerRadius="6" Padding="{StaticResource Pad.Notice}" Background="{DynamicResource Brush.Bg}"
                                    Visibility="{Binding Fix.LastBuild, Converter={StaticResource NotEmptyToVisibility}}">
                                <!-- El tope de altura solo vale si lo que sobra se puede alcanzar:
                                     antes recortaba la salida del build sin decirlo. -->
                                <!-- Cede la rueda al llegar a su tope (patrón de la casa,
                                     SnippetScroll): si no, bajar por la pantalla de cierre pasando
                                     el cursor por encima de la salida del build era una lotería, y
                                     la tarjeta de commit quedaba fuera de alcance. -->
                                <ScrollViewer Style="{StaticResource Scroll}" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="OnInnerScroll">
                                    <TextBlock Text="{Binding Fix.LastBuild}" FontFamily="Consolas" FontSize="{StaticResource FontSize.Meta}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </ScrollViewer>
                            </Border>

                            <!-- · La sugerencia de commit, en su tarjeta propia y EDITABLE ·

                                 SOLO SI HAY QUE COMMITEAR ALGO (R10 §7). Era la pieza más dañina de
                                 las cuatro que sobraban en un arreglo sin cambios: un título y una
                                 descripción redactados para un trabajo que nadie hizo, listos para
                                 copiar y commitear. -->
                            <Border CornerRadius="8" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.M.Top}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    Visibility="{Binding ClosedWithChanges, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Sugerencia de commit" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Help}" Margin="{StaticResource Pad.XS.Bottom}"
                                               Text="Atalaya no commitea: esto solo te ahorra redactarlo. Edítalo a tu gusto y cópialo." />
                                    <TextBlock Text="Título" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XXS}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Text="{Binding Commit.Title, UpdateSourceTrigger=PropertyChanged}" />
                                    <!-- El aviso de titulo largo, en ambar de la paleta y no en un
                                         `#E0A030` escrito a mano que no cambia con el tema (UI-0008). -->
                                    <TextBlock Text="{Binding Commit.TitleLengthNote}" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XXS.Top}"
                                               HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Commit.TitleIsLong}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Ink}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Descripción" FontSize="{StaticResource FontSize.Meta}" Margin="{StaticResource Pad.XS.Top}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Text="{Binding Commit.Description, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                                VerticalScrollBarVisibility="Auto"
                                                PreviewMouseWheel="OnInnerScroll" />
                                    <Button Style="{StaticResource Button.Primary}" Content="Copiar" Command="{Binding CopyCommitCommand}" HorizontalAlignment="Left" Margin="{StaticResource Pad.S.Top}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Rectangle Style="{StaticResource Scroll.Fade.Bottom.Surface}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ================================ PIE ================================ -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="{DynamicResource Brush.Surface2}" CornerRadius="8"
                    Padding="{StaticResource Pad.Field}" Margin="{StaticResource Pad.S.Top}">
                <!-- F17-RETOQUE: el WrapPanel bajaba de línea lo que no cabía, y el StackPanel de la
                     auditoría lo cortaba; ninguno de los dos abreviaba. Ahora los textos van en una
                     FooterLine que reparte por prioridad —llamadas → coste → tokens— y nunca trunca;
                     el detalle entero está en su tooltip. El anillo de build y el ajuste del ámbito
                     quedan a la derecha, en columna propia, para que no compitan con los textos. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:FooterLine x:Name="Footer" Grid.Column="0" Segments="{Binding Footer}" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource Pad.M.Left}">
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="{StaticResource Pad.S.Right}" VerticalAlignment="Center"
                                     Visibility="{Binding Fix.IsBuilding, Converter={StaticResource BoolToVisibility}}" />
                    <!-- H9.1 §2: el ámbito de la compilación es decisión del USUARIO. El agente no
                         puede tocarlo: él no sabe si este cambio puede haber roto a un vecino, ni paga
                         el tiempo de averiguarlo.

                         F16-RETOQUE §2·3 — y vive AQUÍ, no en la cabecera. Estaba entre los botones de
                         la barra de acciones, que es donde va lo que se pulsa para que pase algo; esto
                         no hace nada al marcarlo, cambia lo que hará el siguiente build. Su sitio es
                         al lado del resultado de ese build, que es donde se ve su consecuencia. -->
                    <CheckBox Content="Compilar solución completa" IsChecked="{Binding BuildFullSolution}"
                              VerticalAlignment="Center" FontSize="{StaticResource FontSize.Meta}"
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                              ToolTip="Por defecto se compila solo el proyecto de los ficheros tocados y sus tests, que es lo que el veredicto puede atribuir al cambio. Marcando esto se compila la solución entera y los errores se cuentan contra una línea base del mismo commit." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
