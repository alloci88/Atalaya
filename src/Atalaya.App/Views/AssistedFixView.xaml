<UserControl
    x:Class="Atalaya.App.Views.AssistedFixView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Atalaya.App.Services">

    <UserControl.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- · Una intervención de la conversación · -->
        <DataTemplate DataType="{x:Type services:FixMessage}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Speaker}" FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Top" Margin="0,2,8,0" TextAlignment="Right"
                           Foreground="{Binding Voice, Converter={StaticResource FixVoiceToBrush}}" />
                <Border Grid.Column="1" CornerRadius="6" Padding="10,7"
                        Background="{Binding Voice, Converter={StaticResource FixVoiceToFill}}">
                    <!-- Rejilla, NO StackPanel horizontal: un StackPanel horizontal mide a sus
                         hijos con ancho INFINITO, así que TextWrapping no envuelve nada y el
                         mensaje largo se sale del globo y se ve cortado. Con Auto+* el texto
                         recibe el ancho que queda y crece hacia abajo. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontWeight="Bold" Margin="0,0,8,0"
                                   VerticalAlignment="Top" Opacity="0.9"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Visibility="{Binding Glyph, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- · Una pregunta esperando respuesta · -->
        <DataTemplate DataType="{x:Type services:FixQuestion}">
            <Border CornerRadius="8" Padding="14,12" Margin="76,8,0,8"
                    Background="#22E0A030" BorderBrush="#66E0A030" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" Foreground="#E0A030" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- Opciones cerradas -->
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,10,0,0"
                                  Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <!-- Una opción por línea y a todo el ancho. Estas etiquetas no son «Sí/No»:
                             son consecuencias —«(A) lanzar excepción y adaptar los 7 llamadores»— y
                             se estarían eligiendo a ciegas si el botón las recortara. Nunca elipsis
                             aquí: el botón crece con su texto. -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Left"
                                           Command="{Binding DataContext.ChooseCommand,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ui:Button.Content>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </ui:Button.Content>
                                    <ui:Button.CommandParameter>
                                        <MultiBinding Converter="{StaticResource QuestionChoicePair}">
                                            <Binding Path="DataContext"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                            <Binding />
                                        </MultiBinding>
                                    </ui:Button.CommandParameter>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Texto libre -->
                    <Grid Margin="0,4,0,0">
                        <Grid.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                <Binding Path="IsPending" />
                                <Binding Path="AllowFreeform" />
                            </MultiBinding>
                        </Grid.Visibility>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Se estira: un ancho fijo de 420 no cabe en la columna izquierda de una
                             pantalla de 1366 y empujaba el botón fuera de la tarjeta. -->
                        <ui:TextBox Grid.Column="0" PlaceholderText="…o contesta con tus palabras"
                                    Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Content="Responder" Margin="8,0,0,0" Appearance="Primary"
                                   Command="{Binding DataContext.AnswerFreeformCommand,
                                             RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                    </Grid>

                    <!-- Ya contestada -->
                    <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsAnswered, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="Tu respuesta:" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Answer, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================ CABECERA ================================ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Arreglo asistido" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HeaderText}" Opacity="0.6" VerticalAlignment="Bottom" Margin="12,0,0,4" />
            </StackPanel>
            <!-- Barra de acciones: pausar, descartar, detener. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}"
                           Margin="0,0,8,0"
                           ToolTip="Mientras esté en pausa no se aplicará ningún cambio ni se compilará nada. El agente puede seguir razonando."
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Descartar todo" Command="{Binding DiscardAllCommand}"
                           Appearance="Danger" Margin="0,0,8,0"
                           ToolTip="Devuelve cada fichero tocado a como estaba antes de esta sesión." />
                <ui:Button Content="Detener" Command="{Binding StopCommand}" Appearance="Caution"
                           ToolTip="Para al agente. Lo que ya haya aplicado se queda."
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- ================================ SIN SESIÓN ================================ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aquí no hay ninguna sesión de arreglo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="El arreglo asistido se lanza desde la ficha de un hallazgo, con «Arreglar con agente». El agente edita tu clon local mientras te explica lo que hace y te pregunta en los momentos de decisión; commitear sigue siendo cosa tuya." />
                    </StackPanel>
                </Border>

                <!-- Cambios de sesiones anteriores que siguen sin cerrar. -->
                <Border Style="{StaticResource Card}"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Arreglos anteriores sin cerrar" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8"
                                   Text="Estos cambios los aplicó un arreglo asistido y siguen en tu clon. Puedes descartarlos —vuelven byte a byte a como estaban— o darlos por buenos para dejar de verlos aquí." />
                        <ItemsControl ItemsSource="{Binding Pending}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,8" Margin="0,4"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11"
                                                           Margin="0,3,0,0" Opacity="0.8" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="Descartar" Appearance="Danger" Margin="8,0,0,0"
                                                           Command="{Binding DataContext.DiscardPendingCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                                <ui:Button Content="Los mantengo" Margin="8,0,0,0"
                                                           Command="{Binding DataContext.KeepPendingCommand,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================================ EL FALLO ================================ -->
        <Border Grid.Row="1" VerticalAlignment="Top" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                Background="#22C04040" BorderBrush="#66C04040" BorderThickness="1"
                Visibility="{Binding ShowFailure, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="No se pudo arreglar" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FailureMessage}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Tu clon no se ha tocado. El generador de prompt de arreglo de la ficha sigue disponible." />
                <ui:Button Content="Elegir modelo en Ajustes" Margin="0,12,0,0" Appearance="Primary"
                           Command="{Binding FixModelCommand}"
                           Visibility="{Binding FailureOffersModelChange, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ================================ CUERPO ================================ -->
        <Grid Grid.Row="1" Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.15*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- · Conversación (la protagonista) · -->
            <Border Grid.Column="0" Background="#0C000000" CornerRadius="8" Padding="4">
                <DockPanel>
                    <!-- Campo de entrada SIEMPRE disponible: interrumpir y dirigir es la mitad
                         del producto (F6.9 §4). -->
                    <Grid DockPanel.Dock="Bottom" Margin="8,6,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0"
                                    PlaceholderText="Dile algo al agente: «no toques ese fichero», «prefiero TryParse»…"
                                    Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                    KeyDown="OnDraftKeyDown"
                                    IsEnabled="{Binding IsRunning}" />
                        <ui:Button Grid.Column="1" Content="Enviar" Margin="8,0,0,0" Appearance="Primary"
                                   Command="{Binding SendCommand}" IsEnabled="{Binding IsRunning}" />
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Margin="8,0,8,4">
                        <ui:Button Content="↓ Volver al final" Command="{Binding BackToBottomCommand}"
                                   Padding="8,2" FontSize="11" HorizontalAlignment="Right"
                                   Visibility="{Binding AutoScroll, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OnConversationScrollChanged">
                        <ItemsControl ItemsSource="{Binding Conversation}" Margin="6" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- · Diff · -->
            <Border Grid.Column="2" Background="#14808080" CornerRadius="8" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Cambios en tu clon" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Cada pestaña es un fichero tocado. El diff compara con lo que había ANTES de esta sesión, que es lo que tendrás que revisar antes de commitear."
                                   Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="Todavía no se ha modificado ningún fichero."
                                   Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,6,6" Padding="9,4" Cursor="Hand" BorderThickness="1"
                                            Command="{Binding DataContext.SelectFileCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RelativePath}"
                                            Background="{Binding IsSelected, Converter={StaticResource SelectedTabToFill}}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠" Margin="0,0,5,0" Foreground="#E0A030" FontSize="11"
                                                       ToolTip="Fichero fuera del hallazgo: lo autorizaste durante la sesión"
                                                       Visibility="{Binding InScope, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!-- Nombre largo: elipsis EN MEDIO, nunca al final —lo que
                                                 identifica un fichero es su nombre, y la extensión dice
                                                 de qué se trata—. La ruta entera va en el ToolTip. -->
                                            <TextBlock FontSize="12"
                                                       Text="{Binding FileName, Converter={StaticResource MiddleEllipsis}, ConverterParameter=28}" />
                                            <TextBlock Text="{Binding Tally}" FontSize="11" Opacity="0.7" Margin="7,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  DataContext="{Binding SelectedFile}">
                        <StackPanel>
                            <TextBlock FontSize="11" Opacity="0.75" Margin="2,0,0,2"
                                       ToolTip="{Binding RelativePath}"
                                       Text="{Binding RelativePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=52}" />
                            <TextBlock Text="{Binding ScopeNote}" FontSize="11" Opacity="0.6" Margin="2,0,0,6"
                                       TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Background="{Binding Kind, Converter={StaticResource DiffKindToFill}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding OldNumber}" FontFamily="Consolas"
                                                       FontSize="11" Opacity="0.45" TextAlignment="Right" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding NewNumber}" FontFamily="Consolas"
                                                       FontSize="11" Opacity="0.45" TextAlignment="Right" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding Marker}" FontFamily="Consolas"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding Kind, Converter={StaticResource DiffKindToBrush}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="Consolas"
                                                       FontSize="12" TextWrapping="NoWrap"
                                                       Foreground="{Binding Kind, Converter={StaticResource DiffKindToBrush}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ============================ PANTALLA DE CIERRE ============================ -->
            <Border Grid.Column="0" Grid.ColumnSpan="3"
                    Background="#F2101010" CornerRadius="8" Padding="22"
                    Visibility="{Binding ShowClosing, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Arreglo terminado" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Fix.StatusMessage}" TextWrapping="Wrap" Opacity="0.8"
                                   FontSize="12" Margin="0,6,0,0" />
                        <Border CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                                Background="#22E0A030" BorderBrush="#66E0A030" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#F0D090"
                                       Text="Los cambios están en tu clon sin commitear — revisa y commitea cuando estés conforme. Arreglar no resuelve el hallazgo: sigue activo hasta que lo verifiques." />
                        </Border>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                        <ui:Button Content="Verificar ahora" Command="{Binding VerifyNowCommand}" Appearance="Primary" />
                        <ui:Button Content="Abrir en el editor" Command="{Binding OpenInEditorCommand}" Margin="8,0,0,0" />
                        <ui:Button Content="Ver informe" Command="{Binding OpenReportCommand}" Margin="8,0,0,0" />
                        <ui:Button Content="Me quedo los cambios" Command="{Binding FinishCommand}" Margin="8,0,0,0" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Qué cambió y por qué" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Fix.Summary}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                            <TextBlock Text="Riesgos declarados" Style="{StaticResource SectionTitle}" Margin="0,16,0,8"
                                       Visibility="{Binding Fix.Risks, Converter={StaticResource NotEmptyToVisibility}}" />
                            <TextBlock Text="{Binding Fix.Risks}" TextWrapping="Wrap" FontSize="12.5" Foreground="#E0A030"
                                       Visibility="{Binding Fix.Risks, Converter={StaticResource NotEmptyToVisibility}}" />

                            <TextBlock Text="Ficheros tocados" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                            <ItemsControl ItemsSource="{Binding Files}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0,2" Cursor="Hand"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Command="{Binding DataContext.SelectFileCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <WrapPanel>
                                                <TextBlock FontFamily="Consolas" FontSize="12"
                                                           ToolTip="{Binding RelativePath}"
                                                           Text="{Binding RelativePath, Converter={StaticResource MiddleEllipsis}, ConverterParameter=60}" />
                                                <TextBlock Text="{Binding Tally}" FontSize="11" Opacity="0.7" Margin="8,0,0,0" />
                                                <TextBlock Text="fuera del hallazgo, autorizado por ti" FontSize="11"
                                                           Foreground="#E0A030" Margin="8,0,0,0"
                                                           Visibility="{Binding InScope, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </WrapPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Resultado del último build/tests" Style="{StaticResource SectionTitle}"
                                       Margin="0,16,0,8" />
                            <TextBlock Text="{Binding BuildText}" FontSize="12" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Border CornerRadius="6" Padding="10,8" Background="#18000000"
                                    Visibility="{Binding Fix.LastBuild, Converter={StaticResource NotEmptyToVisibility}}">
                                <!-- El tope de altura solo vale si lo que sobra se puede alcanzar:
                                     antes recortaba la salida del build sin decirlo. -->
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Fix.LastBuild}" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </ScrollViewer>
                            </Border>

                            <!-- · La sugerencia de commit, en su tarjeta propia y EDITABLE · -->
                            <Border CornerRadius="8" Padding="14,12" Margin="0,18,0,0"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Sugerencia de commit" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource Help}" Margin="0,0,0,8"
                                               Text="Atalaya no commitea: esto solo te ahorra redactarlo. Edítalo a tu gusto y cópialo." />
                                    <TextBlock Text="Título" FontSize="11" Margin="0,4,0,3"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Text="{Binding Commit.Title, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Commit.TitleLengthNote}" FontSize="10.5" Margin="0,3,0,0"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding Commit.TitleIsLong, Converter={StaticResource WarningToBrush}}" />
                                    <TextBlock Text="Descripción" FontSize="11" Margin="0,8,0,3"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:TextBox Text="{Binding Commit.Description, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                                VerticalScrollBarVisibility="Auto" />
                                    <ui:Button Content="Copiar" Command="{Binding CopyCommitCommand}"
                                               Appearance="Primary" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================ PIE ================================ -->
        <Border Grid.Row="2" Background="#14808080" CornerRadius="8" Padding="12,7" Margin="0,10,0,0"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVisibility}}">
            <!-- WrapPanel: en 1366×768 estos seis trozos no caben en una fila y el último
                 —el resultado del build— se perdía por el borde. Aquí bajan de línea. -->
            <WrapPanel>
                <TextBlock Text="{Binding SubHeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           ToolTip="{Binding SubHeaderText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="320" />
                <TextBlock Text="·" Opacity="0.4" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ElapsedText}" VerticalAlignment="Center" Opacity="0.85" />
                <TextBlock Text="·" Opacity="0.4" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CostText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="·" Opacity="0.4" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TouchedText}" VerticalAlignment="Center" Opacity="0.8" FontSize="12" />
                <TextBlock Text="·" Opacity="0.4" Margin="10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BuildText}" VerticalAlignment="Center" Opacity="0.8" FontSize="12" />
                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="12,0,0,0"
                                 Visibility="{Binding Fix.IsBuilding, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
