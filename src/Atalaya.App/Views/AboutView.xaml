<UserControl
    x:Class="Atalaya.App.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <!--
        F26 §C — «Acerca de», que era un modal al fondo de Ajustes → Avanzado, es una PÁGINA del
        grupo Sistema. Y como página se gana la pantalla (segunda revisión): con el contenido del
        diálogo eran cuatro líneas perdidas en un monitor entero.

        UNA tarjeta, centrada en los dos ejes: identidad arriba, qué es, la ficha del binario y las
        acciones. En la tercera revisión la ficha adelgazó —lo que se enseña es lo que solo se puede
        saber aquí— y la marca subió a la cabecera.
    -->
    <Grid>
        <Border Style="{StaticResource Card}"
                MaxWidth="{StaticResource About.CardWidth}"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="{StaticResource Pad.XL}">
            <StackPanel c:Stack.Gap="{StaticResource Space.L}">

                <!-- LA CABECERA: el icono, el nombre y, a la derecha, la marca.

                     LA MARCA VA AQUÍ, a la derecha del nombre: es la cabecera la que dice de quién
                     es esto. Sin organización en el hub no se pinta, y la fila se queda con el
                     icono y el nombre.

                     F38 · Y la marca es AHORA EL NOMBRE de la organización configurada, no un
                     logotipo. Éste es el ÚNICO emplazamiento que queda de los tres de F6.4: la
                     bienvenida no tiene cuenta conectada de la que sacar el nombre, y la tarjeta
                     de Cuenta ya lo escribe bajo el usuario. Aquí no lo dice nadie más — la ficha
                     de abajo soltó su fila de organización cuando el logotipo la decía. -->
                <DockPanel>
                    <controls:BrandMark DockPanel.Dock="Right"
                                        VerticalAlignment="Center"
                                        Margin="{StaticResource Pad.M.Left}"
                                        Organization="{Binding Info.Organization}" />
                    <!-- El `.ico` se pide con el fotograma de su tamaño; sin `DecodePixelWidth` se
                         decodifica por el de 256 y se encoge, que es el borrón que la variante de
                         silueta existe para evitar. -->
                    <Image Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center">
                        <Image.Source>
                            <BitmapImage UriSource="pack://application:,,,/Atalaya;component/assets/atalaya.ico"
                                         DecodePixelWidth="64" DecodePixelHeight="64" />
                        </Image.Source>
                    </Image>
                    <!-- El nombre SOLO. La versión estaba aquí y en la ficha de abajo: el mismo
                         número dos veces a diez píxeles de distancia. -->
                    <TextBlock Text="Atalaya" Style="{StaticResource Text.H2}"
                               VerticalAlignment="Center"
                               Margin="{StaticResource Pad.M.Left}" />
                </DockPanel>

                <TextBlock Style="{StaticResource Text.Body}"
                           Text="Auditoría de código colaborativa con agentes de IA. El estado vive en un repositorio git compartido; no hay servidor propio." />

                <!-- LA FICHA: versión y fecha del binario. Nombre a la izquierda, valor a la
                     derecha, una fila por dato, para que se lean en columna y la tercera que vuelva
                     nazca alineada. Traía seis filas y sobraban cuatro — el logotipo ya dice la
                     organización, y proveedor y modelo son opciones de Ajustes, no propiedades de
                     este binario. -->
                <ItemsControl ItemsSource="{Binding Facts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{StaticResource Pad.XXS.V}">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="{Binding Label}"
                                           Style="{StaticResource Text.Small}"
                                           Width="{StaticResource About.LabelWidth}" />
                                <TextBlock Text="{Binding Value}"
                                           Style="{StaticResource Text.Small}"
                                           Foreground="{DynamicResource Brush.Text}"
                                           TextWrapping="Wrap" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Las acciones. «Buscar actualizaciones» es el primario: es lo único de esta
                     página que hace algo, y es la razón por la que se abre cuando algo va raro. -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                        <Button Content="Buscar actualizaciones"
                                Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource Button.Primary}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                ToolTip="Pregunta a GitHub ahora mismo si hay una versión más nueva."
                                Visibility="{Binding CanCheckUpdates, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Novedades"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding Notes}"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="{Binding Notes}"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Repositorio"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding Info.Repository}"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="{Binding Info.Repository}"
                                Visibility="{Binding Info.HasRepository, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Manual"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="{Binding Info.Manual}"
                                Style="{StaticResource Button.Secondary}"
                                ToolTip="{Binding Info.Manual}"
                                Visibility="{Binding Info.HasManual, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Small}"
                               Margin="{StaticResource Pad.XS.Top}"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>

                <!-- BUGFIX-VERSION: sin «appRepoUrl» en el despliegue no hay adónde enlazar, y el
                     hueco se explica en vez de dejar tres botones que no aparecen sin motivo. -->
                <TextBlock Text="{Binding Info.NoLinksNotice}" Style="{StaticResource Text.Small}"
                           Visibility="{Binding Info.HasNoLinks, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
