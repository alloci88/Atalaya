<UserControl
    x:Class="Atalaya.App.Views.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="Cuenta" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- ============ DESCONECTADO: bienvenida + un botón ============ -->
            <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Text="Conecta tu cuenta de GitHub de la organización: es la que te da identidad, autoría y acceso al hub de auditorías, y hace falta audites con quien audites. Con ella entra además tu asiento de Copilot."
                    TextWrapping="Wrap" Opacity="0.9" Margin="0,0,0,20" FontSize="15" />

                <ui:Button
                    Content="Conectar con GitHub"
                    Command="{Binding ConnectCommand}"
                    Appearance="Primary"
                    FontSize="16"
                    Padding="24,12"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding CanConnect}" />

                <TextBlock
                    Text="{Binding ConnectBlockedMessage}"
                    TextWrapping="Wrap"
                    Foreground="#E0A030"
                    Margin="0,14,0,0"
                    Visibility="{Binding CanConnect, Converter={StaticResource InverseBoolToVisibility}}" />

                <TextBlock
                    Text="No necesitas conocer la URL del hub, crear ningún token ni abrir una consola."
                    Opacity="0.6" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" />

                <!-- F6.4 · La firma de la bienvenida. Discreta y DEBAJO del bloque de conexión:
                     quien abre la aplicación por primera vez viene a conectarse, no a mirar un
                     logo. Si no hay asset, el hueco se colapsa solo. -->
                <controls:BrandMark LogoHeight="24" Margin="0,34,0,0" />
            </StackPanel>

            <!-- ============ AUTORIZANDO: el código en grande ============ -->
            <StackPanel Visibility="{Binding IsAuthorizing, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Introduce este código en GitHub" FontSize="15" Opacity="0.9" Margin="0,0,0,10" />

                <Border Background="#22808080" CornerRadius="10" Padding="28,18" HorizontalAlignment="Left" Margin="0,0,0,14">
                    <TextBlock
                        Text="{Binding UserCode}"
                        FontSize="46"
                        FontWeight="Bold"
                        FontFamily="Consolas"
                        TextAlignment="Center" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <ui:Button Content="Abrir github.com/login/device" Command="{Binding OpenVerificationPageCommand}"
                               Appearance="Primary" Margin="0,0,8,0" />
                    <ui:Button Content="Copiar código" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Cancelar" Command="{Binding CancelConnectCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" />
                    <TextBlock Text="Esperando autorización…" VerticalAlignment="Center" Opacity="0.85" />
                    <TextBlock Text="{Binding Countdown}" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.65" />
                </StackPanel>
            </StackPanel>

            <!-- ============ CONECTADO: perfil + comprobaciones ============ -->
            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
                <Border Background="#18808080" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="28" Margin="0,0,14,0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Login}" Opacity="0.75" />
                            <TextBlock Opacity="0.6" FontSize="12"
                                       Visibility="{Binding ShowOrganization, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Organización:" /><Run Text=" " /><Run Text="{Binding OrganizationLogin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- F6.4 · La firma, junto a la organización a la que pertenece la cuenta.
                             Es el único sitio de una vista de trabajo donde va, y va aquí porque
                             es aquí donde se habla de la organización. -->
                        <controls:BrandMark LogoHeight="22" Margin="20,0,0,0"
                                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="#33E0A030" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                        Visibility="{Binding NeedsReconnect, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap"
                               Text="GitHub ha rechazado tus credenciales. Vuelve a conectar la cuenta para seguir sincronizando y auditando." />
                </Border>

                <TextBlock Text="Estado de la conexión" FontWeight="SemiBold" Margin="0,0,0,8" />
                <!-- F14 — la pantalla no puede sugerir que elegir otro auditor sustituya a GitHub:
                     identidad, autoría y hub lo necesitan siempre. Las tres primeras filas son de
                     GitHub; las de abajo, una por proveedor de auditoría. -->
                <TextBlock
                    Text="Las tres primeras son de GitHub y no se sustituyen: sin ellas no hay identidad, ni autoría, ni hub donde escribir. Debajo, un auditor por proveedor: basta con tener uno listo para poder auditar, y cuál se usa se elige en Ajustes."
                    TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Checker.Steps}" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="{Binding State, Converter={StaticResource CheckStateToGlyph}}"
                                        Foreground="{Binding State, Converter={StaticResource CheckStateToBrush}}"
                                        FontWeight="Bold" Width="22" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap"
                                    Opacity="0.75"
                                    FontSize="12"
                                    Margin="22,2,0,0"
                                    Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />
                                <ui:HyperlinkButton
                                    Content="Ver la documentación de GitHub"
                                    NavigateUri="{Binding HelpUrl}"
                                    Margin="18,0,0,0"
                                    Padding="4,2"
                                    FontSize="12"
                                    Visibility="{Binding HelpUrl, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Hub local" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Border Background="#18808080" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock FontSize="12" Opacity="0.75" Margin="0,0,0,2">
                            <Run Text="Estado:" /><Run Text=" " /><Run Text="{Binding SyncState, Mode=OneWay}" />
                            <Run Text=" · última sincronización:" /><Run Text=" " /><Run Text="{Binding LastSync, Mode=OneWay}" />
                        </TextBlock>
                        <TextBox
                            Text="{Binding HubClonePath, Mode=OneWay}"
                            IsReadOnly="True"
                            BorderThickness="0"
                            Background="Transparent"
                            Padding="0"
                            FontFamily="Consolas"
                            FontSize="12"
                            Opacity="0.8"
                            ToolTip="Ruta del clon local del hub en esta máquina" />
                        <TextBlock
                            Text="{Binding SyncSummary}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Opacity="0.75"
                            Margin="0,6,0,0"
                            ToolTip="Qué trajo el pull y qué commits locales se publicaron"
                            Visibility="{Binding SyncSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding SyncError}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="#E0A030"
                            Margin="0,6,0,0"
                            Visibility="{Binding SyncError, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding TlsNotice}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Opacity="0.7"
                            Margin="0,6,0,0"
                            Visibility="{Binding TlsNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding MigrationNotice}"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Opacity="0.7"
                            Margin="0,6,0,0"
                            Visibility="{Binding MigrationNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Comprobar conexión" Command="{Binding CheckConnectionCommand}"
                               Appearance="Primary" Margin="0,0,8,0" />
                    <ui:Button Content="Sincronizar ahora" Command="{Binding SyncNowCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Desconectar" Command="{Binding DisconnectCommand}" />
                </StackPanel>
            </StackPanel>

            <!--
                EXCEPCIÓN deliberada a la regla de F5.7 §4 (feedback de acción = toast global).
                Esto no es el resultado de una acción: es el hilo narrado del flujo de dispositivo
                —«pidiendo código», «introduce el código en github.com», «leyendo tu perfil»— que
                el usuario tiene que poder leer MIENTRAS se va al navegador y vuelve. Un toast que
                caduca a los 8 segundos se lo llevaría justo cuando hace falta. Por eso vive aquí,
                junto a su anillo de progreso, y no en la cola de avisos.
            -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.9" MaxWidth="620" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
