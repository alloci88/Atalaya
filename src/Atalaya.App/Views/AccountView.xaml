<UserControl
    x:Class="Atalaya.App.Views.AccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <!--
        F26 Parte C — CUENTA.

        Era una columna estrecha pegada al borde izquierdo con la mitad de la pantalla vacía, y sus
        estados de conexión se decían con un glifo suelto —«…», «•»— pintado por un converter con
        los hexadecimales dentro, que es el defecto de D-971 en su forma pura: un pincel ya resuelto
        no se entera de que el tema ha cambiado.

        Ahora el contenido se CENTRA en su ancho (principio 2: el espacio se reparte, y repartirlo
        en una columna de formulario es dejar aire a los dos lados) y cada estado se dice con las
        tres cosas a la vez: icono, color y PALABRA.
    -->
    <!-- EL PATRÓN DE PÁGINA (P-02, UI-0035). El título arrancaba en x = 800 porque la columna
         entera iba centrada, así que pasar de Portafolio a Cuenta movía el contenido 536 px a la
         derecha y dejaba la miga —que no se mueve— casi quinientos píxeles a su izquierda. Ahora
         Cuenta se centra en su ancho máximo, como en la Parte C, y lo que F27 aporta es que el
         TÍTULO se centre con ella: el defecto era que la cabecera se quedaba en el margen mientras
         el cuerpo se iba al centro, con 530 px en blanco entre los dos. Uno de los dos tenía que
         moverse, y el que se mueve es el título. -->
    <!-- ANCLADA ARRIBA, Y CON AIRE SOBRE EL TÍTULO (R6 §2). Un formulario se lee desde arriba: si
         se centrara en vertical, el contenido saltaría al cambiar de sección o al aparecer un
         aviso. `VerticalAlignment` se escribe aunque hoy ya sea el efecto por defecto — es lo que
         impide que un cambio futuro en el patrón de página lo mueva sin que nadie lo note. -->
    <UserControl.Resources>

        <!-- UNA FILA DE ESTADO (R8). 48 de alto, 8 hasta la siguiente, el icono en un círculo de 24,
             la palabra a la derecha alineada con el TÍTULO —no con el bloque, que crece cuando hay
             detalle— y el detalle debajo, a 14. Antes era una rejilla de tres filas sin alto fijo:
             las que tenían detalle medían el doble que las que no, y la lista bailaba al comprobar.

             Es un recurso y no dos copias porque la usan los dos grupos, GitHub y auditores, y dos
             plantillas iguales acaban siendo distintas. -->
        <DataTemplate x:Key="CheckRow">
            <Grid MinHeight="{StaticResource Check.RowHeight}"
                  Margin="{StaticResource Pad.CheckRow}"
                  ToolTip="{Binding Tooltip}"
                  Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- El icono, dentro de su círculo. El círculo es lo que da a las cuatro filas la
                     misma columna izquierda tenga el estado que tenga, incluido el giro de
                     «comprobando», que mide distinto que un glifo. -->
                <Border Grid.Row="0" Grid.Column="0"
                        Width="{StaticResource Check.CircleSize}"
                        Height="{StaticResource Check.CircleSize}"
                        CornerRadius="{StaticResource Radius.Pill}"
                        Background="{DynamicResource Brush.Surface2}"
                        VerticalAlignment="Center"
                        Margin="{StaticResource Pad.S.Right}">
                    <Grid>
                        <Path Style="{StaticResource Check.Glyph}"
                              Width="{StaticResource Icon.Size.Small}"
                              Height="{StaticResource Icon.Size.Small}" />
                        <Grid Style="{StaticResource Check.Spinner}"
                              Width="{StaticResource Icon.Size.Small}"
                              Height="{StaticResource Icon.Size.Small}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="{StaticResource Icon.Size.Small}"
                                             Height="{StaticResource Icon.Size.Small}" />
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding Title}"
                           Style="{StaticResource Text.Default}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />

                <!-- La palabra, en la fila del TÍTULO: así queda a su altura aunque debajo haya
                     detalle. Centrada en la primera fila, no en la rejilla entera. -->
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Style="{StaticResource Check.Word}"
                           Margin="{StaticResource Pad.S.Left}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Text="{Binding Detail}"
                           Style="{StaticResource Text.Small}"
                           TextWrapping="Wrap"
                           Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVisibility}}" />

                <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Content="Ver la documentación de GitHub"
                        Style="{StaticResource Button.Link}"
                        Command="{Binding DataContext.OpenHelpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding HelpUrl}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HelpUrl, Converter={StaticResource NotEmptyToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- El subtítulo de un grupo: 13 y terciario. Es un rótulo, no un título. -->
        <Style x:Key="CheckGroup" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="{StaticResource FontSize.Meta}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="{StaticResource Pad.CheckGroup}" />
        </Style>

    </UserControl.Resources>

    <c:PageShell Title="Cuenta"
                 Subtitle="Tu identidad de GitHub, lo que hace falta para auditar y el clon del hub en esta máquina."
                 VerticalAlignment="Top"
                 Margin="{StaticResource Pad.FormTop}"
                 BodyWidth="{StaticResource Form.MaxWidth}">
    <ScrollViewer Style="{StaticResource Scroll}" VerticalScrollBarVisibility="Auto">
        <!-- CABE ENTERA A 1920×1080, SIN DESPLAZAMIENTO (R4 §2). Lo que sobraba era AIRE, no
             contenido: 24 de faldón al pie, 16 entre tarjetas, 20 dentro de cada una y 4 por
             encima y por debajo de cada fila de estado. Se aprieta el aire y no la letra —los
             tamaños son los de la escala y no se tocan—, que es lo que permite que la vista quepa
             sin quitarle nada de lo que dice. -->
        <!-- 32 BAJO EL TÍTULO DE LA VISTA, antes de la primera tarjeta (R8). El patrón de
             página deja 24 entre la cabecera y el cuerpo; aquí el cuerpo empieza con una tarjeta de
             32 de relleno, y con 24 el título se le quedaba encima. -->
        <StackPanel Margin="{StaticResource Pad.AccountFirstCard}">

            <!-- ============ DESCONECTADO: bienvenida + un botón ============ -->
            <StackPanel Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.AccountCard}"
                        Margin="{StaticResource Pad.AccountCardGap}">
                    <StackPanel c:Stack.Gap="{StaticResource Space.M}">
                        <TextBlock Style="{StaticResource Text.Body}"
                                   Text="Conecta tu cuenta de GitHub de la organización: es la que te da identidad, autoría y acceso al hub de auditorías, y hace falta audites con quien audites. Con ella entra además tu asiento de Copilot." />

                        <Button Content="Conectar con GitHub"
                                Command="{Binding ConnectCommand}"
                                Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanConnect}" />

                        <Border Style="{StaticResource Notice.Warning}"
                                Visibility="{Binding CanConnect, Converter={StaticResource InverseBoolToVisibility}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Text="{Binding ConnectBlockedMessage}"
                                           Style="{StaticResource Notice.Text}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Text.Small}"
                                   Text="No necesitas conocer la URL del hub, crear ningún token ni abrir una consola." />
                    </StackPanel>
                </Border>

                <!-- F6.4 · La firma de la bienvenida. Discreta y DEBAJO del bloque de conexión:
                     quien abre la aplicación por primera vez viene a conectarse, no a mirar un
                     logo. Si no hay asset, el hueco se colapsa solo. -->
                <controls:BrandMark LogoHeight="24" Margin="{StaticResource Pad.L}"
                                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ============ AUTORIZANDO: el código en grande ============ -->
            <StackPanel Visibility="{Binding IsAuthorizing, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.AccountCard}"
                        Margin="{StaticResource Pad.AccountCardGap}">
                    <StackPanel c:Stack.Gap="{StaticResource Space.M}">
                        <TextBlock Text="Introduce este código en GitHub" Style="{StaticResource Text.Lead}" />

                        <Border Background="{DynamicResource Brush.Surface2}"
                                CornerRadius="{StaticResource Radius.L}"
                                Padding="{StaticResource Pad.L}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding UserCode}"
                                       FontSize="{StaticResource FontSize.H1}"
                                       FontWeight="Bold"
                                       FontFamily="{StaticResource Font.Mono}"
                                       Foreground="{DynamicResource Brush.Text}"
                                       TextAlignment="Center" />
                        </Border>

                        <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                            <Button Content="Abrir github.com/login/device"
                                    Command="{Binding OpenVerificationPageCommand}"
                                    Style="{StaticResource Button.Primary}" />
                            <Button Content="Copiar código" Command="{Binding CopyCodeCommand}"
                                    Style="{StaticResource Button.Secondary}" />
                            <Button Content="Cancelar" Command="{Binding CancelConnectCommand}"
                                    Style="{StaticResource Button.Secondary}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="{StaticResource Icon.Size}"
                                             Height="{StaticResource Icon.Size}" />
                            <TextBlock Text="Esperando autorización…" Style="{StaticResource Text.Body}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Countdown}" Style="{StaticResource Text.Meta}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ CONECTADO: identidad, estados, hub y acciones ============ -->
            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}"
                        c:Stack.Gap="{StaticResource Space.S}">

                <!-- · La identidad · -->
                <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.AccountCard}"
                        Margin="{StaticResource Pad.AccountCardGap}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left"
                                Width="{StaticResource Avatar.Size}" Height="{StaticResource Avatar.Size}"
                                CornerRadius="{StaticResource Radius.Pill}"
                                Margin="{StaticResource Pad.M.Right}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <!-- F6.4 · La firma, junto a la organización a la que pertenece la cuenta.
                             Es el único sitio de una vista de trabajo donde va, y va aquí porque es
                             aquí donde se habla de la organización. -->
                        <controls:BrandMark DockPanel.Dock="Right" LogoHeight="22"
                                            VerticalAlignment="Center" />

                        <StackPanel VerticalAlignment="Center">
                            <!-- UN nombre, no dos (F26 §C, revisión). `DisplayName` cae en el login
                                 cuando la cuenta no declara nombre completo, que es el caso normal
                                 aquí: la tarjeta enseñaba «alopezciller» en negrita y otra vez en
                                 gris al lado. Un dato repetido no es jerarquía, es ruido. -->
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource Text.Name}"
                                       FontSize="{StaticResource FontSize.Lead}"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Meta}"
                                       Visibility="{Binding ShowOrganization, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Organización:" /><Run Text=" " /><Run Text="{Binding OrganizationLogin, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Notice.Warning}"
                        Visibility="{Binding NeedsReconnect, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                              Data="{x:Static c:Icons.Warning}"
                              Stroke="{DynamicResource Brush.Warning.Ink}" />
                        <TextBlock Style="{StaticResource Notice.Text}"
                                   Foreground="{DynamicResource Brush.Warning.Ink}"
                                   Text="GitHub ha rechazado tus credenciales. Vuelve a conectar la cuenta para seguir sincronizando y auditando." />
                    </DockPanel>
                </Border>

                <!-- · Estado de la conexión · -->
                <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.AccountCard}"
                        Margin="{StaticResource Pad.AccountCardGap}">
                    <StackPanel>
                        <TextBlock Text="Estado de la conexión" Style="{StaticResource Dialog.Title}" />

                        <!-- DOS GRUPOS, CADA UNO CON SU RÓTULO (R8). Aquí había una frase de ayuda
                             que intentaba explicar de una vez las tres de GitHub y las dos de los
                             auditores, y que además se leía lejos de las filas que describía. El
                             rótulo de cada grupo dice lo suyo justo encima de lo que nombra, y la
                             frase desaparece: donde se elige el auditor lo dice el segundo. -->
                        <TextBlock Text="GitHub" Style="{StaticResource CheckGroup}" />
                        <ItemsControl ItemsSource="{Binding Checker.GitHubSteps}"
                                      ItemTemplate="{StaticResource CheckRow}" />

                        <TextBlock Style="{StaticResource CheckGroup}"
                                   Margin="{StaticResource Pad.CheckGroupSecond}"
                                   Text="Auditores · basta con uno, se elige en Ajustes → Proveedor y modelo" />
                        <ItemsControl ItemsSource="{Binding Checker.AuditorSteps}"
                                      ItemTemplate="{StaticResource CheckRow}" />

                        <!-- LOS AVISOS DEL HUB SE QUEDAN AQUÍ (R6 §2). Lo que se ha retirado es
                             la tarjeta «Hub local», que repetía el estado y la fecha que ya dice la
                             línea «Acceso al hub» de arriba y añadía la ruta, que ahora vive en su
                             tooltip. Estos cuatro no repetían nada: cuentan qué trajo el último
                             pull, qué falló, y las dos migraciones que pueden estar pendientes.
                             Borrarlos con la tarjeta habría sido perder lo único que no sobraba. -->
                        <TextBlock
                            Text="{Binding SyncSummary}"
                            Style="{StaticResource Text.Small}"
                            Margin="{StaticResource Pad.XS.Top}"
                            ToolTip="Qué trajo el pull y qué commits locales se publicaron"
                            Visibility="{Binding SyncSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding SyncError}"
                            Style="{StaticResource Text.Small}"
                            Foreground="{DynamicResource Brush.Warning.Ink}"
                            Margin="{StaticResource Pad.XS.Top}"
                            Visibility="{Binding SyncError, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding TlsNotice}"
                            Style="{StaticResource Text.Small}"
                            Margin="{StaticResource Pad.XS.Top}"
                            Visibility="{Binding TlsNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                        <TextBlock
                            Text="{Binding MigrationNotice}"
                            Style="{StaticResource Text.Small}"
                            Margin="{StaticResource Pad.XS.Top}"
                            Visibility="{Binding MigrationNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- · La botonera. UN primario, y el destructivo el último y perfilado (D-949).
                     CENTRADA CON LA TARJETA DE ENCIMA (R4 §2): iba pegada al margen izquierdo de
                     una columna centrada de 920, así que los tres botones quedaban en una esquina
                     de la vista en vez de bajo el bloque al que pertenecen. · -->
                <!-- Y a 24 de la tarjeta (R8): la última tarjeta ya trae los suyos por debajo,
                     así que el margen de aquí es el que separa el bloque de su botonera. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="{StaticResource Pad.AccountActions}"
                            c:Stack.Gap="{StaticResource Space.S}">
                    <Button Content="Comprobar conexión" Command="{Binding CheckConnectionCommand}"
                            Style="{StaticResource Button.Primary}" />
                    <Button Content="Sincronizar ahora" Command="{Binding SyncNowCommand}"
                            Style="{StaticResource Button.Secondary}" />
                    <Button Content="Desconectar" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource Button.Danger}" />
                </StackPanel>
            </StackPanel>

            <!--
                EXCEPCIÓN deliberada a la regla de F5.7 §4 (feedback de acción = toast global).
                Esto no es el resultado de una acción: es el hilo narrado del flujo de dispositivo
                —«pidiendo código», «introduce el código en github.com», «leyendo tu perfil»— que
                el usuario tiene que poder leer MIENTRAS se va al navegador y vuelve. Un toast que
                caduca a los 8 segundos se lo llevaría justo cuando hace falta. Por eso vive aquí,
                junto a su anillo de progreso, y no en la cola de avisos.
            -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.M.Top}"
                        c:Stack.Gap="{StaticResource Space.S}"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="{StaticResource Icon.Size}" Height="{StaticResource Icon.Size}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </c:PageShell>
</UserControl>
