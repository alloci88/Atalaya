<ui:FluentWindow
    x:Class="Atalaya.App.Views.AuditLaunchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Lanzar auditoría"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lanzar auditoría" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="22,10,22,20">
            <TextBlock
                Text="{Binding Headline}"
                FontSize="17"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{Binding PassesLine}"
                Margin="0,8,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- El cálculo, desglosado. Un total suelto no se puede contrastar. -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Estimación de coste" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BreakdownText"
                               Text="{Binding Breakdown}"
                               TextWrapping="Wrap"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Provenance}"
                               TextWrapping="Wrap"
                               FontSize="11.5"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- F17 §5: el juez preferido del ciclo no es el de esta máquina. Una línea, y se
                 sigue: es preferencia, no imposición. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding HasPreferenceNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="0,0,7,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding PreferenceNotice}"
                           TextWrapping="Wrap" FontSize="12" MaxWidth="440"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- Solo cuando el dato es flojo: si la media se sostiene, no hay nada que advertir. -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                        Visibility="{Binding IsWeakEstimate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="0,0,7,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="El número es orientativo: hay poco gasto medido detrás."
                           TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding Reassurance}"
                       TextWrapping="Wrap"
                       FontSize="11.5"
                       Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="Cancelar" Click="OnCancel" Appearance="Secondary" Margin="0,0,8,0" />
                <ui:Button x:Name="ConfirmButton" Content="Confirmar y auditar" Click="OnConfirm" Appearance="Primary" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
