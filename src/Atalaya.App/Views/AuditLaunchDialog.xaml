<ui:FluentWindow
    x:Class="Atalaya.App.Views.AuditLaunchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Lanzar auditoría"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Style="{StaticResource Dialog}"
    WindowBackdropType="None"
    ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource Brush.Bg}">
        <!-- EL DIÁLOGO PINTA SU FONDO (UI-0013). `FluentWindow` aplica su propio telón por
             debajo —`#FAFAFA` en claro, `#202020` en oscuro, los colores de fábrica de
             WPF-UI— y `MainWindow` lo tapa desde F26 §A justamente por eso; ninguno de los
             nueve diálogos lo hacía, así que abrir uno enseñaba otro programa encima de una
             aplicación crema. Y `PaletteContrastTests` pasaba en verde midiendo contra una
             superficie que la aplicación nunca declara.

             Y sus botones son los cuatro del sistema (UI-0014): el primario era el acento de
             Windows —`#1E9BFA`/`#0071C7`— y no el azul de la casa, y el botón que confirma un
             borrado irreversible no puede ser de otro color que el de Atalaya. El macizo de
             peligro se queda AQUÍ y solo aquí (UI-0039): destruir es lo que se ha venido a
             hacer a un diálogo de confirmación. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}" ShowMaximize="False" ShowMinimize="False" Grid.Row="0" Title="Lanzar auditoría" />

        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Dialog}">
            <TextBlock
                Text="{Binding Headline}"
                FontSize="{StaticResource FontSize.Lead}"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />

            <TextBlock
                Text="{Binding PassesLine}"
                Margin="{StaticResource Pad.XS.Top}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- El cálculo, desglosado. Un total suelto no se puede contrastar. -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{StaticResource Pad.Notice}" Margin="{StaticResource Pad.M.Top}">
                <StackPanel>
                    <TextBlock Text="Estimación de coste" FontSize="{StaticResource FontSize.Small}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="BreakdownText"
                               Text="{Binding Breakdown}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize.Body}" FontWeight="SemiBold"
                               Margin="{StaticResource Pad.XS.Top}" />
                    <TextBlock Text="{Binding Provenance}"
                               TextWrapping="Wrap"
                               FontSize="{StaticResource FontSize.Small}"
                               Margin="{StaticResource Pad.XS.Top}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- F17 §5: el juez preferido del ciclo no es el de esta máquina. Una línea, y se
                 sigue: es preferencia, no imposición. -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}"
                        Visibility="{Binding HasPreferenceNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="{StaticResource Pad.XS.Right}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding PreferenceNotice}"
                           TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}" MaxWidth="440"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <!-- Solo cuando el dato es flojo: si la media se sostiene, no hay nada que advertir. -->
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.S.Top}"
                        Visibility="{Binding IsWeakEstimate, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠" Margin="{StaticResource Pad.XS.Right}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="El número es orientativo: hay poco gasto medido detrás."
                           TextWrapping="Wrap" FontSize="{StaticResource FontSize.Small}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            </StackPanel>

            <TextBlock Text="{Binding Reassurance}"
                       TextWrapping="Wrap"
                       FontSize="{StaticResource FontSize.Small}"
                       Margin="{StaticResource Pad.S.Top}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Pad.M.Top}">
                <Button Content="Cancelar" Click="OnCancel" Margin="{StaticResource Pad.XS.Right}" />
                <Button x:Name="ConfirmButton" Content="Confirmar y auditar" Click="OnConfirm" Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
