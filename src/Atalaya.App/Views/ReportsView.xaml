<UserControl
    x:Class="Atalaya.App.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>

        <!-- La fila entera es el enlace al informe, igual que en V3: sin botón «Ver», hover sutil.
             Y con BasedOn implícito NO: quien redefine la plantilla se queda con el color, y un
             Style de Button sin Foreground explícito cae al negro de serie de WPF, invisible sobre
             el tema oscuro (F5.6 §1). -->
        <Style x:Key="ReportRowLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La insignia de tipo. Los tres tonos salen del TEMA, no de una paleta nueva: los colores
             de severidad están reservados (D-316) y un informe no habla de gravedad. -->
        <Style x:Key="KindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindLabel}" Value="Consolidado">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindLabel}" Value="Operaciones">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ================= La lista ================= -->
        <!-- Sigue VIVA mientras se lee un informe (solo se oculta): es lo que hace que «Volver»
             devuelva los filtros Y la posición del scroll sin guardar nada en ninguna parte. -->
        <Grid Visibility="{Binding IsViewing, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- · Cabecera · -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Informes" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Todo lo que las auditorías han dejado escrito. Pulsa uno para leerlo aquí."
                               FontSize="12" Opacity="0.7" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding ResultsSummary}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,2"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- · Barra de filtros: los mismos patrones que Hallazgos · -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right"
                               Content="Limpiar filtros"
                               Command="{Binding ClearFiltersCommand}"
                               Appearance="Secondary"
                               Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />

                    <WrapPanel Orientation="Horizontal">
                        <ui:TextBox PlaceholderText="Buscar…"
                                    ToolTip="Busca en el CONTENIDO del informe además de en su título, su aplicación y quién lo firmó."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                    Width="210" Margin="0,3,8,3" VerticalAlignment="Center" />

                        <ComboBox ItemsSource="{Binding AppOptions}"
                                  SelectedItem="{Binding SelectedApp}"
                                  DisplayMemberPath="Label"
                                  Width="170" Margin="0,3,8,3" VerticalAlignment="Center"
                                  ToolTip="Aplicación" />

                        <ComboBox ItemsSource="{Binding KindOptions}"
                                  SelectedItem="{Binding SelectedKind}"
                                  DisplayMemberPath="Label"
                                  Width="140" Margin="0,3,8,3" VerticalAlignment="Center"
                                  ToolTip="Tipo de informe" />

                        <ComboBox ItemsSource="{Binding AuthorOptions}"
                                  SelectedItem="{Binding SelectedAuthor}"
                                  DisplayMemberPath="Label"
                                  Width="150" Margin="0,3,8,3" VerticalAlignment="Center"
                                  ToolTip="Quién lo generó" />

                        <ComboBox ItemsSource="{Binding RangeOptions}"
                                  SelectedItem="{Binding SelectedRange}"
                                  DisplayMemberPath="Label"
                                  Width="150" Margin="0,3,8,3" VerticalAlignment="Center"
                                  IsEnabled="{Binding UsePresetRange}"
                                  ToolTip="Ventana temporal" />

                        <CheckBox Content="Rango a mano"
                                  IsChecked="{Binding UseCustomRange}"
                                  VerticalAlignment="Center" Margin="4,3,8,3"
                                  ToolTip="Elige tú las dos fechas en vez de usar un preset." />

                        <DatePicker SelectedDate="{Binding CustomFrom}"
                                    Width="130" Margin="0,3,6,3" VerticalAlignment="Center"
                                    ToolTip="Desde"
                                    Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibility}}" />
                        <DatePicker SelectedDate="{Binding CustomTo}"
                                    Width="130" Margin="0,3,0,3" VerticalAlignment="Center"
                                    ToolTip="Hasta (incluido)"
                                    Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- · Cabecera de columnas · -->
            <Grid Grid.Row="2" Margin="10,0,24,6"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Fecha" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="1" Text="Aplicación" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="2" Text="Tipo" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="3" Text="Modo" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="4" Text="Usuario" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="5" Text="Unidades" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="6" Text="Hallazgos" Style="{StaticResource ColumnHead}" />
                <TextBlock Grid.Column="7" Text="Coste" Style="{StaticResource ColumnHead}" />
            </Grid>

            <!-- · Las filas. Virtualizada por fila, como V3. · -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ReportRowLink}"
                                Margin="0,0,14,1"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding When}" Style="{StaticResource Cell}"
                                           ToolTip="{Binding WhenTooltip}" />
                                <TextBlock Grid.Column="1" Text="{Binding AppName}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border Grid.Column="2" Style="{StaticResource KindBadge}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Mode}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="4" Text="{Binding By}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="5" Text="{Binding Units}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="6" Text="{Binding Findings}" Style="{StaticResource Cell}" />
                                <TextBlock Grid.Column="7" Text="{Binding Cost}" Style="{StaticResource Cell}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- · Estado vacío: dice QUÉ pasa, y solo ofrece la salida que corresponde · -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EmptyMessage}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Content="Limpiar filtros"
                           Command="{Binding ClearFiltersCommand}"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <!-- ================= El visor ================= -->
        <Grid Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button Grid.Column="0"
                               Content="← Volver"
                               Command="{Binding BackCommand}"
                               Appearance="Secondary"
                               Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center"
                               ToolTip="Vuelve a la lista con los filtros como estaban" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewerTitle}" FontSize="16" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ViewerSubtitle}" FontSize="12" Opacity="0.7" Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="Ver hallazgos de esta sesión"
                                   Command="{Binding OpenFindingsCommand}"
                                   Appearance="Secondary"
                                   Padding="10,4" Margin="0,0,8,0"
                                   ToolTip="Abre Hallazgos filtrado por esta aplicación"
                                   Visibility="{Binding CanOpenFindings, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Descargar .md"
                                   Command="{Binding DownloadCommand}"
                                   Appearance="Primary"
                                   Padding="10,4"
                                   ToolTip="Guarda una copia del informe donde tú elijas" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- El informe renderizado. Scroll PROPIO: los informes largos se leen aquí dentro y
                 no arrastran la página entera. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16,8,8">
                <FlowDocumentScrollViewer
                    Document="{Binding Document}"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    IsToolBarVisible="False"
                    Background="Transparent"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
