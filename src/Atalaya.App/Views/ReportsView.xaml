<UserControl
    x:Class="Atalaya.App.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:s="clr-namespace:Atalaya.App.Services"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        F26 Parte C — INFORMES.

        Lo que se veía: una tabla de filas de 35 px con las cabeceras a 11 px y opacidad 0,6 —o
        sea, ilegibles—, la columna «Usuario» recortando nombres («Daniel Rodríguez d…»), una barra
        de filtros de cinco desplegables que ponían «Todas · Todos · Todos · Todo» sin decir cuál
        era cuál, y un estado vacío que era una frase centrada sin salida.

        Y el informe abierto: 13,5 px de cuerpo a todo lo ancho de un monitor de 27", con el anexo
        técnico —que el propio informe dice que no hace falta para actuar— ocupando media pantalla
        justo debajo del resumen.
    -->

    <UserControl.Resources>

        <!-- La fila entera es el enlace al informe, igual que en Hallazgos: sin botón «Ver». Hereda
             del secundario del sistema para no volver a quedarse con el negro de serie de WPF
             (F5.6 §1), y su alto es el de una fila de tabla (`Table.Row`: 40 px). -->
        <Style x:Key="ReportRowLink" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="{StaticResource Border.Bottom}"
                                MinHeight="40"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La insignia de tipo. Los tonos salen del TEMA, no de una paleta nueva: los colores
             de severidad están reservados (D-316) y un informe no habla de gravedad. -->
        <Style x:Key="KindBadge" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindLabel}" Value="Consolidado">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding KindLabel}" Value="Operaciones">
                    <Setter Property="Background" Value="Transparent" />
                </DataTrigger>
                <!-- F16 §F: verificar tiene insignia propia porque tiene FILTRO propio; si se
                     pintara como una sesión, la lista diría que son lo mismo. -->
                <DataTrigger Binding="{Binding KindLabel}" Value="Verificación">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Ink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ================================================================ F36 · la página

             La tarjeta de un hallazgo, la pastilla de su regla, el punto del índice y la fila del
             índice. Van aquí y no en `Styles.xaml` porque solo esta vista pinta hallazgos LEÍDOS DE
             UN INFORME: los de Hallazgos y los del portafolio salen del hub y ya tienen sus estilos
             con `Severity` como enum. Aquí la gravedad es la palabra que el informe escribió
             —«Crítica», con tilde—, así que los disparadores son sobre ese texto.
        -->
        <Thickness x:Key="Finding.Edge">3,1,1,1</Thickness>

        <!-- DOS LÍNEAS de `LineHeight.Meta` (18), que es lo que el carril le da a un título de
             hallazgo. Va como recurso y no como número suelto para que se lea de dónde sale. -->
        <sys:Double x:Key="Rail.TwoLines">36</sys:Double>

        <!-- EL BORDE IZQUIERDO DICE LA GRAVEDAD sin leer, que es lo que la pastilla entre
             corchetes no hacía (F27, y aquí llevado a la tarjeta). Los cuatro tonos son los
             reservados de D-316: ninguno es nuevo. -->
        <Style x:Key="Finding.Card" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="{StaticResource Pad.S}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.S}" />
            <Setter Property="BorderThickness" Value="{StaticResource Finding.Edge}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Low}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Crítica">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Crit}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Alta">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.High}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Media">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Sev.Med}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- La regla, en pastilla neutra: es un identificador, no una gravedad ni un estado. -->
        <Style x:Key="Report.Rule" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
            <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- El punto del índice: el mismo color que el borde de su tarjeta. -->
        <Style x:Key="Report.SevDot" TargetType="Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Sev.Low}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Crítica">
                    <Setter Property="Background" Value="{DynamicResource Brush.Sev.Crit}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Alta">
                    <Setter Property="Background" Value="{DynamicResource Brush.Sev.High}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Media">
                    <Setter Property="Background" Value="{DynamicResource Brush.Sev.Med}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- La fila del índice. Es un enlace de fila, como el de la lista de arriba, con el mismo
             realce al pasar por encima y con el foco visible: se recorre con el teclado. -->
        <Style x:Key="Report.IndexEntry" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="{StaticResource Pad.XXS.V}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.S}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ================= La lista ================= -->
        <!-- Sigue VIVA mientras se lee un informe (solo se oculta): es lo que hace que «Volver»
             devuelva los filtros Y la posición del scroll sin guardar nada en ninguna parte. -->
        <Grid Visibility="{Binding IsViewing, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- · Cabecera. EL RECUENTO VA BAJO EL TÍTULO (P-02, UI-0056): «8 informes» se
                 pintaba en el extremo derecho, a 1.600 px del título que cuenta, mientras en
                 Hallazgos y en Portafolio el mismo dato va aquí. Tres listas hermanas, dos sitios
                 para el mismo dato, y el que estaba solo era el que había que ir a buscar al otro
                 extremo. · -->
            <c:PageShell Grid.Row="0"
                         Title="Informes"
                         Count="{Binding ResultsSummary}"
                         Subtitle="Todo lo que las auditorías han dejado escrito. Pulsa uno para leerlo aquí." />

            <!-- · Barra de filtros: los mismos patrones que Hallazgos. Cada filtro dice QUÉ filtra
                 (D-973) y la separación la pone la barra, una y la misma (D-984). · -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Padding="{StaticResource Pad.XS}"
                    CornerRadius="{StaticResource Radius.M}"
                    Margin="{StaticResource Pad.S.Bottom}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="Limpiar filtros"
                            Command="{Binding ClearFiltersCommand}"
                            Style="{StaticResource Button.Secondary}"
                            Margin="{StaticResource Pad.BarItem}"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />

                    <!-- EL RITMO LO PONE LA BARRA, TAMBIÉN CUANDO ENVUELVE (D-984, UI-0055). A
                         1280 esta barra se parte en dos filas, y las dos empezaban en x distinta:
                         281 la primera —el borde de «Buscar…», que lleva el margen de la barra— y
                         274 la segunda, porque arrancaba con un RÓTULO que solo llevaba su hueco a
                         la derecha. Siete píxeles, y además ni siquiera múltiplo de 4. En Hallazgos
                         la misma barra partida empieza las dos filas en 285 porque allí cada
                         rótulo va DENTRO del bloque que lleva el margen. Aquí, igual. -->
                    <WrapPanel Orientation="Horizontal">
                        <ui:TextBox PlaceholderText="Buscar…"
                                    ToolTip="Busca en el CONTENIDO del informe además de en su título, su aplicación y quién lo firmó."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                    Width="220" Margin="{StaticResource Pad.BarItem}" VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Aplicación:" Style="{StaticResource Text.Small}"
                                       VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                            <ComboBox ItemsSource="{Binding AppOptions}"
                                      SelectedItem="{Binding SelectedApp}"
                                      DisplayMemberPath="Label"
                                      Width="180" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Tipo:" Style="{StaticResource Text.Small}"
                                       VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                            <ComboBox ItemsSource="{Binding KindOptions}"
                                      SelectedItem="{Binding SelectedKind}"
                                      DisplayMemberPath="Label"
                                      Width="150" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Usuario:" Style="{StaticResource Text.Small}"
                                       VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                            <ComboBox ItemsSource="{Binding AuthorOptions}"
                                      SelectedItem="{Binding SelectedAuthor}"
                                      DisplayMemberPath="Label"
                                      Width="170" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Periodo:" Style="{StaticResource Text.Small}"
                                       VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                            <ComboBox ItemsSource="{Binding RangeOptions}"
                                      SelectedItem="{Binding SelectedRange}"
                                      DisplayMemberPath="Label"
                                      Width="160" VerticalAlignment="Center"
                                      IsEnabled="{Binding UsePresetRange}" />
                        </StackPanel>

                        <CheckBox Content="Rango a mano"
                                  IsChecked="{Binding UseCustomRange}"
                                  VerticalAlignment="Center" Margin="{StaticResource Pad.BarItem}"
                                  Padding="{StaticResource Pad.Zero}" MinWidth="0"
                                  ToolTip="Elige tú las dos fechas en vez de usar un preset." />

                        <DatePicker SelectedDate="{Binding CustomFrom}"
                                    Width="140" Margin="{StaticResource Pad.BarItem}" VerticalAlignment="Center"
                                    ToolTip="Desde"
                                    Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibility}}" />
                        <DatePicker SelectedDate="{Binding CustomTo}"
                                    Width="140" Margin="{StaticResource Pad.BarItem}" VerticalAlignment="Center"
                                    ToolTip="Hasta (incluido)"
                                    Visibility="{Binding UseCustomRange, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- · Cabecera de columnas. Mismo relleno que la fila, para que cada rótulo caiga
                 sobre su columna: `Pad.Row` en los dos y ni un número suelto. · -->
            <!-- Y LOS MÍNIMOS SUMAN MENOS QUE EL ANCHO QUE HAY. Sumaban 960 y a 1280 la tabla
                 dispone de 952 con su relleno: ocho píxeles de más, que hasta P-08 no se veían
                 porque las cifras iban pegadas a la IZQUIERDA de su columna y les sobraba sitio
                 por la derecha. Alineadas a la derecha, esos ocho píxeles se comían la «s» de
                 «credits» y la «e» de «Coste». Un mínimo que no cabe no es un mínimo. -->
            <Grid Grid.Row="2" Margin="{StaticResource Pad.Row}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" MinWidth="140" />
                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                    <ColumnDefinition Width="1.3*" MinWidth="110" />
                    <ColumnDefinition Width="1.7*" MinWidth="120" />
                    <ColumnDefinition Width="1*" MinWidth="85" />
                    <ColumnDefinition Width="1*" MinWidth="85" />
                    <ColumnDefinition Width="1.2*" MinWidth="105" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Fecha" Style="{StaticResource Table.Header}" />
                <TextBlock Grid.Column="1" Text="Aplicación" Style="{StaticResource Table.Header}" />
                <TextBlock Grid.Column="2" Text="Tipo" Style="{StaticResource Table.Header}" />
                <TextBlock Grid.Column="3" Text="Modo" Style="{StaticResource Table.Header}" />
                <TextBlock Grid.Column="4" Text="Usuario" Style="{StaticResource Table.Header}" />
                <TextBlock Grid.Column="5" Text="Unidades" Style="{StaticResource Table.Header.Number}" />
                <TextBlock Grid.Column="6" Text="Hallazgos" Style="{StaticResource Table.Header.Number}" />
                <TextBlock Grid.Column="7" Text="Coste" Style="{StaticResource Table.Header.Number}" />
            </Grid>

            <!-- · Las filas. Virtualizada por fila, como Hallazgos. · -->
            <ListBox Grid.Row="3"
                     ItemsSource="{Binding Rows}"
                     Background="Transparent"
                     BorderThickness="{StaticResource Pad.Zero}"
                     Padding="{StaticResource Pad.Zero}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Margin" Value="{StaticResource Pad.Zero}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ReportRowLink}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" MinWidth="140" />
                                    <ColumnDefinition Width="1.4*" MinWidth="110" />
                                    <ColumnDefinition Width="1.1*" MinWidth="90" />
                                    <ColumnDefinition Width="1.3*" MinWidth="110" />
                                    <ColumnDefinition Width="1.7*" MinWidth="120" />
                                    <ColumnDefinition Width="1*" MinWidth="85" />
                                    <ColumnDefinition Width="1*" MinWidth="85" />
                                    <ColumnDefinition Width="1.2*" MinWidth="105" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding When}" Style="{StaticResource Table.Cell}"
                                           ToolTip="{Binding WhenTooltip}" />
                                <TextBlock Grid.Column="1" Text="{Binding AppName}"
                                           Style="{StaticResource Table.Cell.Strong}" />
                                <Border Grid.Column="2" Style="{StaticResource KindBadge}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Pill.Text}" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Mode}" Style="{StaticResource Table.Cell}" />
                                <!-- «Usuario» NO se recorta: un nombre cortado no falla, MIENTE
                                     (D-975). Ancho suficiente para el caso real y envuelve si aun
                                     así no cabe — la fila crece, que es lo que tiene que pasar. -->
                                <TextBlock Grid.Column="4" Text="{Binding By}" Style="{StaticResource Table.Cell}" />
                                <!-- Cifras a la derecha y tabulares (P-08, UI-0030): es la
                                     diferencia entre poder recorrer una columna de costes y tener
                                     que leerla número a número. -->
                                <TextBlock Grid.Column="5" Text="{Binding Units}" Style="{StaticResource Cell.Number}" />
                                <TextBlock Grid.Column="6" Text="{Binding Findings}" Style="{StaticResource Cell.Number.Delta}" />
                                <TextBlock Grid.Column="7" Text="{Binding Cost}" Style="{StaticResource Cell.Number}"
                                           ToolTip="{Binding CostDetail}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- · Estado vacío: el patrón del sistema —icono, una frase y la SALIDA que
                 corresponde— y no una frase suelta centrada. · -->
            <c:EmptyState Grid.Row="3"
                          VerticalAlignment="Center"
                          Glyph="{x:Static c:Icons.Reports}"
                          Message="{Binding EmptyMessage}"
                          ActionLabel="{Binding EmptyActionLabel}"
                          Command="{Binding EmptyActionCommand}"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ================= El visor =================

             F36 — la pantalla se compone del REGISTRO de la sesión con el markdown como cuerpo. El
             `.md` ni se toca ni se reconstruye (D-441).

             F36-1b — y deja de repetirse y de dejar media pantalla en blanco. Las cuatro cifras y
             las dos gráficas van en UNA rejilla (D-990); la cabecera y el resumen —que son lo que
             la portada acaba de decir— se pliegan en «Ficha del documento»; el cuerpo empieza por
             los hallazgos y usa el ancho que hay, con la prosa en su medida de lectura (F27) y las
             tarjetas en dos columnas cuando cabe.
        -->
        <Grid Visibility="{Binding IsViewing, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer x:Name="PageScroll" Style="{StaticResource Scroll}">
                <StackPanel>

                    <!-- · Portada · -->
                    <Border Style="{StaticResource Card}"
                            Padding="{StaticResource Pad.M}"
                            CornerRadius="{StaticResource Radius.M}"
                            Margin="{StaticResource Pad.S.Bottom}">
                        <StackPanel>
                            <TextBlock Text="{Binding ViewerTitle}"
                                       Style="{StaticResource Text.H2}"
                                       TextWrapping="Wrap" />

                            <!-- La aplicación con SU punto de color, el que le da el hash de su
                                 slug (D-314): el mismo que lleva en Métricas y en el registro de
                                 sesiones, hoy y dentro de tres meses. -->
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.XXS.Top}">
                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{Binding AppBrush}" VerticalAlignment="Center"
                                           Margin="{StaticResource Pad.XS.Right}" />
                                <TextBlock Text="{Binding ViewerApp}"
                                           Style="{StaticResource Text.Small}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CoverMeta}"
                                           Style="{StaticResource Text.Small}"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Margin="{StaticResource Pad.XS.Left}" />
                            </StackPanel>

                            <!-- LA FRASE EJECUTIVA (F36 §1.1). Plantilla determinista, sin modelo:
                                 lo que pasó en esta sesión en un renglón, concordado, y sin nombrar
                                 lo que no hay. -->
                            <TextBlock Text="{Binding Page.Lead}"
                                       Style="{StaticResource Text.Lead}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource Pad.S.Top}"
                                       Visibility="{Binding Page.Lead, Converter={StaticResource NotEmptyToVisibility}}" />

                            <!-- Y LA CONCLUSIÓN (F36-1b §1.9). La frase dice cuánto hubo; ésta dice
                                 si hay algo que mirar hoy. Va en el ámbar de lo que está ABIERTO
                                 —el mismo de las citas de aviso—, y solo aparece con críticas o
                                 altas: «0 críticos» sería un renglón para no decir nada (D-318). -->
                            <TextBlock Text="{Binding Page.Conclusion}"
                                       Style="{StaticResource Text.Small}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Warning.Ink}"
                                       TextWrapping="Wrap"
                                       Margin="{StaticResource Pad.XXS.Top}"
                                       Visibility="{Binding Page.HasConclusion, Converter={StaticResource BoolToVisibility}}" />

                            <!-- F29 §1 — el informe NO se reescribe, así que lo que se calculó
                                 después se dice aquí y no dentro de su texto. -->
                            <TextBlock Text="{Binding CalculatedLaterLine}"
                                       Style="{StaticResource Text.Meta}"
                                       Margin="{StaticResource Pad.XS.Top}"
                                       TextWrapping="Wrap"
                                       ToolTip="El coste de esta sesión no se pudo calcular el día en que se escribió el informe. Se cerró después, y la lista de Informes ya lo enseña calculado."
                                       Visibility="{Binding HasCalculatedLater, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- · UNA FILA Y UNA REJILLA (F36-1b §1.1, D-990) ·

                         Cuatro cifras y dos gráficas, juntas: es lo único que las iguala en alto y
                         les reparte el ancho. Fuera de la rejilla las tarjetas medían 130 y las
                         gráficas 180, y la barra de origen se cortaba.

                         La colección es heterogénea y cada tipo trae su plantilla por `DataType`,
                         que es como WPF elige plantilla sin que nadie escriba un selector. -->
                    <ItemsControl ItemsSource="{Binding Tiles}"
                                  Margin="{StaticResource Pad.S.Bottom}"
                                  Visibility="{Binding HasTiles, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:ColumnsPanel MinColumnWidth="{x:Static c:ReportLayout.TileMinWidth}" MaxColumns="6"
                                                Gap="{StaticResource Space.S}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Resources>

                            <!-- Una cifra. SIN «Copiar» desde F36-1b: eran cinco botones para una
                                 sola cosa, y «Copiar resumen» del carril ya se lleva la frase y las
                                 cuatro cifras. -->
                            <DataTemplate DataType="{x:Type s:ReportStat}">
                                <Border Style="{StaticResource Stat.Card}" ToolTip="{Binding ToolTip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Stat.Label}" />

                                        <!-- La cifra y su unidad en UN `TextBlock` con dos `Run`:
                                             es lo único que comparte línea base en WPF (D-983 §9,
                                             D-990). Centrada, que es lo que iguala las cuatro. -->
                                        <TextBlock HorizontalAlignment="Center"
                                                   Margin="{StaticResource Pad.XS.Top}">
                                            <Run Text="{Binding Value, Mode=OneWay}"
                                                 FontSize="{StaticResource FontSize.H2}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Unit, Mode=OneWay}"
                                                 FontSize="{StaticResource FontSize.Small}"
                                                 Foreground="{DynamicResource Brush.TextMuted}" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Small}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="{StaticResource Pad.XXS.Top}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- EL ROSCO DE GRAVEDAD, con su leyenda al lado (F36-1b §1.2). Un
                                 rosco sin leyenda obliga a adivinar qué tramo es cuál por el color,
                                 que es justo lo que la leyenda existe para no hacer. Va con los
                                 cuatro colores reservados porque ahí la paleta semántica ES el dato
                                 (D-316, F6.5), y solo con las gravedades que hay (D-318). -->
                            <DataTemplate DataType="{x:Type vm:SeverityTile}">
                                <Border Style="{StaticResource Stat.Card}">
                                    <StackPanel>
                                        <TextBlock Text="Gravedad" Style="{StaticResource Stat.Label}" />
                                        <Grid Margin="{StaticResource Pad.XS.Top}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="96" Height="96">
                                                <c:DonutRing Segments="{Binding Segments}" RingThickness="14" />
                                                <TextBlock Text="{Binding Total}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="{StaticResource FontSize.Lead}"
                                                           FontWeight="SemiBold" />
                                            </Grid>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Legend}"
                                                          VerticalAlignment="Center"
                                                          Margin="{StaticResource Pad.S.Left}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="{StaticResource Pad.XXS.Bottom}">
                                                            <Border Style="{StaticResource Report.SevDot}" />
                                                            <TextBlock Text="{Binding Severity}"
                                                                       Style="{StaticResource Text.Meta}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="{StaticResource Pad.XS.Left}" />
                                                            <TextBlock Text="{Binding Count}"
                                                                       Style="{StaticResource Text.Meta}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Margin="{StaticResource Pad.XS.Left}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>

                            <!-- EL ORIGEN, dos barras completas (F36-1b §1.3). La etiqueta va
                                 ENCIMA de la barra y no a su izquierda: medido, «Criterio del
                                 auditor» ocupa ~150 px de los ~400 de la tarjeta, y con la etiqueta
                                 al lado la barra se quedaba en un muñón y el porcentaje se cortaba.
                                 Encima, ninguno de los tres se recorta a ningún ancho.

                                 En neutros (D-316, D-887): el origen no es una gravedad ni un
                                 estado, y pintarlo con esos colores diría que un hallazgo del
                                 criterio del auditor es más grave que uno del catálogo. -->
                            <DataTemplate DataType="{x:Type vm:OriginTile}">
                                <Border Style="{StaticResource Stat.Card}"
                                        ToolTip="De dónde salió cada hallazgo: de una regla del catálogo, o del juicio del auditor sin regla detrás.">
                                    <StackPanel>
                                        <TextBlock Text="Origen" Style="{StaticResource Stat.Label}" />
                                        <ItemsControl ItemsSource="{Binding Bars}"
                                                      Margin="{StaticResource Pad.XS.Top}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="{StaticResource Pad.XS.Bottom}">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   TextWrapping="Wrap" />
                                                        <Grid Margin="{StaticResource Pad.XXS.Top}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding Share}" />
                                                                <ColumnDefinition Width="{Binding Rest}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="0" Height="10" RadiusX="3" RadiusY="3"
                                                                       HorizontalAlignment="Stretch"
                                                                       VerticalAlignment="Center"
                                                                       Fill="{DynamicResource Brush.TextMuted}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Tally}"
                                                                       Style="{StaticResource Text.Meta}"
                                                                       Margin="{StaticResource Pad.XS.Left}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <!-- · LA FICHA DEL DOCUMENTO, PLEGADA (F36-1b §1.5) ·

                         La cabecera y el resumen del informe dicen, con otras palabras, lo que la
                         portada acaba de decir: el H1, la lista de metadatos y el resumen se leían
                         dos veces antes de llegar al primer hallazgo. Se pliegan; NO se borran ni
                         se reescriben (D-441): quien quiera el documento tal cual lo despliega y
                         ahí está, entero. -->
                    <Expander Header="Ficha del documento"
                              Margin="{StaticResource Pad.S.Bottom}"
                              ToolTip="La cabecera y el resumen del informe, tal y como se escribieron."
                              Visibility="{Binding Page.HasSheet, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}">
                            <FlowDocumentScrollViewer
                                Document="{Binding Document}"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollBarVisibility="Auto"
                                IsToolBarVisible="False"
                                Background="Transparent"
                                Foreground="{DynamicResource Brush.Text}" />
                        </Border>
                    </Expander>

                    <!-- · Dos columnas: la lectura a la izquierda y el carril a la derecha ·

                         La columna de lectura se queda con el ancho que haya (F36-1b §1.7). La
                         medida de lectura de F27 no se toca y no vive aquí: la aplica cada
                         documento sobre SU prosa, así que un párrafo sigue midiendo 720 dentro de
                         una columna de 2.100. Lo que usa el ancho es lo que no es prosa. -->
                    <c:ReadingPanel x:Name="Reading"
                                    RailWidth="{x:Static c:ReportLayout.RailWidth}"
                                    ReadWidth="{x:Static c:ReportLayout.ReadWidth}"
                                    Gap="{x:Static c:ReportLayout.Gap}">

                        <!-- · La lectura · -->
                        <StackPanel>

                            <!-- ·· Cada hallazgo, una tarjeta (F36 §1.5), y PRIMERO (F36-1b §1.6) ··

                                 Es reordenar trozos ya partidos, no reescribir el documento
                                 (D-441): el `.md` sigue diciendo lo mismo en el mismo orden. Lo que
                                 cambia es que en pantalla lo primero es lo que hay que decidir.

                                 La ruta es el título del grupo y no se repite en cada tarjeta —es
                                 lo que F23 §5 ya había hecho con el texto—, y las tarjetas de ese
                                 grupo van en dos columnas cuando la ventana da de sí: una tarjeta
                                 no es prosa. -->
                            <ItemsControl x:Name="FindingCards"
                                          ItemsSource="{Binding Page.Groups}"
                                          Visibility="{Binding Page.HasFindings, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="{StaticResource Pad.M.Bottom}">
                                            <!-- `c:PathText` y no un `TextBlock`: `Text.Path` acorta
                                                 POR EL MEDIO, y es lo que una ruta necesita (P-01) —
                                                 el final de «.../SnippetScroll.cs» es lo que
                                                 identifica el fichero. Y el estilo declara ese tipo:
                                                 en un `TextBlock` revienta al colocar (D-1047). -->
                                            <c:PathText Full="{Binding Unit}"
                                                        Style="{StaticResource Text.Path}"
                                                        FontSize="{StaticResource FontSize.Small}"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Margin="{StaticResource Pad.XS.Bottom}" />

                                            <ItemsControl ItemsSource="{Binding Findings}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <c:ColumnsPanel
                                                            MinColumnWidth="{x:Static c:ReportLayout.CardMinWidth}"
                                                            MaxColumns="2"
                                                            Gap="{x:Static c:ReportLayout.Gap}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Finding.Card}"
                                                                Margin="{StaticResource Pad.XS.Bottom}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               Style="{StaticResource Text.Small}"
                                                                               FontWeight="SemiBold"
                                                                               TextWrapping="Wrap" />
                                                                    <Button Grid.Column="1" Content="Abrir"
                                                                            Style="{StaticResource Button.Link}"
                                                                            FontSize="{StaticResource FontSize.Meta}"
                                                                            VerticalAlignment="Top"
                                                                            Command="{Binding DataContext.OpenFindingCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="Abre la ficha de este hallazgo"
                                                                            Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                                                                </Grid>

                                                                <StackPanel Orientation="Horizontal"
                                                                            Margin="{StaticResource Pad.XXS.Top}">
                                                                    <Border Style="{StaticResource Report.Rule}">
                                                                        <TextBlock Text="{Binding RuleId}"
                                                                                   Style="{StaticResource Pill.Text}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding RuleDetail}"
                                                                               Style="{StaticResource Text.Meta}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="{StaticResource Pad.XS.Left}"
                                                                               Visibility="{Binding HasRuleDetail, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock Text="{Binding Line}"
                                                                               Style="{StaticResource Text.Meta}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="{StaticResource Pad.XS.Left}"
                                                                               Visibility="{Binding HasLine, Converter={StaticResource BoolToVisibility}}" />
                                                                </StackPanel>

                                                                <!-- La descripción y la recomendación,
                                                                     dentro y tal cual, con su propia
                                                                     medida de lectura: el documento la
                                                                     lleva puesta (F27). -->
                                                                <FlowDocumentScrollViewer
                                                                    Document="{Binding Body, Converter={StaticResource MarkdownToDocument}}"
                                                                    VerticalScrollBarVisibility="Disabled"
                                                                    HorizontalScrollBarVisibility="Auto"
                                                                    IsToolBarVisible="False"
                                                                    Background="Transparent"
                                                                    HorizontalAlignment="Left"
                                                                    Foreground="{DynamicResource Brush.Text}"
                                                                    Margin="{StaticResource Pad.XS.Top}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ·· Cobertura: una barra de pasadas por unidad, DESPUÉS ··

                                 «2 auditadas» tapa la diferencia que más importa: una unidad que
                                 convergió está barrida y otra que agotó el tope SEGUÍA ENCONTRANDO
                                 (D-887). La barra enseña cuántas pasadas hicieron falta y cuáles
                                 trajeron algo; el motivo de cierre va en texto, con las palabras
                                 que el informe ya escribió. -->
                            <Border Style="{StaticResource Card}"
                                    Margin="{StaticResource Pad.S.Bottom}"
                                    Visibility="{Binding Page.HasCoverage, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Cobertura" Style="{StaticResource Text.H3}"
                                               Margin="{StaticResource Pad.XS.Bottom}" />
                                    <ItemsControl ItemsSource="{Binding Page.Coverage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="{StaticResource Pad.S.Bottom}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource Text.Small}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Where}"
                                                                   Style="{StaticResource Text.Meta}"
                                                                   Margin="{StaticResource Pad.XS.Left}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <ItemsControl ItemsSource="{Binding Passes}"
                                                                  Margin="{StaticResource Pad.XXS.Top}"
                                                                  Visibility="{Binding HasPasses, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="26" Height="10" CornerRadius="3"
                                                                        Margin="{StaticResource Pad.XXS.Right}"
                                                                        ToolTip="{Binding New, StringFormat=Pasada con {0} hallazgo(s) nuevo(s)}">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <!-- Una pasada seca es un hueco, no un
                                                                                 tramo de otro color: no trajo nada. -->
                                                                            <Setter Property="Background"
                                                                                    Value="{DynamicResource Brush.Surface2}" />
                                                                            <Setter Property="BorderThickness"
                                                                                    Value="{StaticResource Border.Hairline}" />
                                                                            <Setter Property="BorderBrush"
                                                                                    Value="{DynamicResource Brush.Line}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Found}" Value="True">
                                                                                    <Setter Property="Background"
                                                                                            Value="{DynamicResource Brush.Primary.Fill}" />
                                                                                    <Setter Property="BorderBrush"
                                                                                            Value="{DynamicResource Brush.Primary.Fill}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource Text.Meta}"
                                                               TextWrapping="Wrap"
                                                               Margin="{StaticResource Pad.XXS.Top}" />
                                                    <TextBlock Style="{StaticResource Text.Meta}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Brush.TextMuted}"
                                                               Visibility="{Binding HasReviewed, Converter={StaticResource BoolToVisibility}}">
                                                        <Run Text="Revisados: " />
                                                        <Run Text="{Binding Reviewed, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Lo que el informe escribe entre la cobertura y los hallazgos:
                                 incidencias, patrones, directivas. Tal cual, y pegado a la
                                 cobertura, que es de lo que hablan. -->
                            <Border Style="{StaticResource Card}"
                                    Margin="{StaticResource Pad.S.Bottom}"
                                    Visibility="{Binding Page.HasMiddle, Converter={StaticResource BoolToVisibility}}">
                                <FlowDocumentScrollViewer
                                    Document="{Binding MiddleDocument}"
                                    VerticalScrollBarVisibility="Disabled"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsToolBarVisible="False"
                                    Background="Transparent"
                                    HorizontalAlignment="Left"
                                    Foreground="{DynamicResource Brush.Text}" />
                            </Border>

                            <!-- La firma cierra el DOCUMENTO, así que va al pie de todo. -->
                            <FlowDocumentScrollViewer
                                Document="{Binding FootDocument}"
                                VerticalScrollBarVisibility="Disabled"
                                HorizontalScrollBarVisibility="Disabled"
                                IsToolBarVisible="False"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource Brush.Text}"
                                Visibility="{Binding Page.HasFoot, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- · El carril. Se queda quieto al bajar por el cuerpo: un índice que se
                             va por arriba en cuanto se hace scroll es un índice que no está. · -->
                        <StackPanel x:Name="Rail">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="RailShift" />
                            </StackPanel.RenderTransform>

                            <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.M}"
                                    CornerRadius="{StaticResource Radius.M}">
                                <StackPanel c:Stack.Gap="{StaticResource Space.XS}">
                                    <Button Content="Descargar .md"
                                            Command="{Binding DownloadCommand}"
                                            Style="{StaticResource Button.Primary}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Guarda una copia del informe donde tú elijas" />
                                    <!-- «Copiar resumen» se lleva la frase y las cifras como texto:
                                         es el informe en cinco líneas, para pegarlo en un correo sin
                                         adjuntar el `.md` (F36 §1.3). Desde F36-1b es el ÚNICO
                                         copiar de la página: había cinco para una sola cosa. -->
                                    <Button Content="Copiar resumen"
                                            Command="{Binding CopySummaryCommand}"
                                            Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Copia la frase de portada y las cifras como texto"
                                            Visibility="{Binding Page.HasSummary, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding OpenFindingLabel}"
                                            Command="{Binding OpenFindingCommand}"
                                            Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Abre la ficha del hallazgo que arregló esta sesión"
                                            Visibility="{Binding CanOpenFinding, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Ver hallazgos de esta sesión"
                                            Command="{Binding OpenFindingsCommand}"
                                            Style="{StaticResource Button.Secondary}"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Abre Hallazgos filtrado por esta aplicación"
                                            Visibility="{Binding CanOpenFindings, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- EL ÍNDICE, POR GRAVEDAD. Es la lista de lo que hay que decidir, en
                                 el orden en que se decide; pulsar una entrada lleva a su tarjeta en
                                 el cuerpo. -->
                            <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.M}"
                                    CornerRadius="{StaticResource Radius.M}"
                                    Margin="{StaticResource Pad.S.Top}"
                                    Visibility="{Binding Page.HasFindings, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Hallazgos" Style="{StaticResource Stat.Label}"
                                               Margin="{StaticResource Pad.XS.Bottom}" />
                                    <ItemsControl ItemsSource="{Binding Page.Index}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Report.IndexEntry}"
                                                        Command="{Binding DataContext.GoToFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding Title}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource Report.SevDot}"
                                                                VerticalAlignment="Top"
                                                                Margin="{StaticResource Pad.XXS.Top}" />
                                                        <StackPanel Grid.Column="1"
                                                                    Margin="{StaticResource Pad.XS.Left}">
                                                            <!-- El alias, cuando el informe lo escribe: es
                                                                 como se nombra un hallazgo en una
                                                                 conversación («BUG-0236»). -->
                                                            <TextBlock Text="{Binding Alias}"
                                                                       Style="{StaticResource Text.Meta}"
                                                                       FontWeight="SemiBold"
                                                                       Visibility="{Binding Alias, Converter={StaticResource NotEmptyToVisibility}}" />
                                                            <!-- DOS LÍNEAS Y ELIPSIS. WPF no tiene
                                                                 `MaxLines` —eso es de UWP—, así que el
                                                                 tope son dos `LineHeight.Meta` y el
                                                                 recorte lo pone `TextTrimming` sobre la
                                                                 última línea que cabe. El título entero
                                                                 está en el tooltip: recortar sin decirlo
                                                                 es lo que P-01 prohíbe, y aquí se dice
                                                                 con los puntos suspensivos. -->
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource Text.Meta}"
                                                                       TextWrapping="Wrap"
                                                                       MaxHeight="{StaticResource Rail.TwoLines}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- El anexo, SOLO COMO ENLACE (F36-1b §1.8). Trae tablas de nueve
                                 columnas y en 380 px no se leen: el enlace salta al anexo, que se
                                 despliega a ancho completo bajo el cuerpo (F27). -->
                            <Button Content="Anexo técnico ↓"
                                    Command="{Binding GoToAnnexCommand}"
                                    Style="{StaticResource Button.Link}"
                                    HorizontalAlignment="Left"
                                    Margin="{StaticResource Pad.S.Top}"
                                    ToolTip="Baja al anexo técnico, que se lee a ancho completo bajo el cuerpo"
                                    Visibility="{Binding HasAnnex, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </c:ReadingPanel>

                    <!-- EL ANEXO TÉCNICO, PLEGADO Y A ANCHO COMPLETO (F27). El propio informe dice
                         que no hace falta para actuar sobre los hallazgos; se despliega debajo de
                         las dos columnas porque lo que lleva dentro son tablas de nueve columnas,
                         no prosa, y en una medida de lectura se parten. -->
                    <Expander x:Name="Annex"
                              Header="Anexo técnico — diagnóstico"
                              Margin="{StaticResource Pad.M.Top}"
                              Visibility="{Binding HasAnnex, Converter={StaticResource BoolToVisibility}}">
                        <FlowDocumentScrollViewer
                            Document="{Binding AnnexDocument}"
                            MaxHeight="{StaticResource Read.MaxWidth}"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto"
                            IsToolBarVisible="False"
                            Background="Transparent"
                            Foreground="{DynamicResource Brush.Text}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
