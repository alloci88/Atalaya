<UserControl
    x:Class="Atalaya.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels"
    xmlns:s="clr-namespace:Atalaya.App.Services">
    <!--
        F26 Parte C — AJUSTES DEJA DE SER UN SCROLL.

        Eran dos pantallas y media de alto con las descripciones a 11 px, la caja del tope de
        pasadas del tamaño de dos cifras y «Guardar» al fondo, fuera de la vista mientras se
        editaba. Ahora son CINCO SECCIONES navegables por una lista lateral —el mismo gesto que el
        raíl una capa más abajo—, cada ajuste es una fila con el mismo ritmo (etiqueta y UNA línea
        de ayuda a la izquierda, control a la derecha) y lo que no cabe en esa línea vive detrás de
        un «más». Y desde R5 no hay barra de guardar: cada ajuste se guarda al cambiarlo y lo dice
        con un «Guardado ✓» al lado del control. La única que queda es la de Tarifas, que escribe en
        el hub del equipo.

        El orden de las secciones es el del trabajo: con quién auditas · cómo audita · lo que
        cuesta · cómo se ve · lo demás.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera -->
        <StackPanel Grid.Row="0" Margin="{StaticResource Pad.L.Bottom}">
            <TextBlock Text="Ajustes" Style="{StaticResource Text.H2}" />
            <TextBlock Style="{StaticResource Text.Small}"
                       Text="Las preferencias de esta máquina. La conexión con GitHub y el hub vive en «Cuenta»." />
        </StackPanel>

        <!-- ==================================================== Secciones + contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- LA COLUMNA DEL FORMULARIO, y con ella la de su barra de acciones. El tope va en
                     la COLUMNA y no en cada hijo: puesto en el hijo, un `Left` lo encoge hasta su
                     contenido —la barra se quedaba del ancho del botón— y un `Stretch` lo centra.
                     En la columna, los dos se estiran hasta 960 y ahí se paran, con el aire a la
                     derecha; por debajo de 960 la columna vale lo que haya. -->
                <ColumnDefinition Width="*" MaxWidth="{StaticResource Setting.ContentWidth}" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- La lista de secciones. Se construye desde `Sections` y no como cinco botones
                 escritos a mano por lo mismo que el raíl (D-954): la entrada activa es un dato, y
                 un dato se puede probar. -->
            <!-- UNA LISTA DE CINCO SE RECORRE CON FLECHAS Y SE ACTIVA CON ENTER (UI-0016).
                 Medido sobre el `dist`: las cinco secciones ocupaban las paradas 18 a 22 de las 28
                 del ciclo de tabulación, Espacio activaba, **Enter no hacía nada y las flechas no
                 movían** — así que recorrer cinco opciones costaba cinco tabulaciones. Un `Button`
                 solo responde a Enter si es el predeterminado de la ventana, y la navegación
                 direccional por defecto se sale de la lista en la primera flecha: las dos cosas se
                 declaran. `Focusable="False"` en el contenedor, además, para que la lista no sea
                 ella misma una parada que no hace nada (UI-0042). -->
            <ItemsControl Grid.Column="0" Grid.RowSpan="2"
                          Width="{StaticResource Setting.SectionsWidth}"
                          Margin="{StaticResource Pad.L.Right}"
                          Focusable="False"
                          AutomationProperties.Name="Secciones de Ajustes"
                          KeyboardNavigation.DirectionalNavigation="Cycle"
                          ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsSectionItem}">
                        <Button Style="{StaticResource Setting.Section}"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}">
                            <Button.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Key}" />
                            </Button.InputBindings>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- LA COLUMNA DE CONTENIDO, con su fila de acciones DEBAJO del contenido y no al pie
                 de la ventana. Las tres filas hacen los dos comportamientos que hacen falta: el
                 scroll mide lo que mide su contenido —así los botones quedan justo debajo de la
                 última fila de una sección corta— pero no pasa del alto de la columna menos lo que
                 ocupan los botones, así que en una sección larga se queda pegado al pie de la
                 columna. WPF no tiene «position: sticky»; esto es lo que hay. -->
            <Grid Grid.Column="1" x:Name="SettingsColumn">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- LA BARRA DE GUARDAR NO SIEGA UNA LÍNEA (UI-0037). El tope de alto deja los
                     botones pegados al pie de la columna (D-1000 §1) y el corte caía DENTRO de una
                     línea: a media altura de glifo, sin elipsis y sin nada que dijera que había
                     más. El degradado lo dice. -->
                <Grid Grid.Row="0">
                <!-- EL TOPE SOLO DESCUENTA LA BARRA DONDE HAY BARRA (R5). Los 64 px que dejaba
                     libres para los botones eran ciertos en las cinco secciones; ahora solo Tarifas
                     tiene botones, y en las otras cuatro ese hueco sería una franja muerta al pie. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="{StaticResource Pad.Scroll}">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="MaxHeight"
                                    Value="{Binding ActualHeight, ElementName=SettingsColumn}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRates}" Value="True">
                                    <Setter Property="MaxHeight"
                                            Value="{Binding ActualHeight, ElementName=SettingsColumn, Converter={StaticResource Minus}, ConverterParameter=64}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                <Grid>

                    <!-- ============================== Proveedor y modelo ============================== -->
                    <StackPanel Visibility="{Binding ShowProvider, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Proveedor y modelo" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}"
                                   Visibility="{Binding HasProviderChoice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Proveedor de auditoría" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Con quién auditas tú, en esta máquina. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasProveedor" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="{Binding ProviderNotice}"
                                           Visibility="{Binding IsChecked, ElementName=MasProveedor, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <ComboBox ItemsSource="{Binding Providers}"
                                          AutomationProperties.Name="Proveedor"
                                          SelectedValue="{Binding SelectedProviderId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          MinWidth="{StaticResource Field.SelectWidth}"
                                          HorizontalAlignment="Left" />
                                <c:SavedMark Shown="{Binding Saved[SelectedProviderId].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Modelo del auditor" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Qué modelo del proveedor audita. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasModelo" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="Copilot los publica para tu cuenta con su multiplicador de coste cuando lo da, y Claude Code ofrece sus alias de familia, que siempre apuntan al último modelo de cada una. Cada proveedor recuerda el suyo, y queda registrado en el informe de la sesión."
                                           Visibility="{Binding IsChecked, ElementName=MasModelo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                    <ComboBox ItemsSource="{Binding Models}"
                                              AutomationProperties.Name="Modelo"
                                              SelectedValue="{Binding SelectedModelId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Label"
                                              MinWidth="{StaticResource Field.SelectWidth}" />
                                    <Button Content="Actualizar lista" Command="{Binding RefreshModelsCommand}"
                                            Style="{StaticResource Button.Secondary}" />
                                    <c:SavedMark Shown="{Binding Saved[SelectedModelId].Shown}" />
                                </StackPanel>

                                <!-- El aviso de la lista de modelos, por el recurso del sistema: el
                                     ámbar escrito a mano de antes era ilegible en tema claro
                                     (D-983 §8). -->
                                <Border Style="{StaticResource Notice.Warning}"
                                        Margin="{StaticResource Pad.S.Top}"
                                        Visibility="{Binding ModelsNotice, Converter={StaticResource NotEmptyToVisibility}}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                              Data="{x:Static c:Icons.Warning}"
                                              Stroke="{DynamicResource Brush.Warning.Ink}" />
                                        <TextBlock Text="{Binding ModelsNotice}" Style="{StaticResource Notice.Text}"
                                                   Foreground="{DynamicResource Brush.Warning.Ink}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- ============================== Auditoría ============================== -->
                    <StackPanel Visibility="{Binding ShowAudit, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Auditoría" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Pasadas del barrido (tope)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="El presupuesto de pasadas por unidad. Aplica a las auditorías que lances a partir de ahora." />
                                <ToggleButton x:Name="MasPasadas" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="De él salen también las DOS pasadas secas seguidas con las que el barrido se da por terminado: con un tope de 6 quedan 4 pasadas que puedan aportar algo. Con 1, cada auditoría es una pasada única. Si se agota el tope sin llegar a las dos secas, la unidad queda marcada como «cobertura posiblemente incompleta». La que esté en curso termina con el tope que tenía. Mínimo 1."
                                           Visibility="{Binding IsChecked, ElementName=MasPasadas, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <TextBox Text="{Binding MaxPassesPerUnit}" Style="{StaticResource Field.Number}" />
                                <c:SavedMark Shown="{Binding Saved[MaxPassesPerUnit].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- R2 §1 — MODO EXHAUSTIVO. Va junto al tope porque los dos gobiernan lo
                             mismo: cuánto se paga por unidad. La frase del icono es literal: sale de
                             SettingsViewModel.ExhaustiveWarning, para que no haya dos versiones del
                             precio. -->
                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Modo exhaustivo" Style="{StaticResource Setting.Name}" />
                                <!-- UNA línea, y la que dice qué hace y qué cuesta. La de antes
                                     describía lo que el modo NO hace cuando está apagado, que es
                                     la forma más rápida de no entender un interruptor. El texto
                                     sale del view-model, el mismo que el tooltip del icono: una
                                     sola versión del precio (R2 §1). -->
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="{Binding ExhaustiveNotice}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.XS}">
                                <ui:ToggleSwitch IsChecked="{Binding ExhaustiveSweep}" VerticalAlignment="Center" />
                                <Path Style="{StaticResource Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}"
                                      ToolTip="{Binding ExhaustiveNotice}" />
                                <c:SavedMark Shown="{Binding Saved[ExhaustiveSweep].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- F6.9: el interruptor del arreglo asistido. Vive en Auditoría y no en
                             Avanzado porque gobierna lo que un agente puede hacer sobre tu clon,
                             que es de lo que va esta sección. -->
                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Arreglo asistido" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Habilita «Arreglar con agente» en la ficha de un hallazgo. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasArreglo" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="El agente arregla sobre tu clon local explicando lo que hace y pidiéndote permiso para tocar ficheros que no son del hallazgo. Nunca commitea ni publica nada, y exige que no tengas cambios sin commitear. El generador de prompt de arreglo funciona igual con esto apagado."
                                           Visibility="{Binding IsChecked, ElementName=MasArreglo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <ui:ToggleSwitch IsChecked="{Binding EnableAssistedFix}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <c:SavedMark Shown="{Binding Saved[EnableAssistedFix].Shown}" />
                            </StackPanel>
                        </DockPanel>

                    </StackPanel>

                    <!-- ============================== Tarifas ============================== -->
                    <!-- R2 §2 trajo esta pantalla desde Métricas y la dejó detrás de un botón que
                         abría una ventana; F26 §C la hizo sección. Esta revisión la hace TABLA:
                         el `DataGrid` de la librería salía plano y, en ventana reducida, recortaba
                         sus propias cabeceras —«Entrada $/» , «Caché leíd»—, que es la peor forma
                         de ahorrar sitio: se pierde justo lo que dice qué es cada columna.

                         Ahora es la tabla del sistema, con cabecera de DOS líneas (nombre arriba,
                         unidad debajo), las cifras a la derecha con dígitos tabulares y una raya
                         fina por fila. El fichero sigue en el hub (D-786): esto es dónde se edita,
                         no dónde vive. -->
                    <Grid Visibility="{Binding ShowRates, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tarifas de GitHub Copilot" Style="{StaticResource Setting.SectionTitle}" />

                        <!-- F29 §2 — LA DIVISA, LA PRIMERA FILA DE LA SECCIÓN. Es lo único de aquí
                             que cambia lo que se ve en todas las demás pantallas, y es de esta
                             máquina: la tabla de abajo es del hub y se pulsa para guardarla; esto se
                             guarda al cambiarlo, como los demás ajustes (R5 §7). -->
                        <DockPanel Grid.Row="1" Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <!-- SIN AYUDA (R8). Eran seis líneas para un desplegable de dos
                                     opciones cuyos rótulos —«AI credits» y «Dólares (USD)»— ya
                                     dicen todo lo que hay que decidir. La etiqueta y el control, y
                                     nada más. -->
                                <TextBlock Text="Mostrar el coste en" Style="{StaticResource Setting.Name}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <ComboBox ItemsSource="{Binding Currencies}"
                                          SelectedValue="{Binding ShowCostIn}"
                                          AutomationProperties.Name="Mostrar el coste en"
                                          MinWidth="{StaticResource Field.SelectWidth}"
                                          HorizontalAlignment="Left" />
                                <c:SavedMark Shown="{Binding Saved[ShowCostIn].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- UNA línea, y el resto plegado (R8). La visible dice qué son estos
                             precios y de dónde salen —que es lo que hace falta para mirar la tabla—
                             y baja de tres frases a dos. Lo que se pliega son las dos salvedades:
                             una caja en blanco no es un cero, y Claude Code no entra aquí. Las dos
                             importan el día que se editan; ninguna, el resto de los días. -->
                        <StackPanel Grid.Row="2" Margin="{StaticResource Pad.L.Bottom}">
                            <TextBlock Style="{StaticResource Text.Small}"
                                       MaxWidth="{StaticResource Read.MaxWidth}" HorizontalAlignment="Left"
                                       Text="Precios de la tabla pública de GitHub Copilot, por millón de tokens. Atalaya los siembra y completa sola; aquí solo se corrige lo que no cuadre." />
                            <ToggleButton x:Name="MasTarifas" Style="{StaticResource Toggle.More}" />
                            <TextBlock Style="{StaticResource Setting.More}"
                                       MaxWidth="{StaticResource Read.MaxWidth}" HorizontalAlignment="Left"
                                       Text="Caché escrita en blanco significa que ese modelo no la cobra aparte y esos tokens son entrada normal; no es lo mismo que escribir un 0. Las sesiones de Claude Code no se tarifan —van contra tu suscripción— y por eso no están en esta tabla."
                                       Visibility="{Binding IsChecked, ElementName=MasTarifas, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- F29 §1 — AQUÍ VIVÍA EL AVISO ÁMBAR de «modelos usados sin tarifa», con
                             su lista y su icono. Se va, y en su sitio queda una línea neutra con el
                             recuento y el camino.

                             El motivo no es que sobrara información: es que estaba en la pantalla
                             equivocada. El coste es de la sesión, la sesión es de una aplicación, y
                             quien mira el Portafolio —que es quien decide— no pasa por Ajustes. El
                             aviso vive ahora en la tarjeta de su aplicación y la acción, en el
                             resumen de su ciclo. Tarifas es para precios; el hueco es de las
                             aplicaciones.

                             Y ámbar tampoco: desde aquí no se puede hacer nada, así que un color de
                             alarma sobre algo que no tiene botón se aprende a ignorar. -->
                        <TextBlock Grid.Row="3" Style="{StaticResource Text.Small}"
                                   Margin="{StaticResource Pad.M.Bottom}"
                                   MaxWidth="{StaticResource Read.MaxWidth}" HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Rates.HasMissing, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding Rates.MissingLine, Mode=OneWay}" /><Run Text=" · se reconcilian desde el inventario de cada aplicación" />
                        </TextBlock>
                        <Button Grid.Row="3" Content="Ir al Portafolio" Style="{StaticResource Button.Link}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding GoToPortfolioCommand}"
                                ToolTip="El aviso y la acción viven con la aplicación: su tarjeta dice cuántas sesiones sin coste tiene, y el resumen de su ciclo lleva a reconciliarlas."
                                Visibility="{Binding Rates.HasMissing, Converter={StaticResource BoolToVisibility}}" />

                        <!-- EN ESTRECHO, LA TABLA SE DESPLAZA; las cabeceras no se recortan nunca.
                             El ancho de la rejilla sigue al del hueco visible —así las columnas
                             reparten cuando sobra— pero no baja de su mínimo: por debajo aparece la
                             barra horizontal, que es «reorganizar» en una tabla (principio 1). La
                             cabecera va DENTRO del mismo desplazamiento, o se separaría de sus
                             columnas al primer arrastre. -->
                        <Border Grid.Row="4" Style="{StaticResource Panel}"
                                Visibility="{Binding CanManageRates, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer Style="{StaticResource Scroll}" x:Name="RatesScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <Grid MinWidth="910"
                                      Width="{Binding ViewportWidth, ElementName=RatesScroll}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="220" />
                                        <ColumnDefinition Width="1*" MinWidth="110" />
                                        <ColumnDefinition Width="1*" MinWidth="110" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="1*" MinWidth="140" />
                                        <ColumnDefinition Width="2*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="6"
                                            BorderBrush="{DynamicResource Brush.LineStrong}"
                                            BorderThickness="{StaticResource Border.Bottom}" />

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Modelo" Style="{StaticResource Table.Header}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Entrada" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Static s:CostFormat.RateColumnUnit}" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Salida" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Static s:CostFormat.RateColumnUnit}" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Caché leída" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Static s:CostFormat.RateColumnUnit}" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Caché escrita" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Static s:CostFormat.RateColumnUnit}" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="5" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Nota" Style="{StaticResource Table.Header}" />
                                    </StackPanel>

                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="6"
                                                  ItemsSource="{Binding Rates.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Line}"
                                                        BorderThickness="{StaticResource Border.Bottom}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MinWidth="220" />
                                                            <ColumnDefinition Width="1*" MinWidth="110" />
                                                            <ColumnDefinition Width="1*" MinWidth="110" />
                                                            <ColumnDefinition Width="1*" MinWidth="130" />
                                                            <ColumnDefinition Width="1*" MinWidth="140" />
                                                            <ColumnDefinition Width="2*" MinWidth="200" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Model}"
                                                                 Style="{StaticResource Field.Cell}"
                                                                 FontWeight="SemiBold" />
                                                        <TextBox Grid.Column="1" Text="{Binding Input}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="2" Text="{Binding Output}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="3" Text="{Binding CachedInput}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="4" Text="{Binding CacheWrite}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="5" Text="{Binding Note}"
                                                                 Style="{StaticResource Field.Cell.Note}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <c:EmptyState Grid.Row="4"
                                      Glyph="{x:Static c:Icons.Metrics}"
                                      Message="Todavía no hay tabla de tarifas en el hub. Se siembra sola al conectar con él."
                                      Visibility="{Binding CanManageRates, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Border Grid.Row="5" Style="{StaticResource Notice.Warning}"
                                Margin="{StaticResource Pad.S.Top}"
                                Visibility="{Binding Rates.Status, Converter={StaticResource NotEmptyToVisibility}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Text="{Binding Rates.Status}" Style="{StaticResource Notice.Text}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ============================== Apariencia ============================== -->
                    <StackPanel Visibility="{Binding ShowAppearance, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Apariencia" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Tema claro" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Cambia el tema oscuro por el claro. Se aplica al momento, sin reiniciar la aplicación." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <ui:ToggleSwitch IsChecked="{Binding IsLightTheme}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <c:SavedMark Shown="{Binding Saved[IsLightTheme].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- NO hay control de escala tipográfica, y no se inventa uno: la escala es
                             del sistema (D-946) y quien necesita el texto más grande lo tiene en la
                             de Windows, que Atalaya respeta al dibujarse con vectores (D-950). El
                             aviso dice DÓNDE está, con la ruta entera: mandar a «la escala de
                             Windows» sin decir por dónde se llega es no contestar. -->
                        <Border Style="{StaticResource Notice.Info}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Info}"
                                      Stroke="{DynamicResource Brush.Primary.Ink}" />
                                <TextBlock Style="{StaticResource Notice.Text}"
                                           Text="El tamaño del texto sigue la escala de Windows (Configuración → Pantalla → Escala). Atalaya no tiene un ajuste propio." />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================== Avanzado ============================== -->
                    <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Avanzado" Style="{StaticResource Setting.SectionTitle}" />

                        <!-- R13 §2 — el desplegable enseña SOLO los editores detectados en esta
                             máquina, más el manejador del sistema y «Otro». Un editor que no está
                             instalado no se ofrece: elegirlo sería elegir un fallo. -->
                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Editor preferido" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Con qué editor se abre el código desde la ficha de un hallazgo. Solo se ofrecen los editores encontrados en esta máquina. Se aplica la próxima vez que abras código." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <ComboBox ItemsSource="{Binding EditorOptions}"
                                          SelectedValue="{Binding Editor}"
                                          SelectedValuePath="Id" DisplayMemberPath="Label"
                                          AutomationProperties.Name="Editor de código"
                                          MinWidth="{StaticResource Field.SelectWidth}"
                                          HorizontalAlignment="Left" />
                                <Button Content="Probar" Command="{Binding TestEditorCommand}"
                                        AutomationProperties.Name="Probar el editor" />
                                <c:SavedMark Shown="{Binding Saved[Editor].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- R13 §2 — el comando de «Otro» aparece SOLO cuando «Otro» está elegido:
                             en el resto de los casos no ocupa sitio. -->
                        <DockPanel Style="{StaticResource Setting.Row}"
                                   Visibility="{Binding ShowEditorCommand, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Comando del editor" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="El comando con el que abrir un fichero: {file} es la ruta, {line} la línea y {col} la columna. Entrecomilla las rutas. Ejemplo: &quot;C:\Program Files\Notepad++\notepad++.exe&quot; -n{line} &quot;{file}&quot;. Se aplica la próxima vez que abras código." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <TextBox Text="{Binding EditorCommand, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.Name="Comando personalizado del editor"
                                         MinWidth="{StaticResource Field.SelectWidth}"
                                         HorizontalAlignment="Left" />
                                <c:SavedMark Shown="{Binding Saved[EditorCommand].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Frescura (días)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="A partir de cuántos días sin reconfirmarse un hallazgo se marca como pendiente de revisión. Se aplica al momento. Mínimo 1 día." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <TextBox Text="{Binding FreshnessDays}" Style="{StaticResource Field.Number}" />
                                <c:SavedMark Shown="{Binding Saved[FreshnessDays].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Sincronización del hub (segundos)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Cada cuántos segundos se buscan cambios de tus compañeros en el hub. Se aplica al momento, sin reiniciar. El mínimo es 15." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <TextBox Text="{Binding PollingSeconds}" Style="{StaticResource Field.Number}" />
                                <c:SavedMark Shown="{Binding Saved[PollingSeconds].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Timeout de Copilot (minutos)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Tiempo máximo de espera por una respuesta del modelo antes de dar el turno por fallido. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasTimeout" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="Vale también para cada compilación del arreglo asistido. Mínimo 1 minuto."
                                           Visibility="{Binding IsChecked, ElementName=MasTimeout, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.S}">
                                <TextBox Text="{Binding CopilotTimeoutMinutes}" Style="{StaticResource Field.Number}" />
                                <c:SavedMark Shown="{Binding Saved[CopilotTimeoutMinutes].Shown}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- ZONA PELIGROSA. Va al final, y lo que la marca es el color del sistema
                             —no un hexadecimal escrito a mano, que era ilegible en tema claro
                             (D-983 §8)—. El botón es peligro macizo porque destruir ES la acción
                             de este bloque (D-949). -->
                        <!-- EL TOPE LO PONE LA COLUMNA, NO EL BLOQUE (UI-0040). Medidos los bordes
                             derechos dentro del mismo armazón, tres bloques del mismo nivel de la
                             misma vista acababan en tres x distintas —1441, 1460 y 1400—, y
                             ninguna de las dos diferencias (41 y 19) era múltiplo de 4: cada uno
                             se había puesto su propio ancho. La columna ya tiene el suyo
                             (`Setting.ContentWidth`), que es lo que hace que Ajustes tenga UN
                             ritmo y no uno por bloque. -->
                        <Border Style="{StaticResource Notice.Danger}" Margin="{StaticResource Pad.M.Top}">
                            <StackPanel>
                                <TextBlock Text="Zona peligrosa" Style="{StaticResource Text.Lead}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Danger.Ink}" />
                                <TextBlock Text="Restablecimiento de fábrica"
                                           Style="{StaticResource Setting.Name}"
                                           FontWeight="SemiBold"
                                           Margin="{StaticResource Pad.XS.Top}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Borra TODAS las aplicaciones del hub —las tuyas y las de tus compañeros— y deja esta máquina como recién instalada: sin clon del hub, sin ajustes y con la cuenta desconectada. El historial git del hub conserva una copia recuperable por un administrador." />
                                <!-- PERFILADA, NO MACIZA (UI-0039). Era `#F2645E`/`#BA3630`
                                     macizo, y acababa siendo lo más saturado de una pantalla cuyo
                                     primario está apagado en gris: el rojo se llevaba la mirada
                                     hacia lo único que no hay que pulsar. El macizo se reserva
                                     para el diálogo que confirma (D-999 §4). -->
                                <Button Content="Restablecimiento de fábrica"
                                        Command="{Binding FactoryResetCommand}"
                                        Style="{StaticResource Button.Danger}"
                                        HorizontalAlignment="Left"
                                        Margin="{StaticResource Pad.S.Top}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
                <Rectangle Style="{StaticResource Scroll.Fade.Bottom}" />
                </Grid>

                <!-- ==================================================== Las acciones

                     AQUÍ ESTABAN «GUARDAR», «DESCARTAR» Y «HAY CAMBIOS SIN GUARDAR», Y SE VAN (R5).
                     Cada ajuste se guarda en el momento de cambiarlo, así que no queda nada que
                     guardar a mano, nada que descartar y nada de lo que avisar: lo que dice que se
                     ha guardado es la marca «Guardado ✓» que aparece al lado del control que se
                     acaba de tocar. El porqué está en D-1003, que sustituye a D-987.

                     La única barra que queda es la de Tarifas, y queda por lo que la separa de las
                     otras cuatro: escribe en el hub del equipo, con su commit y su atribución. Eso
                     se pulsa.
                -->

                <!-- En Tarifas, bajo la TABLA y alineadas con su borde izquierdo: la tabla ocupa la
                     columna entera, así que aquí la sangría de los controles no aplica. -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            Margin="{StaticResource Pad.RatesActions}"
                            c:Stack.Gap="{StaticResource Space.S}"
                            Visibility="{Binding ShowRates, Converter={StaticResource BoolToVisibility}}">
                    <!-- Apagado mientras no haya nada que guardar. P-27 no aplica —apagado ya lo
                         dice entero, porque lo único que puede encenderlo es haber tocado la tabla
                         (F27, cierre)—, y es la única «marca de sucio» que sobrevive a R5: aquí sí
                         hay un paso entre editar y publicar, porque lo que se publica es del
                         equipo. -->
                    <Button Content="Guardar tarifas" Command="{Binding Rates.SaveCommand}"
                            Style="{StaticResource Button.Primary}"
                            IsEnabled="{Binding Rates.IsDirty}" />
                    <Button Content="Añadir modelo" Command="{Binding Rates.AddRowCommand}"
                            Style="{StaticResource Button.Secondary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
