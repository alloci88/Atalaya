<UserControl
    x:Class="Atalaya.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        F5.7 §1: un solo ritmo para toda la página. Cada control es una FILA con la MISMA
        rejilla (etiqueta de 220 · control) y el MISMO margen inferior, y su línea de ayuda
        cuelga bajo el control, alineada con él. Antes cada bloque llevaba su propio margen
        a ojo y los umbrales quedaban con un espaciado que no seguía ninguna regla.
    -->
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,26" />
        </Style>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="FieldHelp" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left" Margin="0,0,0,20">
            <TextBlock Text="Ajustes" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="La conexión con GitHub y el hub vive en «Cuenta»." Opacity="0.65" FontSize="12" Margin="0,0,0,24" />

            <!-- ============================== General ============================== -->
            <StackPanel Style="{StaticResource SectionBlock}">
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tema claro" Style="{StaticResource FieldLabel}" />
                    <ui:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsLightTheme}" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Cambia el tema oscuro por el claro. Aplica al guardar, sin reiniciar la aplicación."
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Editor preferido" Style="{StaticResource FieldLabel}" />
                    <ComboBox
                        Grid.Row="0" Grid.Column="1"
                        SelectedValue="{Binding Editor}" SelectedValuePath="Tag"
                        Width="220" HorizontalAlignment="Left">
                        <ComboBoxItem Content="Visual Studio" Tag="vs" />
                        <ComboBoxItem Content="VS Code" Tag="vscode" />
                    </ComboBox>
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Con qué editor se abre el código desde la ficha de un hallazgo (botón «Abrir en el editor»). Aplica al guardar: lo lee cada vez que abres código."
                        Style="{StaticResource FieldHelp}" />
                </Grid>
            </StackPanel>

            <!-- ============================= Auditoría ============================= -->
            <StackPanel Style="{StaticResource SectionBlock}">
                <TextBlock Text="Auditoría" Style="{StaticResource SectionTitle}" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Unidad grande (LOC)" Style="{StaticResource FieldLabel}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Se gobierna por aplicación, en Inventario → Gobernanza → Umbrales." />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="No se edita aquí: este umbral clasifica el inventario y crea los hallazgos de tamaño, que viven en el hub y comparte todo el equipo. Por eso es política de cada aplicación —una sola verdad, versionada, con el commit del hub diciendo quién la cambió— y no una preferencia de esta máquina. Aplica al re-escanear."
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pasadas del barrido (tope)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxPassesPerUnit}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Cuántas veces se repite la revisión de una unidad hasta que una pasada queda seca. Con 1, cada auditoría es una pasada única. Si se agota el tope sin secarse, la unidad queda marcada como «cobertura posiblemente incompleta». Aplica a las auditorías que lances a partir de ahora; la que esté en curso termina con el tope que tenía. Mínimo 1."
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Frescura (días)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FreshnessDays}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="A partir de cuántos días sin reconfirmarse un hallazgo se marca como pendiente de revisión en «Hallazgos». Aplica al guardar: la lista lo usa la próxima vez que se dibuja. Mínimo 1 día."
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <!-- F14 — con quién auditas. Va JUSTO ENCIMA del modelo porque lo condiciona:
                     cambiar de casa recarga la lista de modelos y recupera el que esa casa tenía
                     elegido. El estado de cada proveedor (instalado, con sesión) se ve en Cuenta,
                     que es donde se arregla; aquí solo se elige. -->
                <Grid Style="{StaticResource FieldRow}"
                      Visibility="{Binding HasProviderChoice, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Proveedor de auditoría" Style="{StaticResource FieldLabel}" />
                    <ComboBox
                        Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding Providers}"
                        SelectedValue="{Binding SelectedProviderId}"
                        SelectedValuePath="Id"
                        DisplayMemberPath="Name"
                        Width="260" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="{Binding ProviderNotice}"
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Modelo del auditor" Style="{StaticResource FieldLabel}" />
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox
                            ItemsSource="{Binding Models}"
                            SelectedValue="{Binding SelectedModelId}"
                            SelectedValuePath="Id"
                            DisplayMemberPath="Label"
                            Width="260" />
                        <ui:Button Content="Actualizar lista" Command="{Binding RefreshModelsCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Los modelos del proveedor elegido arriba: Copilot los publica para tu cuenta con su multiplicador de coste cuando lo da, y Claude Code ofrece sus alias de familia, que siempre apuntan al último modelo de cada una. Cada proveedor recuerda el suyo. Aplica a las sesiones que lances a partir de ahora, sin reiniciar, y queda registrado en el informe."
                        Style="{StaticResource FieldHelp}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        Text="{Binding ModelsNotice}"
                        TextWrapping="Wrap" Opacity="0.85" FontSize="12" Foreground="#E0A030" Margin="0,6,0,0"
                        Visibility="{Binding ModelsNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                </Grid>

                <!-- F6.9: el interruptor del arreglo asistido vuelve a Ajustes, ahora que hay
                     algo detrás. Encendido por defecto: es supervisado por diseño. -->
                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Arreglo asistido" Style="{StaticResource FieldLabel}" />
                    <ui:ToggleSwitch Grid.Row="0" Grid.Column="1" IsChecked="{Binding EnableAssistedFix}"
                                     HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Habilita «Arreglar con agente» en la ficha de un hallazgo: el agente arregla sobre tu clon local explicando lo que hace y pidiéndote permiso para tocar ficheros que no son del hallazgo. Nunca commitea ni publica nada, y exige que no tengas cambios sin commitear. El generador de prompt de arreglo funciona igual con esto apagado. Aplica al guardar."
                        Style="{StaticResource FieldHelp}" />
                </Grid>
            </StackPanel>

            <!-- =========================== Sincronización =========================== -->
            <StackPanel Style="{StaticResource SectionBlock}">
                <TextBlock Text="Sincronización" Style="{StaticResource SectionTitle}" />

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sincronización del hub (segundos)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PollingSeconds}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Cada cuántos segundos se buscan cambios de tus compañeros en el hub. Aplica al guardar, sin reiniciar. El mínimo es 15."
                        Style="{StaticResource FieldHelp}" />
                </Grid>

                <Grid Style="{StaticResource FieldRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Timeout de Copilot (minutos)" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CopilotTimeoutMinutes}" Width="120" HorizontalAlignment="Left" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        Text="Tiempo máximo de espera por una respuesta del modelo antes de dar el turno por fallido — y también por cada compilación del arreglo asistido. Aplica al guardar, en el siguiente turno. Mínimo 1 minuto."
                        Style="{StaticResource FieldHelp}" />
                </Grid>
            </StackPanel>

            <ui:Button Content="Guardar" Command="{Binding SaveCommand}" Appearance="Primary" HorizontalAlignment="Left" />
            <!--
                No hay TextBlock de estado aquí: el aviso de guardado va por el toast global de
                F5.3. El que vivía en este punto quedaba por debajo del borde de la ventana y
                nadie lo veía sin bajar a buscarlo (F5.7 §4).
            -->

            <!-- F6.4 · «Acerca de»: versión real, organización y enlaces. Va antes de la zona
                 peligrosa porque lo último de una página no puede ser algo que no da miedo. -->
            <ui:Button Content="Acerca de Atalaya"
                       Command="{Binding ShowAboutCommand}"
                       Appearance="Secondary"
                       HorizontalAlignment="Left"
                       Margin="0,26,0,0" />

            <!-- ========================== Zona peligrosa ========================== -->
            <Border
                Background="#18D13A3A"
                BorderBrush="#55D13A3A"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,34,0,0">
                <StackPanel>
                    <TextBlock Text="Zona peligrosa" FontSize="15" FontWeight="SemiBold"
                               Foreground="#E05050" Margin="0,0,0,12" />
                    <TextBlock Text="Restablecimiento de fábrica" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock
                        Text="Borra TODAS las aplicaciones del hub —las tuyas y las de tus compañeros— y deja esta máquina como recién instalada: sin clon del hub, sin ajustes y con la cuenta desconectada. El historial git del hub conserva una copia recuperable por un administrador."
                        Style="{StaticResource FieldHelp}" Opacity="0.85" FontSize="12" Margin="0,0,0,14" />
                    <ui:Button
                        Content="Restablecimiento de fábrica"
                        Command="{Binding FactoryResetCommand}"
                        Appearance="Danger"
                        HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
