<UserControl
    x:Class="Atalaya.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:vm="clr-namespace:Atalaya.App.ViewModels">
    <!--
        F26 Parte C — AJUSTES DEJA DE SER UN SCROLL.

        Eran dos pantallas y media de alto con las descripciones a 11 px, la caja del tope de
        pasadas del tamaño de dos cifras y «Guardar» al fondo, fuera de la vista mientras se
        editaba. Ahora son CINCO SECCIONES navegables por una lista lateral —el mismo gesto que el
        raíl una capa más abajo—, cada ajuste es una fila con el mismo ritmo (etiqueta y UNA línea
        de ayuda a la izquierda, control a la derecha) y lo que no cabe en esa línea vive detrás de
        un «más». La barra de guardar está siempre al pie, con su primario dentro.

        El orden de las secciones es el del trabajo: con quién auditas · cómo audita · lo que
        cuesta · cómo se ve · lo demás.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================================================== Cabecera -->
        <StackPanel Grid.Row="0" Margin="{StaticResource Pad.L.Bottom}">
            <TextBlock Text="Ajustes" Style="{StaticResource Text.H2}" />
            <TextBlock Style="{StaticResource Text.Small}"
                       Text="Las preferencias de esta máquina. La conexión con GitHub y el hub vive en «Cuenta»." />
        </StackPanel>

        <!-- ==================================================== Secciones + contenido -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- La lista de secciones. Se construye desde `Sections` y no como cinco botones
                 escritos a mano por lo mismo que el raíl (D-954): la entrada activa es un dato, y
                 un dato se puede probar. -->
            <ItemsControl Grid.Column="0"
                          Width="{StaticResource Setting.SectionsWidth}"
                          Margin="{StaticResource Pad.L.Right}"
                          ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsSectionItem}">
                        <Button Style="{StaticResource Setting.Section}"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Padding="{StaticResource Pad.L.Right}">
                <Grid MaxWidth="{StaticResource Content.MaxWidth}" HorizontalAlignment="Left">

                    <!-- ============================== Proveedor y modelo ============================== -->
                    <StackPanel Visibility="{Binding ShowProvider, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Proveedor y modelo" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}"
                                   Visibility="{Binding HasProviderChoice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Proveedor de auditoría" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Con quién auditas tú, en esta máquina. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasProveedor" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="{Binding ProviderNotice}"
                                           Visibility="{Binding IsChecked, ElementName=MasProveedor, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Providers}"
                                      SelectedValue="{Binding SelectedProviderId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      MinWidth="{StaticResource Field.SelectWidth}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Modelo del auditor" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Qué modelo del proveedor audita. Aplica a las sesiones que lances a partir de ahora." />
                                <ToggleButton x:Name="MasModelo" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="Copilot los publica para tu cuenta con su multiplicador de coste cuando lo da, y Claude Code ofrece sus alias de familia, que siempre apuntan al último modelo de cada una. Cada proveedor recuerda el suyo, y queda registrado en el informe de la sesión."
                                           Visibility="{Binding IsChecked, ElementName=MasModelo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.XS}">
                                    <ComboBox ItemsSource="{Binding Models}"
                                              SelectedValue="{Binding SelectedModelId}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Label"
                                              MinWidth="{StaticResource Field.SelectWidth}" />
                                    <Button Content="Actualizar lista" Command="{Binding RefreshModelsCommand}"
                                            Style="{StaticResource Button.Secondary}" />
                                </StackPanel>

                                <!-- El aviso de la lista de modelos, por el recurso del sistema: el
                                     ámbar escrito a mano de antes era ilegible en tema claro
                                     (D-983 §8). -->
                                <Border Style="{StaticResource Notice.Warning}"
                                        Margin="{StaticResource Pad.S.Top}"
                                        Visibility="{Binding ModelsNotice, Converter={StaticResource NotEmptyToVisibility}}">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                              Data="{x:Static c:Icons.Warning}"
                                              Stroke="{DynamicResource Brush.Warning.Ink}" />
                                        <TextBlock Text="{Binding ModelsNotice}" Style="{StaticResource Notice.Text}"
                                                   Foreground="{DynamicResource Brush.Warning.Ink}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>

                    <!-- ============================== Auditoría ============================== -->
                    <StackPanel Visibility="{Binding ShowAudit, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Auditoría" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Pasadas del barrido (tope)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="El presupuesto de pasadas por unidad. Aplica a las auditorías que lances a partir de ahora." />
                                <ToggleButton x:Name="MasPasadas" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="De él salen también las DOS pasadas secas seguidas con las que el barrido se da por terminado: con un tope de 6 quedan 4 pasadas que puedan aportar algo. Con 1, cada auditoría es una pasada única. Si se agota el tope sin llegar a las dos secas, la unidad queda marcada como «cobertura posiblemente incompleta». La que esté en curso termina con el tope que tenía. Mínimo 1."
                                           Visibility="{Binding IsChecked, ElementName=MasPasadas, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBox Text="{Binding MaxPassesPerUnit}" Style="{StaticResource Field.Number}"
                                     VerticalAlignment="Top" />
                        </DockPanel>

                        <!-- R2 §1 — MODO EXHAUSTIVO. Va junto al tope porque los dos gobiernan lo
                             mismo: cuánto se paga por unidad. La frase del icono es literal: sale de
                             SettingsViewModel.ExhaustiveWarning, para que no haya dos versiones del
                             precio. -->
                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Modo exhaustivo" Style="{StaticResource Setting.Name}" />
                                <!-- UNA línea, y la que dice qué hace y qué cuesta. La de antes
                                     describía lo que el modo NO hace cuando está apagado, que es
                                     la forma más rápida de no entender un interruptor. El texto
                                     sale del view-model, el mismo que el tooltip del icono: una
                                     sola versión del precio (R2 §1). -->
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="{Binding ExhaustiveNotice}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        c:Stack.Gap="{StaticResource Space.XS}">
                                <ui:ToggleSwitch IsChecked="{Binding ExhaustiveSweep}" VerticalAlignment="Center" />
                                <Path Style="{StaticResource Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}"
                                      ToolTip="{Binding ExhaustiveNotice}" />
                            </StackPanel>
                        </DockPanel>

                        <!-- F6.9: el interruptor del arreglo asistido. Vive en Auditoría y no en
                             Avanzado porque gobierna lo que un agente puede hacer sobre tu clon,
                             que es de lo que va esta sección. -->
                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Arreglo asistido" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Habilita «Arreglar con agente» en la ficha de un hallazgo. Aplica al guardar." />
                                <ToggleButton x:Name="MasArreglo" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="El agente arregla sobre tu clon local explicando lo que hace y pidiéndote permiso para tocar ficheros que no son del hallazgo. Nunca commitea ni publica nada, y exige que no tengas cambios sin commitear. El generador de prompt de arreglo funciona igual con esto apagado."
                                           Visibility="{Binding IsChecked, ElementName=MasArreglo, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding EnableAssistedFix}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </DockPanel>

                    </StackPanel>

                    <!-- ============================== Tarifas ============================== -->
                    <!-- R2 §2 trajo esta pantalla desde Métricas y la dejó detrás de un botón que
                         abría una ventana; F26 §C la hizo sección. Esta revisión la hace TABLA:
                         el `DataGrid` de la librería salía plano y, en ventana reducida, recortaba
                         sus propias cabeceras —«Entrada $/» , «Caché leíd»—, que es la peor forma
                         de ahorrar sitio: se pierde justo lo que dice qué es cada columna.

                         Ahora es la tabla del sistema, con cabecera de DOS líneas (nombre arriba,
                         unidad debajo), las cifras a la derecha con dígitos tabulares y una raya
                         fina por fila. El fichero sigue en el hub (D-786): esto es dónde se edita,
                         no dónde vive. -->
                    <Grid Visibility="{Binding ShowRates, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Tarifas" Style="{StaticResource Setting.SectionTitle}" />

                        <!-- UNA línea, y el resto plegado: la de antes eran cuatro y había que
                             leerlas enteras para llegar a la tabla, que es lo que se viene a ver. -->
                        <StackPanel Grid.Row="1" Margin="{StaticResource Pad.M.Bottom}">
                            <TextBlock Style="{StaticResource Text.Small}"
                                       MaxWidth="{StaticResource Read.MaxWidth}" HorizontalAlignment="Left"
                                       Text="Precio por millón de tokens de cada modelo. Son de la organización: viven en el hub." />
                            <ToggleButton x:Name="MasTarifas" Style="{StaticResource Toggle.More}" />
                            <TextBlock Style="{StaticResource Setting.More}"
                                       MaxWidth="{StaticResource Read.MaxWidth}" HorizontalAlignment="Left"
                                       Text="De aquí sale el coste de cada sesión. La aplicación las trae puestas y las mantiene al día sola: aquí se corrige un precio que no cuadre y se añade el de un modelo que no traiga. Las ve todo el equipo, con el commit del hub como atribución. Proveedor en blanco = vale para cualquiera; ponlo solo cuando el mismo modelo cueste distinto según quién facture. Caché escrita en blanco = ese modelo no la cobra aparte, y esos tokens son entrada normal; no es lo mismo que escribir un 0."
                                       Visibility="{Binding IsChecked, ElementName=MasTarifas, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border Grid.Row="2" Style="{StaticResource Notice.Warning}"
                                Margin="{StaticResource Pad.M.Bottom}"
                                Visibility="{Binding Rates.HasMissing, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Notice.Text}"
                                               Foreground="{DynamicResource Brush.Warning.Ink}"
                                               Text="Modelos usados SIN tarifa configurada. Sus sesiones no se pueden valorar, así que los agregados que las incluyan salen marcados como parciales." />
                                    <ItemsControl ItemsSource="{Binding Rates.MissingModels}"
                                                  Margin="{StaticResource Pad.XS.Top}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Small}"
                                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- EN ESTRECHO, LA TABLA SE DESPLAZA; las cabeceras no se recortan nunca.
                             El ancho de la rejilla sigue al del hueco visible —así las columnas
                             reparten cuando sobra— pero no baja de su mínimo: por debajo aparece la
                             barra horizontal, que es «reorganizar» en una tabla (principio 1). La
                             cabecera va DENTRO del mismo desplazamiento, o se separaría de sus
                             columnas al primer arrastre. -->
                        <Border Grid.Row="3" Style="{StaticResource Panel}"
                                Visibility="{Binding CanManageRates, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer x:Name="RatesScroll"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <Grid MinWidth="1040"
                                      Width="{Binding ViewportWidth, ElementName=RatesScroll}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" MinWidth="220" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="1*" MinWidth="110" />
                                        <ColumnDefinition Width="1*" MinWidth="110" />
                                        <ColumnDefinition Width="1*" MinWidth="130" />
                                        <ColumnDefinition Width="1*" MinWidth="140" />
                                        <ColumnDefinition Width="2*" MinWidth="200" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.ColumnSpan="7"
                                            BorderBrush="{DynamicResource Brush.LineStrong}"
                                            BorderThickness="{StaticResource Border.Bottom}" />

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Modelo" Style="{StaticResource Table.Header}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Proveedor" Style="{StaticResource Table.Header}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Entrada" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="$ por millón" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Salida" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="$ por millón" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Caché leída" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="$ por millón" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="5" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Caché escrita" Style="{StaticResource Table.Header}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="$ por millón" Style="{StaticResource Table.HeaderUnit}"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6" Margin="{StaticResource Pad.Row}">
                                        <TextBlock Text="Nota" Style="{StaticResource Table.Header}" />
                                    </StackPanel>

                                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="7"
                                                  ItemsSource="{Binding Rates.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Brush.Line}"
                                                        BorderThickness="{StaticResource Border.Bottom}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*" MinWidth="220" />
                                                            <ColumnDefinition Width="1*" MinWidth="130" />
                                                            <ColumnDefinition Width="1*" MinWidth="110" />
                                                            <ColumnDefinition Width="1*" MinWidth="110" />
                                                            <ColumnDefinition Width="1*" MinWidth="130" />
                                                            <ColumnDefinition Width="1*" MinWidth="140" />
                                                            <ColumnDefinition Width="2*" MinWidth="200" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Model}"
                                                                 Style="{StaticResource Field.Cell}"
                                                                 FontWeight="SemiBold" />
                                                        <TextBox Grid.Column="1" Text="{Binding Provider}"
                                                                 Style="{StaticResource Field.Cell.Pill}" />
                                                        <TextBox Grid.Column="2" Text="{Binding Input}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="3" Text="{Binding Output}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="4" Text="{Binding CachedInput}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="5" Text="{Binding CacheWrite}"
                                                                 Style="{StaticResource Field.Cell.Number}" />
                                                        <TextBox Grid.Column="6" Text="{Binding Note}"
                                                                 Style="{StaticResource Field.Cell.Note}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>
                        </Border>

                        <c:EmptyState Grid.Row="3"
                                      Glyph="{x:Static c:Icons.Metrics}"
                                      Message="Todavía no hay tabla de tarifas en el hub. Se siembra sola al conectar con él."
                                      Visibility="{Binding CanManageRates, Converter={StaticResource InverseBoolToVisibility}}" />

                        <Border Grid.Row="4" Style="{StaticResource Notice.Warning}"
                                Margin="{StaticResource Pad.S.Top}"
                                Visibility="{Binding Rates.Status, Converter={StaticResource NotEmptyToVisibility}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Warning}"
                                      Stroke="{DynamicResource Brush.Warning.Ink}" />
                                <TextBlock Text="{Binding Rates.Status}" Style="{StaticResource Notice.Text}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ============================== Apariencia ============================== -->
                    <StackPanel Visibility="{Binding ShowAppearance, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Apariencia" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Tema claro" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Cambia el tema oscuro por el claro. Aplica al guardar, sin reiniciar la aplicación." />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding IsLightTheme}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </DockPanel>

                        <!-- NO hay control de escala tipográfica, y no se inventa uno: la escala es
                             del sistema (D-946) y quien necesita el texto más grande lo tiene en la
                             de Windows, que Atalaya respeta al dibujarse con vectores (D-950). El
                             aviso dice DÓNDE está, con la ruta entera: mandar a «la escala de
                             Windows» sin decir por dónde se llega es no contestar. -->
                        <Border Style="{StaticResource Notice.Info}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                      Data="{x:Static c:Icons.Info}"
                                      Stroke="{DynamicResource Brush.Primary.Ink}" />
                                <TextBlock Style="{StaticResource Notice.Text}"
                                           Text="El tamaño del texto sigue la escala de Windows (Configuración → Pantalla → Escala). Atalaya no tiene un ajuste propio." />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================== Avanzado ============================== -->
                    <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Avanzado" Style="{StaticResource Setting.SectionTitle}" />

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Editor preferido" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Con qué editor se abre el código desde la ficha de un hallazgo. Aplica al guardar." />
                            </StackPanel>
                            <ComboBox SelectedValue="{Binding Editor}" SelectedValuePath="Tag"
                                      MinWidth="{StaticResource Field.SelectWidth}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top">
                                <ComboBoxItem Content="Visual Studio" Tag="vs" />
                                <ComboBoxItem Content="VS Code" Tag="vscode" />
                            </ComboBox>
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Frescura (días)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="A partir de cuántos días sin reconfirmarse un hallazgo se marca como pendiente de revisión. Aplica al guardar. Mínimo 1 día." />
                            </StackPanel>
                            <TextBox Text="{Binding FreshnessDays}" Style="{StaticResource Field.Number}"
                                     VerticalAlignment="Top" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Sincronización del hub (segundos)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Cada cuántos segundos se buscan cambios de tus compañeros en el hub. Aplica al guardar, sin reiniciar. El mínimo es 15." />
                            </StackPanel>
                            <TextBox Text="{Binding PollingSeconds}" Style="{StaticResource Field.Number}"
                                     VerticalAlignment="Top" />
                        </DockPanel>

                        <DockPanel Style="{StaticResource Setting.Row}">
                            <StackPanel Style="{StaticResource Setting.Label}">
                                <TextBlock Text="Timeout de Copilot (minutos)" Style="{StaticResource Setting.Name}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Tiempo máximo de espera por una respuesta del modelo antes de dar el turno por fallido. Aplica al guardar, en el siguiente turno." />
                                <ToggleButton x:Name="MasTimeout" Style="{StaticResource Toggle.More}" />
                                <TextBlock Style="{StaticResource Setting.More}"
                                           Text="Vale también para cada compilación del arreglo asistido. Mínimo 1 minuto."
                                           Visibility="{Binding IsChecked, ElementName=MasTimeout, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBox Text="{Binding CopilotTimeoutMinutes}" Style="{StaticResource Field.Number}"
                                     VerticalAlignment="Top" />
                        </DockPanel>

                        <!-- ZONA PELIGROSA. Va al final, y lo que la marca es el color del sistema
                             —no un hexadecimal escrito a mano, que era ilegible en tema claro
                             (D-983 §8)—. El botón es peligro macizo porque destruir ES la acción
                             de este bloque (D-949). -->
                        <Border Style="{StaticResource Notice.Danger}" Margin="{StaticResource Pad.M.Top}"
                                MaxWidth="{StaticResource Form.MaxWidth}" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Zona peligrosa" Style="{StaticResource Text.Lead}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Danger.Ink}" />
                                <TextBlock Text="Restablecimiento de fábrica"
                                           Style="{StaticResource Setting.Name}"
                                           FontWeight="SemiBold"
                                           Margin="{StaticResource Pad.XS.Top}" />
                                <TextBlock Style="{StaticResource Setting.Help}"
                                           Text="Borra TODAS las aplicaciones del hub —las tuyas y las de tus compañeros— y deja esta máquina como recién instalada: sin clon del hub, sin ajustes y con la cuenta desconectada. El historial git del hub conserva una copia recuperable por un administrador." />
                                <Button Content="Restablecimiento de fábrica"
                                        Command="{Binding FactoryResetCommand}"
                                        Style="{StaticResource Button.DangerSolid}"
                                        HorizontalAlignment="Left"
                                        Margin="{StaticResource Pad.S.Top}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ==================================================== La barra de guardar

             Al PIE de la vista y siempre a la vista, que es lo que «Guardar» no era: vivía al final
             de un scroll de dos pantallas, así que se editaba sin tenerlo delante.

             UN primario, y el de la sección que estás editando (principio 4): en Tarifas se guarda
             la tabla del hub, que es otra cosa y otro sitio. Dos «Guardar» a la vez habrían dejado
             al usuario decidiendo cuál era el suyo.
        -->
        <Border Grid.Row="2" Style="{StaticResource Card}"
                Padding="{StaticResource Pad.SaveBar}"
                CornerRadius="{StaticResource Radius.M}"
                Margin="{StaticResource Pad.M.Top}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            c:Stack.Gap="{StaticResource Space.S}"
                            Visibility="{Binding ShowRates, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Content="Descartar" Command="{Binding DiscardCommand}"
                            Style="{StaticResource Button.Secondary}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Guardar" Command="{Binding SaveCommand}"
                            Style="{StaticResource Button.Primary}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            c:Stack.Gap="{StaticResource Space.S}"
                            Visibility="{Binding ShowRates, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Añadir modelo" Command="{Binding Rates.AddRowCommand}"
                            Style="{StaticResource Button.Secondary}" />
                    <Button Content="Guardar tarifas" Command="{Binding Rates.SaveCommand}"
                            Style="{StaticResource Button.Primary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            c:Stack.Gap="{StaticResource Space.XS}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource Icon.Small}"
                          Data="{x:Static c:Icons.Info}"
                          Stroke="{DynamicResource Brush.Warning.Ink}" />
                    <TextBlock Text="Hay cambios sin guardar" Style="{StaticResource Text.Small}"
                               Foreground="{DynamicResource Brush.Warning.Ink}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
