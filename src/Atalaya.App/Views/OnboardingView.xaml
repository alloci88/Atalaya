<UserControl
    x:Class="Atalaya.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Nueva aplicación" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Registra un repo auditable: detecta el stack y construye el inventario del primer ciclo."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16" />

            <!-- R3: el repositorio se ELIGE. La organización ya está identificada —es la de la
                 cuenta conectada— así que los repositorios donde puede vivir una app son una
                 lista, no un texto. El combo es editable a propósito: escribir filtra la lista, y
                 si la lista no cargó, lo escrito vale como URL y el alta sigue siendo posible. -->
            <TextBlock Text="Repositorio" FontWeight="SemiBold" Margin="0,4,0,4" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          IsEditable="True"
                          IsTextSearchEnabled="False"
                          ItemsSource="{Binding Repositories}"
                          SelectedItem="{Binding SelectedRepository}"
                          TextSearch.TextPath="Name"
                          Text="{Binding RepoQuery, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="· ya en el hub" Opacity="0.65" Margin="8,0,0,0"
                                           Visibility="{Binding AlreadyInHub, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button Grid.Column="1" Content="Recargar" Command="{Binding ReloadRepositoriesCommand}"
                           Margin="8,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding RepoListNotice}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Visibility="{Binding RepoListNotice, Converter={StaticResource NotEmptyToVisibility}}" />

            <!-- El nombre ya no se teclea: es el del repositorio elegido. -->
            <TextBlock Text="Nombre" FontWeight="SemiBold" Margin="0,4,0,4" />
            <TextBlock Text="{Binding Name}" FontSize="16"
                       Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="Se toma del repositorio que elijas." Opacity="0.6" FontStyle="Italic"
                       Visibility="{Binding HasName, Converter={StaticResource InverseBoolToVisibility}}" />
            <TextBlock Text="{Binding RepoUrl}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                       Margin="0,2,0,12"
                       Visibility="{Binding RepoUrl, Converter={StaticResource NotEmptyToVisibility}}" />

            <TextBlock Text="Ruta del clon local (en esta máquina)" FontWeight="SemiBold" Margin="0,4,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Text="{Binding ClonePath, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Column="1" Content="Examinar…" Command="{Binding PickClonePathCommand}" Margin="8,0,0,0" />
                <ui:Button Grid.Column="2" Content="Detectar stack" Command="{Binding DetectCommand}" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Stack detectado: " Opacity="0.7" />
                <TextBlock Text="{Binding DetectedStack}" FontWeight="SemiBold" />
            </StackPanel>

            <!-- F5.8 §2: el repo elegido ya está en el portafolio. El asistente no crea un
                 duplicado: redirige al gesto correcto, que es vincular el clon. -->
            <Border Background="#22D2B036" BorderBrush="#55D2B036" BorderThickness="1"
                    CornerRadius="6" Padding="12,10" Margin="0,0,0,16"
                    Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding DuplicateNotice}" TextWrapping="Wrap" />
                    <ui:Button Content="{Binding LinkExistingLabel}"
                               Command="{Binding LinkExistingCommand}"
                               Appearance="Primary"
                               HorizontalAlignment="Left"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- F5.9 §1: el importador v4 ya no es un destino del menú. Es un paso OPCIONAL de
                 esta alta, porque traerse lo que el sistema anterior sabía de la app y dar la app
                 de alta son el mismo gesto y se hace una sola vez por aplicación. El asistente
                 busca la carpeta solo; si no está donde debería, se señala a mano. -->
            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Baseline del sistema v4 (opcional)" FontWeight="SemiBold" />
                    <TextBlock Text="Si esta aplicación ya se auditaba con el sistema v4, su carpeta CodeAudit/ se puede importar ahora: hallazgos, silencios, histórico e informes entran con el alta."
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding CodeAuditPath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ruta de la carpeta CodeAudit/" />
                        <ui:Button Grid.Column="1" Content="Elegir carpeta…" Command="{Binding PickBaselineCommand}"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding BaselineNotice}" FontSize="12" Opacity="0.8" TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding BaselineNotice, Converter={StaticResource NotEmptyToVisibility}}" />

                    <CheckBox Content="Importar el baseline del sistema v4 al crear la aplicación"
                              IsChecked="{Binding ImportBaseline}"
                              IsEnabled="{Binding HasBaseline}" />

                    <!-- La salida del importador se queda a la vista: no es el aviso de una
                         acción (eso va por toast, F5.7 §4) sino lo que no se pudo importar. -->
                    <ItemsControl ItemsSource="{Binding ImportLog}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,1" Opacity="0.85" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ui:Button Content="Crear e inventariar" Command="{Binding CreateCommand}" Appearance="Primary"
                       IsEnabled="{Binding CanCreate}" HorizontalAlignment="Left" />
            <!-- F5.7 §4: sin texto de estado al pie. El resultado va por el toast global. -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
