<UserControl
    x:Class="Atalaya.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls">
    <!--
        F26 Parte C — NUEVA APLICACIÓN, por el sistema.

        R3 dejó la vista bien planteada —el repositorio se elige de una lista, el nombre se deriva
        de él, la ruta local se examina— y maquetada a la antigua: columna estrecha pegada al borde
        izquierdo con el resto de la pantalla vacía, ayudas a 11 px, títulos de tarjeta a 13,5 y la
        validación en un toast que decía dos cosas a la vez sin señalar ninguna.

        Ahora el formulario se CENTRA en su ancho, las filas son las de Ajustes —etiqueta con su
        línea de ayuda a la izquierda, control a la derecha— y cada error de validación va debajo
        de su campo, en peligro.
    -->
    <ScrollViewer Style="{StaticResource Scroll}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="{StaticResource Form.MaxWidth}" HorizontalAlignment="Center"
                    Margin="{StaticResource Pad.L.Bottom}">

            <TextBlock Text="Nueva aplicación" Style="{StaticResource Text.H2}" />
            <TextBlock Style="{StaticResource Text.Small}" Margin="{StaticResource Pad.L.Bottom}"
                       Text="Registra un repo auditable: detecta el stack y construye el inventario del primer ciclo." />

            <!-- ==================================================== Qué se audita -->
            <!-- Dos tarjetas, porque son dos preguntas distintas: QUÉ se audita (el repositorio,
                 que es de la organización y lo ve todo el equipo) y DÓNDE está en ESTA máquina (el
                 clon, que es de este puesto — R3 §4). -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource Pad.M.Bottom}">
                <StackPanel>
                    <TextBlock Text="El repositorio" Style="{StaticResource Text.Lead}" FontWeight="SemiBold"
                               Margin="{StaticResource Pad.M.Bottom}" />

                    <!-- R3: el repositorio se ELIGE. La organización ya está identificada —es la de
                         la cuenta conectada— así que los repositorios donde puede vivir una app son
                         una lista, no un texto. El combo es editable a propósito: escribir filtra la
                         lista, y si la lista no cargó, lo escrito vale como URL. -->
                    <DockPanel Style="{StaticResource Setting.Row}">
                        <StackPanel Style="{StaticResource Setting.Label}">
                            <TextBlock Text="Repositorio" Style="{StaticResource Setting.Name}" />
                            <TextBlock Style="{StaticResource Setting.Help}"
                                       Text="Los repositorios de tu organización. Escribe para filtrar; los que ya están en el hub salen marcados." />
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Recargar"
                                        Command="{Binding ReloadRepositoriesCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="{StaticResource Pad.XS.Left}"
                                        ToolTip="Vuelve a pedirle la lista a GitHub. Úsalo si acabas de crear el repositorio." />
                                <ComboBox IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          MaxDropDownHeight="320"
                                          MinWidth="{StaticResource Field.SelectWidth}"
                                          ItemsSource="{Binding Repositories}"
                                          SelectedItem="{Binding SelectedRepository}"
                                          TextSearch.TextPath="Name"
                                          Text="{Binding RepoQuery, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel MinWidth="260">
                                                <!-- La marca va ESCRITA, no en un color (D-296). -->
                                                <Border DockPanel.Dock="Right"
                                                        Style="{StaticResource Pill}"
                                                        Margin="{StaticResource Pad.S.Left}"
                                                        Visibility="{Binding AlreadyInHub, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="ya en el hub" Style="{StaticResource Pill.Text}" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Name}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <TextBlock Text="{Binding RepoError}" Style="{StaticResource Text.Error}"
                                       Visibility="{Binding RepoError, Converter={StaticResource NotEmptyToVisibility}}" />

                            <!-- Cuando la lista falla, lo que hay que leer es el fallo y su salida.
                                 Va por el recurso de aviso del sistema y no con un ámbar propio:
                                 los que llevaban color a mano salían ilegibles en claro (D-983 §8). -->
                            <Border Style="{StaticResource Notice.Warning}"
                                    Margin="{StaticResource Pad.XS.Top}"
                                    Visibility="{Binding RepoListNotice, Converter={StaticResource NotEmptyToVisibility}}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                          Data="{x:Static c:Icons.Warning}"
                                          Stroke="{DynamicResource Brush.Warning.Ink}" />
                                    <TextBlock Text="{Binding RepoListNotice}" Style="{StaticResource Notice.Text}"
                                               Foreground="{DynamicResource Brush.Warning.Ink}" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- El nombre ya no se teclea: es el del repositorio elegido. Va con su URL en
                         un solo bloque para que se lean como lo que son —el RESULTADO de la
                         elección— y no como dos campos más que rellenar. -->
                    <DockPanel Style="{StaticResource Setting.Row}" Margin="{StaticResource Pad.Zero}">
                        <StackPanel Style="{StaticResource Setting.Label}">
                            <TextBlock Text="Aplicación" Style="{StaticResource Setting.Name}" />
                            <TextBlock Style="{StaticResource Setting.Help}"
                                       Text="El nombre se deriva del repositorio: no hay una tercera cosa que teclear mal." />
                        </StackPanel>
                        <Border Background="{DynamicResource Brush.Surface2}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="{StaticResource Border.Hairline}"
                                CornerRadius="{StaticResource Radius.M}"
                                Padding="{StaticResource Pad.Field}">
                            <StackPanel>
                                <TextBlock Text="Se toma del repositorio que elijas."
                                           Style="{StaticResource Text.Small}"
                                           FontStyle="Italic"
                                           Visibility="{Binding HasName, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Name}"
                                           FontSize="{StaticResource FontSize.Lead}"
                                           FontWeight="SemiBold"
                                           Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding RepoUrl}" Style="{StaticResource Text.Name}"
                                           FontSize="{StaticResource FontSize.Meta}"
                                           Foreground="{DynamicResource Brush.TextFaint}"
                                           ToolTip="{Binding RepoUrl}"
                                           Visibility="{Binding RepoUrl, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- F5.8 §2: el repo elegido ya está en el portafolio. El asistente no crea un
                 duplicado: redirige al gesto correcto, que es vincular el clon. -->
            <Border Style="{StaticResource Notice.Warning}" Margin="{StaticResource Pad.M.Bottom}"
                    Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                          Data="{x:Static c:Icons.Warning}"
                          Stroke="{DynamicResource Brush.Warning.Ink}" />
                    <StackPanel>
                        <TextBlock Text="{Binding DuplicateNotice}" Style="{StaticResource Notice.Text}"
                                   Foreground="{DynamicResource Brush.Warning.Ink}" />
                        <Button Content="{Binding LinkExistingLabel}"
                                Command="{Binding LinkExistingCommand}"
                                Style="{StaticResource Button.Primary}"
                                HorizontalAlignment="Left"
                                Margin="{StaticResource Pad.S.Top}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============================================ Dónde está en esta máquina -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource Pad.M.Bottom}">
                <StackPanel>
                    <TextBlock Text="El clon en esta máquina" Style="{StaticResource Text.Lead}" FontWeight="SemiBold"
                               Margin="{StaticResource Pad.M.Bottom}" />

                    <DockPanel Style="{StaticResource Setting.Row}">
                        <StackPanel Style="{StaticResource Setting.Label}">
                            <TextBlock Text="Carpeta" Style="{StaticResource Setting.Name}" />
                            <TextBlock Style="{StaticResource Setting.Help}"
                                       Text="Dónde tienes clonado ese repositorio en este equipo. La ruta es de esta máquina y no viaja al hub." />
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Examinar…"
                                        Command="{Binding PickClonePathCommand}"
                                        Style="{StaticResource Button.Secondary}"
                                        Margin="{StaticResource Pad.XS.Left}" />
                                <ui:TextBox Text="{Binding ClonePath, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="C:\ruta\a\tu\clon" />
                            </DockPanel>
                            <TextBlock Text="{Binding ClonePathError}" Style="{StaticResource Text.Error}"
                                       Visibility="{Binding ClonePathError, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Setting.Row}" Margin="{StaticResource Pad.Zero}">
                        <StackPanel Style="{StaticResource Setting.Label}">
                            <TextBlock Text="Stack" Style="{StaticResource Setting.Name}" />
                            <TextBlock Style="{StaticResource Setting.Help}"
                                       Text="Lo deduce de los ficheros del clon. Sin repositorio elegido, lo toma del «origin» de la carpeta." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" c:Stack.Gap="{StaticResource Space.S}">
                            <TextBlock Text="{Binding DetectedStack}" Style="{StaticResource Text.Default}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="90" />
                            <Button Content="Detectar stack" Command="{Binding DetectCommand}"
                                    Style="{StaticResource Button.Secondary}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- F5.9 §1: el importador v4 ya no es un destino del menú. Es un paso OPCIONAL de
                 esta alta, porque traerse lo que el sistema anterior sabía de la app y dar la app
                 de alta son el mismo gesto y se hace una sola vez por aplicación. -->
            <Border Style="{StaticResource Card}" Margin="{StaticResource Pad.M.Bottom}">
                <StackPanel>
                    <TextBlock Text="Baseline del sistema v4 (opcional)"
                               Style="{StaticResource Text.Lead}" FontWeight="SemiBold"
                               Margin="{StaticResource Pad.XXS.Bottom}" />
                    <TextBlock Style="{StaticResource Text.Small}" Margin="{StaticResource Pad.M.Bottom}"
                               Text="Si esta aplicación ya se auditaba con el sistema v4, su carpeta CodeAudit/ se puede importar ahora: hallazgos, silencios, histórico e informes entran con el alta." />

                    <DockPanel Style="{StaticResource Setting.Row}">
                        <StackPanel Style="{StaticResource Setting.Label}">
                            <TextBlock Text="Carpeta CodeAudit/" Style="{StaticResource Setting.Name}" />
                            <TextBlock Text="{Binding BaselineNotice}" Style="{StaticResource Setting.Help}"
                                       Visibility="{Binding BaselineNotice, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Elegir…"
                                    Command="{Binding PickBaselineCommand}"
                                    Style="{StaticResource Button.Secondary}"
                                    Margin="{StaticResource Pad.XS.Left}" />
                            <ui:TextBox Text="{Binding CodeAuditPath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Se busca sola dentro del clon" />
                        </DockPanel>
                    </DockPanel>

                    <DockPanel Style="{StaticResource Setting.Row}" Margin="{StaticResource Pad.Zero}">
                        <StackPanel Style="{StaticResource Setting.Label}" />
                        <CheckBox Content="Importar el baseline al crear la aplicación"
                                  IsChecked="{Binding ImportBaseline}"
                                  IsEnabled="{Binding HasBaseline}"
                                  VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- La salida del importador se queda a la vista: no es el aviso de una
                         acción (eso va por toast, F5.7 §4) sino lo que no se pudo importar.
                         Sin margen propio: vacío tiene que ocupar CERO, o la tarjeta se queda con
                         un hueco al pie en el caso normal, que es el de no importar nada. -->
                    <ItemsControl ItemsSource="{Binding ImportLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Mono}"
                                           TextWrapping="Wrap" Margin="{StaticResource Pad.XXS.Top}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- F5.7 §4: sin texto de estado al pie. El resultado va por el toast global. -->
            <Button Content="Crear e inventariar" Command="{Binding CreateCommand}"
                    Style="{StaticResource Button.Primary}"
                    IsEnabled="{Binding CanCreate}" HorizontalAlignment="Left"
                    MinWidth="180" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
