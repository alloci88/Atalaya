<UserControl
    x:Class="Atalaya.App.Views.MetricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Histórico y métricas" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock Text="Sin datos todavía." Opacity="0.6"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <WrapPanel>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="Activos" Opacity="0.6" />
                        <TextBlock Text="{Binding Summary.ActiveTotal}" FontSize="28" FontWeight="Bold" />
                        <TextBlock FontSize="11" Opacity="0.7">
                            <Run Text="Crít " /><Run Text="{Binding Summary.Critica}" />
                            <Run Text=" · Alta " /><Run Text="{Binding Summary.Alta}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="Resueltos" Opacity="0.6" />
                        <TextBlock Text="{Binding Summary.Resolved}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="Reincidencias" Opacity="0.6" />
                        <TextBlock Text="{Binding Summary.Recurrences}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="Tiempo medio a resolución" Opacity="0.6" />
                        <TextBlock Text="{Binding Summary.AvgDaysToResolution, StringFormat='{}{0:0.0} días'}" FontSize="24" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="% criterio" Opacity="0.6" />
                        <TextBlock Text="{Binding Summary.CriterioPct, StringFormat='{}{0:0}%'}" FontSize="28" FontWeight="Bold" />
                    </StackPanel>
                </Border>
                <Border Background="#14808080" CornerRadius="8" Padding="14" Margin="0,0,12,12" MinWidth="180">
                    <StackPanel>
                        <TextBlock Text="Tokens (in / out)" Opacity="0.6" />
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="{Binding Summary.InputTokens}" /><Run Text=" / " /><Run Text="{Binding Summary.OutputTokens}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Burndown (nuevos vs resueltos, 8 semanas)" FontWeight="SemiBold" Margin="0,10,0,10" />
            <Border Background="#0C000000" CornerRadius="8" Padding="14">
                <ItemsControl ItemsSource="{Binding Burndown}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="10,0" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="100">
                                    <Rectangle Width="14" Height="{Binding NewHeight}" Fill="#6C93C0" VerticalAlignment="Bottom" Margin="0,0,3,0" />
                                    <Rectangle Width="14" Height="{Binding ResolvedHeight}" Fill="#3FB950" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="Activos por aplicación" FontWeight="SemiBold" Margin="0,16,0,8" />
            <ItemsControl ItemsSource="{Binding PerApp}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Slug}" />
                            <TextBlock Grid.Column="1" Text="{Binding Active}" FontWeight="Bold" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
