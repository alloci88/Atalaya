<UserControl
    x:Class="Atalaya.App.Views.MetricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:c="clr-namespace:Atalaya.App.Controls"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <!--
        F26 Parte C — MÉTRICAS.

        Lo que se veía: cuatro tarjetas de resumen de alturas distintas y CENTRADAS en su fila, así
        que ni sus cifras ni sus bordes de arriba caían a la misma altura; las pastillas de gravedad
        pintadas con pinceles ya resueltos (D-971), que no cambian con el tema; los vacíos escritos
        como prosa gris a 12 px dentro del panel de la gráfica; y el conmutador «Acumulado» flotando
        sobre el título en vez de en su línea.

        Lo que NO cambia: qué se mide y cómo (D-786 y siguientes). Ni una consulta, ni un número, ni
        un filtro nuevo.
    -->
    <UserControl.Resources>

        <!-- El bloque de una gráfica: tarjeta del sistema con el hueco que la separa de la
             siguiente. Es lo único que queda de los ocho estilos locales que este fichero
             declaraba —su tipografía entera, a 15/12/11— porque el resto ya vive en el sistema. -->
        <Style x:Key="Block" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="{StaticResource Pad.M.Bottom}" />
        </Style>

        <!-- La leyenda: color + NOMBRE, nunca un color solo. Es la misma regla del piloto de
             vinculación (D-296): quien no distinga dos tonos tiene que poder leer cuál es cuál. -->
        <DataTemplate x:Key="LegendEntry">
            <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.BarItem}">
                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center"
                           Fill="{Binding Brush}"
                           StrokeDashArray="{Binding Dashed, Converter={StaticResource DashedToArray}}" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}"
                           Margin="{StaticResource Pad.XS.Left}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- La fila del registro de operaciones. Lleva plantilla propia por una razón medida en
             el render: el ContentPresenter del botón por defecto NO estira su contenido, así que
             la rejilla de columnas de la fila se encogía hasta el ancho del texto y dejaba de
             cuadrar con la de la cabecera. Ahora hereda del secundario del sistema, así que el
             color del texto y la altura mínima salen de ahí. -->
        <Style x:Key="SessionRow" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{StaticResource Pad.Zero}" />
            <Setter Property="Padding" Value="{StaticResource Pad.Row}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="{StaticResource Border.Bottom}"
                                MinHeight="40"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource Brush.Surface2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="{StaticResource Pad.S.Bottom}">
            <TextBlock Text="Métricas" Style="{StaticResource Text.H2}" />
            <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource Text.Small}" />
        </StackPanel>

        <!-- Fila de filtros: afectan a TODO el panel. Van arriba del todo porque cambian el
             significado de cada número de abajo, y cada uno dice QUÉ filtra (D-973): antes eran
             dos desplegables sin nombre y había que abrirlos para saber cuál era cuál. El ritmo lo
             pone la barra, uno y el mismo (D-984). -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Padding="{StaticResource Pad.XS}"
                CornerRadius="{StaticResource Radius.M}"
                Margin="{StaticResource Pad.M.Bottom}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Aplicación:" Style="{StaticResource Text.Small}"
                           VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                <ComboBox MinWidth="220" Margin="{StaticResource Pad.BarItem}"
                          ItemsSource="{Binding AppOptions}"
                          SelectedItem="{Binding SelectedApp}"
                          DisplayMemberPath="Name"
                          ToolTip="Filtra el panel entero por una aplicación" />

                <TextBlock Text="Periodo:" Style="{StaticResource Text.Small}"
                           VerticalAlignment="Center" Margin="{StaticResource Pad.XXS.Right}" />
                <ComboBox MinWidth="160" Margin="{StaticResource Pad.BarItem}"
                          ItemsSource="{Binding RangeOptions}"
                          SelectedItem="{Binding SelectedRange}"
                          DisplayMemberPath="Label"
                          ToolTip="Ventana temporal de las gráficas y de los tiles de periodo" />

                <ui:ProgressRing IsIndeterminate="True"
                                 Width="{StaticResource Icon.Size}" Height="{StaticResource Icon.Size}"
                                 Margin="{StaticResource Pad.BarItem}"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Border>

        <!-- El mismo canalón que la cabecera y los filtros. La barra de desplazamiento de WPF-UI
             se pinta ENCIMA del contenido, así que sin este hueco la última tarjeta de la fila de
             cifras queda debajo de la barra. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Padding="{StaticResource Pad.M.Right}">
            <StackPanel>

                <!-- Estado vacío del panel entero -->
                <Border Style="{StaticResource Block}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <c:EmptyState
                        Glyph="{x:Static c:Icons.Metrics}"
                        Message="Todavía no hay nada que medir. El panel se llena solo con lo que ya se guarda: hallazgos, inventarios y sesiones." />
                </Border>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                    <!-- ================= Las cuatro cifras (F35 §1.3) =================

                         Cobertura · Deuda activa · Coste · Coste por hallazgo resuelto. Cada una
                         es un número grande, una línea pequeña debajo y una flecha contra el
                         periodo anterior, y las cuatro llevan «Copiar» (F33).

                         UNA plantilla repetida, no cuatro bloques escritos a mano. Antes eran
                         cuatro `Border` con cuatro maneras de poner la cifra y su unidad —y la de
                         coste, con su desglose por proveedor y por fase, medía el triple que sus
                         vecinas—: exactamente lo que `ColumnsPanel` tiene después que igualar.

                         En `ColumnsPanel` y no en un `UniformGrid` con márgenes a mano: el panel
                         reparte el ancho entero, y —lo que hacía falta aquí— DA A TODAS LAS
                         TARJETAS DE UNA FILA EL ALTO DE LA MÁS ALTA (D-970). -->
                    <!-- LOS DOS AVISOS QUE ABARCAN LA REJILLA, no una tarjeta.

                         F15 · R2 §2 — FALTA GASTO POR CONTAR: hay sesiones cuyo modelo no tiene
                         tarifa. Afecta a las cuatro cifras, así que va encima de la rejilla.

                         F35 §1.3 — y con él, la nota de la casa que NO FACTURA. Vivía dentro del
                         azulejo de coste; explica dos de las cuatro cifras y es un párrafo, así
                         que dentro de una tarjeta la haría el doble de alta que sus vecinas y la
                         rejilla volvería a igualar por la peor (D-990). -->
                    <Border Style="{StaticResource Notice.Warning}"
                            Margin="{StaticResource Pad.M.Bottom}"
                            Visibility="{Binding CostPartialNotice, Converter={StaticResource NotEmptyToVisibility}}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Style="{StaticResource Notice.Icon}"
                                  Data="{x:Static c:Icons.Warning}"
                                  Stroke="{DynamicResource Brush.Warning.Ink}" />
                            <StackPanel>
                                <TextBlock Text="{Binding CostPartialNotice}"
                                           Style="{StaticResource Notice.Text}"
                                           Foreground="{DynamicResource Brush.Warning.Ink}" />
                                <Button Content="Ajustes → Tarifas"
                                        Style="{StaticResource Button.Link}"
                                        Command="{Binding ManageRatesCommand}"
                                        HorizontalAlignment="Left"
                                        ToolTip="Las tarifas se aplican solas desde el primer uso. Aquí se corrigen las que no cuadren y se añaden las de un modelo nuevo." />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="{Binding CostScopeNote}" Style="{StaticResource Text.Meta}"
                               TextWrapping="Wrap" Margin="{StaticResource Pad.XS.Bottom}"
                               Visibility="{Binding CostScopeNote, Converter={StaticResource NotEmptyToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Cards}" Margin="{StaticResource Pad.M.Bottom}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:ColumnsPanel MinColumnWidth="260" MaxColumns="4"
                                                Gap="{StaticResource Space.M}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Stat.Card}" ToolTip="{Binding ToolTip}">
                                    <StackPanel>
                                        <!-- El nombre a la izquierda y «Copiar» en la esquina
                                             superior derecha, que es donde D-1038 lo puso en la
                                             ficha del hallazgo: el mismo control de texto, no un
                                             icono nuevo. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                       Style="{StaticResource Stat.Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="Copiar"
                                                    Style="{StaticResource Button.Link}"
                                                    FontSize="{StaticResource FontSize.Meta}"
                                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Command="{Binding DataContext.CopyCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Copia la cifra, su línea de detalle y la tendencia como texto." />
                                        </Grid>

                                        <!-- La cifra y su unidad en UN `TextBlock` con dos `Run`:
                                             es lo único que comparte línea base en WPF (D-983 §9,
                                             D-990). Centrada, que es lo que iguala las cuatro. -->
                                        <TextBlock HorizontalAlignment="Center"
                                                   Margin="{StaticResource Pad.XS.Top}">
                                            <Run Text="{Binding Value, Mode=OneWay}"
                                                 FontSize="{StaticResource FontSize.H2}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Unit, Mode=OneWay}"
                                                 FontSize="{StaticResource FontSize.Small}"
                                                 Foreground="{DynamicResource Brush.TextMuted}" />
                                        </TextBlock>

                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Small}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="{StaticResource Pad.XXS.Top}" />

                                        <!-- EL COLOR SALE DE UN NOMBRE, no de un pincel resuelto en
                                             el view-model (D-971): un pincel ya calculado no se
                                             entera de que el tema ha cambiado. Verde cuando la
                                             cifra se movió a mejor, rojo a peor, y apagado cuando
                                             no hay tendencia o es neutra —el coste lo es siempre—. -->
                                        <TextBlock Text="{Binding Trend}"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="{StaticResource Pad.XXS.Top}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Good">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Ink}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Bad">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Ink}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- ============ Gráfica 1: coste en el tiempo ============ -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <!-- El conmutador va en LA MISMA LÍNEA del título y alineado a la
                                 derecha: es una opción de lectura de esta gráfica, no un control
                                 flotando sobre su bloque. -->
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right"
                                                 Content="Acumulado"
                                                 IsChecked="{Binding Cumulative}"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Suma tramo a tramo: la curva ascendente de lo gastado hasta cada fecha" />
                                <TextBlock Text="Coste en el tiempo" Style="{StaticResource Text.Lead}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Lo que consumió cada aplicación en cada tramo del periodo. Pasa el ratón por la gráfica para ver el desglose." />

                            <ItemsControl ItemsSource="{Binding CostLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="{StaticResource Pad.XS.Top}"
                                          Visibility="{Binding ShowCostLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <controls:ChartPlot
                                Height="240"
                                Margin="{StaticResource Pad.XS.Top}"
                                Series="{Binding CostSeries}"
                                Labels="{Binding CostLabels}"
                                TooltipLabels="{Binding CostRanges}"
                                IsCost="True"
                                Unit="{Binding CostUnit}"
                                AxisBrush="{DynamicResource Brush.TextMuted}"
                                GridBrush="{DynamicResource Brush.Line}"
                                Visibility="{Binding HasCost, Converter={StaticResource BoolToVisibility}}" />

                            <c:EmptyState
                                Glyph="{x:Static c:Icons.Metrics}"
                                Message="Se activará cuando alguna sesión del periodo tenga coste facturable. El coste se deriva de los tokens con la tarifa del modelo; las sesiones de Claude Code no se tarifan y salen en la actividad con sus tokens."
                                Visibility="{Binding HasCost, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 2: resoluciones en el tiempo ============ -->
                    <!-- Misma forma y mismo componente que la de coste, y va JUSTO debajo: se
                         leen en pareja («esto costó, esto saldó»). -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right"
                                                 Content="Acumulado"
                                                 IsChecked="{Binding CumulativeResolutions}"
                                                 VerticalAlignment="Center"
                                                 ToolTip="Suma tramo a tramo: la curva ascendente de lo saldado hasta cada fecha" />
                                <TextBlock Text="Resoluciones en el tiempo" Style="{StaticResource Text.Lead}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Cuántos hallazgos se dieron por resueltos en cada tramo, por aplicación. Cuenta todas las vías —veredicto del auditor, resolución manual y medida—: es deuda saldada, venga de donde venga." />

                            <ItemsControl ItemsSource="{Binding ResolutionLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="{StaticResource Pad.XS.Top}"
                                          Visibility="{Binding ShowResolutionLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <controls:ChartPlot
                                Height="240"
                                Margin="{StaticResource Pad.XS.Top}"
                                Series="{Binding ResolutionSeries}"
                                Labels="{Binding ResolutionLabels}"
                                TooltipLabels="{Binding ResolutionRanges}"
                                ValueFormat="0"
                                Unit="resoluciones"
                                AxisBrush="{DynamicResource Brush.TextMuted}"
                                GridBrush="{DynamicResource Brush.Line}"
                                Visibility="{Binding HasResolutions, Converter={StaticResource BoolToVisibility}}" />

                            <c:EmptyState
                                Message="Aún no hay resoluciones en este periodo."
                                Visibility="{Binding HasResolutions, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 3: cobertura por aplicación ============ -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Cobertura por aplicación" Style="{StaticResource Text.Lead}"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Qué parte del inventario del ciclo vigente está auditada. Pulsa un rosco para abrir ese inventario." />

                            <ItemsControl ItemsSource="{Binding Coverage}" Margin="{StaticResource Pad.M.Top}"
                                          Visibility="{Binding HasCoverage, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.OpenInventoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}"
                                            Margin="{StaticResource Pad.BarItem}"
                                            ToolTip="{Binding Detail}">
                                            <StackPanel>
                                                <Grid Width="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      Height="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      HorizontalAlignment="Center">
                                                    <controls:DonutRing Segments="{Binding Segments}" RingThickness="14" />
                                                    <TextBlock Text="{Binding PctText}"
                                                               Style="{StaticResource Text.H3}"
                                                               Foreground="{DynamicResource Brush.Text}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           HorizontalAlignment="Center"
                                                           Margin="{StaticResource Pad.XS.Top}" />
                                                <TextBlock Text="{Binding CycleLabel}" Style="{StaticResource Text.Meta}"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <c:EmptyState
                                Message="Se activará cuando haya un inventario del ciclo vigente."
                                Visibility="{Binding HasCoverage, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 3b: severidad por aplicación ============ -->
                    <!-- Va JUSTO debajo de cobertura y con el mismo lenguaje de roscos: una dice
                         cuánto se ha mirado, la otra qué se encontró. Y es la única gráfica del
                         panel que usa los colores de severidad, porque es la única donde la
                         paleta semántica ES el dato (F5.9 §2, D-316). -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Severidad por aplicación" Style="{StaticResource Text.Lead}"
                                       FontWeight="SemiBold" />
                            <!-- El subtítulo dice que el rango temporal NO manda aquí. Sin esa
                                 frase, cambiar el periodo y ver los mismos números se lee como un
                                 fallo del programa en vez de como lo que es. -->
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Cómo se reparte la deuda viva de cada aplicación — hallazgos activos a día de hoy, sin recortar por el periodo. Pulsa un tramo para ver esos hallazgos." />

                            <!-- Una leyenda para la fila entera, no una por rosco. -->
                            <ItemsControl ItemsSource="{Binding SeverityLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="{StaticResource Pad.XS.Top}"
                                          Visibility="{Binding HasSeverity, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding SeverityCards}" Margin="{StaticResource Pad.S.Top}"
                                          Visibility="{Binding HasSeverity, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- El botón cubre el rosco entero: es el gesto «esta app,
                                             todas las severidades». Los tramos marcan su clic como
                                             atendido, así que el suyo gana sin que este se dispare
                                             también. -->
                                        <Button
                                            Command="{Binding DataContext.OpenAppFindingsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Ghost}"
                                            Margin="{StaticResource Pad.BarItem}"
                                            ToolTip="{Binding Detail}">
                                            <StackPanel>
                                                <Grid Width="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      Height="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      HorizontalAlignment="Center">
                                                    <controls:DonutRing
                                                        Segments="{Binding Segments}"
                                                        RingThickness="14"
                                                        SegmentGap="3"
                                                        EmptyBrush="{DynamicResource Brush.Surface2}"
                                                        SegmentCommand="{Binding DataContext.OpenSeverityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                    <TextBlock Text="{Binding TotalText}"
                                                               Style="{StaticResource Text.H3}"
                                                               Foreground="{DynamicResource Brush.Text}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Small}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text}"
                                                           HorizontalAlignment="Center"
                                                           Margin="{StaticResource Pad.XS.Top}" />
                                                <TextBlock Text="0 activos" Style="{StaticResource Text.Meta}"
                                                           HorizontalAlignment="Center"
                                                           Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <c:EmptyState
                                Message="Se activará cuando haya alguna aplicación dada de alta."
                                Visibility="{Binding HasSeverity, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 4: flujo de hallazgos ============ -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Flujo de hallazgos" Style="{StaticResource Text.Lead}"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Lo que entra y lo que se cierra en cada tramo, y cuántos quedaban vivos al cerrarlo. Si la línea baja, la deuda baja." />

                            <ItemsControl ItemsSource="{Binding FlowLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="{StaticResource Pad.XS.Top}"
                                          Visibility="{Binding ShowFlowLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <controls:ChartPlot
                                Height="220"
                                Margin="{StaticResource Pad.XS.Top}"
                                Series="{Binding FlowSeries}"
                                Labels="{Binding FlowLabels}"
                                TooltipLabels="{Binding FlowRanges}"
                                ValueFormat="0"
                                Unit="hallazgos"
                                AxisBrush="{DynamicResource Brush.TextMuted}"
                                GridBrush="{DynamicResource Brush.Line}"
                                Visibility="{Binding HasFlow, Converter={StaticResource BoolToVisibility}}" />

                            <c:EmptyState
                                Message="Se activará cuando haya hallazgos detectados o resueltos en el periodo."
                                Visibility="{Binding HasFlow, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 6: la cinta de ciclos (F17 §6) ============ -->
                    <Border Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Ciclos y temáticas" Style="{StaticResource Text.Lead}"
                                       FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Small}"
                                       Text="Los ciclos de cada aplicación, en orden: un bloque por ciclo, coloreado por su temática, con sus fechas debajo y los huecos sin auditar contados. Pulsa un bloque para abrir el informe de su cierre; el ciclo abierto lleva al inventario." />

                            <ItemsControl ItemsSource="{Binding CycleLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="{StaticResource Pad.XS.Top}"
                                          Visibility="{Binding ShowCycleLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- F17.1: la cinta lleva DENTRO su columna fija de nombres y su propio
                                 desplazamiento horizontal (jamás el de la página): la fila es la
                                 unidad indivisible, y nombre y banda no pueden moverse por separado. -->
                            <controls:CycleRibbon
                                Margin="{StaticResource Pad.XS.Top}"
                                Tracks="{Binding CycleTracks}"
                                SpanCommand="{Binding OpenCycleCommand}"
                                AxisBrush="{DynamicResource Brush.TextMuted}"
                                TextBrush="{DynamicResource Brush.Text}"
                                Visibility="{Binding HasCycles, Converter={StaticResource BoolToVisibility}}" />

                            <c:EmptyState
                                Message="Se activará cuando haya alguna aplicación registrada."
                                Visibility="{Binding HasCycles, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- ============ Gráfica 7: actividad de sesiones ============ -->
                    <Border Style="{StaticResource Block}" Padding="{StaticResource Pad.Zero}">
                        <StackPanel>
                            <StackPanel Margin="{StaticResource Pad.Card}">
                                <TextBlock Text="Actividad de sesiones" Style="{StaticResource Text.Lead}"
                                           FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Text.Small}"
                                           Text="El registro de operaciones del periodo. Pulsa una línea para abrir su informe." />
                            </StackPanel>

                            <Grid Margin="{StaticResource Pad.Row}"
                                  Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                                <!-- EL SOBRANTE SE REPARTE CON LA DERECHA (R4 §4). «Hallazgos»
                                     tenia 110 fijos y «Coste y tokens» 170 pegado a continuacion,
                                     sin un solo pixel entre ellos: «sin cambios» acaba en el borde
                                     de su columna y «20,2 AI credits» empieza en ese mismo borde,
                                     asi que las dos se leian pegadas —«sin cambios20,2 AI
                                     credits»— y parecian una sola.

                                     EL SOBRANTE SE REPARTE ENTRE TODAS, NO ENTRE TRES (R6 §3). Con
                                     cinco anchos fijos y tres estrellas 2:1:1, «Fecha», «Aplicación»
                                     y «Tipo» iban apretadas —«Auditoría por lotes» partida en dos
                                     líneas— mientras «Hallazgos» y «Coste» nadaban en cuatrocientos
                                     píxeles de vacío. Ahora las OCHO son estrella con su mínimo
                                     declarado, así que lo que sobra se reparte por igual y ninguna
                                     se lo lleva todo. «Aplicación» lleva además un máximo de 320:
                                     un nombre de repositorio no necesita más, y sin tope se comía
                                     el reparto.

                                     Y EL AIRE ENTRE COLUMNAS ES 24, NO 12 (R6 §3). Con 12, «Quién»
                                     acababa pegada a «Unidades» —un nombre completo llena su
                                     columna y la cifra de al lado empieza donde el nombre termina—
                                     mientras las columnas cortas parecían tener más aire. El canal
                                     es ahora el mismo para las ocho, y sale del canal y no de lo
                                     que mida el dato de cada una.

                                     Con ese aire, «Quién» pide 200 y «Tipo» 160: medido, «Auditoría
                                     por lotes» ocupa 124 px y la columna deja 136 libres tras su
                                     canal, así que no vuelve a partirse en dos líneas. Los mínimos
                                     —110, 160, 160, 130, 200, 100, 110, 160— suman 1.130 y siguen
                                     cabiendo a 1280. -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="110" />
                                    <ColumnDefinition Width="*" MinWidth="160" MaxWidth="320" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="*" MinWidth="130" />
                                    <ColumnDefinition Width="*" MinWidth="200" />
                                    <ColumnDefinition Width="*" MinWidth="100" />
                                    <ColumnDefinition Width="*" MinWidth="110" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fecha" Style="{StaticResource Table.Header}" Margin="{StaticResource Pad.L.Right}" />
                                <TextBlock Grid.Column="1" Text="Aplicación" Style="{StaticResource Table.Header}" Margin="{StaticResource Pad.L.Right}" />
                                <TextBlock Grid.Column="2" Text="Tipo" Style="{StaticResource Table.Header}" Margin="{StaticResource Pad.L.Right}" />
                                <!-- F16 §C: con dos casas, saber cuál gastó es parte de leer la fila. -->
                                <TextBlock Grid.Column="3" Text="Proveedor" Style="{StaticResource Table.Header}" Margin="{StaticResource Pad.L.Right}" />
                                <TextBlock Grid.Column="4" Text="Quién" Style="{StaticResource Table.Header}" Margin="{StaticResource Pad.L.Right}" />
                                <TextBlock Grid.Column="5" Text="Unidades" Style="{StaticResource Table.Header.Number}" Margin="{StaticResource Pad.L.Right}" />
                                <TextBlock Grid.Column="6" Text="Hallazgos" Style="{StaticResource Table.Header.Number}" Margin="{StaticResource Pad.L.Right}" />
                                <!-- «Coste y tokens» es una CIFRA, y va donde van las cifras: a la
                                     derecha, como «Unidades» y «Hallazgos» (P-08). -->
                                <TextBlock Grid.Column="7" Text="Coste y tokens" Style="{StaticResource Table.Header.Number}" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sessions}"
                                          Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Style="{StaticResource SessionRow}"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir el informe de esta sesión">
                                            <Grid>
                                                <!-- LAS MISMAS OCHO QUE LA CABECERA (R4 §4). -->
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="110" />
                                                    <ColumnDefinition Width="*" MinWidth="160" MaxWidth="320" />
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                    <ColumnDefinition Width="*" MinWidth="130" />
                                                    <ColumnDefinition Width="*" MinWidth="200" />
                                                    <ColumnDefinition Width="*" MinWidth="100" />
                                                    <ColumnDefinition Width="*" MinWidth="110" />
                                                    <ColumnDefinition Width="*" MinWidth="160" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding When}" Style="{StaticResource Table.Cell}" Margin="{StaticResource Pad.L.Right}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{StaticResource Pad.L.Right}">
                                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                                               Fill="{Binding AppBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AppName}" Style="{StaticResource Table.Cell.Strong}"
                                                               Margin="{StaticResource Pad.XS.Left}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Table.Cell}" Margin="{StaticResource Pad.L.Right}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Provider}" Style="{StaticResource Table.Cell}"
                                                           Margin="{StaticResource Pad.L.Right}"
                                                           ToolTip="{Binding Provider}" />
                                                <!-- R6 §3: el nombre entero en una línea; si no cabe,
                                                     elipsis al final y el nombre completo en el tooltip. -->
                                                <TextBlock Grid.Column="4" Text="{Binding By}" Style="{StaticResource Table.Cell}"
                                                           Margin="{StaticResource Pad.L.Right}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding By}" />
                                                <!-- Cifras a la derecha y tabulares, como en Informes (P-08, UI-0030). -->
                                                <TextBlock Grid.Column="5" Text="{Binding Units}" Style="{StaticResource Cell.Number}" Margin="{StaticResource Pad.L.Right}" />
                                                <TextBlock Grid.Column="6" Text="{Binding Findings}" Style="{StaticResource Cell.Number}" Margin="{StaticResource Pad.L.Right}" />
                                                <!-- F16-RETOQUE §1 — el coste y, debajo, los tokens.
                                                     Una sesión que no se tarifa dice «suscripción» y
                                                     sus tokens son lo que deja comparar su peso con
                                                     el de cualquier otra. -->
                                                <StackPanel Grid.Column="7">
                                                    <TextBlock Text="{Binding Cost}" Style="{StaticResource Cell.Number}"
                                                               ToolTip="{Binding CostDetail}" />
                                                    <TextBlock Text="{Binding Tokens}" Style="{StaticResource Text.Meta}"
                                                               TextWrapping="Wrap" TextAlignment="Right"
                                                               ToolTip="{Binding TokensDetail}"
                                                               Visibility="{Binding Tokens, Converter={StaticResource NotEmptyToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <c:EmptyState
                                Glyph="{x:Static c:Icons.Session}"
                                Message="No hay sesiones registradas en este periodo."
                                Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
