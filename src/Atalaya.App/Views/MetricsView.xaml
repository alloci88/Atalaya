<UserControl
    x:Class="Atalaya.App.Views.MetricsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:Atalaya.App.Controls">
    <UserControl.Resources>

        <!-- El ritmo del panel en un sitio: cada bloque es una tarjeta con el mismo margen, y
             cada titulo de bloque pesa lo mismo. Ponerlo a ojo en cada gráfica es como se
             descuadró Ajustes (F5.7 §1). -->
        <!-- BasedOn NO es opcional: un Style con TargetType="ui:Card" y sin él SUSTITUYE al
             estilo implícito de WPF-UI en vez de extenderlo, y la tarjeta se queda sin fondo, sin
             borde y sin padding. Se vio en el render: el interruptor «Acumulado» acababa pegado
             al borde de la página porque el bloque ya no tenía relleno que lo separase. Es la
             misma regla que ButtonForegroundTests vigila en los Button, aplicada a Card. -->
        <Style x:Key="Block" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="BlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="BlockHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="TileFoot" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="EmptyNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>

        <!-- La fila del registro de operaciones. Lleva plantilla propia por una razón medida en
             el render: el ContentPresenter del botón por defecto NO estira su contenido, así que
             la rejilla de columnas de la fila se encogía hasta el ancho del texto y dejaba de
             cuadrar con la de la cabecera — el nombre de la app y quién la auditó salían pegados.
             Y quien redefine la plantilla se queda con el color: un Style de Button sin BasedOn
             arranca con el negro de serie de WPF, invisible sobre el tema oscuro (F5.6 §1). -->
        <Style x:Key="SessionRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- La leyenda: color + NOMBRE, nunca un color solo. Es la misma regla del piloto de
             vinculación (D-296): quien no distinga dos tonos tiene que poder leer cuál es cuál. -->
        <DataTemplate x:Key="LegendEntry">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Rectangle Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                           VerticalAlignment="Center"
                           Fill="{Binding Brush}"
                           StrokeDashArray="{Binding Dashed, Converter={StaticResource DashedToArray}}" />
                <TextBlock Text="{Binding Name}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <StackPanel Grid.Row="0" Margin="0,0,18,12">
            <TextBlock Text="Métricas" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PeriodLabel}" Style="{StaticResource BlockHint}" />
        </StackPanel>

        <!-- Fila de filtros: afectan a TODO el panel. Van arriba del todo porque cambian el
             significado de cada número de abajo. -->
        <Border Grid.Row="1"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,18,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aplicación" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Margin="0,0,8,0" />
                <ComboBox MinWidth="220"
                          ItemsSource="{Binding AppOptions}"
                          SelectedItem="{Binding SelectedApp}"
                          DisplayMemberPath="Name"
                          ToolTip="Filtra el panel entero por una aplicación" />

                <TextBlock Text="Periodo" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.7" Margin="20,0,8,0" />
                <ComboBox MinWidth="140"
                          ItemsSource="{Binding RangeOptions}"
                          SelectedItem="{Binding SelectedRange}"
                          DisplayMemberPath="Label"
                          ToolTip="Ventana temporal de las gráficas y de los tiles de periodo" />

                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="18,0,0,0"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- El mismo canalón que la cabecera y los filtros. La barra de desplazamiento de WPF-UI
             se pinta ENCIMA del contenido, así que sin este hueco la última tarjeta de la fila de
             cifras queda debajo de la barra; y con un hueco distinto al de arriba, el panel
             tendría dos bordes derechos. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,18,0">
            <StackPanel>

                <!-- Estado vacío del panel entero -->
                <ui:Card Style="{StaticResource Block}"
                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Todavía no hay nada que medir" Style="{StaticResource BlockTitle}" />
                        <TextBlock Style="{StaticResource BlockHint}"
                                   Text="El panel se llena solo con lo que ya se guarda: hallazgos, inventarios y sesiones. Lanza una auditoría desde el inventario de una aplicación y vuelve aquí." />
                    </StackPanel>
                </ui:Card>

                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">

                    <!-- ================= Tiles ================= -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">

                        <ui:Card Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Hallazgos activos" Style="{StaticResource TileCaption}" />
                                <TextBlock Text="{Binding ActiveTotal}" Style="{StaticResource TileNumber}" />
                                <ItemsControl ItemsSource="{Binding ActiveChips}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2" Margin="0,0,4,4"
                                                    Background="{Binding Background}">
                                                <TextBlock FontSize="11">
                                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                                    <Run Text="{Binding Count, Mode=OneWay}" FontWeight="Bold" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Resueltos en el periodo" Style="{StaticResource TileCaption}" />
                                <TextBlock Text="{Binding ResolvedInPeriod}" Style="{StaticResource TileNumber}" />
                                <TextBlock Text="{Binding ResolvedDelta}"
                                           Foreground="{Binding ResolvedDeltaBrush}"
                                           FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Coste del periodo" Style="{StaticResource TileCaption}" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CostTotal}" Style="{StaticResource TileNumber}" />
                                    <TextBlock Text="{Binding CostUnit}" Style="{StaticResource TileCaption}"
                                               VerticalAlignment="Bottom" Margin="7,0,0,7" />
                                </StackPanel>
                                <TextBlock Text="{Binding CostPerUnit}" Style="{StaticResource TileFoot}" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card>
                            <StackPanel>
                                <TextBlock Text="Cobertura del ciclo" Style="{StaticResource TileCaption}" />
                                <TextBlock Text="{Binding CyclePct}" Style="{StaticResource TileNumber}" />
                                <TextBlock Text="{Binding CycleDetail}" Style="{StaticResource TileFoot}" />
                            </StackPanel>
                        </ui:Card>
                    </UniformGrid>

                    <!-- ============ Gráfica 1: coste en el tiempo ============ -->
                    <ui:Card Style="{StaticResource Block}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Coste en el tiempo" Style="{StaticResource BlockTitle}" />
                                    <TextBlock Style="{StaticResource BlockHint}"
                                               Text="Lo que consumió cada aplicación en cada tramo del periodo. Pasa el ratón por la gráfica para ver el desglose." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 Content="Acumulado"
                                                 IsChecked="{Binding Cumulative}"
                                                 VerticalAlignment="Top"
                                                 ToolTip="Suma tramo a tramo: la curva ascendente de lo gastado hasta cada fecha" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CostLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="0,12,0,0"
                                          Visibility="{Binding ShowCostLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <controls:ChartPlot
                                Height="240"
                                Margin="0,8,0,0"
                                Series="{Binding CostSeries}"
                                Labels="{Binding CostLabels}"
                                Unit="{Binding CostUnit}"
                                AxisBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                GridBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                Visibility="{Binding HasCost, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Style="{StaticResource EmptyNote}"
                                       Text="— · se activará cuando alguna sesión del periodo registre coste. Las sesiones ya guardan tokens; el coste lo declara el SDK cuando lo conoce."
                                       Visibility="{Binding HasCost, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- ============ Gráfica 2: cobertura por aplicación ============ -->
                    <ui:Card Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Cobertura por aplicación" Style="{StaticResource BlockTitle}" />
                            <TextBlock Style="{StaticResource BlockHint}"
                                       Text="Qué parte del inventario del ciclo vigente está auditada. Pulsa un rosco para abrir ese inventario." />

                            <ItemsControl ItemsSource="{Binding Coverage}" Margin="0,14,0,0"
                                          Visibility="{Binding HasCoverage, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding DataContext.OpenInventoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10,6"
                                            Margin="0,0,10,10"
                                            Cursor="Hand"
                                            ToolTip="{Binding Detail}">
                                            <StackPanel>
                                                <Grid Width="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      Height="{Binding DataContext.DonutSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      HorizontalAlignment="Center">
                                                    <controls:DonutRing Segments="{Binding Segments}" RingThickness="14" />
                                                    <TextBlock Text="{Binding PctText}"
                                                               FontSize="20" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                <TextBlock Text="{Binding CycleLabel}" FontSize="11" Opacity="0.7"
                                                           HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource EmptyNote}"
                                       Text="— · se activará cuando haya un inventario del ciclo vigente."
                                       Visibility="{Binding HasCoverage, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- ============ Gráfica 3: flujo de hallazgos ============ -->
                    <ui:Card Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Flujo de hallazgos" Style="{StaticResource BlockTitle}" />
                            <TextBlock Style="{StaticResource BlockHint}"
                                       Text="Lo que entra y lo que se cierra en cada tramo, y cuántos quedaban vivos al cerrarlo. Si la línea baja, la deuda baja." />

                            <ItemsControl ItemsSource="{Binding FlowLegend}"
                                          ItemTemplate="{StaticResource LegendEntry}"
                                          Margin="0,12,0,0"
                                          Visibility="{Binding ShowFlowLegend, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <controls:ChartPlot
                                Height="220"
                                Margin="0,8,0,0"
                                Series="{Binding FlowSeries}"
                                Labels="{Binding FlowLabels}"
                                ValueFormat="0"
                                Unit="hallazgos"
                                AxisBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                GridBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                Visibility="{Binding HasFlow, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Style="{StaticResource EmptyNote}"
                                       Text="— · se activará cuando haya hallazgos detectados o resueltos en el periodo."
                                       Visibility="{Binding HasFlow, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>

                    <!-- ============ Gráfica 4: actividad de sesiones ============ -->
                    <ui:Card Style="{StaticResource Block}">
                        <StackPanel>
                            <TextBlock Text="Actividad de sesiones" Style="{StaticResource BlockTitle}" />
                            <TextBlock Style="{StaticResource BlockHint}"
                                       Text="El registro de operaciones del periodo. Pulsa una línea para abrir su informe." />

                            <Grid Margin="6,14,6,4" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Fecha" FontSize="11" Opacity="0.6" />
                                <TextBlock Grid.Column="1" Text="Aplicación" FontSize="11" Opacity="0.6" />
                                <TextBlock Grid.Column="2" Text="Quién" FontSize="11" Opacity="0.6" />
                                <TextBlock Grid.Column="3" Text="Unidades" FontSize="11" Opacity="0.6" />
                                <TextBlock Grid.Column="4" Text="Hallazgos" FontSize="11" Opacity="0.6" />
                                <TextBlock Grid.Column="5" Text="Coste" FontSize="11" Opacity="0.6" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Sessions}"
                                          Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Style="{StaticResource SessionRow}"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Abrir el informe de esta sesión">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding When}" FontSize="12" Opacity="0.85" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2"
                                                               Fill="{Binding AppBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AppName}" FontSize="12" Margin="7,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding By}" FontSize="12" Opacity="0.85" />
                                                <TextBlock Grid.Column="3" Text="{Binding Units}" FontSize="12" Opacity="0.85" />
                                                <TextBlock Grid.Column="4" Text="{Binding Findings}" FontSize="12" Opacity="0.85" />
                                                <TextBlock Grid.Column="5" Text="{Binding Cost}" FontSize="12" Opacity="0.85" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource EmptyNote}"
                                       Text="— · no hay sesiones registradas en este periodo."
                                       Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
