<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Igual que en el proyecto que prueba: el SDK marca [Experimental] parte de su superficie
         de permisos, y comprobarla es justamente lo que este proyecto hace. -->
    <NoWarn>$(NoWarn);GHCP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atalaya.Copilot\Atalaya.Copilot.csproj" />
    <!-- PROV-2 §3 — la OTRA casa, para poder comparar los dos catálogos de herramientas ENTRE SÍ.
         Compararlos contra una lista escrita a mano es lo que dejó divergir `unit_done`. -->
    <ProjectReference Include="..\..\src\Atalaya.ClaudeCode\Atalaya.ClaudeCode.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Domain\Atalaya.Domain.csproj" />
  </ItemGroup>

</Project>
