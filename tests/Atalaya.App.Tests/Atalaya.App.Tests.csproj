<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Atalaya.App\Atalaya.App.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Storage\Atalaya.Storage.csproj" />
    <ProjectReference Include="..\..\src\Atalaya.Domain\Atalaya.Domain.csproj" />
    <!-- F11: el motor del cambio de carpeta se prueba aqui, no lanzando procesos. -->
    <ProjectReference Include="..\..\src\Atalaya.Updater\Atalaya.Updater.csproj" />
    <!-- F14: la eleccion de proveedor y el tratamiento del coste se prueban aqui, con la app. -->
    <ProjectReference Include="..\..\src\Atalaya.ClaudeCode\Atalaya.ClaudeCode.csproj" />

    <!-- PROV-2 §1 — EXPLÍCITA, y a propósito. Esto llegaba de rebote por Atalaya.App, que
         referenciaba el proyecto de Copilot; desde que la aplicación no lo referencia, un
         proyecto de PRUEBAS que quiera el doble de esa casa (FakeCopilotAgent, el agente de
         776 tests) tiene que pedirlo por su nombre. La regla del desacople es sobre la
         aplicación y el dominio, no sobre los tests: aquí se monta a mano lo que haga falta. -->
    <ProjectReference Include="..\..\src\Atalaya.Copilot\Atalaya.Copilot.csproj" />

    <!-- PROV-3 — la tercera casa, EXPLÍCITA por lo mismo que Copilot: la aplicación ya no
         referencia el proyecto de ningún proveedor, así que un proyecto de PRUEBAS que quiera
         conducir un barrido con ella tiene que pedirlo por su nombre. -->
    <ProjectReference Include="..\..\src\Atalaya.OpenAI\Atalaya.OpenAI.csproj" />

    <!-- PROV-2 §5 — el doble que no es de ninguna casa vive junto al contrato, en
         Atalaya.Agents.Tests. El barrido de punta a punta con un proveedor de mentira se conduce
         desde aqui, que es donde esta el arnes de la aplicacion. -->
    <ProjectReference Include="..\Atalaya.Agents.Tests\Atalaya.Agents.Tests.csproj" />

    <!-- F16 — el puente, como ejecutable: la sesión de arreglo se prueba con la cadena entera
         (CLI falso → puente → tubería → servidor MCP → toolbox de verdad). -->
    <ProjectReference Include="..\..\src\Atalaya.Mcp\Atalaya.Mcp.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />

    <!-- F16 — el CLI falso que SÍ habla MCP: lanza el puente y llama a las tools, que es el
         sentido que un guion de eventos no puede ejercitar. Se necesita como EJECUTABLE, igual
         que el puente, así que se construye y se copia pero no se referencia. -->
    <ProjectReference Include="..\Atalaya.FakeCli\Atalaya.FakeCli.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- F37 §0 — las rutas reales de X-BLAST. El árbol de carpetas se mide sobre el inventario que
       existe, no sobre uno inventado: 923 unidades en 22 proyectos es donde se ve si la vista gana
       o pierde filas. -->
  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- OMPT-BUGFIX-CI — la fabrica de repositorios de los tests, compartida con
       Atalaya.Storage.Tests: un test no depende de la identidad de git de la maquina. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <!-- PROV-3 — el endpoint falso y su arnés se ENLAZAN, no se copian. El barrido de punta a punta
       con la casa por API necesita el arnés de la aplicación (hub bare, coordinador, toolbox de
       verdad), que vive aquí; y el doble del endpoint vive donde vive su proyecto. Duplicarlo
       garantizaría que las dos copias divergieran en cuanto una API de verdad cambiara de forma. -->
  <ItemGroup>
    <Compile Include="..\Atalaya.OpenAI.Tests\EndpointFalso.cs" LinkBase="OpenAI" />
    <Compile Include="..\Atalaya.OpenAI.Tests\Arnes.cs" LinkBase="OpenAI" />
  </ItemGroup>

</Project>
